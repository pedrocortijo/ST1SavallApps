@page "/modelos/operarios"
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Operarios</PageTitle>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Operarios</h2>
            <p class="text-muted mb-0">Gestión de operarios, información de contacto, asignación de cargos y permisos</p>
        </div>
        <NavLink href="/" class="btn btn-outline-secondary btn-sm">
            <i class="oi oi-arrow-left me-1"></i> Volver a Inicio
        </NavLink>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <DxPopup @bind-Visible="conflictoAusenciaVisible"
             HeaderText="Servicios asignados"
             ShowFooter="true"
             Width="560px"
             HorizontalAlignment="HorizontalAlignment.Center"
             VerticalAlignment="VerticalAlignment.Center">
        <BodyContentTemplate>
            <div class="py-3">@mensajeConflictoAusencia</div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <div class="d-flex justify-content-end w-100">
                <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => conflictoAusenciaVisible = false" />
            </div>
        </FooterContentTemplate>
    </DxPopup>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (operarios == null || cargos == null || plantas == null || camiones == null)
            {
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted mb-0">Cargando operarios, cargos y plantas...</p>
                </div>
            }
            else
            {
                <DxGrid @ref="grid"
                        Data="@operarios"
                        KeyFieldName="IdOperario"
                        EditMode="GridEditMode.PopupEditForm"
                        EditModelSaving="OnEditModelSaving"
                        DataItemDeleting="OnDataItemDeleting"
                        CustomizeEditModel="Grid_CustomizeEditModel"
                        PopupEditFormHeaderCssClass="bg-primary text-white"
                        PopupEditFormHeaderText="Formulario - Operario"
                        PopupEditFormCssClass="crud-popup operarios-popup"
                        PagerPosition="GridPagerPosition.Bottom"
                        PageSize="20"
                        AllowSort="true"
                        ShowFilterRow="true"
                        ShowSearchBox="true"
                        CustomizeElement="OnCustomizeElement">
                    <Columns>
                        <DxGridCommandColumn Width="120px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                            <HeaderTemplate>
                                <button class="btn btn-sm btn-primary d-flex align-items-center justify-content-center shadow-sm w-100" 
                                        @onclick="StartNewOperarioAsync"
                                        title="Nuevo Operario">
                                    <i class="oi oi-plus me-1"></i> Nuevo
                                </button>
                            </HeaderTemplate>
                            <CellDisplayTemplate>
                                @{
                                    var oper = (Operario)context.DataItem;
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center shadow-sm" 
                                                style="width: 32px; height: 32px;"
                                                @onclick="() => grid?.StartEditDataItemAsync(oper)" 
                                                @onclick:stopPropagation
                                                title="Editar">
                                            <i class="oi oi-pencil" style="font-size: 0.9rem;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-info d-flex align-items-center justify-content-center shadow-sm"
                                                style="width: 32px; height: 32px;"
                                                @onclick="() => DuplicateOperarioAsync(oper)"
                                                @onclick:stopPropagation
                                                title="Duplicar">
                                            <i class="oi oi-document" style="font-size: 0.9rem;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center shadow-sm" 
                                                style="width: 32px; height: 32px;"
                                                @onclick="() => grid?.ShowDataItemDeleteConfirmation(oper)" 
                                                @onclick:stopPropagation
                                                title="Eliminar">
                                            <i class="oi oi-trash" style="font-size: 0.9rem;"></i>
                                        </button>
                                    </div>
                                }
                            </CellDisplayTemplate>
                        </DxGridCommandColumn>
                        <DxGridDataColumn FieldName="IdOperario" Caption="Código" ReadOnly="true" Width="80px" Visible="false"/>
                        <DxGridDataColumn FieldName="Nombre" Caption="Nombre" Width="130px" TextAlignment="GridTextAlignment.Left" />
                        <DxGridDataColumn FieldName="Telefono" Caption="Teléfono" Width="100px" TextAlignment="GridTextAlignment.Left" />
                        <DxGridDataColumn FieldName="IdCargo" Caption="Cargo Asignado" Width="150px" TextAlignment="GridTextAlignment.Left">
                            <CellDisplayTemplate>
                                @{
                                    var oper = (Operario)context.DataItem;
                                    if (oper.IdCargo.HasValue)
                                    {
                                        var c = cargos.FirstOrDefault(x => x.IdCargo == oper.IdCargo.Value);
                                        @c?.Descripcion
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="IdPlanta" Caption="Planta / Centro" Width="200px" TextAlignment="GridTextAlignment.Left">
                            <CellDisplayTemplate>
                                @{
                                    var oper = (Operario)context.DataItem;
                                    if (oper.IdPlanta.HasValue && plantas != null)
                                    {
                                        var p = plantas.FirstOrDefault(x => x.IdPlanta == oper.IdPlanta.Value);
                                        @p?.Nombre
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="IdCamion" Caption="Camión" Width="130px" TextAlignment="GridTextAlignment.Left">
                            <CellDisplayTemplate>
                                @{ var oper = (Operario)context.DataItem; }
                                @camiones.FirstOrDefault(c => c.IdCamion == oper.IdCamion)?.Matricula
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="Activo" Caption="Activo" Width="100px" />
                        <DxGridDataColumn FieldName="EstadoLaboral" Caption="Estado laboral" Width="90px" Visible="false"/>
                        <DxGridDataColumn FieldName="InicioJornada" Caption="Ini. jornada" DisplayFormat="hh':'mm" Width="90px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="FinJornada" Caption="Fin jornada" DisplayFormat="hh':'mm" Width="90px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="Obras" Caption="Per. Obras" Width="110px" Visible="false" />
                        <DxGridDataColumn FieldName="Mensajes" Caption="Per. Mensajes" Width="120px" Visible="false" />
                    </Columns>

                    <EditFormTemplate Context="EditFormContext" >
                        @{
                            var oper = (Operario)EditFormContext.EditModel;
                            RegistrarOperarioEnEdicion(oper);
                        }
                        <DxTabs CssClass="w-100">
                            <DxTabPage Text="Datos generales">
                                <DxFormLayout CssClass="w-100 p-3" CaptionPosition="CaptionPosition.Vertical">
                            <DxFormLayoutItem Caption="Nombre Completo" ColSpanMd="6">
                                <DxTextBox @bind-Text="@oper.Nombre" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Teléfono" ColSpanMd="6">
                                <DxTextBox @bind-Text="@oper.Telefono" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Cargo Asignado" ColSpanMd="6" BeginRow="true">
                                <DxComboBox Data="@cargos"
                                            TextFieldName="Descripcion"
                                            ValueFieldName="IdCargo"
                                            @bind-Value="@oper.IdCargo" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Planta Asignada" ColSpanMd="6">
                                <DxComboBox Data="@plantas"
                                            TextFieldName="Nombre"
                                            ValueFieldName="IdPlanta"
                                            @bind-Value="@oper.IdPlanta" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Camión asignado" ColSpanMd="6" BeginRow="true">
                                <DxComboBox Data="@camiones"
                                            TextFieldName="Matricula"
                                            ValueFieldName="IdCamion"
                                            @bind-Value="@oper.IdCamion"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Inicio jornada" ColSpanMd="4" BeginRow="true">
                                <DxTimeEdit @bind-Time="@oper.InicioJornada" 
                                DisplayFormat="HH:mm" 
                                Format="HH:mm"
                                TimeSectionVisible="false" 
                                CssClass="text-center" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Fin jornada" ColSpanMd="4">
                                <DxTimeEdit @bind-Time="@oper.FinJornada" DisplayFormat="HH:mm" Format="HH:mm" TimeSectionVisible="false" CssClass="text-center" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Total (minutos)" ColSpanMd="4">
                                <div class="form-control bg-body-secondary text-center">@CalcularMinutosJornada(oper)</div>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Inicio almuerzo" ColSpanMd="4" BeginRow="true">
                                <DxTimeEdit @bind-Time="@oper.InicioDescanso" DisplayFormat="HH:mm" Format="HH:mm" TimeSectionVisible="false" CssClass="text-center" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Fin almuerzo" ColSpanMd="4">
                                <DxTimeEdit @bind-Time="@oper.FinDescanso" DisplayFormat="HH:mm" Format="HH:mm" TimeSectionVisible="false" CssClass="text-center" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Total (horas)" ColSpanMd="4">
                                <div class="form-control bg-body-secondary text-center">@CalcularHorasJornada(oper)</div>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Estado laboral" ColSpanMd="3" BeginRow="true" CssClass="@ClaseEstadoInactivo(oper)">
                                        <DxComboBox Data="@estadosLaborales" @bind-Value="@oper.EstadoLaboral" />
                                    </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Motivo" ColSpanMd="3" CssClass="@ClaseEstadoInactivo(oper)">
                                        <DxTextBox @bind-Text="@oper.MotivoInactividad" />
                                    </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Desde" ColSpanMd="3" CssClass="@ClaseEstadoInactivo(oper)">
                                        <DxDateEdit @bind-Date="@oper.InactivoDesde" />
                                    </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Hasta" ColSpanMd="3" CssClass="@ClaseEstadoInactivo(oper)">
                                        <DxDateEdit @bind-Date="@oper.InactivoHasta" />
                                    </DxFormLayoutItem>

                                </DxFormLayout>
                            </DxTabPage>
                            <DxTabPage Text="Ausencias">
                                <div class="p-3">
                            @if (EsOperarioExistente(oper.IdOperario))
                            {
                                    <DxGrid @key="oper.IdOperario" @ref="ausenciasGrid" Data="@GetAusencias(oper.IdOperario)" KeyFieldName="IdAusencia"
                                            EditMode="GridEditMode.PopupEditForm" EditModelSaving="OnAusenciaSaving"
                                            DataItemDeleting="OnAusenciaDeleting" PageSize="5" ShowPager="true">
                                        <Columns>
                                            <DxGridCommandColumn Width="96px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                                <HeaderTemplate Context="ausenciasHeader">
                                                    <button type="button" class="btn btn-sm btn-primary w-100" @onclick="() => NuevaAusencia(oper.IdOperario)">Nueva</button>
                                                </HeaderTemplate>
                                                <CellDisplayTemplate Context="ausenciaCell">
                                                    @{ var ausencia = (Ausencia)ausenciaCell.DataItem; }
                                                    <div class="d-flex flex-nowrap justify-content-center gap-1">
                                                        <button type="button" class="btn btn-sm btn-outline-primary p-0" style="width:32px;height:32px" title="Editar" @onclick="() => ausenciasGrid?.StartEditDataItemAsync(ausencia)"><i class="oi oi-pencil"></i></button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger p-0" style="width:32px;height:32px" title="Eliminar" @onclick="() => ausenciasGrid?.ShowDataItemDeleteConfirmation(ausencia)"><i class="oi oi-trash"></i></button>
                                                    </div>
                                                </CellDisplayTemplate>
                                            </DxGridCommandColumn>
                                            <DxGridDataColumn FieldName="FechaInicio" Caption="Desde" DisplayFormat="d" SortIndex="0" SortOrder="GridColumnSortOrder.Descending" />
                                            <DxGridDataColumn FieldName="FechaFin" Caption="Hasta" DisplayFormat="d" />
                                            <DxGridDataColumn FieldName="Tipo" Caption="Tipo" />
                                        </Columns>
                                        <EditFormTemplate Context="AusenciaEditContext">
                                            @{ var ausencia = (Ausencia)AusenciaEditContext.EditModel; }
                                            <DxFormLayout CssClass="p-3" CaptionPosition="CaptionPosition.Vertical">
                                                <DxFormLayoutItem Caption="Desde" ColSpanMd="6"><DxDateEdit @bind-Date="ausencia.FechaInicio" /></DxFormLayoutItem>
                                                <DxFormLayoutItem Caption="Hasta" ColSpanMd="6"><DxDateEdit @bind-Date="ausencia.FechaFin" /></DxFormLayoutItem>
                                                <DxFormLayoutItem Caption="Tipo" ColSpanMd="12"><DxComboBox Data="@tiposAusencia" @bind-Value="ausencia.Tipo" /></DxFormLayoutItem>
                                            </DxFormLayout>
                                        </EditFormTemplate>
                                    </DxGrid>
                            }
                            else
                            {
                                <span class="text-muted small">Guarde el operario antes de registrar sus ausencias.</span>
                            }

                                </div>
                            </DxTabPage>
                        </DxTabs>


@*                             <DxFormLayoutItem Caption="Permisos Especiales" ColSpanMd="12" BeginRow="true" CssClass="border-top pt-2 mt-2 fw-bold text-muted small text-uppercase">
                            </DxFormLayoutItem>
                            <DxFormLayoutItem ColSpanMd="4" BeginRow="true">
                                <DxCheckBox @bind-Checked="@oper.Obras" LabelPosition="LabelPosition.Right">Acceso Obras</DxCheckBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem ColSpanMd="4">
                                <DxCheckBox @bind-Checked="@oper.Mensajes" LabelPosition="LabelPosition.Right">Enviar Mensajes</DxCheckBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem ColSpanMd="4">
                                <DxCheckBox @bind-Checked="@oper.Tierras" LabelPosition="LabelPosition.Right">Gestión Tierras</DxCheckBox>
                            </DxFormLayoutItem>

 *@
                    </EditFormTemplate>
                </DxGrid>
            }
        </div>
    </div>
</div>

@code {
    private IGrid? grid;
    private IGrid? ausenciasGrid;
    private List<Operario>? operarios;
    private List<Cargo>? cargos;
    private List<Planta>? plantas;
    private List<Camion>? camiones;
    private string? errorMessage;
    private bool conflictoAusenciaVisible;
    private string? mensajeConflictoAusencia;
    private List<Ausencia> ausencias = [];
    private int conductorAusenciaActual;
    private Operario? operarioEnEdicion;
    private Operario? operarioToDuplicate;
    private readonly List<string> tiposAusencia = ["Asuntos Propios", "Baja Médica", "Vacaciones"];
    private readonly List<string> estadosLaborales = ["Activo", "Inactivo"];

    private sealed class MensajeApi
    {
        public string? Message { get; set; }
    }

    private async Task StartNewOperarioAsync()
    {
        operarioToDuplicate = null;
        if (grid is not null)
        {
            await grid.StartEditNewRowAsync();
        }
    }

    private async Task DuplicateOperarioAsync(Operario operario)
    {
        operarioToDuplicate = operario;
        if (grid is not null)
        {
            await grid.StartEditNewRowAsync();
        }
    }

    private void Grid_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        if (!e.IsNew || operarioToDuplicate is null)
        {
            return;
        }

        var newOperario = (Operario)e.EditModel;
        newOperario.IdOperario = 0;
        newOperario.Nombre = $"{operarioToDuplicate.Nombre} (Copia)";
        newOperario.Telefono = operarioToDuplicate.Telefono;
        newOperario.IdCargo = operarioToDuplicate.IdCargo;
        newOperario.IdPlanta = operarioToDuplicate.IdPlanta;
        newOperario.IdCamion = null;
        newOperario.Activo = operarioToDuplicate.Activo;
        newOperario.Obras = operarioToDuplicate.Obras;
        newOperario.Mensajes = operarioToDuplicate.Mensajes;
        newOperario.Tierras = operarioToDuplicate.Tierras;
        newOperario.EstadoLaboral = operarioToDuplicate.EstadoLaboral;
        newOperario.MotivoInactividad = operarioToDuplicate.MotivoInactividad;
        newOperario.InactivoDesde = operarioToDuplicate.InactivoDesde;
        newOperario.InactivoHasta = operarioToDuplicate.InactivoHasta;
        newOperario.InicioJornada = operarioToDuplicate.InicioJornada;
        newOperario.FinJornada = operarioToDuplicate.FinJornada;
        newOperario.InicioDescanso = operarioToDuplicate.InicioDescanso;
        newOperario.FinDescanso = operarioToDuplicate.FinDescanso;
        newOperario.Cargo = null;
        newOperario.Planta = null;
        operarioToDuplicate = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await SetupHeadersAsync();
        await LoadDataAsync();
    }

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            cargos = await Http.GetFromJsonAsync<List<Cargo>>("api/cargos") ?? new List<Cargo>();
            plantas = await Http.GetFromJsonAsync<List<Planta>>("api/plantas") ?? new List<Planta>();
            camiones = await Http.GetFromJsonAsync<List<Camion>>("api/camiones") ?? new List<Camion>();
            operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? new List<Operario>();
            ausencias = await Http.GetFromJsonAsync<List<Ausencia>>("api/ausencias") ?? [];
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar operarios: {ex.Message}";
            cargos ??= new List<Cargo>();
            plantas ??= new List<Planta>();
            camiones ??= new List<Camion>();
            operarios ??= new List<Operario>();
            ausencias ??= [];
        }
    }

    private async Task OnEditModelSaving(GridEditModelSavingEventArgs e)
    {
        var editModel = (Operario)e.EditModel;
        try
        {
            await SetupHeadersAsync();
            if (e.IsNew)
            {
                var response = await Http.PostAsJsonAsync("api/operarios", editModel);
                if (!response.IsSuccessStatusCode)
                {
                    var mensajeObj = await response.Content.ReadFromJsonAsync<MensajeApi>();
                    errorMessage = $"Error al crear operario: {mensajeObj?.Message ?? response.ReasonPhrase}";
                    e.Cancel = true;
                    return;
                }
            }
            else
            {
                var response = await Http.PutAsJsonAsync($"api/operarios/{editModel.IdOperario}", editModel);
                if (!response.IsSuccessStatusCode)
                {
                    var mensajeObj = await response.Content.ReadFromJsonAsync<MensajeApi>();
                    errorMessage = $"Error al actualizar operario: {mensajeObj?.Message ?? response.ReasonPhrase}";
                    e.Cancel = true;
                    return;
                }
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
            e.Cancel = true;
        }
    }

    private async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e)
    {
        var dataItem = (Operario)e.DataItem;
        try
        {
            await SetupHeadersAsync();
            var response = await Http.DeleteAsync($"api/operarios/{dataItem.IdOperario}");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Error al borrar operario: {response.ReasonPhrase}";
                return;
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al borrar: {ex.Message}";
        }
    }

    private IEnumerable<Ausencia> GetAusencias(int idOperario) => ausencias.Where(a => a.IdConductor == idOperario);

    private void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataRow && e.ElementType != GridElementType.DataCell)
            return;

        if (e.Grid.GetDataItem(e.VisibleIndex) is Operario operario &&
            (string.Equals(operario.EstadoLaboral, "Inactivo", StringComparison.OrdinalIgnoreCase) || operario.Activo == false))
        {
            e.Style = "background-color: #fde7e9 !important; color: #b42318 !important; font-weight: 700 !important;";
        }
    }

    private bool EsOperarioExistente(int idOperario) => operarios?.Any(o => o.IdOperario == idOperario) == true;

    private void RegistrarOperarioEnEdicion(Operario operario) => operarioEnEdicion = operario;

    private async Task ActualizarEstadoOperarioAsync(int idOperario)
    {
        var actualizado = await Http.GetFromJsonAsync<Operario>($"api/operarios/{idOperario}");
        if (actualizado is null) return;

        var indice = operarios?.FindIndex(o => o.IdOperario == idOperario) ?? -1;
        if (indice >= 0) operarios![indice] = actualizado;

        if (operarioEnEdicion?.IdOperario == idOperario)
        {
            operarioEnEdicion.Activo = actualizado.Activo;
            operarioEnEdicion.EstadoLaboral = actualizado.EstadoLaboral;
            operarioEnEdicion.MotivoInactividad = actualizado.MotivoInactividad;
            operarioEnEdicion.InactivoDesde = actualizado.InactivoDesde;
            operarioEnEdicion.InactivoHasta = actualizado.InactivoHasta;
        }
    }

    private static string ClaseEstadoInactivo(Operario operario) =>
        string.Equals(operario.EstadoLaboral, "Inactivo", StringComparison.OrdinalIgnoreCase)
            ? "operario-inactivo"
            : string.Empty;

    private static int CalcularMinutosJornada(Operario operario)
    {
        var jornada = operario.FinJornada - operario.InicioJornada;
        if (jornada < TimeSpan.Zero) jornada += TimeSpan.FromDays(1);

        if (operario.InicioDescanso is not { } inicioDescanso || operario.FinDescanso is not { } finDescanso)
            return Math.Max(0, (int)jornada.TotalMinutes);

        var descanso = finDescanso - inicioDescanso;
        if (descanso < TimeSpan.Zero) descanso += TimeSpan.FromDays(1);
        return Math.Max(0, (int)(jornada - descanso).TotalMinutes);
    }

    private static string CalcularHorasJornada(Operario operario) =>
        (CalcularMinutosJornada(operario) / 60m).ToString("0.00");

    private async Task NuevaAusencia(int idOperario)
    {
        conductorAusenciaActual = idOperario;
        await ausenciasGrid!.StartEditNewRowAsync();
    }

    private async Task OnAusenciaSaving(GridEditModelSavingEventArgs e)
    {
        var ausencia = (Ausencia)e.EditModel;
        if (e.IsNew) ausencia.IdConductor = conductorAusenciaActual;
        var response = e.IsNew
            ? await Http.PostAsJsonAsync("api/ausencias", ausencia)
            : await Http.PutAsJsonAsync($"api/ausencias/{ausencia.IdAusencia}", ausencia);
        if (!response.IsSuccessStatusCode)
        {
            var mensaje = await response.Content.ReadFromJsonAsync<MensajeApi>();
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                mensajeConflictoAusencia = mensaje?.Message ?? "El operario tiene servicios asignados durante el periodo de ausencia.";
                conflictoAusenciaVisible = true;
                e.Cancel = true;
                return;
            }
            errorMessage = $"Error al guardar la ausencia: {mensaje?.Message ?? response.ReasonPhrase}";
            return;
        }
        ausencias = await Http.GetFromJsonAsync<List<Ausencia>>("api/ausencias") ?? [];
        await ActualizarEstadoOperarioAsync(ausencia.IdConductor);
    }

    private async Task OnAusenciaDeleting(GridDataItemDeletingEventArgs e)
    {
        var ausencia = (Ausencia)e.DataItem;
        var response = await Http.DeleteAsync($"api/ausencias/{ausencia.IdAusencia}");
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"Error al eliminar la ausencia: {response.ReasonPhrase}";
            return;
        }
        ausencias = await Http.GetFromJsonAsync<List<Ausencia>>("api/ausencias") ?? [];
        await ActualizarEstadoOperarioAsync(ausencia.IdConductor);
    }
}
