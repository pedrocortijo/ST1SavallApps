@page "/modelos/clientes"
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Gestión de Clientes</PageTitle>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Clientes</h2>
            <p class="text-muted mb-0">Administración de clientes de Sage50</p>
        </div>
        <NavLink href="/" class="btn btn-outline-secondary btn-sm">
            <i class="oi oi-arrow-left me-1"></i> Volver a Inicio
        </NavLink>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (clientes == null)
            {
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted mb-0">Cargando clientes...</p>
                </div>
            }
            else
            {
                <DxGrid Data="@clientes"
                        KeyFieldName="Key"
                        PagerVisible="false"
                        PageSize="100"
                        AllowSort="true"
                        ShowFilterRow="false"
                        ShowSearchBox="true"
                        SearchBoxNullText="Buscar por código, nombre, CIF, dirección o población..."
                        SearchBoxInputDelay="500"
                        SearchText="@textoBusqueda"
                        SearchTextChanged="OnGridSearchTextChanged">
                    <Columns>
                        <DxGridCommandColumn Width="80px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                            <HeaderTemplate>
                                <button class="btn btn-sm btn-primary d-flex align-items-center justify-content-center shadow-sm w-100" 
                                        @onclick="NavigateToCreate"
                                        title="Nuevo Cliente">
                                    <i class="oi oi-plus me-1"></i> Nuevo
                                </button>
                            </HeaderTemplate>
                            <CellDisplayTemplate>
                                @{
                                    var item = (ClienteSage50)context.DataItem;
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center shadow-sm" 
                                                style="width: 32px; height: 32px;"
                                                @onclick="() => NavigateToEdit(item.Codigo, item.Clienteerp)" 
                                                @onclick:stopPropagation
                                                title="Editar">
                                            <i class="oi oi-pencil" style="font-size: 0.9rem;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center shadow-sm" 
                                                style="width: 32px; height: 32px;"
                                                @onclick="() => ConfirmDelete(item)" 
                                                @onclick:stopPropagation
                                                title="Eliminar">
                                            <i class="oi oi-trash" style="font-size: 0.9rem;"></i>
                                        </button>
                                    </div>
                                }
                            </CellDisplayTemplate>
                        </DxGridCommandColumn>
                        <DxGridDataColumn FieldName="Codigo" Caption="Código" Width="80px" />
                        <DxGridDataColumn FieldName="Nombre" Caption="Nombre Comercial"  />
                        <DxGridDataColumn FieldName="Cif" Caption="CIF" Width="100px" />
                        <DxGridDataColumn FieldName="Direccion" Caption="Dirección" Width="250px" />
                        <DxGridDataColumn FieldName="Poblacion" Caption="Población" Width="200px"/>
                        @* <DxGridDataColumn FieldName="Provincia" Caption="Provincia" /> *@
                        <DxGridDataColumn FieldName="BloqCli" Caption="Bloq." Width="80px">
                            <CellDisplayTemplate>
                                @{
                                    var item = (ClienteSage50)context.DataItem;
                                    if (item.BloqCli)
                                    {
                                        <span class="badge bg-danger">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">No</span>
                                    }
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 border-top">
                    <small class="text-muted">@ResumenBloque</small>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(!PuedeIrAnterior)" @onclick="IrAnteriorAsync">
                            <i class="oi oi-chevron-left me-1"></i> Anterior
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(!PuedeIrSiguiente)" @onclick="IrSiguienteAsync">
                            Siguiente <i class="oi oi-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<ClienteSage50>? clientes;
    private string? errorMessage;
    private const int TamanoBloque = 100;
    private int paginaActual = 1;
    private int totalClientes;
    private string? textoBusqueda;

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(totalClientes / (double)TamanoBloque));
    private bool PuedeIrAnterior => paginaActual > 1;
    private bool PuedeIrSiguiente => paginaActual < TotalPaginas;
    private string ResumenBloque => totalClientes == 0
        ? "No se han encontrado clientes."
        : $"Mostrando {(paginaActual - 1) * TamanoBloque + 1}-{Math.Min(paginaActual * TamanoBloque, totalClientes)} de {totalClientes} clientes";

    protected override async Task OnInitializedAsync()
    {
        await SetupHeadersAsync();
        await LoadDataAsync();
    }

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var filtro = Uri.EscapeDataString(textoBusqueda?.Trim() ?? string.Empty);
            var resultado = await Http.GetFromJsonAsync<ResultadoPaginado<ClienteSage50>>(
                $"api/clientessage50/paginados?pagina={paginaActual}&tamanoPagina={TamanoBloque}&buscar={filtro}");

            clientes = resultado?.Datos.ToList() ?? [];
            totalClientes = resultado?.TotalRegistros ?? 0;
            if (totalClientes > 0 && paginaActual > TotalPaginas)
            {
                paginaActual = TotalPaginas;
                await LoadDataAsync();
                return;
            }
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar clientes: {ex.Message}";
        }
    }

    private async Task OnGridSearchTextChanged(string texto)
    {
        textoBusqueda = texto;
        paginaActual = 1;
        await LoadDataAsync();
    }

    private async Task IrAnteriorAsync()
    {
        if (!PuedeIrAnterior) return;
        paginaActual--;
        await LoadDataAsync();
    }

    private async Task IrSiguienteAsync()
    {
        if (!PuedeIrSiguiente) return;
        paginaActual++;
        await LoadDataAsync();
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo("/modelos/clientes/edit");
    }

    private void NavigateToEdit(string codigo, string clienteerp)
    {
        var escCodigo = Uri.EscapeDataString(codigo.Trim());
        if (string.IsNullOrWhiteSpace(clienteerp))
        {
            NavigationManager.NavigateTo($"/modelos/clientes/edit/{escCodigo}");
        }
        else
        {
            var escClienteerp = Uri.EscapeDataString(clienteerp.Trim());
            NavigationManager.NavigateTo($"/modelos/clientes/edit/{escCodigo}/{escClienteerp}");
        }
    }

    private async Task ConfirmDelete(ClienteSage50 item)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea eliminar al cliente {item.Nombre.Trim()} (Código: {item.Codigo.Trim()})?");
        if (confirmed)
        {
            try
            {
                await SetupHeadersAsync();
                var escCodigo = Uri.EscapeDataString(item.Codigo.Trim());
                var url = $"api/clientessage50/{escCodigo}";
                if (!string.IsNullOrWhiteSpace(item.Clienteerp))
                {
                    url += $"/{Uri.EscapeDataString(item.Clienteerp.Trim())}";
                }
                var response = await Http.DeleteAsync(url);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = $"Error al borrar cliente: {response.ReasonPhrase}";
                    return;
                }
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                errorMessage = $"Error al borrar: {ex.Message}";
            }
        }
    }
}
