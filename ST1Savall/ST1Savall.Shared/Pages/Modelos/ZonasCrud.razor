@page "/modelos/zonas"
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Zonas</PageTitle>
<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Zonas</h2>
            <p class="text-muted mb-0">Mantenimiento de las zonas de Sage 50.</p>
        </div>
        <NavLink href="/" class="btn btn-outline-secondary btn-sm">Volver a inicio</NavLink>
    </div>
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (zonas is null)
            {
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary"></div>
                </div>
            }
            else
            {
                <DxGrid @ref="grid"
                        Data="@zonas"
                        KeyFieldName="Clave"
                        EditMode="GridEditMode.PopupEditForm"
                        EditModelSaving="GuardarAsync"
                        DataItemDeleting="EliminarAsync"
                        ValidationEnabled="false"
                        PopupEditFormHeaderText="Zona"
                        PopupEditFormHeaderCssClass="bg-primary text-white"
                        PopupEditFormCssClass="zonas-popup"
                        PageSize="20"
                        ShowFilterRow="true"
                        ShowSearchBox="true"
                        SearchBoxNullText="Buscar zona...">
                    <Columns>
                        <DxGridCommandColumn Width="100px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                            <HeaderTemplate>
                                <button class="btn btn-sm btn-primary w-100" @onclick="() => grid?.StartEditNewRowAsync()">Nuevo</button>
                            </HeaderTemplate>
                            <CellDisplayTemplate>
                                @{
                                    var zona = (ZonaComunSage50)context.DataItem;
                                }
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary" title="Editar zona" @onclick="() => EditarZonaAsync(zona)">✎</button>
                                    <button class="btn btn-sm btn-outline-danger" title="Eliminar zona" @onclick="() => grid?.ShowDataItemDeleteConfirmation(zona)">🗑</button>
                                </div>
                            </CellDisplayTemplate>
                        </DxGridCommandColumn>
                        <DxGridDataColumn FieldName="Zona" Caption="Zona" Width="110px" />
                        <DxGridDataColumn FieldName="Descripcion" Caption="Descripción" />
                        <DxGridDataColumn FieldName="Vista" Caption="Visible" Width="100px" />
                    </Columns>
                    <EditFormTemplate Context="editContext">
                        @{
                            var zona = (ZonaComunSage50)editContext.EditModel;
                            if (zona.Descripcion != null)
                            {
                                zona.Descripcion = zona.Descripcion.Trim();
                            }
                            if (zona.Zona != null)
                            {
                                zona.Zona = zona.Zona.Trim();
                            }
                        }
                        <DxFormLayout CssClass="p-2" CaptionPosition="CaptionPosition.Vertical">
                            <DxFormLayoutItem Caption="Zona" ColSpanMd="4">
                                <DxTextBox @bind-Text="zona.Zona" MaxLength="4" ReadOnly="@(editContext.DataItem != null)" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Descripción" ColSpanMd="12">
                                <DxTextBox @bind-Text="zona.Descripcion" MaxLength="50" BindValueMode="BindValueMode.OnInput" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Visible" ColSpanMd="4">
                                <DxCheckBox @bind-Checked="zona.Vista" />
                            </DxFormLayoutItem>
                        </DxFormLayout>
                    </EditFormTemplate>
                </DxGrid>
            }
        </div>
    </div>
</div>
<style>.zonas-popup { width: min(96vw, 700px) !important; }</style>

@code {
    private IGrid? grid;
    private List<ZonaComunSage50>? zonas;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await AutenticarAsync();
        await CargarAsync();
    }

    private async Task AutenticarAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = state.User.FindFirst("token")?.Value;
        if (!string.IsNullOrWhiteSpace(token))
            Http.DefaultRequestHeaders.Authorization = new("Bearer", token);
    }

    private async Task CargarAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<ZonaComunSage50>>("api/zonas") ?? [];
            foreach (var z in res)
            {
                z.Ruta = z.Ruta?.Trim() ?? "";
                z.Zona = z.Zona?.Trim() ?? "";
                z.Descripcion = z.Descripcion?.Trim() ?? "";
            }
            zonas = res;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            zonas ??= [];
            errorMessage = $"Error al cargar las zonas: {ex.Message}";
        }
    }

    private async Task EditarZonaAsync(ZonaComunSage50 zona)
    {
        zona.Ruta = zona.Ruta?.Trim() ?? "";
        zona.Zona = zona.Zona?.Trim() ?? "";
        zona.Descripcion = zona.Descripcion?.Trim() ?? "";
        if (grid != null)
        {
            await grid.StartEditDataItemAsync(zona);
        }
    }

    private async Task GuardarAsync(GridEditModelSavingEventArgs e)
    {
        var item = (ZonaComunSage50)e.EditModel;
        item.Ruta = string.IsNullOrWhiteSpace(item.Ruta) ? "01" : item.Ruta.Trim();
        item.Zona = item.Zona?.Trim() ?? "";
        item.Descripcion = item.Descripcion?.Trim() ?? "";

        try
        {
            HttpResponseMessage r;
            if (e.IsNew)
            {
                r = await Http.PostAsJsonAsync("api/zonas", item);
            }
            else
            {
                var original = (ZonaComunSage50)e.DataItem;
                var rutaOriginal = string.IsNullOrWhiteSpace(original.Ruta) ? "01" : original.Ruta.Trim();
                var zonaOriginal = original.Zona?.Trim() ?? "";
                r = await Http.PutAsJsonAsync(
                    $"api/zonas?ruta={Uri.EscapeDataString(rutaOriginal)}&zona={Uri.EscapeDataString(zonaOriginal)}", item);
            }

            if (!r.IsSuccessStatusCode)
            {
                errorMessage = await ErrorAsync(r);
                e.Cancel = true;
                return;
            }

            await CargarAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            e.Cancel = true;
        }
    }

    private async Task EliminarAsync(GridDataItemDeletingEventArgs e)
    {
        var item = (ZonaComunSage50)e.DataItem;
        var ruta = string.IsNullOrWhiteSpace(item.Ruta) ? "01" : item.Ruta.Trim();
        var zona = item.Zona?.Trim() ?? "";
        var r = await Http.DeleteAsync($"api/zonas?ruta={Uri.EscapeDataString(ruta)}&zona={Uri.EscapeDataString(zona)}");
        if (!r.IsSuccessStatusCode)
        {
            errorMessage = await ErrorAsync(r);
            e.Cancel = true;
            return;
        }
        await CargarAsync();
    }

    private static async Task<string> ErrorAsync(HttpResponseMessage r)
    {
        try
        {
            return (await r.Content.ReadFromJsonAsync<ApiMessage>())?.Message ?? $"Error: {r.ReasonPhrase}";
        }
        catch
        {
            return $"Error: {r.ReasonPhrase}";
        }
    }

    private sealed class ApiMessage
    {
        public string? Message { get; set; }
    }
}