@page "/modelos/parametros"
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Gestión de Parámetros</PageTitle>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Parámetros</h2>
            <p class="text-muted mb-0">Configuración de correo por empresa</p>
        </div>
        <NavLink href="/" class="btn btn-outline-secondary btn-sm">
            <i class="oi oi-arrow-left me-1"></i> Volver a Inicio
        </NavLink>
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Cerrar"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (parametros is null)
            {
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted mb-0">Cargando parámetros...</p>
                </div>
            }
            else
            {
                <DxGrid @ref="grid"
                        Data="@parametros"
                        KeyFieldName="Id"
                        EditMode="GridEditMode.PopupEditForm"
                        EditModelSaving="OnEditModelSaving"
                        DataItemDeleting="OnDataItemDeleting"
                        PopupEditFormHeaderCssClass="bg-primary text-white"
                        PopupEditFormHeaderText="Formulario - Parámetros"
                        PopupEditFormCssClass="crud-popup"
                        PagerPosition="GridPagerPosition.Bottom"
                        PageSize="20"
                        AllowSort="true"
                        ShowFilterRow="true"
                        ShowSearchBox="true"
                        SearchBoxNullText="Buscar parámetros...">
                    <Columns>
                        <DxGridCommandColumn Width="80px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                            <HeaderTemplate>
                                <button class="btn btn-sm btn-primary d-flex align-items-center justify-content-center shadow-sm w-100"
                                        @onclick="() => grid?.StartEditNewRowAsync()" title="Nuevo parámetro">
                                    <i class="oi oi-plus me-1"></i> Nuevo
                                </button>
                            </HeaderTemplate>
                            <CellDisplayTemplate>
                                @{ var parametro = (Parametro)context.DataItem; }
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center shadow-sm"
                                            style="width: 32px; height: 32px;"
                                            @onclick="() => grid?.StartEditDataItemAsync(parametro)"
                                            @onclick:stopPropagation title="Editar">
                                        <i class="oi oi-pencil" style="font-size: 0.9rem;"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center shadow-sm"
                                            style="width: 32px; height: 32px;"
                                            @onclick="() => grid?.ShowDataItemDeleteConfirmation(parametro)"
                                            @onclick:stopPropagation title="Eliminar">
                                        <i class="oi oi-trash" style="font-size: 0.9rem;"></i>
                                    </button>
                                </div>
                            </CellDisplayTemplate>
                        </DxGridCommandColumn>
                        <DxGridDataColumn FieldName="Id" Caption="Código" ReadOnly="true" Width="80px" Visible = "false"/>
                        <DxGridDataColumn FieldName="Empresa" Caption="Empresa" />
                        <DxGridDataColumn FieldName="SenderEmail" Caption="Email remitente" />
                        <DxGridDataColumn FieldName="SmtpServer" Caption="Servidor SMTP" />
                        <DxGridDataColumn FieldName="SmtpPort" Caption="Puerto" Width="90px" />
                    </Columns>
                    <EditFormTemplate Context="EditFormContext">
                        @{ var parametro = (Parametro)EditFormContext.EditModel; }
                        <DxTabs CssClass="w-100">
                            <DxTabPage Text="Datos generales">
                                <DxFormLayout CssClass="w-100 p-3">
                                    <DxFormLayoutItem Caption="Empresa *" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.Empresa" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Email receptor *" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.ReceiverEmail" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Email remitente *" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.SenderEmail" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Servidor SMTP *" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.SmtpServer" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Puerto SMTP *" ColSpanMd="12">
                                        <DxSpinEdit @bind-Value="parametro.SmtpPort" MinValue="1" MaxValue="65535" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Tipo SSL SMTP" ColSpanMd="12">
                                        <DxComboBox TData="string" Data="@tiposSslSmtp"
                                                    TValue="string"
                                                    @bind-Value="parametro.SslSmtpType"
                                                    NullText="Seleccione el tipo de seguridad..." />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Usuario SMTP" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.SmtpUser" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Contraseña SMTP" ColSpanMd="12">
                                        <input type="password"
                                               class="form-control"
                                               @bind="parametro.SmtpPassword"
                                               @bind:event="oninput"
                                               autocomplete="new-password"
                                               aria-label="Contraseña SMTP" />
                                    </DxFormLayoutItem>
                                </DxFormLayout>
                            </DxTabPage>
                            <DxTabPage Text="Estados/otros">
                                <DxFormLayout CssClass="w-100 p-3">
                                    <DxFormLayoutItem Caption="Tolerancia aviso inicio y fin servicio (minu.)" ColSpanMd="12">
                                        <DxSpinEdit @bind-Value="parametro.AvisoTiempoServicio" MinValue="0" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Redondeo de hora de servicio (minu.)" ColSpanMd="12">
                                        <DxSpinEdit @bind-Value="parametro.RedondeoHora" MinValue="1" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Tolerancia (+) sobre la duración del servicio (minu.)" ColSpanMd="12">
                                        <DxSpinEdit @bind-Value="parametro.DuracionOperacionServicioMinutos" MinValue="0" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Aviso días antelación contenedor OVP" ColSpanMd="12">
                                        <DxSpinEdit @bind-Value="parametro.AvisoTiempoContenedor" MinValue="0" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Ruta de imágenes" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.PathImagenes" NullText="Carpeta de red donde se guardan las fotos..." />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Ruta de firmas" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.PathFirmas" NullText="Carpeta de red donde se guardan las firmas..." />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutGroup Caption="Estados" ColSpanMd="12">
                                        <DxFormLayoutItem Caption="Estado iniciado" ColSpanMd="6">
                                            <DxComboBox Data="@estadosList"
                                                        TData="EstadoSolicitud"
                                                        TValue="int?"
                                                        TextFieldName="Descripcion"
                                                        ValueFieldName="IdEstado"
                                                        @bind-Value="parametro.EstadoIniciado"
                                                        ClearButtonVisible="true"
                                                        NullText="Seleccione estado iniciado..." />
                                        </DxFormLayoutItem>
                                        <DxFormLayoutItem Caption="Estado finalizado" ColSpanMd="6">
                                            <DxComboBox Data="@estadosList"
                                                        TData="EstadoSolicitud"
                                                        TValue="int?"
                                                        TextFieldName="Descripcion"
                                                        ValueFieldName="IdEstado"
                                                        @bind-Value="parametro.EstadoFinalizado"
                                                        ClearButtonVisible="true"
                                                        NullText="Seleccione estado finalizado..." />
                                        </DxFormLayoutItem>
                                        <DxFormLayoutItem Caption="Estado adjudicado" ColSpanMd="6">
                                            <DxComboBox Data="@estadosList"
                                                        TData="EstadoSolicitud"
                                                        TValue="int?"
                                                        TextFieldName="Descripcion"
                                                        ValueFieldName="IdEstado"
                                                        @bind-Value="parametro.EstadoAdjudicado"
                                                        ClearButtonVisible="true"
                                                        NullText="Seleccione estado adjudicado..." />
                                        </DxFormLayoutItem>
                                        <DxFormLayoutItem Caption="Estado pendiente" ColSpanMd="6">
                                            <DxComboBox Data="@estadosList"
                                                        TData="EstadoSolicitud"
                                                        TValue="int?"
                                                        TextFieldName="Descripcion"
                                                        ValueFieldName="IdEstado"
                                                        @bind-Value="parametro.EstadoPendiente"
                                                        ClearButtonVisible="true"
                                                        NullText="Seleccione estado pendiente..." />
                                        </DxFormLayoutItem>
                                        <DxFormLayoutItem Caption="Estado al reprogramar" ColSpanMd="12">
                                            <DxComboBox Data="@estadosList"
                                                        TData="EstadoSolicitud"
                                                        TValue="int?"
                                                        TextFieldName="Descripcion"
                                                        ValueFieldName="IdEstado"
                                                        @bind-Value="parametro.EstadoReprogramacion"
                                                        ClearButtonVisible="true"
                                                        NullText="Seleccione estado al reprogramar..." />
                                        </DxFormLayoutItem>
                                    </DxFormLayoutGroup>
                                    <DxFormLayoutItem Caption="Contraseña administración estados" ColSpanMd="12">
                                        <input type="password"
                                               class="form-control"
                                               @bind="parametro.AdminPassword"
                                               @bind:event="oninput"
                                               autocomplete="new-password"
                                               placeholder="Introduce la contraseña de administración..."
                                               aria-label="Contraseña de administración" />
                                    </DxFormLayoutItem>
                                </DxFormLayout>
                            </DxTabPage>
                            <DxTabPage Text="Albaranes">
                                <DxFormLayout CssClass="w-100 p-3">
                                    <DxFormLayoutItem Caption="Serie de albaranes" ColSpanMd="6">
                                        <DxTextBox @bind-Text="parametro.SerieAlbaranes" MaxLength="2" NullText="Ej.: A" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Empresa Sage" ColSpanMd="6">
                                        <DxTextBox @bind-Text="parametro.EmpresaAlbaranes" MaxLength="2" NullText="Ej.: 01" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Almacén de albaranes" ColSpanMd="6">
                                        <DxTextBox @bind-Text="parametro.AlmacenAlbaranes" MaxLength="3" NullText="Ej.: AL1" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Usuario Sage para albaranes" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.UsuarioAlbaranes" MaxLength="25" NullText="Ej.: MAYCA_NET" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Ruta Excel albaranes de planta · Sabospa Alicante" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.ExcelAlbaranesSabospaAlicante" MaxLength="500" NullText="Ej.: E:\BDClientes\ST1Savall\ALICANTE 2026.xlsx" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Ruta Excel albaranes de planta · Sabospa Finestrat" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.ExcelAlbaranesSabospaFinestrat" MaxLength="500" NullText="Ej.: E:\BDClientes\ST1Savall\FINESTRAT 2026.xlsx" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Ruta Excel albaranes de planta · Sabospa Monforte" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.ExcelAlbaranesSabospaMonforte" MaxLength="500" NullText="Ej.: E:\BDClientes\ST1Savall\MONFORTE 2026.xlsx" />
                                    </DxFormLayoutItem>
                                </DxFormLayout>
                            </DxTabPage>
                            <DxTabPage Text="Rutas (OSRM / Mapbox)">
                                <DxFormLayout CssClass="w-100 p-3">
                                    <DxFormLayoutItem Caption="Token (Solo Mapbox - opcional)" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.MapboxAccessToken" MaxLength="500" NullText="Vacío = Gratuito con OSRM (Sin Token)" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="URL base servicio rutas" ColSpanMd="12"><DxTextBox @bind-Text="parametro.MapboxBaseUrl" NullText="Por defecto: https://router.project-osrm.org" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Perfil de ruta" ColSpanMd="12"><DxTextBox @bind-Text="parametro.MapboxProfile" NullText="driving / foot / bike" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Caché (horas)" ColSpanMd="6"><DxSpinEdit @bind-Value="parametro.MapboxCacheDurationHours" MinValue="1" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Precisión de coordenadas" ColSpanMd="6"><DxSpinEdit @bind-Value="parametro.MapboxCoordinatePrecision" MinValue="4" MaxValue="6" /></DxFormLayoutItem>
                                </DxFormLayout>
                            </DxTabPage>
                            <DxTabPage Text="Wialon">
                                <DxFormLayout CssClass="w-100 p-3">
                                    <DxFormLayoutItem Caption="URL de Wialon" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.WialonUrl" MaxLength="500" NullText="https://hosting.wialon.com/?lang=es" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Usuario Wialon" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.WialonUsuario" MaxLength="100" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Host API Wialon" ColSpanMd="12"><DxTextBox @bind-Text="parametro.WialonHost" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Token Wialon" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.WialonAccessToken" MaxLength="500" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Contraseña Wialon" ColSpanMd="12">
                                        <DxTextBox @bind-Text="parametro.WialonPassword" MaxLength="500" />
                                    </DxFormLayoutItem>
                                </DxFormLayout>
                            </DxTabPage>
                        </DxTabs>
                    </EditFormTemplate>
                </DxGrid>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<string> tiposSslSmtp = new() { "Ninguno", "SSL/TLS", "STARTTLS" };
    private IGrid? grid;
    private List<Parametro>? parametros;
    private List<EstadoSolicitud>? estadosList;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await SetupHeadersAsync();
        await LoadDataAsync();
    }

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            parametros = await Http.GetFromJsonAsync<List<Parametro>>("api/parametros") ?? [];
            estadosList = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud") ?? [];
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar parámetros: {ex.Message}";
        }
    }

    private async Task OnEditModelSaving(GridEditModelSavingEventArgs e)
    {
        var parametro = (Parametro)e.EditModel;
        try
        {
            await SetupHeadersAsync();
            var response = e.IsNew
                ? await Http.PostAsJsonAsync("api/parametros", parametro)
                : await Http.PutAsJsonAsync($"api/parametros/{parametro.Id}", parametro);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Error al guardar parámetros: {response.ReasonPhrase}";
                e.Cancel = true;
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar parámetros: {ex.Message}";
            e.Cancel = true;
        }
    }

    private async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e)
    {
        var parametro = (Parametro)e.DataItem;
        try
        {
            await SetupHeadersAsync();
            var response = await Http.DeleteAsync($"api/parametros/{parametro.Id}");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Error al borrar parámetros: {response.ReasonPhrase}";
                e.Cancel = true;
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al borrar parámetros: {ex.Message}";
            e.Cancel = true;
        }
    }

}
