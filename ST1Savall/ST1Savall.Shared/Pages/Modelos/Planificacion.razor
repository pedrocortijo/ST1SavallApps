@page "/servicios/planificacion"
@using ST1Savall.Shared.Data
@using DevExpress.Blazor
@using System.Collections
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Planificación de servicios</PageTitle>

<style>
    .scheduler-card {
        width: 100% !important;
        max-width: 100% !important;
        overflow: hidden !important;
    }
    .scheduler-card-body {
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: auto !important;
        padding: 0 !important;
    }
    /* Fix DxScheduler top toolbar button overlapping on smaller screens */
    .dxbl-sc-header {
        flex-wrap: wrap !important;
        gap: 8px !important;
        padding: 8px 12px !important;
    }
    /* Ensure scheduler table view fits device width and scrolls internally */
    .dxbl-sc {
        width: 100% !important;
        max-width: 100% !important;
    }
    .dxbl-sc-view {
        width: 100% !important;
        min-width: 600px !important;
    }
    /* Custom scrollbar styling for scheduler container */
    .scheduler-card-body::-webkit-scrollbar {
        height: 12px !important;
        display: block !important;
    }
    .scheduler-card-body::-webkit-scrollbar-track {
        background: #1e1e2d !important;
        border-radius: 6px !important;
    }
    .scheduler-card-body::-webkit-scrollbar-thumb {
        background: #0d6efd !important;
        border-radius: 6px !important;
        border: 2px solid #1e1e2d !important;
    }
    .scheduler-card-body::-webkit-scrollbar-thumb:hover {
        background: #0b5ed7 !important;
    }
    .scheduler-tooltip-title {
        margin-right: auto;
    }
</style>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary mb-1">Planificación de servicios</h2>
            <p class="text-muted mb-0">Agenda diaria y semanal agrupada por conductor</p>
        </div>
        <div class="d-flex gap-2">
            <NavLink href="/servicios/asignacion-secuencial" class="btn btn-warning text-dark btn-sm fw-bold">
                <i class="oi oi-bolt me-1"></i> Programación
            </NavLink>
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadDataAsync">
                <i class="oi oi-reload me-1"></i> Actualizar
            </button>
            <NavLink href="/modelos/solicitudes" class="btn btn-outline-secondary btn-sm">
                <i class="oi oi-arrow-left me-1"></i> Volver a Solicitudes
            </NavLink>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (loading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando planificación...</p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-xl-3 col-md-6 col-12">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small">Servicios planificados</div>
                        <div class="fs-3 fw-bold text-primary">@CantidadServiciosPlanificadosPeriodo</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-12">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small">Nº de conductores planificados</div>
                        <div class="fs-3 fw-bold text-info">@CantidadConductoresPlanificadosPeriodo</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-12">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small">Horas planificadas</div>
                        <div class="fs-3 fw-bold text-success">@HorasPlanificadasPeriodo.ToString("N2") h</div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-12">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small">Solicitudes sin horario</div>
                        <div class="fs-3 fw-bold text-warning">@CantidadSolicitudesSinPlanificarPeriodo</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4 scheduler-card" style="border-radius: 12px;">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h5 class="fw-bold mb-0">Calendario por conductor</h5>
                <span class="text-muted small">Los servicios anulados no consumen disponibilidad</span>
            </div>
            <div class="card-body scheduler-card-body">
                <DxScheduler StartDate="@startDate"
                             StartDateChanged="OnStartDateChanged"
                             ActiveViewType="@activeViewType"
                             ActiveViewTypeChanged="OnActiveViewTypeChanged"
                             VisibleResourcesDataSource="@visibleConductores"
                             VisibleResourcesDataSourceChanged="OnVisibleResourcesDataSourceChanged"
                             DataStorage="@schedulerDataStorage"
                             GroupType="SchedulerGroupType.Resource"
                             AllowCreateAppointment="false"
                             AllowEditAppointment="false"
                             AllowDeleteAppointment="false"
                             AllowDragAppointment="false"
                             AllowResizeAppointment="false"
                             AllowDragAppointmentBetweenResources="false"
                             Height="650px"
                             Width="100%">
                    <AppointmentTooltipHeaderTemplate>
                        <span class="scheduler-tooltip-title">Servicio</span>
                        <DxSchedulerCloseAppointmentButton />
                    </AppointmentTooltipHeaderTemplate>
                    <Views>
                        <DxSchedulerDayView ShowWorkTimeOnly="true" WorkTime="@intervaloJornadaCalendario" />
                        <DxSchedulerWorkWeekView ShowWorkTimeOnly="true" WorkTime="@intervaloJornadaCalendario" />
                    </Views>
                </DxScheduler>
            </div>
        </div>

        @if (solicitudesSinPlanificar.Count > 0)
        {
            <div class="card shadow-sm border-0">
                <div class="card-header py-3">
                    <h5 class="fw-bold mb-0">Pendientes de planificar</h5>
                </div>
                <div class="card-body p-0">
                    <DxGrid Data="@GetSolicitudesSinPlanificarPeriodo()" KeyFieldName="IdSolicitud" PageSize="10" ShowSearchBox="true">
                        <Columns>
                            <DxGridDataColumn Caption="Acción" Width="90px">
                                <CellDisplayTemplate>
                                    @{
                                        var solicitud = (Solicitud)context.DataItem;
                                    }
                                    <button class="btn btn-sm btn-primary" @onclick="() => EditarSolicitud(solicitud.IdSolicitud)">Planificar</button>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="NombreObra" Caption="Obra" />
                            <DxGridDataColumn FieldName="NombreCliente" Caption="Cliente" />
                            <DxGridDataColumn FieldName="FechaTarea" Caption="Fecha solicitada" DisplayFormat="dd/MM/yyyy" />
                            <DxGridDataColumn FieldName="EstadoDescripcion" Caption="Estado" />
                        </Columns>
                    </DxGrid>
                </div>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Date { get; set; }

    private DateTime startDate = DateTime.Today;
    private SchedulerViewType activeViewType = SchedulerViewType.Day;
    private IEnumerable<Operario>? visibleConductores;
    private bool loading = true;
    private string? errorMessage;
    private List<Solicitud> serviciosPlanificados = [];
    private List<Solicitud> solicitudesSinPlanificar = [];
    private List<Operario> conductores = [];
    private List<EstadoSolicitud> estados = [];
    private DxSchedulerDataStorage schedulerDataStorage = new();
    private DxSchedulerTimeSpanRange intervaloJornadaCalendario = new(TimeSpan.FromHours(8), TimeSpan.FromHours(17));

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Date) && DateTime.TryParse(Date, out var parsedDate))
        {
            startDate = parsedDate.Date;
        }
        await SetupHeadersAsync();
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    (() => {
                        const replaceText = () => {
                            document.querySelectorAll('.dxbl-sc-header button, .dxbl-sc-header .dxbl-btn').forEach(btn => {
                                btn.childNodes.forEach(node => {
                                    if (node.nodeType === Node.TEXT_NODE && (node.textContent.trim() === 'Recursos' || node.textContent.trim() === 'Resources')) {
                                        node.textContent = node.textContent.replace(/Recursos|Resources/gi, 'Conductores');
                                    }
                                });
                            });
                        };
                        replaceText();
                        const observer = new MutationObserver(replaceText);
                        const target = document.querySelector('.scheduler-card') || document.body;
                        observer.observe(target, { childList: true, subtree: true, characterData: true });
                    })();
                ");
            }
            catch { }
        }
    }

    private void OnStartDateChanged(DateTime newDate)
    {
        startDate = newDate;
        StateHasChanged();
    }

    private void OnActiveViewTypeChanged(SchedulerViewType newView)
    {
        activeViewType = newView;
        StateHasChanged();
    }

    private void OnVisibleResourcesDataSourceChanged(IEnumerable newResources)
    {
        visibleConductores = newResources?.OfType<Operario>().ToList();
        StateHasChanged();
    }

    private (DateTime start, DateTime end) GetIntervaloVisible()
    {
        var fecha = startDate.Date;
        if (activeViewType == SchedulerViewType.WorkWeek || activeViewType == SchedulerViewType.Week)
        {
            int diff = (7 + (fecha.DayOfWeek - DayOfWeek.Monday)) % 7;
            var startOfWeek = fecha.AddDays(-diff);
            var endOfWeek = activeViewType == SchedulerViewType.Week ? startOfWeek.AddDays(7) : startOfWeek.AddDays(5);
            return (startOfWeek, endOfWeek);
        }
        else
        {
            return (fecha, fecha.AddDays(1));
        }
    }

    private HashSet<int> GetSelectedDriverIds()
    {
        var list = (visibleConductores != null && visibleConductores.Any())
            ? visibleConductores
            : conductores;
        return list.Select(c => c.IdOperario).ToHashSet();
    }

    private List<Solicitud> GetServiciosPlanificadosPeriodo()
    {
        if (serviciosPlanificados == null || serviciosPlanificados.Count == 0)
            return [];

        var (start, end) = GetIntervaloVisible();
        var driverIds = GetSelectedDriverIds();

        return serviciosPlanificados.Where(s =>
            s.FechaHoraInicioPlanificada.HasValue &&
            s.FechaHoraInicioPlanificada.Value.Date >= start &&
            s.FechaHoraInicioPlanificada.Value.Date < end &&
            s.IdConductor.HasValue &&
            driverIds.Contains(s.IdConductor.Value)
        ).ToList();
    }

    private int CantidadServiciosPlanificadosPeriodo => GetServiciosPlanificadosPeriodo().Count;

    private int CantidadConductoresPlanificadosPeriodo => GetServiciosPlanificadosPeriodo()
        .Where(s => s.IdConductor.HasValue && s.IdConductor.Value > 0)
        .Select(s => s.IdConductor!.Value)
        .Distinct()
        .Count();

    private double HorasPlanificadasPeriodo => GetServiciosPlanificadosPeriodo()
        .Sum(s => s.DuracionPlanificadaMinutos ?? 0) / 60d;

    private List<Solicitud> GetSolicitudesSinPlanificarPeriodo()
    {
        if (solicitudesSinPlanificar == null || solicitudesSinPlanificar.Count == 0)
            return [];

        var (start, end) = GetIntervaloVisible();
        var driverIds = GetSelectedDriverIds();

        return solicitudesSinPlanificar.Where(s =>
        {
            var fecha = s.FechaTarea ?? s.FechaSolicitud;
            if (!fecha.HasValue) return true;
            var f = fecha.Value.Date;
            if (f < start || f >= end) return false;
            if (s.IdConductor.HasValue && s.IdConductor.Value > 0 && !driverIds.Contains(s.IdConductor.Value)) return false;
            return true;
        }).ToList();
    }

    private int CantidadSolicitudesSinPlanificarPeriodo => GetSolicitudesSinPlanificarPeriodo().Count;

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrEmpty(token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
    }

    private async Task LoadDataAsync()
    {
        try
        {
            loading = true;
            errorMessage = null;
            var solicitudes = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes") ?? [];
            var todosOperarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? [];
            conductores = todosOperarios
                .Where(o =>
                    (EsConductor(o) && o.Activo != false && !string.Equals(o.EstadoLaboral, "Inactivo", StringComparison.OrdinalIgnoreCase))
                    || solicitudes.Any(s => s.IdConductor == o.IdOperario)
                )
                .OrderBy(o => o.Nombre)
                .ToList();
            ActualizarIntervaloJornadaCalendario();
            estados = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud") ?? [];

            foreach (var solicitud in solicitudes)
                solicitud.EstadoDescripcion = estados.FirstOrDefault(e => e.IdEstado == solicitud.Estado)?.Descripcion;

            serviciosPlanificados = solicitudes
                .Where(s => s.Estado != 6 && s.Estado != 4 && s.IdConductor.HasValue && s.FechaHoraInicioPlanificada.HasValue && s.FechaHoraFinPlanificada.HasValue)
                .ToList();
            solicitudesSinPlanificar = solicitudes
                .Where(s => s.Estado != 6 && s.Estado != 4 && (!s.IdConductor.HasValue || !s.FechaHoraInicioPlanificada.HasValue || !s.FechaHoraFinPlanificada.HasValue))
                .OrderBy(s => s.FechaTarea ?? DateTime.MaxValue)
                .ToList();

            schedulerDataStorage = new DxSchedulerDataStorage
            {
                AppointmentsSource = serviciosPlanificados,
                AppointmentMappings = new DxSchedulerAppointmentMappings
                {
                    Id = "IdSolicitud",
                    Start = "FechaHoraInicioPlanificada",
                    End = "FechaHoraFinPlanificada",
                    Subject = "NombreObra",
                    Description = "Observaciones",
                    Location = "PoblacionCliente",
                    ResourceId = "IdConductor"
                },
                ResourcesSource = conductores,
                ResourceMappings = new DxSchedulerResourceMappings
                {
                    Id = "IdOperario",
                    Caption = "Nombre"
                }
            };
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar la planificación: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ActualizarIntervaloJornadaCalendario()
    {
        var inicios = conductores
            .Where(c => c.InicioJornada != TimeSpan.Zero)
            .Select(c => c.InicioJornada)
            .ToList();
        var finales = conductores
            .Where(c => c.FinJornada != TimeSpan.Zero)
            .Select(c => c.FinJornada)
            .ToList();

        var inicio = inicios.Count > 0 ? inicios.Min() : TimeSpan.FromHours(8);
        var fin = finales.Count > 0 ? finales.Max() : TimeSpan.FromHours(17);
        intervaloJornadaCalendario = new DxSchedulerTimeSpanRange(inicio, fin > inicio ? fin : TimeSpan.FromHours(17));
    }

    private void EditarSolicitud(int id) => NavigationManager.NavigateTo($"/modelos/solicitudes/edit/{id}?returnUrl={Uri.EscapeDataString("/servicios/planificacion")}");

    private static bool EsConductor(Operario? o)
    {
        if (o == null) return false;
        if (o.IdCargo.HasValue && o.IdCargo == 1) return true;
        if (o.Cargo != null && !string.IsNullOrWhiteSpace(o.Cargo.Descripcion))
        {
            return string.Equals(o.Cargo.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase)
                || o.Cargo.Descripcion.Contains("conductor", StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }
}
