    private async Task OnClienteChangedAsync(string newCode)
    {
        if (obra == null || clienteBloqueadoPorAlbaranSage) return;

        if (clienteBloqueadoPorServicios)
        {
            if (!isAdmin) return;

            if (!string.Equals(newCode, clienteOriginal, StringComparison.OrdinalIgnoreCase))
            {
                pendingClienteCode = newCode;
                showClienteWarningPopup = true;
                StateHasChanged();
                return;
            }
        }

        await AplicarNuevoClienteAsync(newCode);
    }

    private async Task ConfirmarCambioClienteAsync()
    {
        showClienteWarningPopup = false;
        if (!string.IsNullOrEmpty(pendingClienteCode))
        {
            await AplicarNuevoClienteAsync(pendingClienteCode);
            pendingClienteCode = null;
        }
    }

    private void CancelarCambioCliente()
    {
        showClienteWarningPopup = false;
        pendingClienteCode = null;
        StateHasChanged();
    }

    private async Task AplicarNuevoClienteAsync(string newCode)
    {
        if (obra == null) return;
        obra.Cliente = newCode;
        if (!string.IsNullOrEmpty(newCode) && clientesList != null)
        {
            var client = clientesList.FirstOrDefault(c => c.Codigo == newCode);
            if (client != null)
            {
                try
                {
                    var contacts = await Http.GetFromJsonAsync<List<ContlfCliSage50>>($"api/contlfclisage50/por-cliente/{Uri.EscapeDataString(newCode)}");
                    if (contacts != null)
                    {
                        var predetContact = contacts.FirstOrDefault(c => c.Predet);
                        obra.Telefono = predetContact != null ? (predetContact.Telefono ?? "") : (client.Telefono ?? "");
                    }
                    else
                    {
                        obra.Telefono = client.Telefono ?? "";
                    }
                }
                catch (Exception)
                {
                    obra.Telefono = client.Telefono ?? "";
                }
            }
        }
    }

    private async Task<bool> IsUserAdminAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var nameOrEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.Identity?.Name;

        if (!string.IsNullOrWhiteSpace(nameOrEmail))
        {
            if (string.Equals(nameOrEmail, "admin@savall.com", StringComparison.OrdinalIgnoreCase) ||
                nameOrEmail.StartsWith("admin", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return user.IsInRole("Admin") || user.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && string.Equals(c.Value, "Admin", StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnCodpostChangedAsync(string val)
    {
        if (obra == null) return;
        obra.Codpost = LimitarTexto(val?.Trim(), 13);
        var p = poblaciones?.FirstOrDefault(x => x.Codigo?.Trim() == val?.Trim())
            ?? await BuscarPoblacionAsync(val, porCodigo: true);
        if (p != null)
        {
            obra.Poblacion = p.Poblacion?.Trim() ?? obra.Poblacion;
            obra.Provincia = p.Provincia?.Trim() ?? "";
        }
    }

    private async Task OnPoblacionChangedAsync(string val)
    {
        if (obra == null) return;
        obra.Poblacion = LimitarTexto(val?.Trim(), 30);
        var p = poblaciones?.FirstOrDefault(x => string.Equals(x.Poblacion?.Trim(), val?.Trim(), StringComparison.OrdinalIgnoreCase))
            ?? await BuscarPoblacionAsync(val, porCodigo: false);
        if (p != null)
        {
            obra.Poblacion = p.Poblacion?.Trim() ?? obra.Poblacion;
            obra.Codpost = p.Codigo?.Trim() ?? "";
            obra.Provincia = p.Provincia?.Trim() ?? "";
        }
    }

    private async Task OnPoblacionValidadaChangedAsync(string val)
    {
        if (obra is null) return;
        obra.Poblacion = LimitarTexto(val?.Trim(), 30);
        if (omitirValidacionPoblacion)
        {
            // La marca se usa únicamente para el cambio de foco provocado por la lupa.
            omitirValidacionPoblacion = false;
            return;
        }

        var poblacion = poblaciones?.FirstOrDefault(p => string.Equals(p.Poblacion?.Trim(), obra.Poblacion, StringComparison.OrdinalIgnoreCase))
            ?? await BuscarPoblacionAsync(obra.Poblacion, porCodigo: false);
        if (poblacion is null)
        {
            poblacionValida = false;
            errorMessage = $"La población '{obra.Poblacion}' no existe. Seleccione una población válida antes de guardar.";
            return;
        }

        poblacionValida = true;
        obra.Poblacion = poblacion.Poblacion?.Trim() ?? obra.Poblacion;
        obra.Codpost = poblacion.Codigo?.Trim() ?? "";
        obra.Provincia = poblacion.Provincia?.Trim() ?? "";
        ComprobarTarifaParaPoblacion();
    }
    private void ComprobarTarifaParaPoblacion()
    {
        if (obra is null || string.IsNullOrWhiteSpace(obra.Poblacion)) return;

        var poblacionNormalizada = obra.Poblacion.Trim().ToUpperInvariant();
        var tarifaParaPoblacion = tarifasVigentes.FirstOrDefault(t => t.NombreZona.Trim().ToUpperInvariant().Contains(poblacionNormalizada));
        var tarifaActual = tarifasVigentes.FirstOrDefault(t => string.Equals(t.Codigo, obra.Tarifa?.Trim(), StringComparison.OrdinalIgnoreCase));

        if (tarifaActual is null)
        {
            if (tarifaParaPoblacion is not null)
            {
                obra.Tarifa = tarifaParaPoblacion.Codigo;
                ActualizarDatosTarifa();
            }
            return;
        }

        if (tarifaActual.NombreZona.Trim().ToUpperInvariant().Contains(poblacionNormalizada)) return;

        if (tarifaParaPoblacion is null)
        {
            tarifaPropuestaPoblacion = null;
            confirmarCambioTarifaVisible = true;
            return;
        }

        if (!string.Equals(tarifaActual.Codigo, tarifaParaPoblacion.Codigo, StringComparison.OrdinalIgnoreCase))
        {
            tarifaPropuestaPoblacion = tarifaParaPoblacion;
            confirmarCambioTarifaVisible = true;
        }
    }
    private void ConfirmarCambioTarifaPorPoblacion()
    {
        if (obra is not null && tarifaPropuestaPoblacion is not null)
        {
            obra.Tarifa = tarifaPropuestaPoblacion.Codigo;
            ActualizarDatosTarifa();
        }
        tarifaPropuestaPoblacion = null;
        confirmarCambioTarifaVisible = false;
    }

    private void CancelarCambioTarifaPorPoblacion()
    {
        tarifaPropuestaPoblacion = null;
        confirmarCambioTarifaVisible = false;
    }
    private async Task<bool> ValidarPoblacionAntesDeGuardarAsync()
    {
        if (obra is null || string.IsNullOrWhiteSpace(obra.Poblacion)) { errorMessage = "Debe indicar una población válida antes de guardar."; return false; }
        var poblacion = poblaciones?.FirstOrDefault(p =>
            string.Equals(p.Poblacion?.Trim(), obra.Poblacion.Trim(), StringComparison.OrdinalIgnoreCase)
            && string.Equals(p.Codigo?.Trim(), obra.Codpost?.Trim(), StringComparison.OrdinalIgnoreCase));

        if (poblacion is null && !string.IsNullOrWhiteSpace(obra.Codpost))
        {
            var poblacionPorCodigo = await BuscarPoblacionAsync(obra.Codpost, porCodigo: true);
            if (poblacionPorCodigo is not null
                && string.Equals(poblacionPorCodigo.Poblacion?.Trim(), obra.Poblacion.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                poblacion = poblacionPorCodigo;
            }
        }

        poblacion ??= poblaciones?.FirstOrDefault(p => string.Equals(p.Poblacion?.Trim(), obra.Poblacion.Trim(), StringComparison.OrdinalIgnoreCase))
            ?? await BuscarPoblacionAsync(obra.Poblacion, porCodigo: false);
        if (poblacion is null) { poblacionValida = false; errorMessage = $"La población '{obra.Poblacion}' no existe. Seleccione una población válida antes de guardar."; return false; }
        poblacionValida = true;
        obra.Codpost = poblacion.Codigo?.Trim() ?? "";
        obra.Provincia = poblacion.Provincia?.Trim() ?? "";
        return true;
    }
    private async Task<CodPosSage50?> BuscarPoblacionAsync(string? valor, bool porCodigo)
    {
        if (string.IsNullOrWhiteSpace(valor)) return null;

        var pagina = await Http.GetFromJsonAsync<ResultadoPaginado<CodPosSage50>>(
            $"api/codpossage50/paginados?pagina=1&tamanoPagina=25&buscar={Uri.EscapeDataString(valor.Trim())}");
        var resultado = (pagina?.Datos ?? [])
            .FirstOrDefault(p => porCodigo
                ? string.Equals(p.Codigo?.Trim(), valor.Trim(), StringComparison.OrdinalIgnoreCase)
                : string.Equals(p.Poblacion?.Trim(), valor.Trim(), StringComparison.OrdinalIgnoreCase));

        if (resultado != null && !(poblaciones?.Any(p => p.Codigo?.Trim() == resultado.Codigo?.Trim() && p.Linea?.Trim() == resultado.Linea?.Trim()) ?? false))
        {
            poblaciones ??= [];
            poblaciones.Add(resultado);
            codigosPostales = poblaciones.OrderBy(p => p.Codigo).ThenBy(p => p.Poblacion).ToList();
        }

        return resultado;
    }

    private async Task BuscarOpcionesPoblacionAsync(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto) || texto.Trim().Length < 2) return;

        var pagina = await Http.GetFromJsonAsync<ResultadoPaginado<CodPosSage50>>(
            $"api/codpossage50/paginados?pagina=1&tamanoPagina=100&buscar={Uri.EscapeDataString(texto.Trim())}");
        var coincidencias = pagina?.Datos ?? [];
        if (coincidencias.Count == 0) return;

        poblaciones ??= [];
        foreach (var poblacion in coincidencias)
        {
            poblacion.Codigo = poblacion.Codigo?.Trim() ?? string.Empty;
            poblacion.Poblacion = poblacion.Poblacion?.Trim() ?? string.Empty;
            poblacion.Provincia = poblacion.Provincia?.Trim() ?? string.Empty;
            if (!poblaciones.Any(p => p.Codigo == poblacion.Codigo && p.Linea?.Trim() == poblacion.Linea?.Trim()))
                poblaciones.Add(poblacion);
        }

        poblaciones = poblaciones.OrderBy(p => p.Poblacion).ToList();
        codigosPostales = poblaciones.OrderBy(p => p.Codigo).ThenBy(p => p.Poblacion).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task<LoadResult> CargarPoblacionesComboAsync(DataSourceLoadOptionsBase opciones, CancellationToken cancellationToken)
    {
        var texto = ExtraerTextoBusqueda(opciones.Filter);
        var tamano = Math.Clamp(opciones.Take > 0 ? opciones.Take : 100, 25, 100);
        var pagina = Math.Max(1, opciones.Skip / tamano + 1);
        var url = $"api/codpossage50/paginados?pagina={pagina}&tamanoPagina={tamano}";
        if (!string.IsNullOrWhiteSpace(texto))
            url += $"&buscar={Uri.EscapeDataString(texto)}";

        var resultado = await Http.GetFromJsonAsync<ResultadoPaginado<CodPosSage50>>(url, cancellationToken)
            ?? new ResultadoPaginado<CodPosSage50>();
        return new LoadResult { data = resultado.Datos, totalCount = resultado.TotalRegistros };
    }

    private static string? ExtraerTextoBusqueda(System.Collections.IList? filtro)
    {
        var textos = new List<string>();
        ExtraerTextos(filtro, textos);
        return textos.LastOrDefault(texto => !string.Equals(texto, "Poblacion", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(texto, "Codigo", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(texto, "contains", StringComparison.OrdinalIgnoreCase));
    }

    private static void ExtraerTextos(System.Collections.IEnumerable? valores, List<string> textos)
    {
        if (valores == null) return;
        foreach (var valor in valores)
        {
            if (valor is string texto) textos.Add(texto);
            else if (valor is System.Collections.IEnumerable hijos) ExtraerTextos(hijos, textos);
        }
    }


    private async Task IncluirPoblacionActualAsync()
    {
        if (obra == null || poblaciones == null) return;

        CodPosSage50? actual = null;
        var codigoPostal = obra.Codpost?.Trim();
        if (!string.IsNullOrWhiteSpace(codigoPostal))
        {
            var opciones = await Http.GetFromJsonAsync<List<CodPosSage50>>(
                $"api/codpossage50/por-codigo/{Uri.EscapeDataString(codigoPostal)}") ?? [];
            actual = opciones.FirstOrDefault(p => string.Equals(p.Poblacion?.Trim(), obra.Poblacion?.Trim(), StringComparison.OrdinalIgnoreCase))
                ?? opciones.FirstOrDefault();
        }
        else if (!string.IsNullOrWhiteSpace(obra.Poblacion))
        {
            actual = await BuscarPoblacionAsync(obra.Poblacion, porCodigo: false);
        }

        if (actual == null || poblaciones.Any(p => p.Codigo?.Trim() == actual.Codigo?.Trim() && p.Linea?.Trim() == actual.Linea?.Trim())) return;

        actual.Codigo = actual.Codigo?.Trim() ?? string.Empty;
        actual.Poblacion = actual.Poblacion?.Trim() ?? string.Empty;
        actual.Provincia = actual.Provincia?.Trim() ?? string.Empty;
        poblaciones.Add(actual);
        poblaciones = poblaciones.OrderBy(p => p.Poblacion).ToList();
        codigosPostales = poblaciones.OrderBy(p => p.Codigo).ThenBy(p => p.Poblacion).ToList();
    }

    private static string LimitarTexto(string? valor, int longitudMaxima) =>
        valor is null ? string.Empty : valor[..Math.Min(valor.Length, longitudMaxima)];

    private async Task GenerarCodigoObraAsync()
    {
        if (obra == null || !string.IsNullOrWhiteSpace(obra.Codigo))
            return;

        try
        {
            errorMessage = null;
            await SetupHeadersAsync();
            var obrasExistentes = await Http.GetFromJsonAsync<List<ObraComunSage50>>("api/obrascomunsage50") ?? [];
            var ultimoCodigo = obrasExistentes
                .Select(o => o.Codigo?.Trim())
                .Where(codigo => int.TryParse(codigo, out _))
                .Select(codigo => int.Parse(codigo!))
                .DefaultIfEmpty(0)
                .Max();

            if (ultimoCodigo >= 99999)
            {
                errorMessage = "No se puede generar un código de obra superior a 99999.";
                return;
            }

            obra.Codigo = (ultimoCodigo + 1).ToString().PadLeft(5, '0');
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido generar el codigo de obra: {ex.Message}";
        }
    }

    private Task GuardarAsync() => GuardarInternoAsync(navegarTrasGuardar: true);

    private async Task<bool> GuardarCambiosPendientesAsync(bool validarPoblacion = true)
    {
        if (!HayCambiosPendientes)
            return true;

        return await GuardarInternoAsync(navegarTrasGuardar: false, validarPoblacion: validarPoblacion);
    }

    private async Task<bool> GuardarInternoAsync(bool navegarTrasGuardar, bool validarPoblacion = true)
    {
        if (obra == null) return false;
        if (validarPoblacion && !await ValidarPoblacionAntesDeGuardarAsync()) return false;
        try
        {
            await SetupHeadersAsync();
            
            // Trim fields
            obra.Codigo = obra.Codigo?.Trim() ?? "";
            obra.Nombre = obra.Nombre?.Trim() ?? "";
            obra.Direccion = obra.Direccion?.Trim() ?? "";
            obra.Cliente = obra.Cliente?.Trim() ?? "";
            obra.Codpost = obra.Codpost?.Trim() ?? "";
            obra.Poblacion = obra.Poblacion?.Trim() ?? "";
            obra.Provincia = obra.Provincia?.Trim() ?? "";
            obra.Telefono = obra.Telefono?.Trim() ?? "";
            obra.Movil = obra.Movil?.Trim() ?? "";
            obra.Encargado = obra.Encargado?.Trim() ?? "";
            obra.Libre1 = obra.Libre1?.Trim() ?? "";
            obra.Libre2 = obra.Libre2?.Trim() ?? "";
            obra.Libre3 = obra.Libre3?.Trim() ?? "";
            obra.Tarifa = obra.Tarifa?.Trim() ?? "";
            obra.Ruta = "01";
            obra.Zona = tarifasVigentes.FirstOrDefault(t => string.Equals(t.Codigo, obra.Tarifa, StringComparison.OrdinalIgnoreCase))?.Zona ?? string.Empty;

            if (IsNew)
            {
                if (string.IsNullOrWhiteSpace(obra.Codigo))
                {
                    var allObras = await Http.GetFromJsonAsync<List<ObraComunSage50>>("api/obrascomunsage50");
                    int maxCodigo = 0;
                    if (allObras != null)
                    {
                        foreach (var o in allObras)
                        {
                            if (int.TryParse(o.Codigo.Trim(), out int val))
                            {
                                if (val > maxCodigo) maxCodigo = val;
                            }
                        }
                    }
                    obra.Codigo = (maxCodigo + 1).ToString().PadLeft(5, '0');
                }

                obra.Created = DateTime.Now;
                obra.Modified = DateTime.Now;

                var response = await Http.PostAsJsonAsync("api/obrascomunsage50", obra);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = $"Error al crear obra: {await ObtenerDetalleErrorAsync(response)}";
                    return false;
                }

                if (Duplicate)
                {
                    await CopiarPreciosEspecialesAsync();
                }
            }
            else
            {
                obra.Modified = DateTime.Now;
                var forzarUrl = (isAdmin || !string.Equals(obra.Cliente, clienteOriginal, StringComparison.OrdinalIgnoreCase)) ? "?forzarCliente=true" : "";
                var response = await Http.PutAsJsonAsync($"api/obrascomunsage50/{Uri.EscapeDataString(obra.Codigo)}{forzarUrl}", obra);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = $"Error al actualizar obra: {await ObtenerDetalleErrorAsync(response)}";
                    return false;
                }
            }

            obraInicial = SerializarObra();
            if (navegarTrasGuardar)
            {
                unsavedChangesGuard?.AllowNextNavigation();
                if (!string.IsNullOrWhiteSpace(ReturnUrl))
                {
                    NavigationManager.NavigateTo(ReturnUrl);
                }
                else
                {
                    NavigationManager.NavigateTo("/modelos/obrasmnto");
                }
            }
            return true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
            return false;
        }
    }

    private async Task CopiarPreciosEspecialesAsync()
    {
        if (obra == null || string.IsNullOrWhiteSpace(codigoObraOrigenDuplicada)) return;

        var tarifas = await Http.GetFromJsonAsync<List<PrecioEspecialCabecera>>("api/precios-especiales-obra") ?? [];
        var origen = tarifas.FirstOrDefault(x => string.Equals(x.ObraSage.Trim(), codigoObraOrigenDuplicada.Trim(), StringComparison.OrdinalIgnoreCase));
        if (origen is null) return;

        var nuevaCabecera = new PrecioEspecialCabecera
        {
            ObraSage = obra.Codigo.Trim(),
            VigenteDesde = origen.VigenteDesde,
            VigenteHasta = origen.VigenteHasta,
            Observaciones = origen.Observaciones
        };
        var respuesta = await Http.PostAsJsonAsync("api/precios-especiales-obra", nuevaCabecera);
        if (!respuesta.IsSuccessStatusCode)
        {
            throw new InvalidOperationException($"La obra se ha creado, pero no se han podido copiar sus precios: {await ObtenerDetalleErrorAsync(respuesta)}");
        }

        var creada = await respuesta.Content.ReadFromJsonAsync<PrecioEspecialCabecera>();
        if (creada is null) return;
        foreach (var detalle in origen.Detalles)
        {
            var copiaDetalle = new PrecioEspecialDetalle { ArticuloSage = detalle.ArticuloSage, Precio = detalle.Precio };
            var detalleRespuesta = await Http.PostAsJsonAsync($"api/precios-especiales-obra/{creada.IdPrecioEspecialCabecera}/detalles", copiaDetalle);
            if (!detalleRespuesta.IsSuccessStatusCode)
            {
                throw new InvalidOperationException($"La obra se ha creado, pero no se han podido copiar todos sus precios: {await ObtenerDetalleErrorAsync(detalleRespuesta)}");
            }
        }
    }

    private void Volver()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            NavigationManager.NavigateTo(ReturnUrl);
            return;
        }
        NavigationManager.NavigateTo("/modelos/obrasmnto");
    }

    private sealed class ErrorApi
    {
        public string? Message { get; set; }
        public string? Detail { get; set; }
        public string? Title { get; set; }
        public Dictionary<string, string[]>? Errors { get; set; }
    }

    private static async Task<string> ObtenerDetalleErrorAsync(HttpResponseMessage response)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        try
        {
            var error = System.Text.Json.JsonSerializer.Deserialize<ErrorApi>(contenido,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (error?.Errors?.Any() == true)
                return string.Join(" ", error.Errors.SelectMany(x => x.Value));

            return error?.Message ?? error?.Detail ?? error?.Title ?? contenido;
        }
        catch (System.Text.Json.JsonException)
        {
            return string.IsNullOrWhiteSpace(contenido) ? response.ReasonPhrase ?? "Error desconocido." : contenido;
        }
    }

    private bool HayCambiosPendientes =>
        obra != null
        && !string.IsNullOrEmpty(obraInicial)
        && !string.Equals(obraInicial, SerializarObra(), StringComparison.Ordinal);

    private string? SerializarObra() => obra == null
        ? null
        : System.Text.Json.JsonSerializer.Serialize(obra);

    // Geolocalización
    private async Task ObtenerUbicacionConGuardadoAsync()
    {
        if (await GuardarCambiosPendientesAsync())
            await ObtenerUbicacionActualAsync();
    }

    private async Task AbrirMapaConGuardadoAsync()
    {
        if (!await GuardarCambiosPendientesAsync())
            return;

        // La navegación a Maps sucede antes del siguiente renderizado; el guardia aún
        // puede conservar el estado anterior de cambios pendientes. Esta autorización
        // se consume exclusivamente por esta navegación, después de guardar con éxito.
        unsavedChangesGuard?.AllowNextNavigation();
        await AbrirMapaAsync();
    }

    private async Task ObtenerUbicacionActualAsync()
    {
        if (obra == null) return;
        try
        {
            if (!string.Equals(FormFactor.GetFormFactor(), "Web", StringComparison.OrdinalIgnoreCase))
            {
                var location = await FormFactor.GetCurrentLocationAsync();
                if (location == null)
                {
                    errorMessage = "El dispositivo no ha podido determinar la ubicación actual.";
                    return;
                }

                pendingLocationUpdate = await ObtenerDireccionDesdeCoordenadasAsync(location.Latitude, location.Longitude);
                showConfirmPopup = true;
                StateHasChanged();
                return;
            }

            var result = await JSRuntime.InvokeAsync<GeocodeResult>("eval", @"
                new Promise((resolve, reject) => {
                    if (!navigator.geolocation) {
                        reject('Geolocalización no soportada');
                    } else {
                        navigator.geolocation.getCurrentPosition(
                            async (pos) => {
                                try {
                                    const lat = pos.coords.latitude;
                                    const lon = pos.coords.longitude;
                                    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&zoom=18&addressdetails=1`);
                                    if (!res.ok) {
                                        resolve({ latitud: lat, longitud: lon });
                                        return;
                                    }
                                    const data = await res.json();
                                    const addr = data.address || {};
                                    const road = addr.road || addr.pedestrian || addr.path || '';
                                    const num = addr.house_number || '';
                                    const city = addr.city || addr.town || addr.village || addr.suburb || addr.county || '';
                                    const postCode = addr.postcode || '';
                                    resolve({
                                        latitud: lat,
                                        longitud: lon,
                                        road: road,
                                        houseNumber: num,
                                        city: city,
                                        postcode: postCode
                                    });
                                } catch (e) {
                                    resolve({ latitud: lat, longitud: lon });
                                }
                            },
                            (err) => reject('Error al obtener ubicación: ' + err.message),
                            { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
                        );
                    }
                })
            ");

            if (result != null)
            {
                pendingLocationUpdate = result;
                showConfirmPopup = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo obtener la ubicación: {ex.Message}";
        }
    }

    private async Task<GeocodeResult> ObtenerDireccionDesdeCoordenadasAsync(double latitude, double longitude)
    {
        var lat = latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lon = longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return await JSRuntime.InvokeAsync<GeocodeResult>("eval", $@"
            new Promise(async (resolve) => {{
                const lat = {lat};
                const lon = {lon};
                try {{
                    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${{lat}}&lon=${{lon}}&zoom=18&addressdetails=1`);
                    if (!res.ok) {{
                        resolve({{ latitud: lat, longitud: lon }});
                        return;
                    }}
                    const data = await res.json();
                    const addr = data.address || {{}};
                    resolve({{
                        latitud: lat,
                        longitud: lon,
                        road: addr.road || addr.pedestrian || addr.path || '',
                        houseNumber: addr.house_number || '',
                        city: addr.city || addr.town || addr.village || addr.suburb || addr.county || '',
                        postcode: addr.postcode || ''
                    }});
                }} catch (e) {{
                    resolve({{ latitud: lat, longitud: lon }});
                }}
            }})");
    }

    private async Task ObtenerUbicacionActualAsync(CodPosSage50 poblacion)
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<DeviceCoordinates>("eval", @"
                new Promise((resolve, reject) => {
                    if (!navigator.geolocation) {
                        reject('Geolocalización no soportada');
                        return;
                    }
                    navigator.geolocation.getCurrentPosition(
                        pos => resolve({ latitud: pos.coords.latitude, longitud: pos.coords.longitude }),
                        err => reject('Error al obtener ubicación: ' + err.message),
                        { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
                    );
                })");

            poblacion.Lati = result.Latitud.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
            poblacion.Longi = result.Longitud.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            popupErrorMessage = $"No se pudo obtener la ubicación: {ex.Message}";
        }
    }

    private async Task VerPoblacionEnMapaAsync(CodPosSage50 poblacion)
    {
        var query = ST1Savall.MapHelper.BuildNormalizedQuery(poblacion.Poblacion, null, poblacion.Provincia, poblacion.Codigo);
        if (string.IsNullOrWhiteSpace(query))
        {
            popupErrorMessage = "Introduzca una población, provincia o código postal primero para verla en el mapa.";
            return;
        }

        // Si no hay coordenadas de ubicación, geocodificar desde el mapa (OpenStreetMap) para recogerlas y ponerlas en sus cuadros
        if (!TryParseCoordinate(poblacion.Lati, out var lat) || !TryParseCoordinate(poblacion.Longi, out var lon))
        {
            try
            {
                var searchQuery = (query + ", España").Replace("'", "\\'");
                var jsScript = @"
                    (async () => {
                        try {
                            const fullQuery = '" + searchQuery + @"';
                            let res = await fetch('https://nominatim.openstreetmap.org/search?format=json&countrycodes=es&q=' + encodeURIComponent(fullQuery) + '&limit=1');
                            if (res.ok) {
                                let data = await res.json();
                                if (data && data.length > 0) {
                                    return { latitud: parseFloat(data[0].lat), longitud: parseFloat(data[0].lon) };
                                }
                            }
                            let parts = fullQuery.split(',').map(p => p.trim()).filter(Boolean);
                            let fallbackQuery = parts.length > 1 ? parts.slice(-2).join(', ') : fullQuery;
                            res = await fetch('https://nominatim.openstreetmap.org/search?format=json&countrycodes=es&q=' + encodeURIComponent(fallbackQuery) + '&limit=1');
                            if (res.ok) {
                                let data = await res.json();
                                if (data && data.length > 0) {
                                    return { latitud: parseFloat(data[0].lat), longitud: parseFloat(data[0].lon) };
                                }
                            }
                        } catch (e) {}
                        return null;
                    })()
                ";
                var geocodeResult = await JSRuntime.InvokeAsync<GeocodeResult>("eval", jsScript);

                if (geocodeResult != null)
                {
                    poblacion.Lati = geocodeResult.Latitud.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
                    poblacion.Longi = geocodeResult.Longitud.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
                    StateHasChanged();
                }
            }
            catch
            {
                // Si falla la geocodificación, continuar al mapa
            }
        }

        var latParam = TryParseCoordinate(poblacion.Lati, out lat) ? $"&lat={lat.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : string.Empty;
        var lonParam = TryParseCoordinate(poblacion.Longi, out lon) ? $"&lon={lon.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : string.Empty;
        var mapsUrl = $"/modelos/contenedores/mapa?address={Uri.EscapeDataString(query)}&title={Uri.EscapeDataString(poblacion.Poblacion ?? "Población")}{latParam}{lonParam}&backUrl={Uri.EscapeDataString(NavigationManager.Uri)}";
        NavigationManager.NavigateTo(mapsUrl);
    }

    private static bool TryParseCoordinate(string? value, out double coordinate)
    {
        return double.TryParse(value?.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out coordinate)
            || double.TryParse(value?.Trim(), System.Globalization.NumberStyles.Float, new System.Globalization.CultureInfo("es-ES"), out coordinate);
    }

    private async Task OnConfirmClosed(bool ok)
    {
        if (ok && obra != null && pendingLocationUpdate != null)
        {
            if (!string.IsNullOrWhiteSpace(pendingLocationUpdate.Road))
            {
                obra.Direccion = string.IsNullOrWhiteSpace(pendingLocationUpdate.HouseNumber)
                    ? pendingLocationUpdate.Road
                    : $"{pendingLocationUpdate.Road}, {pendingLocationUpdate.HouseNumber}";
            }
            if (!string.IsNullOrWhiteSpace(pendingLocationUpdate.City))
            {
                obra.Poblacion = pendingLocationUpdate.City;
            }
            if (!string.IsNullOrWhiteSpace(pendingLocationUpdate.Postcode))
            {
                obra.Codpost = pendingLocationUpdate.Postcode;
            }
            
            // Trigger postal code refresh logic to load province
            if (!string.IsNullOrWhiteSpace(obra.Codpost))
            {
                await OnCodpostChangedAsync(obra.Codpost);
            }
        }
        showConfirmPopup = false;
        pendingLocationUpdate = null;
        StateHasChanged();
    }

