@page "/modelos/obrasmnto/edit"
@page "/modelos/obrasmnto/edit/{Codigo}"
@using ST1Savall.Shared.Data
@using DevExpress.Blazor
@using DevExtreme.AspNet.Data
@using DevExtreme.AspNet.Data.ResponseModel
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ST1Savall.Shared.Services.IFormFactor FormFactor

<PageTitle>@(IsNew ? "Formulario - Obra" : "Formulario - Obra")</PageTitle>

<style>
    .precio-detalle-popup { max-width: 720px !important; }
</style>

<UnsavedChangesGuard @ref="unsavedChangesGuard" HasUnsavedChanges="@HayCambiosPendientes" />

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">@(IsNew ? "Formulario - Obra" : "Formulario - Obra")</h2>
            <p class="text-muted mb-0">Complete los datos de la obra</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Volver">
            <i class="oi oi-arrow-left me-1"></i> @(string.IsNullOrWhiteSpace(ReturnUrl) ? "Volver a Obras" : "Volver a Solicitud")
        </button>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-muted mb-0">Cargando datos de la obra...</p>
        </div>
    }
    else if (obra != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <DxTabs CssClass="w-100" @bind-ActiveTabIndex="activeTabIndex">
                    <DxTabPage Text="Datos de la obra">
                <EditForm Model="@obra" OnValidSubmit="GuardarAsync" Context="editFormContext" FormName="obra-form">
                    <DxFormLayout CssClass="w-100" CaptionPosition="CaptionPosition.Vertical">
                        <!-- Grupo 1: Datos Generales -->
                        <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary border-bottom pb-2 mb-3">
                            Datos Generales
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Código" ColSpanMd="2" BeginRow="true">
                            <div class="d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <DxTextBox Text="@obra.Codigo" TextChanged="@((string valor) => obra.Codigo = LimitarTexto(valor, 5))" TextExpression="@(() => obra.Codigo)" BindValueMode="BindValueMode.OnInput" MaxLength="5" ReadOnly="@(!IsNew)" />
                                </div>
                                <button 
                                    type="button" 
                                    class="btn btn-outline-success btn-sm" 
                                    style="height: 30px; padding-top: 0; padding-bottom: 0;"
                                    title="Generar código" 
                                    disabled="@(!string.IsNullOrWhiteSpace(obra.Codigo))" @onclick="GenerarCodigoObraAsync" @onclick:stopPropagation="true">
                                    <i class="oi oi-random"></i>
                                </button>
                            </div>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Nombre" ColSpanMd="10">
                            <DxTextBox Text="@obra.Nombre" TextChanged="@((string valor) => obra.Nombre = LimitarTexto(valor, 50))" TextExpression="@(() => obra.Nombre)" BindValueMode="BindValueMode.OnInput" MaxLength="50" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Dirección" ColSpanMd="5" BeginRow="true">
                            <DxTextBox Text="@obra.Direccion" TextChanged="@((string valor) => obra.Direccion = LimitarTexto(valor, 50))" TextExpression="@(() => obra.Direccion)" BindValueMode="BindValueMode.OnInput" MaxLength="50" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Población" ColSpanMd="4">
                            <DxTextBox Text="@obra.Poblacion" TextChanged="OnPoblacionValidadaChangedAsync" TextExpression="@(() => obra.Poblacion)" BindValueMode="BindValueMode.OnLostFocus" MaxLength="30">
                                <Buttons>
                                    <DxEditorButton IconCssClass="oi oi-magnifying-glass" Tooltip="Buscar o crear población" Click="AbrirSelectorPoblacion" @onmousedown="PrepararBusquedaPoblacion" @onclick:stopPropagation />
                                </Buttons>
                            </DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Cód. Postal" ColSpanMd="3">
                            <DxTextBox Text="@obra.Codpost" TextExpression="@(() => obra.Codpost)" ReadOnly="true" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Provincia" ColSpanMd="3" BeginRow="true">
                            <DxTextBox @bind-Text="@obra.Provincia" MaxLength="30" ReadOnly="true" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="NIMA (Gestor de residuos)" ColSpanMd="3">
                            <DxTextBox Text="@obra.Libre3" TextChanged="@((string valor) => obra.Libre3 = LimitarTexto(valor, 30))" TextExpression="@(() => obra.Libre3)" BindValueMode="BindValueMode.OnInput" MaxLength="30" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Tarifa" ColSpanMd="6">
                            <DxComboBox Data="@tarifasVigentes" TData="TarifaObraOpcion" TValue="string" TextFieldName="Descripcion" ValueFieldName="Codigo" @bind-Value="obra.Tarifa" @bind-Value:after="ActualizarDatosTarifa" SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains" ClearButtonVisible="true" NullText="Seleccione una tarifa...">
                                <Columns><DxListEditorColumn FieldName="Codigo" Caption="Código" Width="80px" /><DxListEditorColumn FieldName="Nombre" Caption="Nombre" /><DxListEditorColumn FieldName="Zona" Caption="Zona" Width="80px" /><DxListEditorColumn FieldName="NombreZona" Caption="Nombre de zona" /></Columns>
                            </DxComboBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Encargado" ColSpanMd="4" BeginRow="true">
                            <DxTextBox Text="@obra.Encargado" TextChanged="@((string valor) => obra.Encargado = LimitarTexto(valor, 30))" TextExpression="@(() => obra.Encargado)" BindValueMode="BindValueMode.OnInput" MaxLength="30" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Teléfono" ColSpanMd="4">
                            <DxTextBox Text="@obra.Telefono" TextChanged="@((string valor) => obra.Telefono = LimitarTexto(valor, 15))" TextExpression="@(() => obra.Telefono)" BindValueMode="BindValueMode.OnInput" MaxLength="15" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Móvil" ColSpanMd="4">
                            <DxTextBox Text="@obra.Movil" TextChanged="@((string valor) => obra.Movil = LimitarTexto(valor, 15))" TextExpression="@(() => obra.Movil)" BindValueMode="BindValueMode.OnInput" MaxLength="15" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Contacto Alter." ColSpanMd="4" BeginRow="true">
                            <DxTextBox @bind-Text="@obra.Usuario" MaxLength="10" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Teléf. Contacto" ColSpanMd="4">
                            <DxTextBox @bind-Text="@obra.Fax" MaxLength="15" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanMd="2" CssClass="d-flex align-items-center">
                            <DxCheckBox @bind-Checked="@obra.Bloqueada" LabelPosition="LabelPosition.Right">Bloqueada</DxCheckBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanMd="2" CssClass="d-flex align-items-center">
                            <DxCheckBox @bind-Checked="@obra.Terminada" LabelPosition="LabelPosition.Right">Finalizada</DxCheckBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Latitud" ColSpanMd="3" BeginRow="true">
                            <DxTextBox @bind-Text="@obra.Libre1" MaxLength="10" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Longitud" ColSpanMd="3">
                            <DxTextBox @bind-Text="@obra.Libre2" MaxLength="10" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanMd="6" CssClass="align-bottom-to-input pb-1">
                            <div class="d-flex gap-4 w-100 mt-4">
                                <button 
                                    type="button" 
                                    class="btn btn-outline-primary btn-sm flex-fill d-flex align-items-center justify-content-center text-nowrap" 
                                    @onclick="ObtenerUbicacionConGuardadoAsync"
                                    style="height: 32px;">
                                    <i class="oi oi-map-marker me-1"></i> Obtener coordenadas del dispositivo
                                </button>
                                <button 
                                    type="button" 
                                    class="btn btn-outline-success btn-sm flex-fill d-flex align-items-center justify-content-center text-nowrap" @onclick="AbrirMapaConGuardadoAsync" 
                                    style="height: 32px;" 
                                    title="Ver en Google Maps">
                                    <i class="oi oi-eye me-1"></i> Ver en Maps
                                </button>
                            </div>
                        </DxFormLayoutItem>

                        <!-- Grupo Observaciones -->
                        <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary border-bottom pb-2 mb-3 mt-4" BeginRow="true">
                            Observaciones
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
                            <DxMemo @bind-Text="@obra.Observacio" Rows="4" />
                        </DxFormLayoutItem>

                        <!-- Grupo 2: Datos del Cliente -->
                        <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary border-bottom pb-2 mb-3 mt-4">
                            Datos del Cliente
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Cliente" ColSpanMd="7" BeginRow="true">
                            <DxComboBox Data="@clientesList"
                                        TData="ClienteSage50"
                                        TValue="string"
                                        TextFieldName="Nombre"
                                        ValueFieldName="Codigo"
                                        Value="@obra.Cliente"
                                        NullText="Seleccione un cliente..."
                                        ListRenderMode="ListRenderMode.Virtual"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        Enabled="@(!clienteBloqueadoPorAlbaranSage && (!clienteBloqueadoPorServicios || isAdmin))"
                                        ValueChanged="@((string val) => OnClienteChangedAsync(val))"
                                        ValueExpression="@(() => obra.Cliente)">
                                <ItemTemplate Context="cli">
                                    <span style="font-size: 0.9rem;"><strong>@cli.Codigo</strong> - @cli.Nombre</span>
                                </ItemTemplate>
                            </DxComboBox>
                            @if (clienteBloqueadoPorAlbaranSage)
                            {
                                <div class="form-text text-danger"><i class="oi oi-lock-locked me-1"></i> El cliente no se puede modificar porque la obra ya tiene servicios con albarán de Sage 50 emitido.</div>
                            }
                            else if (clienteBloqueadoPorServicios && !isAdmin)
                            {
                                <div class="form-text text-danger"><i class="oi oi-lock-locked me-1"></i> El cliente no puede cambiarse porque la obra tiene servicios asignados.</div>
                            }
                            else if (clienteBloqueadoPorServicios && isAdmin)
                            {
                                <div class="form-text text-warning"><i class="oi oi-warning me-1"></i> Atención (Admin): La obra tiene servicios asignados. Cambiar el cliente solicitará confirmación.</div>
                            }
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Teléfono Cliente" ColSpanMd="5">
                            <DxTextBox Text="@GetClientTelefono(obra.Cliente)" ReadOnly="true" EnableValidation="@false" TextExpression="@(() => obra.Cliente)" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Dirección" ColSpanMd="5" BeginRow="true">
                            <DxTextBox Text="@GetClientDireccion(obra.Cliente)" ReadOnly="true" EnableValidation="@false" TextExpression="@(() => obra.Cliente)" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Población" ColSpanMd="4">
                            <DxTextBox Text="@GetClientPoblacion(obra.Cliente)" ReadOnly="true" EnableValidation="@false" TextExpression="@(() => obra.Cliente)" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Cód. Postal" ColSpanMd="3">
                            <DxTextBox Text="@GetClientCodpost(obra.Cliente)" MaxLength="5" ReadOnly="true" EnableValidation="@false" TextExpression="@(() => obra.Cliente)" />
                        </DxFormLayoutItem>

                        <!-- Botones de Acción Formulario -->
                        <DxFormLayoutItem ColSpanMd="12" CssClass="d-flex justify-content-end gap-2 pt-4 border-top mt-4">
                            <button type="button" class="btn btn-outline-secondary px-4" @onclick="Volver">Cancelar</button>
                            <button type="submit" class="btn btn-primary px-4">Guardar</button>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </EditForm>
                    </DxTabPage>
                    <DxTabPage Text="Precios especiales" Enabled="@(!IsNew)">
                        <div class="p-3">
                            @if (IsNew)
                            {
                                <div class="alert alert-info mb-0">Guarde primero la obra para poder definir sus precios especiales.</div>
                            }
                            else
                            {
                                <h6 class="text-primary border-bottom pb-2 mb-3">Cabecera de precios especiales</h6>
                                <DxFormLayout CssClass="w-100" CaptionPosition="CaptionPosition.Vertical">
                                    <DxFormLayoutItem Caption="Cliente" ColSpanMd="6"><DxTextBox Text="@GetClientName(obra.Cliente)" ReadOnly="true" EnableValidation="false" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Obra" ColSpanMd="6"><DxTextBox Text="@($"{obra.Codigo} - {obra.Nombre}")" ReadOnly="true" EnableValidation="false" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Vigente desde" ColSpanMd="3"><DxDateEdit @bind-Date="precioCabecera.VigenteDesde" ClearButtonVisible="true" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Vigente hasta" ColSpanMd="3"><DxDateEdit @bind-Date="precioCabecera.VigenteHasta" ClearButtonVisible="true" /></DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="Observaciones" ColSpanMd="6"><DxTextBox @bind-Text="precioCabecera.Observaciones" MaxLength="250" /></DxFormLayoutItem>
                                </DxFormLayout>
                                <div class="d-flex justify-content-end gap-2 mt-4 mb-4 pt-2 border-top">
                                    @if (precioCabecera.IdPrecioEspecialCabecera > 0)
                                    {
                                        <button type="button" class="btn btn-outline-danger" @onclick="EliminarPrecioCabeceraAsync"><i class="oi oi-trash me-1"></i>Eliminar tarifa</button>
                                    }
                                    <button type="button" class="btn btn-primary" @onclick="GuardarPrecioCabeceraAsync"><i class="oi oi-check me-1"></i>Guardar precios</button>
                                </div>
                                <h6 class="text-primary border-bottom pb-2 mb-3">Detalles de precios especiales</h6>
                                @if (precioCabecera.IdPrecioEspecialCabecera == 0)
                                {
                                    <div class="alert alert-info mb-0">Guarde la cabecera para añadir artículos y precios.</div>
                                }
                                else
                                {
                                    <DxGrid @ref="gridPrecios" Data="@precioCabecera.Detalles" KeyFieldName="IdPrecioEspecialDetalle" EditMode="GridEditMode.PopupEditForm" EditModelSaving="GuardarPrecioDetalleAsync" DataItemDeleting="BorrarPrecioDetalleAsync" PopupEditFormHeaderCssClass="bg-primary text-white" PopupEditFormHeaderText="Artículo con precio especial" PopupEditFormCssClass="precio-detalle-popup" PageSize="10" AllowSort="true" HorizontalScrollBarMode="ScrollBarMode.Auto">
                                        <Columns>
                                            <DxGridCommandColumn Width="80px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                                <HeaderTemplate><button type="button" class="btn btn-sm btn-primary w-100" title="Añadir artículo" @onclick="() => gridPrecios?.StartEditNewRowAsync()"><i class="oi oi-plus"></i></button></HeaderTemplate>
                                                <CellDisplayTemplate>@{ var detalle = (PrecioEspecialDetalle)context.DataItem; }<div class="d-flex gap-1"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => gridPrecios?.StartEditDataItemAsync(detalle)"><i class="oi oi-pencil"></i></button><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => gridPrecios?.ShowDataItemDeleteConfirmation(detalle)"><i class="oi oi-trash"></i></button></div></CellDisplayTemplate>
                                            </DxGridCommandColumn>
                                            <DxGridDataColumn Caption="Artículo" MinWidth="400"><CellDisplayTemplate>@TextoArticulo(((PrecioEspecialDetalle)context.DataItem).ArticuloSage)</CellDisplayTemplate></DxGridDataColumn>
                                            <DxGridDataColumn FieldName="Precio" Caption="Precio" DisplayFormat="n2" Width="180px" />
                                        </Columns>
                                        <EditFormTemplate Context="editContext">
                                            @{ var detalle = (PrecioEspecialDetalle)editContext.EditModel; }
                                            <DxFormLayout CssClass="w-100 p-3" CaptionPosition="CaptionPosition.Vertical">
                                                <DxFormLayoutItem Caption="Artículo *" ColSpanMd="9"><DxComboBox Data="@articulosPrecio" TData="CodigoNombre" TValue="string" TextFieldName="Descripcion" ValueFieldName="Codigo" @bind-Value="detalle.ArticuloSage" SearchMode="ListSearchMode.AutoSearch" /></DxFormLayoutItem>
                                                <DxFormLayoutItem Caption="Precio *" ColSpanMd="3"><DxSpinEdit @bind-Value="detalle.Precio" MinValue="0m" DisplayFormat="n2" /></DxFormLayoutItem>
                                            </DxFormLayout>
                                        </EditFormTemplate>
                                    </DxGrid>
                                }
                            }
                        </div>
                    </DxTabPage>
                </DxTabs>
            </div>
        </div>

        <DxMessageBox @bind-Visible="showConfirmPopup" 
                      Text="¿Confirma actualizar la ubicación, población y código postal?" 
                      Title="Confirmación" 
                      Type="MessageBoxType.Confirmation" 
                      Closed="OnConfirmClosed" />

        <DxPopup @bind-Visible="@showClienteWarningPopup"
                 HeaderText="Advertencia - Cambio de Cliente"
                 HeaderCssClass="bg-warning text-dark font-weight-bold"
                 Width="540px"
                 CloseOnEscape="false"
                 CloseOnOutsideClick="false"
                 ShowCloseButton="false">
            <BodyTemplate Context="popupCtx">
                <div class="p-3">
                    <div class="d-flex align-items-center mb-3">
                        <i class="oi oi-warning text-warning display-6 me-3"></i>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">¿Confirma cambiar el cliente de esta obra?</h5>
                            <p class="text-muted mb-0 small">Esta obra ya tiene solicitudes y servicios asignados.</p>
                        </div>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert">
                        <strong>Atención Administrador:</strong>
                        <br/>
                        Cliente actual: <strong>@GetClientName(clienteOriginal)</strong> (@clienteOriginal)
                        <br/>
                        Nuevo cliente: <strong>@GetClientName(pendingClienteCode)</strong> (@pendingClienteCode)
                        <br/><br/>
                        Al cambiar el cliente, las futuras consultas, presupuestos y facturaciones de esta obra se vincularán al nuevo cliente.
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="CancelarCambioCliente">Cancelar</button>
                        <button type="button" class="btn btn-warning btn-sm fw-bold px-3" @onclick="ConfirmarCambioClienteAsync">Sí, cambiar cliente</button>
                    </div>
                </div>
            </BodyTemplate>
        </DxPopup>

        <DxPopup @bind-Visible="@confirmarCambioTarifaVisible"
                 HeaderText="Tarifa distinta para la población"
                 HeaderCssClass="bg-warning text-dark"
                 Width="560px"
                 CloseOnEscape="true"
                 CloseOnOutsideClick="false"
                 ShowCloseButton="true">
            <BodyTemplate Context="popupContext">
                <div class="p-3">
                    <p class="mb-2">La población <strong>@obra?.Poblacion</strong> no pertenece a la zona de la tarifa seleccionada.</p>
                    @if (tarifaPropuestaPoblacion is not null)
                    {
                        <p class="mb-3">Se ha encontrado la tarifa vigente <strong>@tarifaPropuestaPoblacion.Descripcion</strong> para esta población. ¿Desea aplicarla?</p>
                        <div class="d-flex justify-content-end gap-2">
                            <DxButton Text="Mantener tarifa actual" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarCambioTarifaPorPoblacion" />
                            <DxButton Text="Sí, cambiar tarifa" RenderStyle="ButtonRenderStyle.Primary" Click="ConfirmarCambioTarifaPorPoblacion" />
                        </div>
                    }
                    else
                    {
                        <p class="mb-3">No existe una tarifa vigente para esta población. Mantenga la tarifa actual o seleccione otra manualmente.</p>
                        <div class="d-flex justify-content-end">
                            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="CancelarCambioTarifaPorPoblacion" />
                        </div>
                    }
                </div>
            </BodyTemplate>
        </DxPopup>
        <DxPopup @bind-Visible="@poblacionPopupVisible"
                 HeaderText="Gestión de Población"
                 HeaderCssClass="bg-primary text-white"
                 Width="500px"
                 CloseOnEscape="true"
                 CloseOnOutsideClick="false"
                 ShowCloseButton="true">
            <BodyTemplate Context="popupContext">
                @if (popupErrorMessage != null)
                {
                    <div class="alert alert-danger py-2 mb-2" role="alert">@popupErrorMessage</div>
                }
                <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
                    <DxFormLayoutItem Caption="Código Postal" ColSpanMd="6" Enabled="@isNewPoblacion">
                        <DxTextBox @bind-Text="@newPoblacion.Codigo" MaxLength="10" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Población" ColSpanMd="12">
                        <DxTextBox @bind-Text="@newPoblacion.Poblacion" MaxLength="30" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Provincia" ColSpanMd="12">
                        <DxTextBox @bind-Text="@newPoblacion.Provincia" MaxLength="30" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Latitud" ColSpanMd="3">
                        <DxTextBox @bind-Text="@newPoblacion.Lati" MaxLength="30" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Longitud" ColSpanMd="3">
                        <DxTextBox @bind-Text="@newPoblacion.Longi" MaxLength="30" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="6" CssClass="align-bottom-to-input pb-1">
                        <div class="d-flex gap-2 w-100 mt-auto">
                            <button type="button" class="btn btn-outline-primary btn-sm flex-fill d-flex align-items-center justify-content-center text-nowrap" @onclick="async () => await ObtenerUbicacionActualAsync(newPoblacion)" style="height: 38px;">
                                <i class="oi oi-map-marker me-1"></i> Obtener coordenadas del dispositivo
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm flex-fill d-flex align-items-center justify-content-center text-nowrap" @onclick="async () => await VerPoblacionEnMapaAsync(newPoblacion)" style="height: 38px;" title="Ver en Google Maps">
                                <i class="oi oi-eye me-1"></i> Ver en Maps
                            </button>
                        </div>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Visible" ColSpanMd="12" BeginRow="true">
                        <DxCheckBox @bind-Checked="@newPoblacionVisible" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" CssClass="d-flex justify-content-end gap-2 pt-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClosePoblacionPopup">Cancelar</button>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="SavePoblacionAsync">Guardar</button>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </BodyTemplate>
        </DxPopup>
    }
</div>

@code {
    [Parameter] public string? Codigo { get; set; }
    [SupplyParameterFromQuery] public bool Duplicate { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "lat")]
    public double? QueryLat { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "lon")]
    public double? QueryLon { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "mapLat")]
    public double? QueryMapLat { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "mapLon")]
