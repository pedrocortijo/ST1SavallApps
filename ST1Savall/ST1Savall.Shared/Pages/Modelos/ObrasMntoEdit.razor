    protected override async Task OnInitializedAsync()
    {
        activeTabIndex = string.Equals(Tab, "precios", StringComparison.OrdinalIgnoreCase) ? 1 : 0;
        await SetupHeadersAsync();
        await LoadAuxiliaryDataAsync();
        await LoadObraAsync();
    }

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task LoadAuxiliaryDataAsync()
    {
        try
        {
            todosLosClientes = await Http.GetFromJsonAsync<List<ClienteSage50>>("api/clientessage50");
            if (todosLosClientes != null)
            {
                foreach (var c in todosLosClientes)
                {
                    c.Codigo = c.Codigo?.Trim() ?? "";
                    c.Nombre = c.Nombre?.Trim() ?? "";
                    c.Cif = c.Cif?.Trim() ?? "";
                    c.Direccion = c.Direccion?.Trim() ?? "";
                    c.Poblacion = c.Poblacion?.Trim() ?? "";
                    c.Codpost = c.Codpost?.Trim() ?? "";
                }
                todosLosClientes = todosLosClientes.OrderBy(c => c.Codigo).ToList();
                AplicarFiltroClientes();
            }

            var articulos = await Http.GetFromJsonAsync<List<ArticuloSage50>>("api/articulos-sage50");
            articulosPrecio = (articulos ?? [])
                .Select(x => new CodigoNombre(x.Codigo?.Trim() ?? "", x.Nombre?.Trim() ?? ""))
                .OrderBy(x => x.Descripcion)
                .ToList();

            tarifasVigentesDatos = (await Http.GetFromJsonAsync<List<TarifaCabecera>>("api/tarifas") ?? []).Where(t => t.Desde.Date <= DateTime.Today && t.Hasta.Date >= DateTime.Today).Select(t => { t.Codigo = t.Codigo?.Trim() ?? ""; t.Nombre = t.Nombre?.Trim() ?? ""; t.Zona = t.Zona?.Trim() ?? ""; return t; }).OrderBy(t => t.Codigo).ToList();
            todasLasZonas = (await Http.GetFromJsonAsync<List<ZonaComunSage50>>("api/zonas") ?? []).Select(z => { z.Ruta = z.Ruta?.Trim() ?? ""; z.Zona = z.Zona?.Trim() ?? ""; z.Descripcion = z.Descripcion?.Trim() ?? ""; return z; }).Where(z => z.Ruta == "01").ToList();
            tarifasVigentes = tarifasVigentesDatos.Select(t => { var zona = todasLasZonas.FirstOrDefault(z => z.Zona == t.Zona); return new TarifaObraOpcion(t.Codigo, t.Nombre, t.Zona, zona?.Descripcion ?? ""); }).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar listas de referencia: {ex.Message}";
        }
    }

    private async Task LoadObraAsync()
    {
        isLoading = true;
        try
        {
            if (!string.IsNullOrEmpty(Codigo))
            {
                var loaded = await Http.GetFromJsonAsync<ObraComunSage50>($"api/obrascomunsage50/{Uri.EscapeDataString(Codigo)}");
                if (loaded != null)
                {
                    obra = loaded;
                    obra.Codigo = obra.Codigo?.Trim() ?? "";
                    obra.Nombre = obra.Nombre?.Trim() ?? "";
                    obra.Direccion = obra.Direccion?.Trim() ?? "";
                    obra.Cliente = obra.Cliente?.Trim() ?? "";
                    obra.Codpost = obra.Codpost?.Trim() ?? "";
                    obra.Provincia = obra.Provincia?.Trim() ?? "";
                    obra.Poblacion = obra.Poblacion?.Trim() ?? "";
                    obra.Telefono = obra.Telefono?.Trim() ?? "";
                    obra.Movil = obra.Movil?.Trim() ?? "";
                    obra.Encargado = obra.Encargado?.Trim() ?? "";
                    obra.Libre3 = obra.Libre3?.Trim() ?? "";
                    obra.Usuario = obra.Usuario?.Trim() ?? "";
                    obra.Fax = obra.Fax?.Trim() ?? "";
                    obra.Observacio = obra.Observacio?.Trim() ?? "";
                    clienteOriginal = obra.Cliente;
                    isAdmin = await IsUserAdminAsync();
                    AplicarFiltroClientes();

                    if (!Duplicate)
                    {
                        clienteBloqueadoPorServicios = await Http.GetFromJsonAsync<bool>(
                            $"api/obrascomunsage50/servicios-asignados/{Uri.EscapeDataString(obra.Codigo)}");
                        clienteBloqueadoPorAlbaranSage = await Http.GetFromJsonAsync<bool>(
                            $"api/obrascomunsage50/albaranes-asignados/{Uri.EscapeDataString(obra.Codigo)}");
                    }

                    if (Duplicate)
                    {
                        codigoObraOrigenDuplicada = obra.Codigo;
                        obra.Codigo = "";
                        obra.Nombre += " (Copia)";
                        obra.GuidId = Guid.NewGuid().ToString();
                        obra.Created = DateTime.Now;
                        obra.Modified = DateTime.Now;
                    }
                }
                else
                {
                    errorMessage = "No se encontró la obra especificada.";
                }
            }
            else
            {
                obra = new ObraComunSage50
                {
                    GuidId = Guid.NewGuid().ToString(),
                    Created = DateTime.Now,
                    Modified = DateTime.Now,
                    Vista = true,
                    Posicion = 0,
                    Terminada = false
                };
            }

            // Si venimos del mapa y no hay coordenadas en latitud y longitud, recoger los valores devueltos
            if (obra != null)
            {
                var returnLat = QueryLat ?? QueryMapLat;
                var returnLon = QueryLon ?? QueryMapLon;
                if (returnLat.HasValue && returnLon.HasValue && (returnLat.Value != 0 || returnLon.Value != 0))
                {
                    var hasLat = TryParseCoordinate(obra.Libre1, out var cLat) && cLat != 0;
                    var hasLon = TryParseCoordinate(obra.Libre2, out var cLon) && cLon != 0;
                    if (!hasLat || !hasLon || string.IsNullOrWhiteSpace(obra.Libre1) || string.IsNullOrWhiteSpace(obra.Libre2))
                    {
                        obra.Libre1 = LimitarTexto(returnLat.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture), 10);
                        obra.Libre2 = LimitarTexto(returnLon.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture), 10);

                        if (!IsNew && !string.IsNullOrWhiteSpace(obra.Codigo))
                        {
                            try
                            {
                                await SetupHeadersAsync();
                                await Http.PutAsJsonAsync($"api/obrascomunsage50/{Uri.EscapeDataString(obra.Codigo)}", obra);
                            }
                            catch { }
                        }
                    }
                }
            }

            if (!IsNew && obra != null)
            {
                await CargarPrecioObraAsync();
            }

            if (AplicarPoblacionSeleccionada())
            {
                ComprobarTarifaParaPoblacion();
                if (!IsNew)
                    await GuardarInternoAsync(navegarTrasGuardar: false);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar obra: {ex.Message}";
        }
        finally
        {
            obraInicial = SerializarObra();
            isLoading = false;
        }
    }

    private void PrepararBusquedaPoblacion() => omitirValidacionPoblacion = true;

    private async Task AbrirSelectorPoblacion()
    {
        // El selector navega a otro mantenimiento. Guardamos antes la obra para
        // no perder cambios y para que el protector de cambios permita salir.
        if (!await GuardarCambiosPendientesAsync(validarPoblacion: false))
            return;

        var ruta = string.IsNullOrWhiteSpace(Codigo)
            ? "/modelos/obrasmnto/edit"
            : $"/modelos/obrasmnto/edit/{Uri.EscapeDataString(Codigo.Trim())}";
        var parametros = new List<string>();
        if (Duplicate) parametros.Add("Duplicate=true");
        if (!string.IsNullOrWhiteSpace(ReturnUrl)) parametros.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        if (parametros.Count > 0) ruta += $"?{string.Join("&", parametros)}";

        unsavedChangesGuard?.AllowNextNavigation();
        NavigationManager.NavigateTo($"/modelos/poblaciones?seleccionar=true&returnUrl={Uri.EscapeDataString(ruta)}");
    }

    private bool AplicarPoblacionSeleccionada()
    {
        if (obra == null || string.IsNullOrWhiteSpace(PoblacionSeleccionada)) return false;

        obra.Poblacion = PoblacionSeleccionada.Trim();
        obra.Codpost = CodigoPostalSeleccionado?.Trim() ?? string.Empty;
        obra.Provincia = ProvinciaSeleccionada?.Trim() ?? string.Empty;
        return true;
    }

    private async Task CargarPrecioObraAsync()
    {
        if (obra == null || string.IsNullOrWhiteSpace(obra.Codigo) || string.IsNullOrWhiteSpace(obra.Cliente))
        {
            precioCabecera = new();
            return;
        }

        var tarifas = await Http.GetFromJsonAsync<List<PrecioEspecialCabecera>>("api/precios-especiales-obra") ?? [];
        foreach (var tarifa in tarifas)
        {
            tarifa.ObraSage = tarifa.ObraSage?.Trim() ?? "";
            foreach (var detalle in tarifa.Detalles)
                detalle.ArticuloSage = detalle.ArticuloSage?.Trim() ?? "";
        }
        precioCabecera = tarifas.FirstOrDefault(x =>
            string.Equals(x.ObraSage.Trim(), obra.Codigo.Trim(), StringComparison.OrdinalIgnoreCase))
            ?? new PrecioEspecialCabecera
            {
                ObraSage = obra.Codigo.Trim()
            };
    }

    private async Task GuardarPrecioCabeceraAsync()
    {
        if (obra == null) return;
        precioCabecera.ObraSage = obra.Codigo?.Trim() ?? "";
        var respuesta = precioCabecera.IdPrecioEspecialCabecera == 0
            ? await Http.PostAsJsonAsync("api/precios-especiales-obra", precioCabecera)
            : await Http.PutAsJsonAsync($"api/precios-especiales-obra/{precioCabecera.IdPrecioEspecialCabecera}", precioCabecera);

        if (!respuesta.IsSuccessStatusCode)
        {
            errorMessage = $"Error al guardar los precios especiales: {await ObtenerDetalleErrorAsync(respuesta)}";
            return;
        }

        if (precioCabecera.IdPrecioEspecialCabecera == 0)
        {
            precioCabecera = await respuesta.Content.ReadFromJsonAsync<PrecioEspecialCabecera>() ?? precioCabecera;
        }
        await CargarPrecioObraAsync();
    }

    private async Task EliminarPrecioCabeceraAsync()
    {
        if (precioCabecera.IdPrecioEspecialCabecera == 0) return;
        var respuesta = await Http.DeleteAsync($"api/precios-especiales-obra/{precioCabecera.IdPrecioEspecialCabecera}");
        if (!respuesta.IsSuccessStatusCode)
        {
            errorMessage = $"Error al eliminar la tarifa: {await ObtenerDetalleErrorAsync(respuesta)}";
            return;
        }
        await CargarPrecioObraAsync();
    }

    private async Task GuardarPrecioDetalleAsync(GridEditModelSavingEventArgs e)
    {
        var detalle = (PrecioEspecialDetalle)e.EditModel;
        var respuesta = e.IsNew
            ? await Http.PostAsJsonAsync($"api/precios-especiales-obra/{precioCabecera.IdPrecioEspecialCabecera}/detalles", detalle)
            : await Http.PutAsJsonAsync($"api/precios-especiales-obra/detalles/{detalle.IdPrecioEspecialDetalle}", detalle);
        if (!respuesta.IsSuccessStatusCode)
        {
            errorMessage = $"Error al guardar el artículo: {await ObtenerDetalleErrorAsync(respuesta)}";
            e.Cancel = true;
            return;
        }
        await CargarPrecioObraAsync();
    }

    private async Task BorrarPrecioDetalleAsync(GridDataItemDeletingEventArgs e)
    {
        var detalle = (PrecioEspecialDetalle)e.DataItem;
        var respuesta = await Http.DeleteAsync($"api/precios-especiales-obra/detalles/{detalle.IdPrecioEspecialDetalle}");
        if (!respuesta.IsSuccessStatusCode)
        {
            errorMessage = $"Error al eliminar el artículo: {await ObtenerDetalleErrorAsync(respuesta)}";
            e.Cancel = true;
            return;
        }
        await CargarPrecioObraAsync();
    }

