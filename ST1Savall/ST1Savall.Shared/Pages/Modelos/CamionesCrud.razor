@page "/modelos/camiones"
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Camiones</PageTitle>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold text-primary mb-1">Camiones</h2><p class="text-muted mb-0">Identificación de camiones.</p></div><NavLink href="/" class="btn btn-outline-secondary btn-sm"><i class="oi oi-arrow-left me-1"></i> Volver a Inicio</NavLink></div>
    @if (errorMessage is not null) { <div class="alert alert-danger">@errorMessage</div> }
    <div class="card shadow-sm"><div class="card-body p-0">
        @if (camiones is null) { <div class="p-5 text-center">Cargando camiones...</div> }
        else {
            <DxGrid @ref="grid" Data="@camiones" KeyFieldName="IdCamion" EditMode="GridEditMode.PopupEditForm" EditModelSaving="OnEditModelSaving" DataItemDeleting="OnDataItemDeleting" CustomizeEditModel="CustomizeEditModel" PopupEditFormHeaderText="Formulario - Camión" PopupEditFormCssClass="crud-popup" PagerPosition="GridPagerPosition.Bottom" PageSize="20" AllowSort="true" ShowFilterRow="true" ShowSearchBox="true" SearchBoxNullText="Buscar camión...">
                <Columns>
                    <DxGridCommandColumn Width="150px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false"><HeaderTemplate><button type="button" class="btn btn-sm btn-primary w-100" @onclick="StartNewAsync"><i class="oi oi-plus me-1"></i> Nuevo</button></HeaderTemplate><CellDisplayTemplate>@{ var camion = (Camion)context.DataItem; }<div class="d-flex gap-1"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => grid?.StartEditDataItemAsync(camion)" @onclick:stopPropagation title="Editar"><i class="oi oi-pencil"></i></button><button type="button" class="btn btn-sm btn-outline-info" @onclick="() => DuplicateAsync(camion)" @onclick:stopPropagation title="Duplicar"><i class="oi oi-document"></i></button><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => grid?.ShowDataItemDeleteConfirmation(camion)" @onclick:stopPropagation title="Eliminar"><i class="oi oi-trash"></i></button></div></CellDisplayTemplate></DxGridCommandColumn>
                    <DxGridDataColumn FieldName="Matricula" Caption="Matrícula" Width="130px" />
                    <DxGridDataColumn FieldName="Descripcion" Caption="Descripción" Width="250px" />
                    <DxGridDataColumn FieldName="UnidadWialonId" Caption="Unidad Wialon" Width="160px" />
                    <DxGridDataColumn FieldName="Activo" Caption="Activo" Width="90px" />
                </Columns>
                <EditFormTemplate Context="editContext">
                    @{ var camion = (Camion)editContext.EditModel; }
                    <DxFormLayout CssClass="w-100 p-3" CaptionPosition="CaptionPosition.Vertical">
                        <DxFormLayoutItem Caption="Matrícula" ColSpanMd="6" BeginRow="true"><DxTextBox @bind-Text="camion.Matricula" /></DxFormLayoutItem><DxFormLayoutItem Caption="Descripción" ColSpanMd="6"><DxTextBox @bind-Text="camion.Descripcion" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="ID de unidad Wialon" ColSpanMd="12" BeginRow="true"><DxTextBox @bind-Text="camion.UnidadWialonId" /></DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanMd="12" BeginRow="true"><DxCheckBox @bind-Checked="camion.Activo" LabelPosition="LabelPosition.Right">Camión activo</DxCheckBox></DxFormLayoutItem>
                    </DxFormLayout>
                </EditFormTemplate>
            </DxGrid>
        }
    </div></div>
</div>

@code {
    private IGrid? grid;
    private List<Camion>? camiones;
    private Camion? camionToDuplicate;
    private string? errorMessage;
    protected override async Task OnInitializedAsync() { await SetupHeadersAsync(); await LoadDataAsync(); }
    private async Task SetupHeadersAsync() { var authState = await AuthStateProvider.GetAuthenticationStateAsync(); var token = authState.User.FindFirst("token")?.Value; if (!string.IsNullOrEmpty(token)) Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token); }
    private async Task LoadDataAsync() { try { camiones = await Http.GetFromJsonAsync<List<Camion>>("api/camiones") ?? []; errorMessage = null; } catch (Exception ex) { errorMessage = $"Error al cargar camiones: {ex.Message}"; camiones ??= []; } }
    private async Task StartNewAsync() { camionToDuplicate = null; if (grid is not null) await grid.StartEditNewRowAsync(); }
    private async Task DuplicateAsync(Camion camion) { camionToDuplicate = camion; if (grid is not null) await grid.StartEditNewRowAsync(); }
    private void CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        if (!e.IsNew || camionToDuplicate is null) return;
        var nuevo = (Camion)e.EditModel;
        nuevo.IdCamion = 0;
        nuevo.Matricula = string.Empty;
        nuevo.Descripcion = camionToDuplicate.Descripcion;
        nuevo.Activo = camionToDuplicate.Activo;
        nuevo.UnidadWialonId = null;
        camionToDuplicate = null;
    }
    private async Task OnEditModelSaving(GridEditModelSavingEventArgs e) { var camion = (Camion)e.EditModel; try { await SetupHeadersAsync(); var response = e.IsNew ? await Http.PostAsJsonAsync("api/camiones", camion) : await Http.PutAsJsonAsync($"api/camiones/{camion.IdCamion}", camion); if (!response.IsSuccessStatusCode) { errorMessage = $"Error al guardar el camión: {response.ReasonPhrase}"; e.Cancel = true; return; } await LoadDataAsync(); } catch (Exception ex) { errorMessage = $"Error al guardar el camión: {ex.Message}"; e.Cancel = true; } }
    private async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e) { var camion = (Camion)e.DataItem; try { await SetupHeadersAsync(); var response = await Http.DeleteAsync($"api/camiones/{camion.IdCamion}"); if (!response.IsSuccessStatusCode) { errorMessage = $"Error al eliminar el camión: {response.ReasonPhrase}"; e.Cancel = true; return; } await LoadDataAsync(); } catch (Exception ex) { errorMessage = $"Error al eliminar el camión: {ex.Message}"; e.Cancel = true; } }
}
