@page "/modelos/solicitudes/edit"
@page "/modelos/solicitudes/edit/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ST1Savall.Shared.Services.IFormFactor FormFactor

<style>
    .solicitud-fotos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .solicitud-foto { position: relative; aspect-ratio: 1; border: 1px solid var(--bs-border-color); border-radius: 10px; overflow: hidden; background: #fff; }
    .solicitud-foto-miniatura { width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
    .solicitud-foto-miniatura img { width: 100%; height: 100%; object-fit: cover; }
    .solicitud-foto .btn-eliminar { position: absolute; right: 6px; top: 6px; min-width: 36px; min-height: 36px; }
    .solicitud-foto-fase { position: absolute; left: 6px; bottom: 6px; z-index: 1; padding: .2rem .45rem; border-radius: .25rem; background: rgba(0, 0, 0, .72); color: #fff; font-size: .7rem; font-weight: 700; pointer-events: none; }
    .solicitud-visor-foto { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(0, 0, 0, .78); }
    .solicitud-visor-contenido { position: relative; max-width: min(100%, 1100px); max-height: 100%; }
    .solicitud-visor-foto img { display: block; max-width: 100%; max-height: calc(100vh - 40px); border-radius: 8px; }
    .solicitud-visor-cerrar { position: absolute; top: 8px; right: 8px; min-width: 40px; min-height: 40px; }
    .cliente-plus-fino { position: relative; display: inline-block; width: 14px; height: 14px; }
    .cliente-plus-fino::before, .cliente-plus-fino::after { content: ""; position: absolute; left: 1px; top: 6px; width: 12px; height: 1px; background: currentColor; }
    .cliente-plus-fino::after { transform: rotate(90deg); }
    .solicitud-visor-cargando { color: #fff; text-align: center; }
    @@media (max-width: 700px) { .solicitud-fotos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<PageTitle>@(Id.HasValue ? "Editar - Solicitud de Servicio" : "Nueva - Solicitud de Servicio")</PageTitle>

<UnsavedChangesGuard @ref="unsavedChangesGuard" HasUnsavedChanges="@HayCambiosPendientes" />

<DxPopup @bind-Visible="passwordFinalizadaVisible"
         HeaderText="Solicitud finalizada"
         ShowFooter="true"
         Width="460px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2">
            <p>Esta solicitud está finalizada. Introduzca la contraseña de administración configurada en Parámetros para poder modificarla.</p>
            <DxTextBox @bind-Text="passwordFinalizada"
                       Password="true"
                       NullText="Contraseña"
                       CssClass="w-100"
                       Attributes="@(new Dictionary<string, object> { { "autocomplete", "new-password" } })" />
            @if (!string.IsNullOrWhiteSpace(errorPasswordFinalizada))
            {
                <div class="text-danger small mt-2">@errorPasswordFinalizada</div>
            }
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarEdicionFinalizada" />
            <DxButton Text="Desbloquear" RenderStyle="ButtonRenderStyle.Primary" Click="ValidarPasswordFinalizadaAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="nuevoContenedorVisible"
         HeaderText="Crear contenedor"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2">
            <div class="alert alert-info py-2 small">La solicitud actual se conserva sin guardar. Al crear el contenedor, se seleccionará automáticamente en <strong>@destinoNuevoContenedorDescripcion</strong>.</div>
            @if (!string.IsNullOrWhiteSpace(errorNuevoContenedor))
            {
                <div class="alert alert-danger py-2 small">@errorNuevoContenedor</div>
            }
            <div class="mb-3"><label class="form-label">Nº de serie</label><DxTextBox @bind-Text="nuevoContenedor.NumSerie" NullText="Introduzca el número de serie" CssClass="w-100" /></div>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Tipo de contenedor</label><DxComboBox Data="@tiposContenedorLocales" TData="ContenedorTipo" TValue="int" TextFieldName="Descripcion" ValueFieldName="IdTipo" @bind-Value="nuevoContenedor.IdTipo" CssClass="w-100" NullText="Seleccione..." /></div>
                <div class="col-md-6"><label class="form-label">Planta</label><DxComboBox Data="@plantas" TData="Planta" TValue="int" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="nuevoContenedor.IdPlanta" CssClass="w-100" NullText="Seleccione..." /></div>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100"><DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarNuevoContenedor" /><DxButton Text="Crear y seleccionar" RenderStyle="ButtonRenderStyle.Primary" Click="CrearNuevoContenedorAsync" /></div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="confirmacionCambioTareaVisible"
         VisibleChanged="OnConfirmacionVisibleChanged"
         HeaderText="Contenedores afectados"
         ShowFooter="true"
         Width="500px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2">
            <p>El cambio de tipo de tarea eliminará los siguientes datos de contenedores:</p>
            <ul class="mb-0">
                @if (entrega1Afectada)
                {
                    <li>Entrega [1]: <strong>@solicitud?.CodigoEntrega</strong></li>
                }
                @if (entrega2Afectada)
                {
                    <li>Entrega [2]: <strong>@solicitud?.CodigoAmbosEntrega</strong></li>
                }
                @if (recogida1Afectada)
                {
                    <li>Recogida [1]: <strong>@solicitud?.CodigoRecogida</strong></li>
                }
                @if (recogida2Afectada)
                {
                    <li>Recogida [2]: <strong>@solicitud?.CodigoAmbosRecogida</strong></li>
                }
            </ul>
            <p class="mt-3 mb-0">Al guardar el servicio, los contenedores recuperarán el estado que les corresponda.</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-center gap-2 w-100">
            <DxButton Text="Cancelar"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="CancelarCambioTarea" />
            <DxButton Text="Continuar"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Click="ConfirmarCambioTarea" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="confirmacionEliminarPlanificacionVisible"
         HeaderText="Cambiar estado"
         ShowFooter="true"
         Width="540px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <div>
                <p class="mb-0">Existen valores en la planificación del servicio que impiden el cambio de estado. ¿Desea que elimine los valores para pasar a este estado?</p>
                @if (estadoPendienteCambio.HasValue && EsEstadoAnulado(estadoPendienteCambio.Value))
                {
                    <p class="mb-0 mt-2 small">Si se va a reprogramar el servicio, indique la próxima fecha prevista y el motivo del aplazamiento para que la solicitud aparezca después en la planificación.</p>
                }
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarCambioEstado" />
            <DxButton Text="Eliminar valores" RenderStyle="ButtonRenderStyle.Primary" Click="ConfirmarCambioEstadoYEliminarPlanificacion" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="advertenciaPlanificacionIncompletaVisible"
         HeaderText="Planificación incompleta"
         ShowFooter="true"
         Width="540px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0">Existen valores en la planificación del servicio que no se han introducido para pasar a este estado.</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => advertenciaPlanificacionIncompletaVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="advertenciaEstadoIniciadoVisible"
         HeaderText="Cambio de estado no permitido"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0">Una solicitud solo puede pasar al estado Iniciado si anteriormente estaba en estado Asignado.</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => advertenciaEstadoIniciadoVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="popupObraBloqueadaVisible"
         HeaderText="Incidencia - Obra Bloqueada"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <div>
                <p class="mb-0 fw-semibold text-danger">No se puede desmarcar la casilla Bloqueado.</p>
                <p class="mb-0 text-muted small mt-1">La solicitud/Servicio no se puede desbloquear al encontrase la obra bloqueada.</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => popupObraBloqueadaVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(errorMessage))"
         VisibleChanged="CerrarMensajeError"
         HeaderText="Error"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-circle-x text-danger fs-3"></i>
            <div class="flex-grow-1">
                <p class="mb-0">@errorMessage</p>
                @if (EsErrorSolicitudFinalizada)
                {
                    <p class="small text-muted mt-3 mb-2">Introduzca la contraseña de administración para desbloquear la solicitud.</p>
                    <DxTextBox @bind-Text="passwordFinalizada" Password="true" NullText="Contraseña" CssClass="w-100" Attributes="@(new Dictionary<string, object> { { "autocomplete", "new-password" } })" />
                    @if (!string.IsNullOrWhiteSpace(errorPasswordFinalizada))
                    {
                        <div class="text-danger small mt-2">@errorPasswordFinalizada</div>
                    }
                }
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="@(EsErrorSolicitudFinalizada ? "Cancelar" : "Aceptar")" RenderStyle="ButtonRenderStyle.Secondary" Click="() => CerrarMensajeError(false)" />
            @if (EsErrorSolicitudFinalizada)
            {
                <DxButton Text="Desbloquear" RenderStyle="ButtonRenderStyle.Primary" Click="DesbloquearSolicitudDesdeErrorAsync" />
            }
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(motivoEstadoMessage))"
         VisibleChanged="@((bool visible) => { if (!visible) motivoEstadoMessage = null; })"
         HeaderText="No se puede cambiar el estado"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-circle-x text-danger fs-3"></i>
            <div>
                <p class="mb-0 fw-semibold">@motivoEstadoMessage</p>
                <p class="mb-0 small mt-2" style="opacity: 0.8;">Por favor, revise los datos antes de volver a grabar la solicitud.</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => motivoEstadoMessage = null" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="confirmacionCrearSolicitudReprogramadaVisible"
         HeaderText="Crear nueva solicitud"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-calendar text-primary fs-3"></i>
            <div>
                <p class="mb-1 fw-semibold">Ha introducido la próxima fecha: @fechaNuevaParaCrear?.ToString("dd/MM/yyyy")</p>
                <p class="mb-0 text-muted">¿Desea crear una nueva solicitud para esa fecha con los datos de la solicitud actual?</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="No" RenderStyle="ButtonRenderStyle.Secondary" Click="() => confirmacionCrearSolicitudReprogramadaVisible = false" />
            <DxButton Text="Sí, crear solicitud" RenderStyle="ButtonRenderStyle.Primary" Click="CrearSolicitudReprogramadaAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(mensajeExitoReprogramacion))"
         VisibleChanged="@((bool visible) => { if (!visible) mensajeExitoReprogramacion = null; })"
         HeaderText="Solicitud reprogramada"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-check text-success fs-3"></i>
            <div>
                <p class="mb-0">@mensajeExitoReprogramacion</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => mensajeExitoReprogramacion = null" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="revisionTiqueVisible"
         HeaderText="Revisar tique de báscula"
         ShowFooter="true"
         Width="620px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        @if (tiqueAnalisis is not null)
        {
            <div class="py-2">
                <div class="alert alert-info py-2 small">
                    Revise los datos leídos antes de aplicarlos. El OCR nunca modifica la solicitud sin esta confirmación.
                    @if (tiqueAnalisis.Confianza.HasValue)
                    {
                        <span class="ms-1">Confianza media: <strong>@tiqueAnalisis.Confianza.Value.ToString("P0")</strong>.</span>
                    }
                </div>
                @if (tiqueAnalisis.Advertencias.Count > 0)
                {
                    <div class="alert alert-warning py-2 small">
                        <strong>Revise especialmente:</strong>
                        <ul class="mb-0 mt-1">@foreach (var aviso in tiqueAnalisis.Advertencias) { <li>@aviso</li> }</ul>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(tiqueAnalisis.TextoOcr))
                {
                    <details class="mb-3 small">
                        <summary>Ver texto detectado por el OCR</summary>
                        <pre class="border rounded p-2 mt-2 mb-0 bg-light text-dark text-wrap">@tiqueAnalisis.TextoOcr</pre>
                    </details>
                }
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Nº albarán planta *</label><DxTextBox @bind-Text="tiqueAnalisis.NumeroAlbaran" MaxLength="20" /></div>
                    <div class="col-md-6"><label class="form-label">Matrícula</label><DxTextBox @bind-Text="tiqueAnalisis.Matricula" MaxLength="20" /></div>
                    <div class="col-md-4"><label class="form-label">Fecha *</label><DxDateEdit @bind-Date="tiqueAnalisis.Fecha" /></div>
                    <div class="col-md-4"><label class="form-label">Hora *</label><DxTimeEdit @bind-Time="tiqueAnalisis.Hora" DisplayFormat="HH:mm" Format="HH:mm" TimeSectionVisible="false" /></div>
                    <div class="col-md-4"><label class="form-label">Peso neto (kg) *</label><DxSpinEdit @bind-Value="tiqueAnalisis.PesoNetoKg" MinValue="1" MaxValue="100000" Increment="1" /></div>
                </div>
            </div>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarRevisionTique" />
            <DxButton Text="Confirmar y aplicar" RenderStyle="ButtonRenderStyle.Primary" Click="ConfirmarTiquePesajeAsync" Enabled="@(!procesandoTique)" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="deCaOficinaPopupVisible"
         HeaderText="Código QR DeCA (Control de Transporte)"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        @if (solicitud != null && !string.IsNullOrWhiteSpace(solicitud.GuidDeCa))
        {
            <div class="py-2 text-center">
                <div class="fw-bold text-primary mb-1">
                    @(solicitud.TipoDeCaEmitido == "ENTREGA" ? "DeCA de Entrega / Colocación" : "DeCA de Retirada de Residuos (RCDs)")
                </div>
                <div class="small text-muted mb-2">
                    Emitido: @(solicitud.FechaHoraEmisionDeCa?.ToString("dd/MM/yyyy HH:mm:ss") ?? "--")
                </div>
                <div class="p-2 border rounded bg-white d-inline-block shadow-sm mb-3">
                                        <img src="@qrDeCaOficinaImagenSrc"
                         alt="Código QR DeCA"
                         style="width: 220px; height: 220px; display: block;" />
                </div>
                <div class="alert alert-info py-2 small text-start mb-0">
                    Al escanear este código QR, los agentes de la autoridad descargan directamente el documento PDF nativo sin requerir contraseña.
                </div>
            </div>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-between align-items-center w-100">
            @if (!string.IsNullOrWhiteSpace(urlDescargaDeCaOficina))
            {
                <a href="@urlDescargaDeCaOficina" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="oi oi-document me-1"></i>Ver PDF DeCA
                </a>
            }
            else { <span></span> }
            <DxButton Text="Cerrar" RenderStyle="ButtonRenderStyle.Secondary" Click="() => deCaOficinaPopupVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">@(Id.HasValue && Id.Value > 0 && Duplicate != true ? "Editar - Solicitud de Servicio" : "Nueva - Solicitud de Servicio")</h2>
            <p class="text-muted mb-0">Complete los datos de la solicitud del servicio</p>
        </div>
        <div class="d-flex gap-2">
            <NavLink href="/servicios/planificacion" class="btn btn-outline-primary btn-sm">
                <i class="oi oi-calendar me-1"></i> Planificación
            </NavLink>
            <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                <i class="oi oi-arrow-left me-1"></i> Volver a Solicitudes
            </button>
        </div>
    </div>



    @if (loading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-muted mb-0">Cargando datos...</p>
        </div>
    }
    else if (solicitud != null && PuedeEditarSolicitud)
    {
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-body p-4">
                <DxFormLayout CssClass="w-100" CaptionPosition="CaptionPosition.Vertical">
                    <!-- Grupo: Obra / Cliente -->
                    <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary border-bottom pb-2 mb-3">
                        Obra / Cliente
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Nº Solicitud" ColSpanMd="2" BeginRow="true" >
                        
                        <DxSpinEdit @bind-Value="@solicitud.IdSolicitud" 
                            ShowSpinButtons="false" 
                            ReadOnly="true" 
                            Enabled="false" />

                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Fecha Solicitud" ColSpanMd="2">
                        <DxDateEdit @bind-Date="@solicitud.FechaSolicitud" />
                    </DxFormLayoutItem>
                    
                    <DxFormLayoutItem Caption="Obra" ColSpanMd="6">

                        <DxComboBox Data="@obras"
                                    TextFieldName="TextoBusqueda"
                                    ValueFieldName="IdObra"
                                    Value="@solicitud.IdCliente"
                                    ValueChanged="@((int val) => OnObraChangedAsync(val))"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                                    AllowUserInput="true"
                                    Enabled="@(!servicioSinObra)">
                            <Buttons>
                                <DxEditorButton IconCssClass="oi oi-pencil"
                                                Tooltip="Editar obra seleccionada"
                                                Click="EditarObraSeleccionada"
                                                Enabled="@TieneObraSeleccionada"
                                                Visible="true" />
                            </Buttons>

                            <ItemTemplate Context="obra">
                                <span><strong>@obra.Codigo</strong> - @obra.Descripcion</span>
                            </ItemTemplate>

                        </DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Servicio sin obra" ColSpanMd="2">
                        <DxCheckBox @bind-Checked:get="@servicioSinObra" @bind-Checked:set="@OnServicioSinObraChanged" LabelPosition="LabelPosition.Right">Datos manuales</DxCheckBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="obra-resumen small p-3 rounded border mb-2" style="background-color: rgba(128, 128, 128, 0.05);">
                                @if (servicioSinObra)
                                {
                                    <div class="alert alert-info py-2 mb-3">Servicio sin obra vinculada: complete los datos manualmente. Los cambios solo afectan a esta solicitud.</div>
                                    <div class="row g-3">
                                        <div class="col-md-7 col-12"><label class="form-label small mb-1">Nombre de obra o servicio</label><DxTextBox @bind-Text="solicitud.NombreObra" NullText="Indique el nombre del servicio" /></div>
                                        <div class="col-md-5 col-12"><label class="form-label small mb-1">Cliente</label><DxComboBox Data="@clientesManuales" TData="ClienteSage50" TValue="string" TextFieldName="Nombre" ValueFieldName="Codigo" Value="@solicitud.CodigoClienteManual" ValueChanged="OnClienteManualChangedAsync" Text="@solicitud.NombreCliente" TextChanged="OnNombreClienteManualChanged" NullText="Seleccione un cliente..." ListRenderMode="ListRenderMode.Virtual" SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains" AllowUserInput="true"><Buttons><DxEditorButton IconCssClass="cliente-plus-fino" Tooltip="Nuevo cliente" Click="NuevoClienteManual" /></Buttons><ItemTemplate Context="cli"><span style="font-size: 0.9rem;"><strong>@cli.Codigo</strong> - @cli.Nombre</span></ItemTemplate></DxComboBox></div>
                                        <div class="col-md-8 col-12"><label class="form-label small mb-1">Dirección</label><DxTextBox @bind-Text="solicitud.DireccionCliente" NullText="Indique la dirección" /></div>
                                        <div class="col-md-4 col-12"><label class="form-label small mb-1">Población</label><DxTextBox Text="@solicitud.PoblacionCliente" TextChanged="OnPoblacionManualChanged" NullText="Indique la población" /></div>                                        <div class="col-md-4 col-12"><label class="form-label small mb-1">Encargado</label><DxTextBox @bind-Text="solicitud.Encargado" /></div>
                                        <div class="col-md-4 col-12"><label class="form-label small mb-1">Teléfono</label><DxTextBox @bind-Text="solicitud.TelefonoCliente" /></div>
                                        <div class="col-md-4 col-12"><label class="form-label small mb-1">Móvil</label><DxTextBox @bind-Text="solicitud.Movil" /></div>
                                        <div class="col-md-12 col-12"><label class="form-label small mb-1">Tarifa aplicada</label><DxComboBox Data="@tarifasOpciones" TData="TarifaSolicitudOpcion" TValue="string" TextFieldName="Descripcion" ValueFieldName="Codigo" @bind-Value="solicitud.TarifaAplicada" NullText="Seleccione tarifa..."><Columns><DxListEditorColumn FieldName="Codigo" Caption="Código" /><DxListEditorColumn FieldName="Nombre" Caption="Nombre" /><DxListEditorColumn FieldName="Zona" Caption="Zona" /><DxListEditorColumn FieldName="NombreZona" Caption="Nombre de zona" /></Columns></DxComboBox></div>
                                    </div>
                                }
                                else
                                {                                <div class="row g-3">
                                    <div class="col-md-8 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Nombre Obra:</span>
                                        <span>@(solicitud.NombreObra ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Cliente:</span>
                                        <span>@(solicitud.NombreCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-8 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Dirección Obra:</span>
                                        <span>@(solicitud.DireccionCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Población:</span>
                                        <span>@(solicitud.PoblacionCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Encargado:</span>
                                        <span>@(solicitud.Encargado ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Teléfono:</span>
                                        <span>@(solicitud.TelefonoCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Móvil:</span>
                                        <span>@(solicitud.Movil ?? "-")</span>
                                    </div>
                                    <div class="col-12 d-flex justify-content-center align-items-baseline gap-2 text-nowrap overflow-auto" style="color: #E8A000;">
                                        <span class="text-nowrap fw-bold">Tarifa de obra:</span>
                                        <span class="text-nowrap fw-bold">@TextoTarifaObra</span>
                                        @if (TienePreciosEspecialesObra) { <NavLink href="@UrlPreciosEspecialesObra" class="link-warning text-nowrap fw-bold">(Con tarifas especiales)</NavLink> }
                                    </div>
                                </div>
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    <!-- Grupo 1: Datos Generales -->
                    <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary mt-4 border-bottom pb-2 mb-3" BeginRow="true">
                        Datos del Servicio
                    </DxFormLayoutItem>


                    <DxFormLayoutItem Caption="Tipo de Tarea" ColSpanMd="3" ColSpanSm="6" ColSpanXs="12" BeginRow="true">
                        <DxComboBox @key="tareaComboKey"
                                    Data="@TareasDisponibles"
                                    TextFieldName="NombreTarea"
                                    ValueFieldName="IdTarea"
                                    Value="@solicitud.IdTipoTarea"
                                    ValueChanged="@((int val) => OnTareaChanged(val))" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Conductor" ColSpanMd="3" ColSpanSm="6" ColSpanXs="12">
                        <DxComboBox Data="@GetOperariosDisponibles()"
                                    TextFieldName="Nombre"
                                    ValueFieldName="IdOperario"
                                    Value="@solicitud?.IdConductor"
                                    ValueChanged="@((int? value) => OnConductorChanged(value))"
                                    ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Matrícula del camión" ColSpanMd="2" ColSpanSm="4" ColSpanXs="12">
                        <DxTextBox Text="@MatriculaCamionConductor" ReadOnly="true" EnableValidation="false" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Prioridad" ColSpanMd="2" ColSpanSm="4" ColSpanXs="6">
                        <DxComboBox Data="@prioridadesList"
                                    TextFieldName="Name"
                                    ValueFieldName="Id"
                                    @bind-Value="@solicitud.Prioridad" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="2" ColSpanSm="4" ColSpanXs="6" CssClass="d-flex align-items-end pb-1">
                        <DxCheckBox Checked="@solicitud.Bloqueado"
                                    CheckedChanged="@((bool val) => OnBloqueadoChanged(val))"
                                    LabelPosition="LabelPosition.Right">Bloqueado</DxCheckBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Estado" ColSpanMd="12" BeginRow="true" CssClass="text-center">
                        @if (estadosList != null && estadosList.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center mt-1">
                                @foreach (var est in estadosList.OrderBy(e => e.IdEstado))
                                {
                                    var id = est.IdEstado;
                                    var isChecked = solicitud?.Estado == id;
                                    var bg = !string.IsNullOrEmpty(est.BgColor) ? est.BgColor : "#f8f9fa";
                                    var text = !string.IsNullOrEmpty(est.TextColor) ? est.TextColor : "#000000";
                                    
                                    <div class="form-check form-check-inline d-flex align-items-center gap-2 px-3 py-2 rounded-3 border shadow-sm"
                                         style="cursor: pointer; background-color: @(isChecked ? bg : "var(--bs-card-bg, #ffffff)"); color: @(isChecked ? text : "inherit"); border-color: @(isChecked ? bg : "#dee2e6") !important; font-weight: @(isChecked ? "bold" : "normal"); transition: all 0.2s ease-in-out;"
                                         @onclick="() => SolicitarCambioEstado(id)">
                                        <input class="form-check-input mt-0"
                                               type="radio"
                                               name="solicitudEstadoRadioGroup"
                                               id="@($"estadoRadio_{id}")"
                                               value="@id"
                                               checked="@isChecked"
                                               @onclick="() => SolicitarCambioEstado(id)"
                                               @onclick:stopPropagation="true"
                                               style="cursor: pointer;" />
                                        <label class="form-check-label mb-0 ms-1" for="@($"estadoRadio_{id}")" style="cursor: pointer; font-size: 0.9rem;">
                                            @est.Descripcion
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Hora" ColSpanMd="3" Visible="false">
                        <DxTextBox @bind-Value="@solicitud.HoraLlegada" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary mt-4 border-bottom pb-2 mb-3" BeginRow="true">
                        Planificación del servicio
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Central - Origen" ColSpanMd="3" BeginRow="true">
                        <DxComboBox Data="@plantas" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="@solicitud.IdPlantaOrigen" ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Planta reciclaje" ColSpanMd="3">
                        <DxComboBox Data="@plantas" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="@solicitud.IdPlantaDescarga" ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Central - Regreso" ColSpanMd="3">
                        <DxComboBox Data="@plantas" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="@solicitud.IdPlantaRegreso" ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Tiempo (minutos)" ColSpanMd="3">
                        <DxSpinEdit Value="@solicitud.DuracionPlanificadaMinutos"
                                    ValueChanged="@((int? value) => OnDuracionTotalChanged(value))"
                                    MinValue="1" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Fecha prevista" ColSpanMd="3" BeginRow="true">
                        <DxDateEdit Date="@solicitud.FechaTarea"
                                    DateChanged="@((DateTime? val) => OnFechaPlanificacionChanged(val))"
                                    DateExpression="@(() => solicitud.FechaTarea)"
                                    Format="dd/MM/yyyy"
                                    DisplayFormat="dd/MM/yyyy" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Hora Inicio" ColSpanMd="2">
                        <DxDateEdit Date="@solicitud.FechaHoraInicioPlanificada"
                                    DateChanged="@((DateTime? val) => OnInicioPlanificadoChanged(val))"
                                    DateExpression="@(() => solicitud.FechaHoraInicioPlanificada)"
                                    TimeSectionVisible="true"
                                    Format="HH:mm"
                                    DisplayFormat="HH:mm" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Hora final." ColSpanMd="2">
                        <DxDateEdit Date="@solicitud.FechaHoraFinPlanificada"
                                    DateChanged="@((DateTime? val) => OnFinPlanificadoChanged(val))"
                                    DateExpression="@(() => solicitud.FechaHoraFinPlanificada)"
                                    TimeSectionVisible="true"
                                    Format="HH:mm"
                                    DisplayFormat="HH:mm" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="2" CssClass="d-flex align-items-end pt-2">
                        <button type="button" 
                                class="btn btn-outline-primary btn-sm w-100" 
                                @onclick="ProponerSiguienteHuecoAsync">
                            <i class="oi oi-clock me-1"></i> Asignar hora
                        </button>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="3" CssClass="d-flex align-items-end pt-2">
                        <button type="button"
                                class="btn btn-outline-success btn-sm w-100"
                                disabled="@calculandoRuta"
                                @onclick="() => CalcularRutaAsync(true)">
                            @if (calculandoRuta)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="oi oi-map-marker me-1"></i>
                            }
                            Calcular ruta
                        </button>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="3" BeginRow="true" Visible = "false">
                        <DxCheckBox @bind-Checked="@solicitud.DuracionModificadaManualmente" LabelPosition="LabelPosition.Right">
                            Duración total manual
                        </DxCheckBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12">
                        @if (solicitud.DistanciaTotalMetros.HasValue)
                        {
                            <div class="small pt-2 text-center" style="color: #f59e0b;">
                                <strong>@FormatKilometros(solicitud.DistanciaTotalMetros)</strong>
                                · Origen→Obra: @solicitud.MinutosOrigenObra min
                                @if (solicitud.IdPlantaDescarga.HasValue)
                                {
                                    <text>· Obra→Reciclaje: @solicitud.MinutosObraDescarga min
                                    · Reciclaje→Central: @solicitud.MinutosDescargaRegreso min</text>
                                }
                                else
                                {
                                    <text>· Obra→Central: @solicitud.MinutosDescargaRegreso min</text>
                                }
                                @if (solicitud.DuracionOperacionMinutos.GetValueOrDefault() > 0)
                                {
                                    <span> · Operación: @solicitud.DuracionOperacionMinutos min</span>
                                }
                                <strong> · Total: @solicitud.DuracionPlanificadaMinutos min</strong>
                            </div>
                        }
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Viaje (minutos)" ColSpanMd="1" Visible="false">
                        <DxSpinEdit @bind-Value="@solicitud.DuracionViajeMinutos" MinValue="0" Enabled="false" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Operación (minutos)" ColSpanMd="1" Visible="false">
                        <DxSpinEdit Value="@solicitud.DuracionOperacionMinutos"
                                    ValueChanged="@((int? value) => OnDuracionOperacionChanged(value))"
                                    MinValue="0" />
                    </DxFormLayoutItem>

                    @if (!string.IsNullOrWhiteSpace(planificacionMessage))
                    {
                        <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
                            <div class="alert alert-info py-2 mb-0">@planificacionMessage</div>
                        </DxFormLayoutItem>
                    }

                    <DxFormLayoutItem Caption="Observaciones" ColSpanMd="6" BeginRow="true">
                        <DxMemo @bind-Text="@solicitud.Observaciones" Rows="4" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Comentarios para oficina" ColSpanMd="6" BeginRow="false">
                        <DxMemo @bind-Text="@solicitud.ComentariosOficina" Rows="4" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Observaciones del conductor para la oficna" ColSpanMd="12" >
                        <DxMemo @bind-Text:get="@solicitud.ObservacionesConductor"
                                @bind-Text:set="@OnObservacionesConductorChanged" Rows="2" />
                    </DxFormLayoutItem>


                    <!-- Grupo 3: Contenedor y Ubicación -->
                    <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="row g-4">
                                <!-- Columna Izquierda: Contenedor -->
                                <div class="col-md-6 border-end pe-md-4">
                                    <h6 class="fw-bold text-primary mb-3 pb-2 border-bottom">Núm. Series Contenedores</h6>
                                    <div class="row g-2">
                                    <div class="col-md-6 mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1"><label class="form-label fw-bold text-muted small mb-0">Entrega [1] </label><span><button type="button" class="btn btn-link btn-sm p-0 me-2" @onclick='() => AbrirNuevoContenedor("CodigoEntrega", "Entrega [1]")'>Nuevo</button><button type="button" class="btn btn-link btn-sm p-0" disabled="@string.IsNullOrWhiteSpace(solicitud.CodigoEntrega)" @onclick="LimpiarEntrega1">Borrar</button></span></div>
                                        <DxComboBox @key="selectorContenedorVersion" Data="@contenedoresEntrega"
                                                    Enabled="@IsEntregaEnabled"
                                                    TData="Contenedor"
                                                    TValue="string"
                                                    TextFieldName="NumSerie"
                                                    ValueFieldName="NumSerie"
                                                    Value="@solicitud.CodigoEntrega"
                                                    ValueChanged="CambiarEntrega1"
                                                    NullText="Seleccionar..."
                                                    NullValue="@((string?)null)"
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                    AllowUserInput="true">
                                            <Columns>
                                                <DxListEditorColumn FieldName="NumSerie" Caption="Nº Serie" />
                                                <DxListEditorColumn FieldName="Tipo.Descripcion" Caption="Tipo" />
                                                <DxListEditorColumn FieldName="EstadoFisico" Caption="Estado" />
                                            </Columns>
                                        </DxComboBox>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1"><label class="form-label fw-bold text-muted small mb-0">Entrega [2] </label><span><button type="button" class="btn btn-link btn-sm p-0 me-2" @onclick='() => AbrirNuevoContenedor("CodigoAmbosEntrega", "Entrega [2]")'>Nuevo</button><button type="button" class="btn btn-link btn-sm p-0" disabled="@string.IsNullOrWhiteSpace(solicitud.CodigoAmbosEntrega)" @onclick="LimpiarEntrega2">Borrar</button></span></div>
                                        <DxComboBox @key="selectorContenedorVersion" Data="@contenedoresEntrega"
                                                    Enabled="@IsEntrega2Enabled"
                                                    TData="Contenedor"
                                                    TValue="string"
                                                    TextFieldName="NumSerie"
                                                    ValueFieldName="NumSerie"
                                                    Value="@solicitud.CodigoAmbosEntrega"
                                                    ValueChanged="CambiarEntrega2"
                                                    NullText="Seleccionar..."
                                                    NullValue="@((string?)null)"
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                    AllowUserInput="true">
                                            <Columns>
                                                <DxListEditorColumn FieldName="NumSerie" Caption="Nº Serie" />
                                                <DxListEditorColumn FieldName="Tipo.Descripcion" Caption="Tipo" />
                                                <DxListEditorColumn FieldName="EstadoFisico" Caption="Estado" />
                                            </Columns>
                                        </DxComboBox>
                                    </div>
                                    </div>
                                    <div class="row g-2">
                                    <div class="col-md-6 mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1"><label class="form-label fw-bold text-muted small mb-0">Retirada [1] </label><span><button type="button" class="btn btn-link btn-sm p-0 me-2" @onclick='() => AbrirNuevoContenedor("CodigoRecogida", "Retirada [1]")'>Nuevo</button><button type="button" class="btn btn-link btn-sm p-0" disabled="@string.IsNullOrWhiteSpace(solicitud.CodigoRecogida)" @onclick="LimpiarRecogida1">Borrar</button></span></div>
                                        <DxComboBox @key="selectorContenedorVersion" Data="@contenedoresRecogida" Enabled="@IsRecogidaEnabled"
                                                    TData="Contenedor" TValue="string"
                                                    TextFieldName="NumSerie" ValueFieldName="NumSerie"
                                                    Value="@solicitud.CodigoRecogida"
                                                    ValueChanged="CambiarRecogida1"
                                                    NullText="Seleccionar..."
                                                    NullValue="@((string?)null)"
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    SearchFilterCondition="ListSearchFilterCondition.Contains" AllowUserInput="true">
                                            <Columns>
                                                <DxListEditorColumn FieldName="NumSerie" Caption="Nº Serie" />
                                                <DxListEditorColumn FieldName="Tipo.Descripcion" Caption="Tipo" />
                                                <DxListEditorColumn FieldName="EstadoFisico" Caption="Estado" />
                                            </Columns>
                                        </DxComboBox>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1"><label class="form-label fw-bold text-muted small mb-0">Retirada [2] </label><span><button type="button" class="btn btn-link btn-sm p-0 me-2" @onclick='() => AbrirNuevoContenedor("CodigoAmbosRecogida", "Retirada [2]")'>Nuevo</button><button type="button" class="btn btn-link btn-sm p-0" disabled="@string.IsNullOrWhiteSpace(solicitud.CodigoAmbosRecogida)" @onclick="LimpiarRecogida2">Borrar</button></span></div>
                                        <DxComboBox @key="selectorContenedorVersion" Data="@contenedoresRecogida" Enabled="@IsRecogida2Enabled"
                                                    TData="Contenedor" TValue="string"
                                                    TextFieldName="NumSerie" ValueFieldName="NumSerie"
                                                    Value="@solicitud.CodigoAmbosRecogida"
                                                    ValueChanged="CambiarRecogida2"
                                                    NullText="Seleccionar..."
                                                    NullValue="@((string?)null)"
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    SearchFilterCondition="ListSearchFilterCondition.Contains" AllowUserInput="true">
                                            <Columns>
                                                <DxListEditorColumn FieldName="NumSerie" Caption="Nº Serie" />
                                                <DxListEditorColumn FieldName="Tipo.Descripcion" Caption="Tipo" />
                                                <DxListEditorColumn FieldName="EstadoFisico" Caption="Estado" />
                                            </Columns>
                                        </DxComboBox>
                                    </div>
                                    </div>
                                    <div class="row g-2 mt-4">
                                        <div class="col-12">
                                            <label class="form-label fw-bold text-muted small mb-2">Tipo de residuo@(RequiereTipoResiduo ? " *" : string.Empty)</label>
                                            <DxComboBox Data="@(tiposContenedor?.OrderBy(articulo => articulo.Nombre) ?? Enumerable.Empty<ArticuloSage50>())"
                                                        TData="ArticuloSage50"
                                                        TValue="string"
                                                        TextFieldName="Descripcion"
                                                        ValueFieldName="Codigo"
                                                        @bind-Value="solicitud.TipoResiduo"
                                                        NullText="Seleccione el tipo de residuo..."
                                                        SearchMode="ListSearchMode.AutoSearch"
                                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Columna Derecha: Localización GPS -->
                                <div class="col-md-6 ps-md-4">
                                    <h6 class="fw-bold text-primary mb-3 pb-2 border-bottom">Localización GPS</h6>
                                    <div class="row g-2">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-muted small mb-1">Latitud</label>
                                            <DxSpinEdit @bind-Value="@solicitud.Latitud" DecimalPlaces="6" ShowSpinButtons="false" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-muted small mb-1">Longitud</label>
                                            <DxSpinEdit @bind-Value="@solicitud.Longitud" DecimalPlaces="6" ShowSpinButtons="false" />
                                        </div>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="ObtenerUbicacionActualAsync" style="height: 38px;">
                                                <i class="oi oi-map-marker me-1"></i> Ubicación Actual
                                            </button>
                                        </div>
                                        <div class="col-6">
                                            <button type="button" class="btn btn-outline-success btn-sm w-100" @onclick="VerCoordenadasEnMapa" style="height: 38px;" title="Ver coordenadas en Google Maps">
                                                <i class="oi oi-eye me-1"></i> Ver en Maps
                                            </button>
                                        </div>
                                    </div>

                                    <h6 class="fw-bold text-primary mt-3 mb-3 pb-2 border-bottom">Albaranes</h6>
                                    <div class="row g-2">
                                        <div class="col-md-2"><label class="form-label fw-bold text-muted small mb-2">Alb. Pla.</label><DxTextBox @bind-Text="@solicitud.AlbaranPlanta" MaxLength="20" /></div>
                                        <div class="col-md-4"><label class="form-label fw-bold text-muted small mb-2">Fecha pesaje</label><DxDateEdit @bind-Date="@solicitud.FechaPesaje" /></div>
                                        <div class="col-md-3"><label class="form-label fw-bold text-muted small mb-2">Kg pesaje</label><DxSpinEdit @bind-Value="solicitud.KgAlbaran" @bind-Value:after="OnKgAlbaranChanged" MinValue="0" Increment="1" CssClass="w-100" /></div>
                                        <div class="col-md-3"><label class="form-label fw-bold text-muted small mb-2">Hora pesaje</label>
