    private Task OnClienteManualChangedAsync(string codigo)
    {
        if (solicitud is null) return Task.CompletedTask;

        var valor = codigo?.Trim() ?? string.Empty;
        var cliente = clientesManuales.FirstOrDefault(c => string.Equals(c.Codigo, valor, StringComparison.OrdinalIgnoreCase));
        if (cliente is null)
        {
            solicitud.CodigoClienteManual = null;
            return Task.CompletedTask;
        }

        solicitud.CodigoClienteManual = cliente.Codigo?.Trim();
        solicitud.NombreCliente = cliente.Nombre?.Trim();
        solicitud.TelefonoCliente = cliente.Telefono?.Trim();
        return Task.CompletedTask;
    }

    private Task OnNombreClienteManualChanged(string nombre)
    {
        if (solicitud is null) return Task.CompletedTask;

        var valor = nombre?.Trim() ?? string.Empty;
        solicitud.NombreCliente = valor;
        var cliente = clientesManuales.FirstOrDefault(c => string.Equals(c.Nombre?.Trim(), valor, StringComparison.OrdinalIgnoreCase));
        solicitud.CodigoClienteManual = cliente?.Codigo?.Trim();
        if (cliente is not null)
            solicitud.TelefonoCliente = cliente.Telefono?.Trim();
        return Task.CompletedTask;
    }
    private Task OnPoblacionManualChanged(string valor)
    {
        if (solicitud is null) return Task.CompletedTask;
        solicitud.PoblacionCliente = valor?.Trim();
        var texto = solicitud.PoblacionCliente?.ToUpperInvariant();
        var propuesta = tarifasVigentes.FirstOrDefault(t => !string.IsNullOrWhiteSpace(texto) && zonasTarifas.Any(z => string.Equals(z.Zona.Trim(), t.Zona.Trim(), StringComparison.OrdinalIgnoreCase) && z.Descripcion.ToUpperInvariant().Contains(texto)));
        if (propuesta is not null) solicitud.TarifaAplicada = propuesta.Codigo.Trim();
        return Task.CompletedTask;
    }
    private void OnServicioSinObraChanged(bool valor)
    {
        if (solicitud is null) return;

        servicioSinObra = valor;
        if (valor)
        {
            solicitud.IdCliente = 0;
            solicitud.Bloqueado = false;
        }
    }
    private async Task OnObraChangedAsync(int val)
    {
        if (solicitud == null) return;
        solicitud.IdCliente = val;
        servicioSinObra = false;
        var obra = obras?.FirstOrDefault(o => o.IdObra == val);
        if (obra != null)
        {
            solicitud.NombreObra = obra.Descripcion;
            solicitud.NombreCliente = obra.NombreCliente;
            solicitud.DireccionCliente = obra.Ubicacion;
            solicitud.PoblacionCliente = obra.Poblacion;
            solicitud.TelefonoCliente = obra.Telefono;
            solicitud.Encargado = obra.Encargado;
            solicitud.Movil = obra.Movil;
            var observacionesObra = obra.Observaciones?.Trim();
            if (!string.IsNullOrWhiteSpace(observacionesObra)
                && !(solicitud.Observaciones ?? string.Empty).Contains(observacionesObra, StringComparison.Ordinal))
            {
                solicitud.Observaciones = string.IsNullOrWhiteSpace(solicitud.Observaciones)
                    ? observacionesObra
                    : solicitud.Observaciones.TrimEnd() + Environment.NewLine + observacionesObra;
            }

            if (obra.Visible == false)
            {
                solicitud.Bloqueado = true;
            }

            if (TryParseCoordinate(obra.Libre1, out var oLat) && TryParseCoordinate(obra.Libre2, out var oLon) && (oLat != 0 || oLon != 0))
            {
                solicitud.Latitud = (decimal)oLat;
                solicitud.Longitud = (decimal)oLon;
                SyncCoordinates();
                StateHasChanged();
            }
            else
            {
                // Limpiar coordenadas anteriores para la nueva obra antes de geocodificar
                solicitud.Latitud = null;
                solicitud.Longitud = null;
                solicitud.CoordenadasGPS = null;
                solicitud.LatitudObra = null;
                solicitud.LongitudObra = null;
                StateHasChanged();

                await GeocodificarUbicacionObraAsync(obra);
            }
        }
        else
        {
            solicitud.NombreObra = null;
            solicitud.NombreCliente = null;
            solicitud.DireccionCliente = null;
            solicitud.PoblacionCliente = null;
            solicitud.TelefonoCliente = null;
            solicitud.Encargado = null;
            solicitud.Movil = null;
            solicitud.Latitud = null;
            solicitud.Longitud = null;
            solicitud.CoordenadasGPS = null;
            solicitud.LatitudObra = null;
            solicitud.LongitudObra = null;
            StateHasChanged();
        }
    }

    private async Task<bool> GeocodificarUbicacionObraAsync(Obra obra)
    {
        if (solicitud == null || obra == null) return false;

        var address = ST1Savall.MapHelper.BuildNormalizedQuery(
            obra.Ubicacion,
            obra.Poblacion,
            obra.Provincia,
            obra.CodigoPostal);

        if (string.IsNullOrWhiteSpace(address))
        {
            address = ST1Savall.MapHelper.BuildNormalizedQuery(
                solicitud.DireccionCliente,
                solicitud.PoblacionCliente,
                null,
                null);
        }

        if (string.IsNullOrWhiteSpace(address))
        {
            address = obra.Descripcion;
        }

        if (string.IsNullOrWhiteSpace(address))
        {
            StateHasChanged();
            return false;
        }

        try
        {
            var searchQuery = (address + ", España").Replace("'", "\\'");
            var jsScript = @"
                (async () => {
                    try {
                        const fullQuery = '" + searchQuery + @"';
                        let res = await fetch('https://nominatim.openstreetmap.org/search?format=json&countrycodes=es&q=' + encodeURIComponent(fullQuery) + '&limit=1');
                        if (res.ok) {
                            let data = await res.json();
                            if (data && data.length > 0) {
                                return { latitud: parseFloat(data[0].lat), longitud: parseFloat(data[0].lon) };
                            }
                        }
                        let parts = fullQuery.split(',').map(p => p.trim()).filter(Boolean);
                        let fallbackQuery = parts.length > 1 ? parts.slice(-2).join(', ') : fullQuery;
                        res = await fetch('https://nominatim.openstreetmap.org/search?format=json&countrycodes=es&q=' + encodeURIComponent(fallbackQuery) + '&limit=1');
                        if (res.ok) {
                            let data = await res.json();
                            if (data && data.length > 0) {
                                return { latitud: parseFloat(data[0].lat), longitud: parseFloat(data[0].lon) };
                            }
                        }
                    } catch (e) {}
                    return null;
                })()
            ";

            var geocodeResult = await JSRuntime.InvokeAsync<GpsPosition>("eval", jsScript);

            if (geocodeResult != null && (geocodeResult.Latitud != 0 || geocodeResult.Longitud != 0))
            {
                solicitud.Latitud = (decimal)geocodeResult.Latitud;
                solicitud.Longitud = (decimal)geocodeResult.Longitud;
                SyncCoordinates();
                await GuardarCoordenadasEnObraSage50Async(obra.IdObra, (decimal)geocodeResult.Latitud, (decimal)geocodeResult.Longitud);
                StateHasChanged();
                return true;
            }
        }
        catch
        {
        }
        StateHasChanged();
        return false;
    }

    private async Task OnBloqueadoChanged(bool value)
    {
        if (solicitud == null) return;

        if (!value)
        {
            try
            {
                await SetupHeadersAsync();
                var latestObra = await Http.GetFromJsonAsync<Obra>($"api/obras/{solicitud.IdCliente}");
                if (latestObra != null)
                {
                    var idx = obras?.FindIndex(o => o.IdObra == solicitud.IdCliente) ?? -1;
                    if (idx >= 0 && obras != null)
                    {
                        obras[idx] = latestObra;
                    }

                    if (latestObra.Visible == false)
                    {
                        solicitud.Bloqueado = true;
                        popupObraBloqueadaVisible = true;
                        StateHasChanged();
                        return;
                    }
                }
            }
            catch
            {
                var obra = obras?.FirstOrDefault(o => o.IdObra == solicitud.IdCliente);
                if (obra != null && obra.Visible == false)
                {
                    solicitud.Bloqueado = true;
                    popupObraBloqueadaVisible = true;
                    StateHasChanged();
                    return;
                }
            }
        }

        solicitud.Bloqueado = value;
    }

