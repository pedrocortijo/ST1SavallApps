                                            CssClass="text-center" 
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
                                        </div>
                                        @* <div class="col-md-2"><label class="form-label fw-bold text-muted small mb-1">Serie Sage</label><DxTextBox @bind-Text="@solicitud.AlbaranSerieSage" MaxLength="2" Enabled="false" /></div> *@
