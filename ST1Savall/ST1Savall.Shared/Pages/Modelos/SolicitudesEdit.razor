    private bool ValidarDatosServicioSinObra(out string? mensaje)
    {
        mensaje = null;
        if (!servicioSinObra || solicitud is null) return true;

        if (string.IsNullOrWhiteSpace(solicitud.NombreObra) && string.IsNullOrWhiteSpace(solicitud.NombreCliente))
        {
            mensaje = "En un servicio sin obra debe indicar el nombre del servicio o el cliente.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(solicitud.DireccionCliente))
        {
            mensaje = "En un servicio sin obra debe indicar la dirección.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(solicitud.PoblacionCliente))
        {
            mensaje = "En un servicio sin obra debe indicar la población.";
            return false;
        }
        return true;
    }
    private bool ValidarEstadoAlGuardar(out string? motivoError)
    {
        motivoError = null;
        if (solicitud == null) return true;

        var estadoSeleccionado = solicitud.Estado;
        var parametro = parametrosList?.FirstOrDefault();
        var idAdjudicado = parametro?.EstadoAdjudicado ?? 9;
        var idReprogramado = parametro?.EstadoReprogramacion ?? 6;

        bool tieneConductor = solicitud.IdConductor.HasValue && solicitud.IdConductor.Value >= 0;
        bool tieneFechaPrevista = solicitud.FechaPrevista.HasValue || solicitud.FechaTarea.HasValue;
        bool tieneHoraInicio = solicitud.FechaHoraInicioPlanificada.HasValue;
        bool tieneHoraFin = solicitud.FechaHoraFinPlanificada.HasValue;
        bool tieneTiempo = solicitud.DuracionPlanificadaMinutos.HasValue && solicitud.DuracionPlanificadaMinutos.Value > 0;
        bool tieneMotivoAplazamiento = solicitud.MotivoReprogramacion.HasValue && solicitud.MotivoReprogramacion.Value > 0;

        if (estadoSeleccionado == idAdjudicado && !(tieneConductor && tieneFechaPrevista && tieneHoraInicio && tieneHoraFin && tieneTiempo))
        {
            var faltantes = new List<string>();
            if (!tieneConductor) faltantes.Add("Conductor");
            if (!tieneFechaPrevista) faltantes.Add("Fecha prevista");
            if (!tieneHoraInicio) faltantes.Add("Hora de inicio");
            if (!tieneHoraFin) faltantes.Add("Hora fin");
            if (!tieneTiempo) faltantes.Add("Duración (minutos)");

            motivoError = $"No se puede cambiar el estado a '{ObtenerNombreEstado(idAdjudicado)}' porque no se cumplen los requisitos de planificación. Faltan los siguientes datos: {string.Join(", ", faltantes)}.";
            return false;
        }

        if (estadoSeleccionado == idReprogramado && !(tieneFechaPrevista && tieneMotivoAplazamiento))
        {
            var faltantes = new List<string>();
            if (!tieneFechaPrevista) faltantes.Add("Fecha prevista");
            if (!tieneMotivoAplazamiento) faltantes.Add("Motivo de reprogramación");

            motivoError = $"No se puede cambiar el estado a '{ObtenerNombreEstado(idReprogramado)}' porque se requiere indicar: {string.Join(" y ", faltantes)}.";
            return false;
        }

        if ((EsEstadoIniciado(estadoSeleccionado)
                && estadoSeleccionado != estadoInicial
                && !EsEstadoAsignado(estadoInicial ?? 0))
            || (EsEstadoFinalizado(estadoSeleccionado)
                && EsEstadoFinalizado(estadoInicial ?? 0)
                && !finalizadaDesbloqueada))
        {
            motivoError = $"No se puede seleccionar el estado '{ObtenerNombreEstado(estadoSeleccionado)}' al grabar la solicitud, ya que es un estado exclusivo de la ejecución del servicio en la aplicación móvil.";
            return false;
        }

        return true;
    }

    private string ObtenerNombreEstado(int idEstado)
    {
        return estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion ?? $"Estado {idEstado}";
    }

    private static bool TryParseCoordinate(string? value, out double coordinate)
    {
        return double.TryParse(value?.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out coordinate)
            || double.TryParse(value?.Trim(), System.Globalization.NumberStyles.Float, new System.Globalization.CultureInfo("es-ES"), out coordinate);
    }

    private static string LimitarTexto(string? texto, int longitudMaxima)
    {
        if (string.IsNullOrEmpty(texto)) return string.Empty;
        var trimmed = texto.Trim();
        return trimmed.Length <= longitudMaxima ? trimmed : trimmed[..longitudMaxima];
    }

    private async Task GuardarCoordenadasEnObraSage50Async(int? idObra, decimal lat, decimal lon)
    {
        if (!idObra.HasValue || idObra.Value <= 0) return;
        try
        {
            var obraDto = obras?.FirstOrDefault(o => o.IdObra == idObra.Value);
            var codigo = obraDto?.Codigo ?? idObra.Value.ToString("D5");
            if (string.IsNullOrWhiteSpace(codigo)) return;

            await SetupHeadersAsync();
            var res = await Http.GetAsync($"api/obrascomunsage50/{Uri.EscapeDataString(codigo)}");
            if (!res.IsSuccessStatusCode) return;

            var obraComun = await res.Content.ReadFromJsonAsync<ObraComunSage50>();
            if (obraComun != null)
            {
                var latStr = LimitarTexto(lat.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture), 10);
                var lonStr = LimitarTexto(lon.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture), 10);

                obraComun.Libre1 = latStr;
                obraComun.Libre2 = lonStr;

                await Http.PutAsJsonAsync($"api/obrascomunsage50/{Uri.EscapeDataString(codigo)}", obraComun);

                if (obraDto != null)
                {
                    obraDto.Libre1 = latStr;
                    obraDto.Libre2 = lonStr;
                }
            }
        }
        catch
        {
            // Ignorar errores no críticos de sincronización con Sage
        }
    }

