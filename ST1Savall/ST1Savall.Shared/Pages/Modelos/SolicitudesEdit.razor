    private async Task BuscarYActualizarSolicitudReprogramadaAsync(DateTime fechaAntigua, DateTime fechaNueva)
    {
        try
        {
            Solicitud? solicitudAActualizar = null;

            // 1. Buscar por ID directo si está vinculado
            if (solicitud?.IdSolicitudReprogramada.HasValue == true && solicitud.IdSolicitudReprogramada.Value > 0)
            {
                try
                {
                    solicitudAActualizar = await Http.GetFromJsonAsync<Solicitud>($"api/solicitudes/{solicitud.IdSolicitudReprogramada.Value}");
                }
                catch
                {
                    solicitudAActualizar = null;
                }
            }

            // 2. Si no se encontró por ID directo, buscar por coincidencia de cliente, obra, tarea y fecha antigua
            if (solicitudAActualizar == null && solicitud != null)
            {
                var todas = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes");
                if (todas != null)
                {
                    solicitudAActualizar = todas
                        .Where(s => s.IdSolicitud != solicitud.IdSolicitud)
                        .Where(s => s.IdCliente == solicitud.IdCliente)
                        .Where(s => string.Equals(s.NombreObra, solicitud.NombreObra, StringComparison.OrdinalIgnoreCase))
                        .Where(s => s.IdTipoTarea == solicitud.IdTipoTarea)
                        .Where(s => (s.FechaTarea.HasValue && s.FechaTarea.Value.Date == fechaAntigua.Date)
                                 || (s.FechaInicial.HasValue && s.FechaInicial.Value.Date == fechaAntigua.Date))
                        .OrderByDescending(s => s.IdSolicitud)
                        .FirstOrDefault();
                }
            }

            // 3. Si se encontró la solicitud, modificar su fecha
            if (solicitudAActualizar != null && solicitud != null)
            {
                solicitudAActualizar.FechaTarea = fechaNueva.Date;
                solicitudAActualizar.FechaInicial = fechaNueva.Date;
                solicitudAActualizar.Observaciones = GenerarObservacionesReprogramada(solicitud, solicitudAActualizar);
                if (solicitudAActualizar.FechaHoraInicioPlanificada.HasValue)
                {
                    solicitudAActualizar.FechaHoraInicioPlanificada = fechaNueva.Date + solicitudAActualizar.FechaHoraInicioPlanificada.Value.TimeOfDay;
                }
                if (solicitudAActualizar.FechaHoraFinPlanificada.HasValue)
                {
                    solicitudAActualizar.FechaHoraFinPlanificada = fechaNueva.Date + solicitudAActualizar.FechaHoraFinPlanificada.Value.TimeOfDay;
                }

                var putResponse = await Http.PutAsJsonAsync($"api/solicitudes/{solicitudAActualizar.IdSolicitud}", solicitudAActualizar);
                if (putResponse.IsSuccessStatusCode)
                {
                    solicitud.IdSolicitudReprogramada = solicitudAActualizar.IdSolicitud;
                    fechaPrevistaInicial = fechaNueva;

                    if (solicitud.IdSolicitud > 0)
                    {
                        try
                        {
                            await Http.PutAsJsonAsync($"api/solicitudes/{solicitud.IdSolicitud}", solicitud);
                        }
                        catch { }
                    }

                    mensajeExitoReprogramacion = $"Se ha modificado la fecha de la solicitud reprogramada nº {solicitudAActualizar.IdSolicitud} a {fechaNueva:dd/MM/yyyy}.";
                }
                else
                {
                    errorMessage = await ObtenerMensajeErrorAsync(putResponse, $"Error al actualizar la solicitud nº {solicitudAActualizar.IdSolicitud}");
                }
            }
            else
            {
                // Si no se encontró ninguna solicitud previa para la fecha antigua, preguntar si desea crear una nueva
                fechaNuevaParaCrear = fechaNueva;
                confirmacionCrearSolicitudReprogramadaVisible = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al buscar y actualizar la solicitud reprogramada: {ex.Message}";
        }
    }

    private string GenerarObservacionesReprogramada(Solicitud? origen, Solicitud? destino = null)
    {
        if (origen == null) return string.Empty;
        var motivoTexto = motivosList?.FirstOrDefault(m => m.IdMotivo == origen.MotivoReprogramacion)?.DescripcionMotivo;

        string textoReferencia;
        if (origen.IdSolicitud > 0)
        {
            textoReferencia = !string.IsNullOrWhiteSpace(motivoTexto)
                ? $"Proviene de la solicitud #{origen.IdSolicitud} y motivo de la anulación: {motivoTexto}"
                : $"Proviene de la solicitud #{origen.IdSolicitud}";
        }
        else
        {
            textoReferencia = !string.IsNullOrWhiteSpace(motivoTexto)
                ? $"Motivo de la anulación anterior: {motivoTexto}"
                : string.Empty;
        }

        var obsExistente = destino?.Observaciones ?? origen.Observaciones;

        if (string.IsNullOrWhiteSpace(obsExistente))
            return textoReferencia;

        // Si ya empezaba con una referencia previa de "Proviene de la solicitud #", la reemplazamos con la versión actualizada
        if (obsExistente.StartsWith("Proviene de la solicitud #"))
        {
            var saltoLinea = obsExistente.IndexOf('\n');
            if (saltoLinea >= 0)
            {
                var resto = obsExistente.Substring(saltoLinea + 1).TrimStart();
                return string.IsNullOrWhiteSpace(resto) ? textoReferencia : $"{textoReferencia}\n{resto}";
            }
            return textoReferencia;
        }

        return !string.IsNullOrWhiteSpace(textoReferencia)
            ? $"{textoReferencia}\n{obsExistente}"
            : obsExistente;
    }

    private void ActualizarEstadoPorAplazamiento()
    {
        if (solicitud == null) return;

        bool tieneFechaAnulacion = solicitud.FechaAnulacion.HasValue;
        bool tieneMotivo = solicitud.MotivoReprogramacion.HasValue && solicitud.MotivoReprogramacion.Value > 0;
        bool tieneFechaPrevista = solicitud.FechaPrevista.HasValue;

        if (tieneFechaAnulacion || (tieneFechaPrevista && tieneMotivo) || tieneMotivo)
        {
            solicitud.Estado = ObtenerEstadoAnulado();
            return;
        }

        AplicarEstadoReprogramacion();
    }

