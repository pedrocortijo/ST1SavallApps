@page "/modelos/solicitudes/edit"
@page "/modelos/solicitudes/edit/{Id:int}"
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@(Id.HasValue ? "Editar - Solicitud de Servicio" : "Nueva - Solicitud de Servicio")</PageTitle>

<UnsavedChangesGuard @ref="unsavedChangesGuard" HasUnsavedChanges="@HayCambiosPendientes" />

<DxPopup @bind-Visible="passwordFinalizadaVisible"
         HeaderText="Solicitud finalizada"
         ShowFooter="true"
         Width="460px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2">
            <p>Esta solicitud está finalizada. Introduzca la contraseña de administración configurada en Parámetros para poder modificarla.</p>
            <DxTextBox @bind-Text="passwordFinalizada"
                       Password="true"
                       NullText="Contraseña"
                       CssClass="w-100"
                       Attributes="@(new Dictionary<string, object> { { "autocomplete", "new-password" } })" />
            @if (!string.IsNullOrWhiteSpace(errorPasswordFinalizada))
            {
                <div class="text-danger small mt-2">@errorPasswordFinalizada</div>
            }
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarEdicionFinalizada" />
            <DxButton Text="Desbloquear" RenderStyle="ButtonRenderStyle.Primary" Click="ValidarPasswordFinalizadaAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="nuevoContenedorVisible"
         HeaderText="Crear contenedor"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2">
            <div class="alert alert-info py-2 small">La solicitud actual se conserva sin guardar. Al crear el contenedor, se seleccionará automáticamente en <strong>@destinoNuevoContenedorDescripcion</strong>.</div>
            @if (!string.IsNullOrWhiteSpace(errorNuevoContenedor))
            {
                <div class="alert alert-danger py-2 small">@errorNuevoContenedor</div>
            }
            <div class="mb-3"><label class="form-label">Nº de serie</label><DxTextBox @bind-Text="nuevoContenedor.NumSerie" NullText="Introduzca el número de serie" CssClass="w-100" /></div>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Tipo</label><DxComboBox Data="@tiposContenedor" TData="ContenedorTipo" TValue="int" TextFieldName="Descripcion" ValueFieldName="IdTipo" @bind-Value="nuevoContenedor.IdTipo" CssClass="w-100" NullText="Seleccione..." /></div>
                <div class="col-md-6"><label class="form-label">Planta</label><DxComboBox Data="@plantas" TData="Planta" TValue="int" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="nuevoContenedor.IdPlanta" CssClass="w-100" NullText="Seleccione..." /></div>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100"><DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarNuevoContenedor" /><DxButton Text="Crear y seleccionar" RenderStyle="ButtonRenderStyle.Primary" Click="CrearNuevoContenedorAsync" /></div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="confirmacionCambioTareaVisible"
         VisibleChanged="OnConfirmacionVisibleChanged"
         HeaderText="Contenedores afectados"
         ShowFooter="true"
         Width="500px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2">
            <p>El cambio de tipo de tarea eliminará los siguientes datos de contenedores:</p>
            <ul class="mb-0">
                @if (entrega1Afectada)
                {
                    <li>Entrega [1]: <strong>@solicitud?.CodigoEntrega</strong></li>
                }
                @if (entrega2Afectada)
                {
                    <li>Entrega [2]: <strong>@solicitud?.CodigoAmbosEntrega</strong></li>
                }
                @if (recogida1Afectada)
                {
                    <li>Recogida [1]: <strong>@solicitud?.CodigoRecogida</strong></li>
                }
                @if (recogida2Afectada)
                {
                    <li>Recogida [2]: <strong>@solicitud?.CodigoAmbosRecogida</strong></li>
                }
            </ul>
            <p class="mt-3 mb-0">Al guardar el servicio, los contenedores recuperarán el estado que les corresponda.</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-center gap-2 w-100">
            <DxButton Text="Cancelar"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="CancelarCambioTarea" />
            <DxButton Text="Continuar"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Click="ConfirmarCambioTarea" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="confirmacionEliminarPlanificacionVisible"
         HeaderText="Cambiar estado"
         ShowFooter="true"
         Width="540px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <div>
                <p class="mb-0">Existen valores en la planificación del servicio que impiden el cambio de estado. ¿Desea que elimine los valores para pasar a este estado?</p>
                @if (estadoPendienteCambio.HasValue && EsEstadoAnulado(estadoPendienteCambio.Value))
                {
                    <p class="mb-0 mt-2 small">Si se va a reprogramar el servicio, indique la próxima fecha prevista y el motivo del aplazamiento para que la solicitud aparezca después en la planificación.</p>
                }
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarCambioEstado" />
            <DxButton Text="Eliminar valores" RenderStyle="ButtonRenderStyle.Primary" Click="ConfirmarCambioEstadoYEliminarPlanificacion" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="advertenciaPlanificacionIncompletaVisible"
         HeaderText="Planificación incompleta"
         ShowFooter="true"
         Width="540px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0">Existen valores en la planificación del servicio que no se han introducido para pasar a este estado.</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => advertenciaPlanificacionIncompletaVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="advertenciaEstadoIniciadoVisible"
         HeaderText="Cambio de estado no permitido"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0">Una solicitud solo puede pasar al estado Iniciado si anteriormente estaba en estado Asignado.</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => advertenciaEstadoIniciadoVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="popupObraBloqueadaVisible"
         HeaderText="Incidencia - Obra Bloqueada"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <div>
                <p class="mb-0 fw-semibold text-danger">No se puede desmarcar la casilla Bloqueado.</p>
                <p class="mb-0 text-muted small mt-1">La solicitud/Servicio no se puede desbloquear al encontrase la obra bloqueada.</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => popupObraBloqueadaVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(errorMessage))"
         VisibleChanged="@((bool visible) => { if (!visible) errorMessage = null; })"
         HeaderText="Error"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-circle-x text-danger fs-3"></i>
            <div>
                <p class="mb-0">@errorMessage</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => errorMessage = null" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(motivoEstadoMessage))"
         VisibleChanged="@((bool visible) => { if (!visible) motivoEstadoMessage = null; })"
         HeaderText="No se puede cambiar el estado"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-circle-x text-danger fs-3"></i>
            <div>
                <p class="mb-0 fw-semibold">@motivoEstadoMessage</p>
                <p class="mb-0 small mt-2" style="opacity: 0.8;">Por favor, revise los datos antes de volver a grabar la solicitud.</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => motivoEstadoMessage = null" />
        </div>
    </FooterContentTemplate>
</DxPopup>



<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">@(Id.HasValue && Id.Value > 0 && Duplicate != true ? "Editar - Solicitud de Servicio" : "Nueva - Solicitud de Servicio")</h2>
            <p class="text-muted mb-0">Complete los datos de la solicitud del servicio</p>
        </div>
        <div class="d-flex gap-2">
            <NavLink href="/servicios/planificacion" class="btn btn-outline-primary btn-sm">
                <i class="oi oi-calendar me-1"></i> Planificación
            </NavLink>
            <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
                <i class="oi oi-arrow-left me-1"></i> Volver a Solicitudes
            </button>
        </div>
    </div>



    @if (loading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-muted mb-0">Cargando datos...</p>
        </div>
    }
    else if (solicitud != null && PuedeEditarSolicitud)
    {
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-body p-4">
                <DxFormLayout CssClass="w-100" CaptionPosition="CaptionPosition.Vertical">
                    <!-- Grupo: Obra / Cliente -->
                    <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary border-bottom pb-2 mb-3">
                        Obra / Cliente
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Nº Solicitud" ColSpanMd="2" BeginRow="true" >
                        
                        <DxSpinEdit @bind-Value="@solicitud.IdSolicitud" 
                            ShowSpinButtons="false" 
                            ReadOnly="true" 
                            Enabled="false" />

                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Fecha Solicitud" ColSpanMd="2">
                        <DxDateEdit @bind-Date="@solicitud.FechaSolicitud" />
                    </DxFormLayoutItem>
                    
                    <DxFormLayoutItem Caption="Obra" ColSpanMd="2">
                        <DxComboBox Data="@obras"
                                    TextFieldName="Codigo"
                                    ValueFieldName="IdObra"
                                    Value="@solicitud.IdCliente"
                                    ValueChanged="@((int val) => OnObraChangedAsync(val))">
                            <ItemTemplate Context="obra">
                                <span><strong>@obra.Codigo</strong> - @obra.Descripcion</span>
                            </ItemTemplate>
                        </DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Albarán planta" ColSpanMd="2">
                        <DxTextBox @bind-Text="@solicitud.AlbaranPlanta" MaxLength="20" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Serie Sage" ColSpanMd="2">
                        <DxTextBox @bind-Text="@solicitud.AlbaranSerieSage" MaxLength="2" Enabled="false" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Número Sage" ColSpanMd="2">
                        <DxTextBox @bind-Text="@solicitud.AlbaranNumeroSage" MaxLength="10" Enabled="false" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="obra-resumen small p-3 rounded border mb-2" style="background-color: rgba(128, 128, 128, 0.05);">
                                <div class="row g-3">
                                    <div class="col-md-8 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Nombre Obra:</span>
                                        <span>@(solicitud.NombreObra ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Cliente:</span>
                                        <span>@(solicitud.NombreCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-8 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Dirección Obra:</span>
                                        <span>@(solicitud.DireccionCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Población:</span>
                                        <span>@(solicitud.PoblacionCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Encargado:</span>
                                        <span>@(solicitud.Encargado ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Teléfono:</span>
                                        <span>@(solicitud.TelefonoCliente ?? "-")</span>
                                    </div>
                                    <div class="col-md-4 col-12 d-flex align-items-baseline gap-2">
                                        <span class="text-nowrap" style="opacity: 0.75;">Móvil:</span>
                                        <span>@(solicitud.Movil ?? "-")</span>
                                    </div>
                                </div>
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    <!-- Grupo 1: Datos Generales -->
                    <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary mt-4 border-bottom pb-2 mb-3" BeginRow="true">
                        Datos del Servicio
                    </DxFormLayoutItem>


                    <DxFormLayoutItem Caption="Usuario" ColSpanMd="4" BeginRow="true"> 
                        <DxComboBox Data="@usuariosList"
                                    TextFieldName="UserName"
                                    ValueFieldName="UserName"
                                    @bind-Value="@solicitud.IdOperario"
                                    Enabled="@(Id.HasValue)"
                                    ReadOnly="@(!Id.HasValue)"
                                    ClearButtonVisible="@(Id.HasValue)" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Tipo de Tarea" ColSpanMd="4">
                        <DxComboBox @key="tareaComboKey"
                                    Data="@TareasDisponibles"
                                    TextFieldName="NombreTarea"
                                    ValueFieldName="IdTarea"
                                    Value="@solicitud.IdTipoTarea"
                                    ValueChanged="@((int val) => OnTareaChanged(val))" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Conductor" ColSpanMd="4">
                        <DxComboBox Data="@GetOperariosDisponibles()"
                                    TextFieldName="Nombre"
                                    ValueFieldName="IdOperario"
                                    Value="@solicitud?.IdConductor"
                                    ValueChanged="@((int? value) => OnConductorChanged(value))"
                                    ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Estado" ColSpanMd="8" BeginRow="true">
                        @if (estadosList != null && estadosList.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-center mt-1">
                                @foreach (var est in estadosList.OrderBy(e => e.IdEstado))
                                {
                                    var id = est.IdEstado;
                                    var isChecked = solicitud?.Estado == id;
                                    var bg = !string.IsNullOrEmpty(est.BgColor) ? est.BgColor : "#f8f9fa";
                                    var text = !string.IsNullOrEmpty(est.TextColor) ? est.TextColor : "#000000";
                                    
                                    <div class="form-check form-check-inline d-flex align-items-center gap-2 px-3 py-2 rounded-3 border shadow-sm"
                                         style="cursor: pointer; background-color: @(isChecked ? bg : "var(--bs-card-bg, #ffffff)"); color: @(isChecked ? text : "inherit"); border-color: @(isChecked ? bg : "#dee2e6") !important; font-weight: @(isChecked ? "bold" : "normal"); transition: all 0.2s ease-in-out;"
                                         @onclick="() => SolicitarCambioEstado(id)">
                                        <input class="form-check-input mt-0"
                                               type="radio"
                                               name="solicitudEstadoRadioGroup"
                                               id="@($"estadoRadio_{id}")"
                                               value="@id"
                                               checked="@isChecked"
                                               @onclick="() => SolicitarCambioEstado(id)"
                                               @onclick:stopPropagation="true"
                                               style="cursor: pointer;" />
                                        <label class="form-check-label mb-0 ms-1" for="@($"estadoRadio_{id}")" style="cursor: pointer; font-size: 0.9rem;">
                                            @est.Descripcion
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Prioridad" ColSpanMd="2" CssClass="d-flex align-items-center mt-4">
                        <DxComboBox Data="@prioridadesList"                                    
                                    TextFieldName="Name"
                                    ValueFieldName="Id"                                   
                                    @bind-Value="@solicitud.Prioridad" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="2" CssClass="d-flex align-items-center mt-4">
                        <DxCheckBox Checked="@solicitud.Bloqueado"
                                    CheckedChanged="@((bool val) => OnBloqueadoChanged(val))"
                                    LabelPosition="LabelPosition.Right">Bloqueado</DxCheckBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Hora" ColSpanMd="3" Visible="false">
                        <DxTextBox @bind-Value="@solicitud.HoraLlegada" />
                    </DxFormLayoutItem>



                    <DxFormLayoutItem ColSpanMd="12" CssClass="fw-bold text-primary mt-4 border-bottom pb-2 mb-3" BeginRow="true">
                        Planificación del servicio
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Central - Origen" ColSpanMd="3" BeginRow="true">
                        <DxComboBox Data="@plantas" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="@solicitud.IdPlantaOrigen" ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Planta reciclaje" ColSpanMd="3">
                        <DxComboBox Data="@plantas" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="@solicitud.IdPlantaDescarga" ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Central - Regreso" ColSpanMd="3">
                        <DxComboBox Data="@plantas" TextFieldName="Nombre" ValueFieldName="IdPlanta" @bind-Value="@solicitud.IdPlantaRegreso" ClearButtonVisible="true" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Tiempo (minutos)" ColSpanMd="3">
                        <DxSpinEdit Value="@solicitud.DuracionPlanificadaMinutos"
                                    ValueChanged="@((int? value) => OnDuracionTotalChanged(value))"
                                    MinValue="1" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Fecha prevista" ColSpanMd="3" BeginRow="true">
                        <DxDateEdit Date="@solicitud.FechaTarea"
                                    DateChanged="@((DateTime? val) => OnFechaPlanificacionChanged(val))"
                                    DateExpression="@(() => solicitud.FechaTarea)"
                                    Format="dd/MM/yyyy"
                                    DisplayFormat="dd/MM/yyyy" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Hora Inicio" ColSpanMd="2">
                        <DxDateEdit Date="@solicitud.FechaHoraInicioPlanificada"
                                    DateChanged="@((DateTime? val) => OnInicioPlanificadoChanged(val))"
                                    DateExpression="@(() => solicitud.FechaHoraInicioPlanificada)"
                                    TimeSectionVisible="true"
                                    Format="HH:mm"
                                    DisplayFormat="HH:mm" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Hora final." ColSpanMd="2">
                        <DxDateEdit Date="@solicitud.FechaHoraFinPlanificada"
                                    DateChanged="@((DateTime? val) => OnFinPlanificadoChanged(val))"
                                    DateExpression="@(() => solicitud.FechaHoraFinPlanificada)"
                                    TimeSectionVisible="true"
                                    Format="HH:mm"
                                    DisplayFormat="HH:mm" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="2" CssClass="d-flex align-items-end pt-2">
                        <button type="button" 
                                class="btn btn-outline-primary btn-sm w-100" 
                                @onclick="ProponerSiguienteHuecoAsync">
                            <i class="oi oi-clock me-1"></i> Asignar hora
                        </button>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="3" CssClass="d-flex align-items-end pt-2">
                        <button type="button"
                                class="btn btn-outline-success btn-sm w-100"
                                disabled="@calculandoRuta"
                                @onclick="() => CalcularRutaAsync(true)">
                            @if (calculandoRuta)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="oi oi-map-marker me-1"></i>
                            }
                            Calcular ruta
                        </button>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="3" BeginRow="true" Visible = "false">
                        <DxCheckBox @bind-Checked="@solicitud.DuracionModificadaManualmente" LabelPosition="LabelPosition.Right">
                            Duración total manual
                        </DxCheckBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12">
                        @if (solicitud.DistanciaTotalMetros.HasValue)
                        {
                            <div class="small pt-2 text-center" style="color: #f59e0b;">
                                <strong>@FormatKilometros(solicitud.DistanciaTotalMetros)</strong>
                                · Origen→Obra: @solicitud.MinutosOrigenObra min
                                · Obra→Reciclaje: @solicitud.MinutosObraDescarga min
                                · Reciclaje→Central: @solicitud.MinutosDescargaRegreso min
                                @if (solicitud.DuracionOperacionMinutos.GetValueOrDefault() > 0)
                                {
                                    <span> · Operación: @solicitud.DuracionOperacionMinutos min</span>
                                }
                                <strong> · Total: @solicitud.DuracionPlanificadaMinutos min</strong>
                            </div>
                        }
                    </DxFormLayoutItem>

