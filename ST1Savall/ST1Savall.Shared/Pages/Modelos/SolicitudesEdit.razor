    }

    private async Task<bool> CalcularRutaAsync(bool mostrarMensaje)
    {
        if (solicitud == null) return false;

        SyncCoordinates();

        if (!solicitud.Latitud.HasValue || !solicitud.Longitud.HasValue)
        {
            var obraObj = obras?.FirstOrDefault(o => o.IdObra == solicitud.IdCliente);
            if (obraObj != null)
            {
                if (TryParseCoordinate(obraObj.Libre1, out var oLat) && TryParseCoordinate(obraObj.Libre2, out var oLon) && (oLat != 0 || oLon != 0))
                {
                    solicitud.Latitud = (decimal)oLat;
                    solicitud.Longitud = (decimal)oLon;
                    SyncCoordinates();
                }
                else
                {
                    await GeocodificarUbicacionObraAsync(obraObj);
                }
            }
        }

        if (!TieneDatosRutaCompletos())
        {
            errorMessage = "Seleccione la central de origen, la central de regreso e indique las coordenadas de la obra.";
            return false;
        }

        try
        {
            calculandoRuta = true;
            errorMessage = null;
            if (mostrarMensaje)
            {
                solicitud.DuracionModificadaManualmente = false;
            }
            await SetupHeadersAsync();
            var url = mostrarMensaje ? "api/solicitudes/calcular-ruta?forzarActualizacion=true" : "api/solicitudes/calcular-ruta";
            var response = await Http.PostAsJsonAsync(url, solicitud);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ObtenerMensajeErrorAsync(response, "No se pudo calcular la ruta");
                return false;
            }

            var resultado = await response.Content.ReadFromJsonAsync<CalculoRutaSolicitudResultado>();
            if (resultado?.Calculado != true || resultado.Solicitud == null)
            {
                errorMessage = resultado?.Mensaje ?? "El servicio de rutas no devolvió un cálculo válido.";
                return false;
            }

            solicitud = resultado.Solicitud;
            if (mostrarMensaje)
            {
                var origenDatos = resultado.TramosDesdeProveedor > 0
                    ? $"{resultado.TramosDesdeProveedor} tramo(s) calculados con el servicio de rutas"
                    : "todos los tramos recuperados de caché";
                planificacionMessage = $"{resultado.Mensaje} ({origenDatos}).";
            }

            return true;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo calcular la ruta: {ex.Message}";
            return false;
        }
        finally
        {
            calculandoRuta = false;
        }
    }

    private bool TieneDatosRutaCompletos() =>
        solicitud?.IdPlantaOrigen.HasValue == true &&
        solicitud.IdPlantaRegreso.HasValue &&
        solicitud.Latitud.HasValue &&
        solicitud.Longitud.HasValue;

