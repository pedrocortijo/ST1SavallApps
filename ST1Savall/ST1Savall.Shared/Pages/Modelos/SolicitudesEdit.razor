            || EsContenedorActual(c, solicitud?.CodigoAmbosEntrega)
            || (IdPlantaOrigen.HasValue
                && c.IdPlanta == IdPlantaOrigen.Value
                && string.Equals(c.EstadoFisico, "Disponible", StringComparison.OrdinalIgnoreCase)
