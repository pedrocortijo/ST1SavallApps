    private async Task AnalizarTiquePesajeAsync(string nombreArchivo, string? contentType, byte[] contenido)
    {
        if (solicitud?.IdSolicitud <= 0)
        {
            errorMessage = "Guarde primero la solicitud para poder escanear el tique.";
            return;
        }

        try
        {
            procesandoTique = true;
            var ocr = await FormFactor.RecognizeTextAsync(contenido);
            var response = await Http.PostAsJsonAsync(
                $"api/solicitudes/{solicitud.IdSolicitud}/tique-pesaje/analizar",
                new AnalizarTiquePesajeRequest
                {
                    NombreArchivo = nombreArchivo,
                    ContentType = contentType,
                    ImagenBase64 = $"data:{contentType ?? "image/jpeg"};base64,{Convert.ToBase64String(contenido)}",
                    TextoOcr = ocr.Text,
                    ConfianzaOcr = ocr.Confidence
                });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ObtenerMensajeErrorAsync(response, "No se ha podido analizar el tique.");
                return;
            }

            tiqueAnalisis = await response.Content.ReadFromJsonAsync<TiquePesajeAnalisisResponse>();
            if (tiqueAnalisis is null)
            {
                errorMessage = "El reconocimiento local no ha devuelto datos para revisar.";
                return;
            }
            revisionTiqueVisible = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido analizar el tique: {ex.Message}";
        }
        finally
        {
            procesandoTique = false;
        }
    }

    private async Task ConfirmarTiquePesajeAsync()
    {
        if (solicitud?.IdSolicitud <= 0 || tiqueAnalisis is null) return;
        try
        {
            procesandoTique = true;
            var response = await Http.PostAsJsonAsync(
                $"api/solicitudes/{solicitud.IdSolicitud}/tique-pesaje/{tiqueAnalisis.IdTiquePesaje}/confirmar",
                new ConfirmarTiquePesajeRequest
                {
                    NumeroAlbaran = tiqueAnalisis.NumeroAlbaran,
                    Matricula = tiqueAnalisis.Matricula,
                    Fecha = tiqueAnalisis.Fecha,
                    Hora = tiqueAnalisis.Hora,
                    PesoNetoKg = tiqueAnalisis.PesoNetoKg
                });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ObtenerMensajeErrorAsync(response, "No se ha podido confirmar el tique.");
                return;
            }

            var confirmado = await response.Content.ReadFromJsonAsync<TiquePesajeAnalisisResponse>();
            if (confirmado is null)
            {
                errorMessage = "El servidor no ha devuelto los datos confirmados.";
                return;
            }

            solicitud.AlbaranPlanta = confirmado.NumeroAlbaran;
            solicitud.FechaPesaje = confirmado.Fecha;
            solicitud.HoraPesaje = confirmado.Hora;
            solicitud.KgAlbaran = confirmado.PesoNetoKg;
            revisionTiqueVisible = false;
            tiqueAnalisis = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido confirmar el tique: {ex.Message}";
        }
        finally
        {
            procesandoTique = false;
        }
    }

