    private static bool EsConductor(Operario o)
    {
        if (o == null) return false;
        if (o.IdCargo.HasValue && o.IdCargo == 1) return true;
        if (o.Cargo != null && !string.IsNullOrWhiteSpace(o.Cargo.Descripcion))
        {
            return string.Equals(o.Cargo.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase)
                || o.Cargo.Descripcion.Contains("conductor", StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    private void OnConductorChanged(int? idConductor)
    {
        if (solicitud == null) return;

        solicitud.IdConductor = idConductor;
        var operarioConductor = operarios?.FirstOrDefault(o => o.IdOperario == idConductor);
        var idPlanta = operarioConductor?.IdPlanta;

        // La planta del conductor se propone como origen, reciclaje y regreso.
        solicitud.IdPlantaOrigen = idPlanta;
        solicitud.IdPlantaDescarga = idPlanta;
        solicitud.IdPlantaRegreso = idPlanta;

        AplicarEstadoReprogramacion();
    }

