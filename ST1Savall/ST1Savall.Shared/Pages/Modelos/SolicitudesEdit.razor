    private async Task GuardarFotoAsync(string nombreArchivo, string? contentType, byte[] contenido)
    {
        if (solicitud?.IdSolicitud <= 0) return;
        var response = await Http.PostAsJsonAsync($"api/solicitudes/{solicitud.IdSolicitud}/fotos", new
        {
            NombreArchivo = $"{FaseFotoActual}_{nombreArchivo}",
            ImagenBase64 = $"data:{contentType ?? "image/jpeg"};base64,{Convert.ToBase64String(contenido)}"
        });
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(await ObtenerMensajeErrorAsync(response, "No se ha podido guardar la foto."));
        await CargarFotosAsync();
    }

    private async Task CargarFotosAsync()
    {
        if (solicitud?.IdSolicitud <= 0) return;
        fotos = await Http.GetFromJsonAsync<List<SolicitudFoto>>($"api/solicitudes/{solicitud.IdSolicitud}/fotos") ?? [];
        fotosDataUri.Clear();
        foreach (var foto in fotos)
        {
            try
            {
                var contenido = await Http.GetByteArrayAsync($"api/solicitudes/{solicitud.IdSolicitud}/fotos/{foto.Id}/miniatura");
                fotosDataUri[foto.Id] = $"data:image/jpeg;base64,{Convert.ToBase64String(contenido)}";
            }
            catch { }
        }
    }

    private async Task EliminarFotoAsync(int idFoto)
    {
        if (solicitud?.IdSolicitud <= 0) return;
        var response = await Http.DeleteAsync($"api/solicitudes/{solicitud.IdSolicitud}/fotos/{idFoto}");
        if (response.IsSuccessStatusCode)
        {
            fotos.RemoveAll(foto => foto.Id == idFoto);
            fotosDataUri.Remove(idFoto);
        }
        else errorMessage = await ObtenerMensajeErrorAsync(response, "No se ha podido eliminar la foto.");
    }

    private async Task AbrirFotoOriginalAsync(int idFoto)
    {
        if (solicitud?.IdSolicitud <= 0) return;
        try
        {
            if (!esAplicacionNativa)
            {
                var url = new Uri(Http.BaseAddress!, $"api/solicitudes/{solicitud.IdSolicitud}/fotos/{idFoto}").AbsoluteUri;
                if (!await JSRuntime.InvokeAsync<bool>("openPhotoWithLoading", url))
                    errorMessage = "El navegador ha bloqueado la apertura de la foto.";
                return;
            }

            fotoCargando = true;
            fotoSeleccionadaDataUri = null;
            await InvokeAsync(StateHasChanged);
            var contenido = await Http.GetByteArrayAsync($"api/solicitudes/{solicitud.IdSolicitud}/fotos/{idFoto}");
            fotoSeleccionadaDataUri = $"data:image/jpeg;base64,{Convert.ToBase64String(contenido)}";
        }
        catch (Exception ex) { errorMessage = $"No se ha podido abrir la foto: {ex.Message}"; }
        finally { fotoCargando = false; }
    }

