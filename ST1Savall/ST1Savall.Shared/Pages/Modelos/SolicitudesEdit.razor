    private bool EsEstadoAnulado(int idEstado)
    {
        if (idEstado == ObtenerEstadoAnulado()) return true;

        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        return descripcion?.Contains("anulad", StringComparison.OrdinalIgnoreCase) == true;
