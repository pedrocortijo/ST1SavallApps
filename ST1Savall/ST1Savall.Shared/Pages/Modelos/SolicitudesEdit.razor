    // DxComboBox devuelve null al pulsar el botón de limpiar. Se asigna de forma
    // explícita al modelo para que el valor anterior no reaparezca al cerrar la lista.
    private void CambiarEntrega1(string? valor) => AsignarContenedor(valor, (s, v) => s.CodigoEntrega = v);
    private void CambiarEntrega2(string? valor) => AsignarContenedor(valor, (s, v) => s.CodigoAmbosEntrega = v);
    private void CambiarRecogida1(string? valor) => AsignarContenedor(valor, (s, v) => s.CodigoRecogida = v);
    private void CambiarRecogida2(string? valor) => AsignarContenedor(valor, (s, v) => s.CodigoAmbosRecogida = v);

    private void AsignarContenedor(string? valor, Action<Solicitud, string?> asignar)
    {
        if (solicitud is null) return;
        if (string.IsNullOrWhiteSpace(valor))
        {
            asignar(solicitud, null);
            return;
        }

        // El texto libre solo se admite si corresponde a un contenedor existente.
        // Así se puede borrar con teclado sin guardar números de serie no válidos.
        if (contenedoresList?.Any(c => string.Equals(c.NumSerie, valor, StringComparison.OrdinalIgnoreCase)) == true)
            asignar(solicitud, valor);
    }

    private void LimpiarEntrega1() => LimpiarContenedor((s, v) => s.CodigoEntrega = v);
    private void LimpiarEntrega2() => LimpiarContenedor((s, v) => s.CodigoAmbosEntrega = v);
    private void LimpiarRecogida1() => LimpiarContenedor((s, v) => s.CodigoRecogida = v);
    private void LimpiarRecogida2() => LimpiarContenedor((s, v) => s.CodigoAmbosRecogida = v);

    private void LimpiarContenedor(Action<Solicitud, string?> asignar)
    {
        if (solicitud is null) return;
        asignar(solicitud, null);
        selectorContenedorVersion++;
    }

    private List<Contenedor> contenedoresRecogida => contenedoresList?
        .Where(c => !EstaSeleccionadoParaEntrega(c)
            && (EsContenedorActual(c, solicitud?.CodigoRecogida)
            || EsContenedorActual(c, solicitud?.CodigoAmbosRecogida)
            || EstaEntregadoEnObraSeleccionada(c)
            || EstaEntregadoDePlantaSinObra(c)))
        .OrderBy(c => c.NumSerie)
        .ToList() ?? new List<Contenedor>();

    private static bool EsContenedorActual(Contenedor contenedor, string? codigoSeleccionado) =>
        !string.IsNullOrWhiteSpace(codigoSeleccionado)
        && string.Equals(contenedor.NumSerie, codigoSeleccionado, StringComparison.OrdinalIgnoreCase);

    private bool EstaSeleccionadoParaEntrega(Contenedor contenedor) =>
        EsContenedorActual(contenedor, solicitud?.CodigoEntrega)
        || EsContenedorActual(contenedor, solicitud?.CodigoAmbosEntrega);

    private bool EstaSeleccionadoParaRetirada(Contenedor contenedor) =>
        EsContenedorActual(contenedor, solicitud?.CodigoRecogida)
        || EsContenedorActual(contenedor, solicitud?.CodigoAmbosRecogida);

    private bool EstaEntregadoEnObraSeleccionada(Contenedor contenedor)
    {
        var entrega = UltimaEntregaVigente(contenedor.NumSerie);
        if (entrega == null) return false;

        if (solicitud?.IdCliente > 0 && entrega.IdCliente == solicitud.IdCliente)
            return true;

        if (!string.IsNullOrWhiteSpace(solicitud?.NombreObra) &&
            string.Equals(entrega.NombreObra?.Trim(), solicitud.NombreObra.Trim(), StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private bool EstaEntregadoDePlantaSinObra(Contenedor c)
    {
        var idPlanta = IdPlantaOrigen 
            ?? solicitud?.IdPlantaDescarga 
            ?? operarios?.FirstOrDefault(o => o.IdOperario == solicitud?.IdConductor)?.IdPlanta
            ?? (plantas?.Count == 1 ? plantas[0].IdPlanta : (int?)null);

        if (!idPlanta.HasValue || c.IdPlanta != idPlanta.Value)
            return false;

        bool estaEntregado = string.Equals(c.EstadoFisico, "Entregado", StringComparison.OrdinalIgnoreCase)
                             || EstaEntregadoActualmente(c.NumSerie);

        if (!estaEntregado)
            return false;

        var entrega = UltimaEntregaVigente(c.NumSerie);
        bool tieneObra = entrega != null && (entrega.IdCliente > 0 || !string.IsNullOrWhiteSpace(entrega.NombreObra));

        return !tieneObra;
    }

    private bool EstaEntregadoActualmente(string numeroSerie) => UltimaEntregaVigente(numeroSerie) is not null;

    private Solicitud? UltimaEntregaVigente(string numeroSerie)
    {
        var ultimoMovimiento = solicitudesConContenedores?
            .Where(s => CoincideNumeroSerie(s, numeroSerie))
            .OrderBy(s => s.FechaTarea ?? s.FechaSolicitud ?? DateTime.MinValue)
            .ThenBy(s => s.IdSolicitud)
            .LastOrDefault();

        return ultimoMovimiento is not null && EsEntrega(ultimoMovimiento, numeroSerie) ? ultimoMovimiento : null;
    }

    private static bool CoincideNumeroSerie(Solicitud solicitud, string numeroSerie) =>
        EsEntrega(solicitud, numeroSerie) || EsRetirada(solicitud, numeroSerie);

    private static bool EsEntrega(Solicitud solicitud, string numeroSerie) =>
        string.Equals(solicitud.CodigoEntrega, numeroSerie, StringComparison.OrdinalIgnoreCase)
        || string.Equals(solicitud.CodigoAmbosEntrega, numeroSerie, StringComparison.OrdinalIgnoreCase);

    private static bool EsRetirada(Solicitud solicitud, string numeroSerie) =>
        string.Equals(solicitud.CodigoRecogida, numeroSerie, StringComparison.OrdinalIgnoreCase)
        || string.Equals(solicitud.CodigoAmbosRecogida, numeroSerie, StringComparison.OrdinalIgnoreCase);

    private Tarea? TareaSeleccionada => tareasList?
        .FirstOrDefault(t => t.IdTarea == solicitud?.IdTipoTarea);

    private IEnumerable<Tarea> TareasDisponibles => tareasList?.Where(PuedeSeleccionarTarea)
        ?? Enumerable.Empty<Tarea>();

    private bool TieneContenedoresEnObra => solicitud?.IdCliente > 0
        && (solicitudesConContenedores?.Any(s => s.IdCliente == solicitud.IdCliente) == true
            || contenedoresList?.Any(EstaEntregadoEnObraSeleccionada) == true);

    private bool TieneContenedoresDisponiblesParaRecogida =>
        TieneContenedoresEnObra || (contenedoresList?.Any(EstaEntregadoDePlantaSinObra) == true);

    private bool PuedeSeleccionarTarea(Tarea tarea) =>
        !RequiereContenedorExistente(tarea) || TieneContenedoresDisponiblesParaRecogida;

    private static bool RequiereContenedorExistente(Tarea tarea) =>
        tarea.Recoger1 || tarea.Recoger2;

    private bool IsEntregaEnabled => TareaSeleccionada?.Entrega1 == true;
    private bool IsEntrega2Enabled => TareaSeleccionada?.Entrega2 == true;
    private bool IsRecogidaEnabled => TareaSeleccionada?.Recoger1 == true;
    private bool IsRecogida2Enabled => TareaSeleccionada?.Recoger2 == true;
    private bool RequiereTipoResiduo => TareaSeleccionada?.Recoger1 == true || TareaSeleccionada?.Recoger2 == true;

    private void OnTareaChanged(int val)
    {
        if (solicitud == null) return;
        if (solicitud.IdTipoTarea == val) return;

        var nuevaTarea = tareasList?.FirstOrDefault(t => t.IdTarea == val);
        if (nuevaTarea is not null && !PuedeSeleccionarTarea(nuevaTarea))
        {
            errorMessage = "No se puede seleccionar esta tarea porque incluye una retirada y la obra no tiene contenedores asignados.";
            return;
        }

        var seAfectaEntrega1 = !string.IsNullOrWhiteSpace(solicitud.CodigoEntrega) && nuevaTarea?.Entrega1 != true;
        var seAfectaEntrega2 = !string.IsNullOrWhiteSpace(solicitud.CodigoAmbosEntrega) && nuevaTarea?.Entrega2 != true;
        var seAfectaRecogida1 = !string.IsNullOrWhiteSpace(solicitud.CodigoRecogida) && nuevaTarea?.Recoger1 != true;
        var seAfectaRecogida2 = !string.IsNullOrWhiteSpace(solicitud.CodigoAmbosRecogida) && nuevaTarea?.Recoger2 != true;

        if (seAfectaEntrega1 || seAfectaEntrega2 || seAfectaRecogida1 || seAfectaRecogida2)
        {
            tareaAnterior = solicitud.IdTipoTarea;
            codigoEntregaPrevio = solicitud.CodigoEntrega;
            codigoAmbosEntregaPrevio = solicitud.CodigoAmbosEntrega;
            codigoRecogidaPrevio = solicitud.CodigoRecogida;
            codigoAmbosRecogidaPrevio = solicitud.CodigoAmbosRecogida;

            tipoTareaPendiente = val;
            entrega1Afectada = seAfectaEntrega1;
            entrega2Afectada = seAfectaEntrega2;
            recogida1Afectada = seAfectaRecogida1;
            recogida2Afectada = seAfectaRecogida2;
            confirmacionCambioTareaVisible = true;
            return;
        }

        AplicarCambioTarea(val);
    }
    private void ConfirmarCambioTarea()
    {
        if (tipoTareaPendiente.HasValue)
        {
            AplicarCambioTarea(tipoTareaPendiente.Value);
        }

        LimpiarCambioTareaPendiente();
    }

    private void CancelarCambioTarea()
    {
        if (tareaAnterior.HasValue && solicitud != null)
        {
            solicitud.IdTipoTarea = tareaAnterior.Value;
            solicitud.CodigoEntrega = codigoEntregaPrevio;
            solicitud.CodigoAmbosEntrega = codigoAmbosEntregaPrevio;
            solicitud.CodigoRecogida = codigoRecogidaPrevio;
            solicitud.CodigoAmbosRecogida = codigoAmbosRecogidaPrevio;
        }

        tareaComboKey++;
        LimpiarCambioTareaPendiente();
        StateHasChanged();
    }

    private void OnConfirmacionVisibleChanged(bool visible)
    {
        confirmacionCambioTareaVisible = visible;
        if (!visible && tipoTareaPendiente.HasValue)
        {
            CancelarCambioTarea();
        }
    }

    private void AplicarCambioTarea(int tipoTarea)
    {
        if (solicitud == null) return;

        solicitud.IdTipoTarea = tipoTarea;

        var tarea = tareasList?.FirstOrDefault(t => t.IdTarea == tipoTarea);

        if (tarea?.Entrega1 != true)
            solicitud.CodigoEntrega = null;

        if (tarea?.Recoger1 != true)
            solicitud.CodigoRecogida = null;

        if (tarea?.Entrega2 != true)
            solicitud.CodigoAmbosEntrega = null;

        if (tarea?.Recoger2 != true)
            solicitud.CodigoAmbosRecogida = null;

    }

    private void LimpiarCambioTareaPendiente()
    {
        confirmacionCambioTareaVisible = false;
        tipoTareaPendiente = null;
        tareaAnterior = null;
        codigoEntregaPrevio = null;
        codigoAmbosEntregaPrevio = null;
        codigoRecogidaPrevio = null;
        codigoAmbosRecogidaPrevio = null;
        entrega1Afectada = false;
        entrega2Afectada = false;
        recogida1Afectada = false;
        recogida2Afectada = false;
    }

