    private static string FormatKilometros(int? metros) => $"{metros.GetValueOrDefault() / 1000d:0.0} km";

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }

    private static async Task<string> ObtenerMensajeErrorAsync(HttpResponseMessage response, string mensajeBase)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(contenido))
            return $"{mensajeBase}: {response.ReasonPhrase ?? $"HTTP {(int)response.StatusCode}"}";

        try
        {
            var apiError = System.Text.Json.JsonSerializer.Deserialize<ApiError>(contenido,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (!string.IsNullOrWhiteSpace(apiError?.Message))
                return apiError.Message;
        }
        catch (System.Text.Json.JsonException)
        {
            // Algunas respuestas de infraestructura devuelven texto plano en lugar de JSON.
        }

        return $"{mensajeBase}: {contenido}";
    }



    private async Task VerCoordenadasEnMapa()
    {
        if (solicitud == null) return;

        if (HayCambiosPendientes)
        {
            if (!await GuardarInternamenteAsync())
            {
                return;
            }
        }

        SyncCoordinates();

        double? lat = null;
        double? lon = null;
        if (solicitud.Latitud.HasValue && solicitud.Longitud.HasValue && (solicitud.Latitud.Value != 0 || solicitud.Longitud.Value != 0))
        {
            lat = (double)solicitud.Latitud.Value;
            lon = (double)solicitud.Longitud.Value;
        }
        else if (!string.IsNullOrWhiteSpace(solicitud.CoordenadasGPS))
        {
            var parts = solicitud.CoordenadasGPS.Split(',');
            if (parts.Length == 2 && 
                double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedLat) && 
                double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedLon) &&
                (parsedLat != 0 || parsedLon != 0))
            {
                lat = parsedLat;
                lon = parsedLon;
            }
        }

        var obraObj = obras?.FirstOrDefault(o => o.IdObra == solicitud.IdCliente);

        // Si no hay coordenadas en la solicitud, comprobar si la obra las tiene en Sage 50
        if ((!lat.HasValue || !lon.HasValue) && obraObj != null)
        {
            if (TryParseCoordinate(obraObj.Libre1, out var oLat) && TryParseCoordinate(obraObj.Libre2, out var oLon) && (oLat != 0 || oLon != 0))
            {
                solicitud.Latitud = (decimal)oLat;
                solicitud.Longitud = (decimal)oLon;
                SyncCoordinates();
                lat = oLat;
                lon = oLon;
            }
        }

        // Si sigue sin haber coordenadas, buscar según la dirección de la obra mediante geocodificación
        if (!lat.HasValue || !lon.HasValue)
        {
            if (obraObj != null)
            {
                if (await GeocodificarUbicacionObraAsync(obraObj))
                {
                    lat = (double?)solicitud.Latitud;
                    lon = (double?)solicitud.Longitud;
                }
            }
            else
            {
                var addressToSearch = ST1Savall.MapHelper.BuildNormalizedQuery(solicitud.DireccionCliente, solicitud.PoblacionCliente, null, null);
                if (!string.IsNullOrWhiteSpace(addressToSearch))
                {
                    try
                    {
                        var searchQuery = (addressToSearch + ", España").Replace("'", "\\'");
                        var jsScript = @"
                            (async () => {
                                try {
                                    const fullQuery = '" + searchQuery + @"';
                                    let res = await fetch('https://nominatim.openstreetmap.org/search?format=json&countrycodes=es&q=' + encodeURIComponent(fullQuery) + '&limit=1');
                                    if (res.ok) {
                                        let data = await res.json();
                                        if (data && data.length > 0) {
                                            return { latitud: parseFloat(data[0].lat), longitud: parseFloat(data[0].lon) };
                                        }
                                    }
                                    let parts = fullQuery.split(',').map(p => p.trim()).filter(Boolean);
                                    let fallbackQuery = parts.length > 1 ? parts.slice(-2).join(', ') : fullQuery;
                                    res = await fetch('https://nominatim.openstreetmap.org/search?format=json&countrycodes=es&q=' + encodeURIComponent(fallbackQuery) + '&limit=1');
                                    if (res.ok) {
                                        let data = await res.json();
                                        if (data && data.length > 0) {
                                            return { latitud: parseFloat(data[0].lat), longitud: parseFloat(data[0].lon) };
                                        }
                                    }
                                } catch (e) {}
                                return null;
                            })()
                        ";
                        var geocodeResult = await JSRuntime.InvokeAsync<GpsPosition>("eval", jsScript);
                        if (geocodeResult != null && (geocodeResult.Latitud != 0 || geocodeResult.Longitud != 0))
                        {
                            solicitud.Latitud = (decimal)geocodeResult.Latitud;
                            solicitud.Longitud = (decimal)geocodeResult.Longitud;
                            SyncCoordinates();
                            lat = geocodeResult.Latitud;
                            lon = geocodeResult.Longitud;
                            if (solicitud.IdCliente > 0)
                            {
                                await GuardarCoordenadasEnObraSage50Async(solicitud.IdCliente, (decimal)geocodeResult.Latitud, (decimal)geocodeResult.Longitud);
                            }
                        }
                    }
                    catch { }
                }
            }
        }

        var address = obraObj != null 
            ? ST1Savall.MapHelper.BuildNormalizedQuery(obraObj.Ubicacion, obraObj.Poblacion, obraObj.Provincia, obraObj.CodigoPostal)
            : ST1Savall.MapHelper.BuildNormalizedQuery(solicitud.DireccionCliente, solicitud.PoblacionCliente, null, null);

        if (string.IsNullOrEmpty(address))
        {
            address = solicitud.NombreObra ?? "Ubicación de Solicitud";
        }

        var backUrl = solicitud.IdSolicitud > 0
            ? $"/modelos/solicitudes/edit/{solicitud.IdSolicitud}"
            : "/modelos/solicitudes";

        var serie = solicitud.CodigoEntrega ?? solicitud.CodigoRecogida ?? string.Empty;
        var obraName = solicitud.NombreObra ?? obraObj?.Descripcion ?? "Ubicación de Solicitud";
        var tipo = "Ubicación de Solicitud";

        if (!string.IsNullOrEmpty(serie))
        {
            var cont = contenedoresList?.FirstOrDefault(c => c.NumSerie == serie);
            if (cont != null)
            {
                tipo = tiposContenedor?.FirstOrDefault(t => string.Equals(t.Codigo, cont.CodigoArticulo, StringComparison.OrdinalIgnoreCase))?.Descripcion ?? "Contenedor";
            }
        }

        var latParam = lat.HasValue ? $"&lat={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : "";
        var lonParam = lon.HasValue ? $"&lon={lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : "";
        var serieParam = !string.IsNullOrEmpty(serie) ? $"&serie={Uri.EscapeDataString(serie)}" : "";
        var obraParam = $"&obra={Uri.EscapeDataString(obraName)}";

        var mapsUrl = $"/modelos/contenedores/mapa?address={Uri.EscapeDataString(address)}&title={Uri.EscapeDataString(tipo)}{serieParam}{obraParam}{latParam}{lonParam}&backUrl={Uri.EscapeDataString(backUrl)}";
        NavigationManager.NavigateTo(mapsUrl);
    }

    private void OnCoordenadasGPSTextChanged(string val)
    {
        if (solicitud == null) return;
        solicitud.CoordenadasGPS = val;

        if (!string.IsNullOrWhiteSpace(val))
        {
            var cleanCoords = val.Replace(" ", "").Replace(";", ",");
            var parts = cleanCoords.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                if (decimal.TryParse(parts[0].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lat) &&
                    decimal.TryParse(parts[1].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lon))
                {
                    solicitud.Latitud = lat;
                    solicitud.Longitud = lon;
                }
            }
        }
    }

    private void SyncCoordinates()
    {
        if (solicitud == null) return;

        // Prioritize Latitud and Longitud if they have values to keep CoordenadasGPS string updated
        if (solicitud.Latitud.HasValue && solicitud.Longitud.HasValue)
        {
            solicitud.LatitudObra = solicitud.Latitud;
            solicitud.LongitudObra = solicitud.Longitud;
            solicitud.CoordenadasGPS = $"{solicitud.Latitud.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)},{solicitud.Longitud.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)}";
        }
        // If they are null/not set but CoordenadasGPS has a value, parse it to populate Latitud and Longitud
        else if (!string.IsNullOrWhiteSpace(solicitud.CoordenadasGPS))
        {
            var cleanCoords = solicitud.CoordenadasGPS.Replace(" ", "").Replace(";", ",");
            var parts = cleanCoords.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                if (decimal.TryParse(parts[0].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lat) &&
                    decimal.TryParse(parts[1].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lon))
                {
                    solicitud.Latitud = lat;
                    solicitud.Longitud = lon;
                    solicitud.LatitudObra = lat;
                    solicitud.LongitudObra = lon;
                }
            }
        }
        else
        {
            solicitud.CoordenadasGPS = null;
            solicitud.LatitudObra = null;
            solicitud.LongitudObra = null;
        }
    }

    private async Task ObtenerUbicacionActualAsync()
    {
        try
        {
            var posicion = await JSRuntime.InvokeAsync<GpsPosition>("eval", @"
                new Promise((resolve, reject) => {
                    if (!navigator.geolocation) {
                        reject('Geolocalización no soportada');
                    } else {
                        navigator.geolocation.getCurrentPosition(
                            (pos) => resolve({ latitud: pos.coords.latitude, longitud: pos.coords.longitude }),
                            (err) => reject('Error al obtener ubicación: ' + err.message),
                            { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
                        );
                    }
                })
            ");

            if (posicion != null && solicitud != null)
            {
                solicitud.Latitud = (decimal)posicion.Latitud;
                solicitud.Longitud = (decimal)posicion.Longitud;
                SyncCoordinates();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo obtener la ubicación: {ex.Message}";
        }
    }

