    private async Task OnFechaPrevistaChanged(DateTime? val)
    {
        if (solicitud == null) return;
        var fechaPrevia = solicitud.FechaPrevista;
        solicitud.FechaPrevista = val;
        ActualizarEstadoPorAplazamiento();

        if (!val.HasValue) return;

        // Caso 1: Si la próxima fecha estaba en blanco al cargar la solicitud
        if (!fechaPrevistaInicial.HasValue)
        {
            if (!solicitud.IdSolicitudReprogramada.HasValue)
            {
                fechaNuevaParaCrear = val.Value;
                confirmacionCrearSolicitudReprogramadaVisible = true;
            }
            else
            {
                await BuscarYActualizarSolicitudReprogramadaAsync(fechaPrevia ?? val.Value, val.Value);
            }
        }
        // Caso 2: Si la próxima fecha ya tenía un valor asignado previamente y se modifica
        else if (val.Value.Date != fechaPrevistaInicial.Value.Date)
        {
            await BuscarYActualizarSolicitudReprogramadaAsync(fechaPrevistaInicial.Value, val.Value);
        }
    }

