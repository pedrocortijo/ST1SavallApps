    private void SolicitarCambioEstado(int nuevoEstado)
    {
        if (solicitud == null || solicitud.Estado == nuevoEstado) return;

        if (EsEstadoIniciado(nuevoEstado) && !EsEstadoAsignado(solicitud.Estado))
        {
            advertenciaEstadoIniciadoVisible = true;
            return;
        }

        if (EsEstadoAsignado(nuevoEstado) && !TienePlanificacionCompletaParaAsignar())
        {
            advertenciaPlanificacionIncompletaVisible = true;
            return;
        }

        if ((EsEstadoPendiente(nuevoEstado) || EsEstadoAnulado(nuevoEstado)) && TieneValoresPlanificacion())
        {
            estadoPendienteCambio = nuevoEstado;
            confirmacionEliminarPlanificacionVisible = true;
            return;
        }

        if (EsEstadoAsignado(solicitud.Estado)
            && !EsEstadoAsignado(nuevoEstado)
            && !EsEstadoIniciado(nuevoEstado)
            && TieneValoresPlanificacion())
        {
            estadoPendienteCambio = nuevoEstado;
            confirmacionEliminarPlanificacionVisible = true;
            return;
        }

        solicitud.Estado = nuevoEstado;
    }

    private bool EsEstadoAsignado(int idEstado)
    {
        var idConfigurado = parametrosList?.FirstOrDefault()?.EstadoAdjudicado;
        if (idConfigurado == idEstado) return true;

        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        return descripcion?.Contains("asignad", StringComparison.OrdinalIgnoreCase) == true
            || descripcion?.Contains("adjudicad", StringComparison.OrdinalIgnoreCase) == true;
    }

    private bool EsEstadoIniciado(int idEstado)
    {
        var idConfigurado = parametrosList?.FirstOrDefault()?.EstadoIniciado;
        if (idConfigurado == idEstado) return true;

        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        return descripcion?.Contains("iniciado", StringComparison.OrdinalIgnoreCase) == true;
    }

    private bool EsEstadoFinalizado(int idEstado)
    {
        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        if (descripcion?.Contains("finalizado", StringComparison.OrdinalIgnoreCase) == true) return true;
        if (descripcion?.Contains("anulad", StringComparison.OrdinalIgnoreCase) == true) return false;

        return parametrosList?.FirstOrDefault()?.EstadoFinalizado == idEstado;
    }

    private bool EsEstadoPendiente(int idEstado)
    {
        var idConfigurado = parametrosList?.FirstOrDefault()?.EstadoPendiente;
        if (idConfigurado == idEstado) return true;

        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        return descripcion?.Contains("pendiente", StringComparison.OrdinalIgnoreCase) == true;
    }

    private bool EsEstadoAnulado(int idEstado)
    {
        if (idEstado == ObtenerEstadoAnulado()) return true;

        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        return descripcion?.Contains("anulad", StringComparison.OrdinalIgnoreCase) == true;
    }

    private int ObtenerEstadoAnulado()
    {
        var parametro = parametrosList?.FirstOrDefault();
        if (parametro?.EstadoReprogramacion is > 0) return parametro.EstadoReprogramacion.Value;

        return estadosList?.FirstOrDefault(e =>
                   e.Descripcion.Contains("anulad", StringComparison.OrdinalIgnoreCase)
                   || e.Descripcion.Contains("reprogram", StringComparison.OrdinalIgnoreCase))?.IdEstado
               ?? 6;
    }

    private bool TieneValoresPlanificacion() =>
        solicitud?.IdConductor.HasValue == true ||
        solicitud?.IdPlantaOrigen.HasValue == true ||
        solicitud?.IdPlantaDescarga.HasValue == true ||
        solicitud?.IdPlantaRegreso.HasValue == true ||
        solicitud?.DuracionPlanificadaMinutos.HasValue == true ||
        solicitud?.FechaPrevista.HasValue == true ||
        solicitud?.FechaTarea.HasValue == true ||
        solicitud?.FechaHoraInicioPlanificada.HasValue == true ||
        solicitud?.FechaHoraFinPlanificada.HasValue == true;

    private bool TienePlanificacionCompletaParaAsignar() =>
        solicitud?.IdConductor is > 0 &&
        solicitud?.IdPlantaOrigen.HasValue == true &&
        solicitud?.IdPlantaDescarga.HasValue == true &&
        solicitud?.IdPlantaRegreso.HasValue == true &&
        solicitud?.DuracionPlanificadaMinutos is > 0 &&
        (solicitud?.FechaTarea.HasValue == true || solicitud?.FechaPrevista.HasValue == true) &&
        solicitud?.FechaHoraInicioPlanificada.HasValue == true &&
        solicitud?.FechaHoraFinPlanificada.HasValue == true;

