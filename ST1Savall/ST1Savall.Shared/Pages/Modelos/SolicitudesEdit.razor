    private async Task ProponerSiguienteHuecoAsync()
    {
        if (solicitud?.IdConductor == null)
        {
            planificacionMessage = "Seleccione primero un conductor.";
            return;
        }

        var conductor = operarios?.FirstOrDefault(o => o.IdOperario == solicitud.IdConductor.Value);
        var inicioShift = conductor != null && conductor.InicioJornada != TimeSpan.Zero ? conductor.InicioJornada : new TimeSpan(8, 0, 0);

        DateTime baseDate = solicitud.FechaTarea?.Date 
            ?? solicitud.FechaHoraInicioPlanificada?.Date 
            ?? DateTime.Today;

        TimeSpan baseTime = solicitud.FechaHoraInicioPlanificada?.TimeOfDay ?? inicioShift;
        if (baseTime < inicioShift) baseTime = inicioShift;
        DateTime desde = baseDate.Date + baseTime;

        var duracion = solicitud.DuracionPlanificadaMinutos.GetValueOrDefault(60);
        var url = $"api/solicitudes/siguiente-hueco?idConductor={solicitud.IdConductor.Value}&fecha={Uri.EscapeDataString(desde.ToString("O"))}&duracionMinutos={duracion}&excluirSolicitudId={solicitud.IdSolicitud}";
        var hueco = await Http.GetFromJsonAsync<PlanificacionHueco>(url);
        if (hueco?.Disponible == true)
        {
            solicitud.FechaHoraInicioPlanificada = hueco.Inicio;
            solicitud.FechaHoraFinPlanificada = hueco.Fin;
            if (hueco.Inicio.HasValue)
            {
                solicitud.FechaTarea = hueco.Inicio.Value.Date;
            }
            planificacionMessage = $"Hueco propuesto: {hueco.Inicio:dd/MM/yyyy HH:mm}–{hueco.Fin:HH:mm}.";
        }
        else
        {
            planificacionMessage = hueco?.Mensaje ?? "No se encontró disponibilidad para la fecha seleccionada.";
        }
    }

    private void OnFechaPlanificacionChanged(DateTime? nuevaFecha)
    {
        if (solicitud == null) return;
        solicitud.FechaTarea = nuevaFecha;

        if (nuevaFecha.HasValue)
        {
            if (solicitud.FechaHoraInicioPlanificada.HasValue)
            {
                var time = solicitud.FechaHoraInicioPlanificada.Value.TimeOfDay;
                solicitud.FechaHoraInicioPlanificada = nuevaFecha.Value.Date + time;
            }
            if (solicitud.FechaHoraFinPlanificada.HasValue)
            {
                var time = solicitud.FechaHoraFinPlanificada.Value.TimeOfDay;
                solicitud.FechaHoraFinPlanificada = nuevaFecha.Value.Date + time;
            }
        }
        AplicarEstadoReprogramacion();
    }

