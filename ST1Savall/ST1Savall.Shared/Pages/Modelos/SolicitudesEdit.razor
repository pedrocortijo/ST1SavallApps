    private static string FormatKilometros(int? metros) => $"{metros.GetValueOrDefault() / 1000d:0.0} km";

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }

    private static async Task<string> ObtenerMensajeErrorAsync(HttpResponseMessage response, string mensajeBase)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(contenido))
            return $"{mensajeBase}: {response.ReasonPhrase ?? $"HTTP {(int)response.StatusCode}"}";

        try
        {
            var apiError = System.Text.Json.JsonSerializer.Deserialize<ApiError>(contenido,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (!string.IsNullOrWhiteSpace(apiError?.Message))
                return apiError.Message;
        }
        catch (System.Text.Json.JsonException)
        {
            // Algunas respuestas de infraestructura devuelven texto plano en lugar de JSON.
        }

        return $"{mensajeBase}: {contenido}";
    }



    private async Task VerCoordenadasEnMapa()
    {
        if (solicitud == null) return;

        if (HayCambiosPendientes)
        {
            if (!await GuardarInternamenteAsync())
            {
                return;
            }
        }

        SyncCoordinates();

        double? lat = null;
        double? lon = null;
        if (solicitud.Latitud.HasValue && solicitud.Longitud.HasValue)
        {
            lat = (double)solicitud.Latitud.Value;
            lon = (double)solicitud.Longitud.Value;
        }
        else if (!string.IsNullOrWhiteSpace(solicitud.CoordenadasGPS))
        {
            var parts = solicitud.CoordenadasGPS.Split(',');
            if (parts.Length == 2 && 
                double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedLat) && 
                double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedLon))
            {
                lat = parsedLat;
                lon = parsedLon;
            }
        }

        var address = ST1Savall.MapHelper.BuildNormalizedQuery(solicitud.DireccionCliente, solicitud.PoblacionCliente, null, null);
        if ((!lat.HasValue || !lon.HasValue) && !string.IsNullOrEmpty(address))
        {
            try
            {
                var queryJson = System.Text.Json.JsonSerializer.Serialize($"{address}, Spain");
                var geocodeResult = await JSRuntime.InvokeAsync<GpsPosition>("eval", $@"
                    (async () => {{
                        const response = await fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent({queryJson}) + '&limit=1');
                        if (!response.ok) return null;
                        const results = await response.json();
                        if (!results || results.length === 0) return null;
                        return {{ latitud: parseFloat(results[0].lat), longitud: parseFloat(results[0].lon) }};
                    }})()");

                if (geocodeResult != null)
                {
                    solicitud.Latitud = (decimal)geocodeResult.Latitud;
                    solicitud.Longitud = (decimal)geocodeResult.Longitud;
                    SyncCoordinates();
                    lat = geocodeResult.Latitud;
                    lon = geocodeResult.Longitud;
                }
            }
            catch
            {
                // El mapa puede abrirse con la dirección aunque la geocodificación falle.
            }
        }

        if (string.IsNullOrEmpty(address))
        {
            address = "Ubicación de Solicitud";
        }

        var backUrl = "/modelos/solicitudes";
        if (solicitud.IdSolicitud > 0)
        {
            backUrl = $"/modelos/solicitudes/edit/{solicitud.IdSolicitud}";
        }

        // Obtener la serie del contenedor y su descripción si está asignado
        if (lat.HasValue && lon.HasValue)
        {
            backUrl += $"?mapLat={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&mapLon={lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }

        var serie = solicitud.CodigoEntrega ?? solicitud.CodigoRecogida ?? string.Empty;
        var obra = solicitud.NombreObra ?? "Ubicación de Solicitud";
        var tipo = "Ubicación de Solicitud";

        if (!string.IsNullOrEmpty(serie))
        {
            var cont = contenedoresList?.FirstOrDefault(c => c.NumSerie == serie);
            if (cont != null)
            {
                tipo = cont.Tipo?.Descripcion ?? "Contenedor";
            }
        }

        var latParam = lat.HasValue ? $"&lat={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : "";
        var lonParam = lon.HasValue ? $"&lon={lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : "";
        var serieParam = !string.IsNullOrEmpty(serie) ? $"&serie={Uri.EscapeDataString(serie)}" : "";
        var obraParam = $"&obra={Uri.EscapeDataString(obra)}";

        var mapsUrl = $"/modelos/contenedores/mapa?address={Uri.EscapeDataString(address)}&title={Uri.EscapeDataString(tipo)}{serieParam}{obraParam}{latParam}{lonParam}&backUrl={Uri.EscapeDataString(backUrl)}";
        NavigationManager.NavigateTo(mapsUrl);
    }

    private void OnCoordenadasGPSTextChanged(string val)
    {
        if (solicitud == null) return;
        solicitud.CoordenadasGPS = val;

        if (!string.IsNullOrWhiteSpace(val))
        {
            var cleanCoords = val.Replace(" ", "").Replace(";", ",");
            var parts = cleanCoords.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                if (decimal.TryParse(parts[0].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lat) &&
                    decimal.TryParse(parts[1].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lon))
                {
                    solicitud.Latitud = lat;
                    solicitud.Longitud = lon;
                }
            }
        }
    }

    private void SyncCoordinates()
    {
        if (solicitud == null) return;

        // Prioritize Latitud and Longitud if they have values to keep CoordenadasGPS string updated
        if (solicitud.Latitud.HasValue && solicitud.Longitud.HasValue)
        {
            solicitud.CoordenadasGPS = $"{solicitud.Latitud.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)},{solicitud.Longitud.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)}";
        }
        // If they are null/not set but CoordenadasGPS has a value, parse it to populate Latitud and Longitud
        else if (!string.IsNullOrWhiteSpace(solicitud.CoordenadasGPS))
        {
            var cleanCoords = solicitud.CoordenadasGPS.Replace(" ", "").Replace(";", ",");
            var parts = cleanCoords.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                if (decimal.TryParse(parts[0].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lat) &&
                    decimal.TryParse(parts[1].Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal lon))
                {
                    solicitud.Latitud = lat;
                    solicitud.Longitud = lon;
                }
            }
        }
    }

    private async Task ObtenerUbicacionActualAsync()
    {
        try
        {
            var posicion = await JSRuntime.InvokeAsync<GpsPosition>("eval", @"
                new Promise((resolve, reject) => {
                    if (!navigator.geolocation) {
                        reject('Geolocalización no soportada');
                    } else {
                        navigator.geolocation.getCurrentPosition(
                            (pos) => resolve({ latitud: pos.coords.latitude, longitud: pos.coords.longitude }),
                            (err) => reject('Error al obtener ubicación: ' + err.message),
                            { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
                        );
                    }
                })
            ");

            if (posicion != null && solicitud != null)
            {
                solicitud.Latitud = (decimal)posicion.Latitud;
                solicitud.Longitud = (decimal)posicion.Longitud;
                SyncCoordinates();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo obtener la ubicación: {ex.Message}";
        }
    }

    private int? IdPlantaConductor => operarios?
        .FirstOrDefault(o => o.IdOperario == solicitud?.IdConductor)?.IdPlanta;

    private List<Contenedor> contenedoresEntrega => contenedoresList?
        .Where(c => !EstaSeleccionadoParaRetirada(c)
            && (EsContenedorActual(c, solicitud?.CodigoEntrega)
            || EsContenedorActual(c, solicitud?.CodigoAmbosEntrega)
            || (IdPlantaConductor.HasValue
                && c.IdPlanta == IdPlantaConductor.Value
                && string.Equals(c.EstadoFisico, "Disponible", StringComparison.OrdinalIgnoreCase))))
        .OrderBy(c => c.NumSerie)
        .ToList() ?? new List<Contenedor>();

    private List<Contenedor> contenedoresRecogida => contenedoresList?
        .Where(c => !EstaSeleccionadoParaEntrega(c)
            && (EsContenedorActual(c, solicitud?.CodigoRecogida)
            || EsContenedorActual(c, solicitud?.CodigoAmbosRecogida)
            || (string.Equals(c.EstadoFisico, "Entregado", StringComparison.OrdinalIgnoreCase)
                && EstaEntregadoEnObraSeleccionada(c))))
        .OrderBy(c => c.NumSerie)
        .ToList() ?? new List<Contenedor>();

    private static bool EsContenedorActual(Contenedor contenedor, string? codigoSeleccionado) =>
        !string.IsNullOrWhiteSpace(codigoSeleccionado)
        && string.Equals(contenedor.NumSerie, codigoSeleccionado, StringComparison.OrdinalIgnoreCase);

    private bool EstaSeleccionadoParaEntrega(Contenedor contenedor) =>
        EsContenedorActual(contenedor, solicitud?.CodigoEntrega)
        || EsContenedorActual(contenedor, solicitud?.CodigoAmbosEntrega);

    private bool EstaSeleccionadoParaRetirada(Contenedor contenedor) =>
        EsContenedorActual(contenedor, solicitud?.CodigoRecogida)
        || EsContenedorActual(contenedor, solicitud?.CodigoAmbosRecogida);

    private bool EstaEntregadoEnObraSeleccionada(Contenedor contenedor) =>
        solicitud?.IdCliente > 0
        && solicitudesConContenedores?.Any(s =>
            s.IdCliente == solicitud.IdCliente
            && (string.Equals(s.CodigoEntrega, contenedor.NumSerie, StringComparison.OrdinalIgnoreCase)
                || string.Equals(s.CodigoAmbosEntrega, contenedor.NumSerie, StringComparison.OrdinalIgnoreCase))) == true;

    private Tarea? TareaSeleccionada => tareasList?
        .FirstOrDefault(t => t.IdTarea == solicitud?.IdTipoTarea);

    private IEnumerable<Tarea> TareasDisponibles => tareasList?.Where(PuedeSeleccionarTarea)
        ?? Enumerable.Empty<Tarea>();

    private bool TieneContenedoresEnObra => solicitud?.IdCliente > 0
        && solicitudesConContenedores?.Any(s => s.IdCliente == solicitud.IdCliente) == true;

    private bool PuedeSeleccionarTarea(Tarea tarea) =>
        !RequiereContenedorExistente(tarea) || TieneContenedoresEnObra;

    private static bool RequiereContenedorExistente(Tarea tarea) =>
        tarea.Recoger1 || tarea.Recoger2;

    private bool IsEntregaEnabled => TareaSeleccionada?.Entrega1 == true;
    private bool IsEntrega2Enabled => TareaSeleccionada?.Entrega2 == true;
    private bool IsRecogidaEnabled => TareaSeleccionada?.Recoger1 == true;
    private bool IsRecogida2Enabled => TareaSeleccionada?.Recoger2 == true;

    private void OnTareaChanged(int val)
    {
        if (solicitud == null) return;
        if (solicitud.IdTipoTarea == val) return;

        var nuevaTarea = tareasList?.FirstOrDefault(t => t.IdTarea == val);
        if (nuevaTarea is not null && !PuedeSeleccionarTarea(nuevaTarea))
        {
            errorMessage = "No se puede seleccionar esta tarea porque incluye una retirada y la obra no tiene contenedores asignados.";
            return;
        }
        var seAfectaEntrega1 = !string.IsNullOrWhiteSpace(solicitud.CodigoEntrega) && nuevaTarea?.Entrega1 != true;
        var seAfectaEntrega2 = !string.IsNullOrWhiteSpace(solicitud.CodigoAmbosEntrega) && nuevaTarea?.Entrega2 != true;
        var seAfectaRecogida1 = !string.IsNullOrWhiteSpace(solicitud.CodigoRecogida) && nuevaTarea?.Recoger1 != true;
        var seAfectaRecogida2 = !string.IsNullOrWhiteSpace(solicitud.CodigoAmbosRecogida) && nuevaTarea?.Recoger2 != true;

        if (seAfectaEntrega1 || seAfectaEntrega2 || seAfectaRecogida1 || seAfectaRecogida2)
        {
            tareaAnterior = solicitud.IdTipoTarea;
            codigoEntregaPrevio = solicitud.CodigoEntrega;
            codigoAmbosEntregaPrevio = solicitud.CodigoAmbosEntrega;
            codigoRecogidaPrevio = solicitud.CodigoRecogida;
            codigoAmbosRecogidaPrevio = solicitud.CodigoAmbosRecogida;

            tipoTareaPendiente = val;
            entrega1Afectada = seAfectaEntrega1;
            entrega2Afectada = seAfectaEntrega2;
            recogida1Afectada = seAfectaRecogida1;
            recogida2Afectada = seAfectaRecogida2;
            confirmacionCambioTareaVisible = true;
            return;
        }

        AplicarCambioTarea(val);
    }

    private void ConfirmarCambioTarea()
    {
        if (tipoTareaPendiente.HasValue)
        {
            AplicarCambioTarea(tipoTareaPendiente.Value);
        }

        LimpiarCambioTareaPendiente();
    }

    private void CancelarCambioTarea()
    {
        if (tareaAnterior.HasValue && solicitud != null)
        {
            solicitud.IdTipoTarea = tareaAnterior.Value;
            solicitud.CodigoEntrega = codigoEntregaPrevio;
            solicitud.CodigoAmbosEntrega = codigoAmbosEntregaPrevio;
            solicitud.CodigoRecogida = codigoRecogidaPrevio;
            solicitud.CodigoAmbosRecogida = codigoAmbosRecogidaPrevio;
        }

        tareaComboKey++;
        LimpiarCambioTareaPendiente();
        StateHasChanged();
    }

    private void OnConfirmacionVisibleChanged(bool visible)
    {
        confirmacionCambioTareaVisible = visible;
        if (!visible && tipoTareaPendiente.HasValue)
        {
            CancelarCambioTarea();
        }
    }

    private void AplicarCambioTarea(int tipoTarea)
    {
        if (solicitud == null) return;

        solicitud.IdTipoTarea = tipoTarea;

        var tarea = tareasList?.FirstOrDefault(t => t.IdTarea == tipoTarea);

        if (tarea?.Entrega1 != true)
            solicitud.CodigoEntrega = null;

        if (tarea?.Recoger1 != true)
            solicitud.CodigoRecogida = null;

        if (tarea?.Entrega2 != true)
            solicitud.CodigoAmbosEntrega = null;

        if (tarea?.Recoger2 != true)
            solicitud.CodigoAmbosRecogida = null;
    }

    private void LimpiarCambioTareaPendiente()
    {
        confirmacionCambioTareaVisible = false;
        tipoTareaPendiente = null;
        tareaAnterior = null;
        codigoEntregaPrevio = null;
        codigoAmbosEntregaPrevio = null;
        codigoRecogidaPrevio = null;
        codigoAmbosRecogidaPrevio = null;
        entrega1Afectada = false;
        entrega2Afectada = false;
        recogida1Afectada = false;
        recogida2Afectada = false;
    }

    private IEnumerable<Operario> GetOperariosDisponibles()
    {
        if (operarios == null) return Enumerable.Empty<Operario>();

        return operarios.Where(o =>
            (o.Activo != false && !string.Equals(o.EstadoLaboral, "Inactivo", StringComparison.OrdinalIgnoreCase))
            || (solicitud != null && solicitud.IdConductor.HasValue && o.IdOperario == solicitud.IdConductor.Value)
        ).OrderBy(o => o.Nombre);
    }

    private void OnConductorChanged(int? idConductor)
    {
        if (solicitud == null) return;

        solicitud.IdConductor = idConductor;
        var operarioConductor = operarios?.FirstOrDefault(o => o.IdOperario == idConductor);
        var idPlanta = operarioConductor?.IdPlanta;

        solicitud.IdPlantaOrigen = idPlanta;
        solicitud.IdPlantaDescarga = idPlanta;
        solicitud.IdPlantaRegreso = idPlanta;

        AplicarEstadoReprogramacion();
    }

    private bool ValidarEstadoAlGuardar(out string? motivoError)
    {
        motivoError = null;
        if (solicitud == null) return true;

        var estadoSeleccionado = solicitud.Estado;
        var parametro = parametrosList?.FirstOrDefault();
        var idAdjudicado = parametro?.EstadoAdjudicado ?? 9;
        var idReprogramado = parametro?.EstadoReprogramacion ?? 6;

        bool tieneConductor = solicitud.IdConductor.HasValue && solicitud.IdConductor.Value > 0;
        bool tieneFechaPrevista = solicitud.FechaPrevista.HasValue || solicitud.FechaTarea.HasValue;
        bool tieneHoraInicio = solicitud.FechaHoraInicioPlanificada.HasValue;
        bool tieneHoraFin = solicitud.FechaHoraFinPlanificada.HasValue;
        bool tieneTiempo = solicitud.DuracionPlanificadaMinutos.HasValue && solicitud.DuracionPlanificadaMinutos.Value > 0;
        bool tieneMotivoAplazamiento = solicitud.MotivoReprogramacion.HasValue && solicitud.MotivoReprogramacion.Value > 0;

        if (estadoSeleccionado == idAdjudicado && !(tieneConductor && tieneFechaPrevista && tieneHoraInicio && tieneHoraFin && tieneTiempo))
        {
            var faltantes = new List<string>();
            if (!tieneConductor) faltantes.Add("Conductor");
            if (!tieneFechaPrevista) faltantes.Add("Fecha prevista");
            if (!tieneHoraInicio) faltantes.Add("Hora de inicio");
            if (!tieneHoraFin) faltantes.Add("Hora fin");
            if (!tieneTiempo) faltantes.Add("Duración (minutos)");

            motivoError = $"No se puede cambiar el estado a '{ObtenerNombreEstado(idAdjudicado)}' porque no se cumplen los requisitos de planificación. Faltan los siguientes datos: {string.Join(", ", faltantes)}.";
            return false;
        }

        if (estadoSeleccionado == idReprogramado && !(tieneFechaPrevista && tieneMotivoAplazamiento))
        {
            var faltantes = new List<string>();
            if (!tieneFechaPrevista) faltantes.Add("Fecha prevista");
            if (!tieneMotivoAplazamiento) faltantes.Add("Motivo de reprogramación");

            motivoError = $"No se puede cambiar el estado a '{ObtenerNombreEstado(idReprogramado)}' porque se requiere indicar: {string.Join(" y ", faltantes)}.";
            return false;
        }

        if ((EsEstadoIniciado(estadoSeleccionado)
                && estadoSeleccionado != estadoInicial
                && !EsEstadoAsignado(estadoInicial ?? 0))
            || (EsEstadoFinalizado(estadoSeleccionado)
                && EsEstadoFinalizado(estadoInicial ?? 0)
                && !finalizadaDesbloqueada))
        {
            motivoError = $"No se puede seleccionar el estado '{ObtenerNombreEstado(estadoSeleccionado)}' al grabar la solicitud, ya que es un estado exclusivo de la ejecución del servicio en la aplicación móvil.";
            return false;
        }

        return true;
    }

    private string ObtenerNombreEstado(int idEstado)
    {
        return estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion ?? $"Estado {idEstado}";
    }

