    {
        if (solicitud != null && estadoPendienteCambio.HasValue)
        {
            solicitud.IdConductor = null;
            solicitud.IdPlantaOrigen = null;
            solicitud.IdPlantaDescarga = null;
            solicitud.IdPlantaRegreso = null;
            solicitud.DuracionPlanificadaMinutos = null;
            solicitud.FechaPrevista = null;
            solicitud.FechaTarea = null;
