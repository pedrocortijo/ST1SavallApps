    private UnsavedChangesGuard? unsavedChangesGuard;

    private bool HayCambiosPendientes =>
        solicitud != null
        && !string.IsNullOrEmpty(solicitudInicial)
        && !string.Equals(solicitudInicial, SerializarSolicitud(), StringComparison.Ordinal);

    private string? SerializarSolicitud() => solicitud == null
        ? null
        : System.Text.Json.JsonSerializer.Serialize(solicitud);

    private async Task ProponerSiguienteHuecoAsync()
    {
        if (solicitud?.IdConductor == null)
        {
            planificacionMessage = "Seleccione primero un conductor.";
            return;
        }

        var conductor = operarios?.FirstOrDefault(o => o.IdOperario == solicitud.IdConductor.Value);
        var inicioShift = conductor != null && conductor.InicioJornada != TimeSpan.Zero ? conductor.InicioJornada : new TimeSpan(8, 0, 0);

        DateTime baseDate = solicitud.FechaTarea?.Date 
            ?? solicitud.FechaHoraInicioPlanificada?.Date 
            ?? DateTime.Today;

        TimeSpan baseTime = solicitud.FechaHoraInicioPlanificada?.TimeOfDay ?? inicioShift;
        if (baseTime < inicioShift) baseTime = inicioShift;
        DateTime desde = baseDate.Date + baseTime;

        var duracion = solicitud.DuracionPlanificadaMinutos.GetValueOrDefault(60);
        var url = $"api/solicitudes/siguiente-hueco?idConductor={solicitud.IdConductor.Value}&fecha={Uri.EscapeDataString(desde.ToString("O"))}&duracionMinutos={duracion}&excluirSolicitudId={solicitud.IdSolicitud}";
        var hueco = await Http.GetFromJsonAsync<PlanificacionHueco>(url);
        if (hueco?.Disponible == true)
        {
            solicitud.FechaHoraInicioPlanificada = hueco.Inicio;
            solicitud.FechaHoraFinPlanificada = hueco.Fin;
            if (hueco.Inicio.HasValue)
            {
                solicitud.FechaTarea = hueco.Inicio.Value.Date;
            }
            planificacionMessage = $"Hueco propuesto: {hueco.Inicio:dd/MM/yyyy HH:mm}–{hueco.Fin:HH:mm}.";
        }
        else
        {
            planificacionMessage = hueco?.Mensaje ?? "No se encontró disponibilidad para la fecha seleccionada.";
        }
    }

    private void OnFechaPlanificacionChanged(DateTime? nuevaFecha)
    {
        if (solicitud == null) return;
        solicitud.FechaTarea = nuevaFecha;

        if (nuevaFecha.HasValue)
        {
            if (solicitud.FechaHoraInicioPlanificada.HasValue)
            {
                var time = solicitud.FechaHoraInicioPlanificada.Value.TimeOfDay;
                solicitud.FechaHoraInicioPlanificada = nuevaFecha.Value.Date + time;
            }
            if (solicitud.FechaHoraFinPlanificada.HasValue)
            {
                var time = solicitud.FechaHoraFinPlanificada.Value.TimeOfDay;
                solicitud.FechaHoraFinPlanificada = nuevaFecha.Value.Date + time;
            }
        }
        AplicarEstadoReprogramacion();
    }

    private void OnInicioPlanificadoChanged(DateTime? nuevoInicio)
    {
        if (solicitud == null) return;

        if (nuevoInicio.HasValue)
        {
            DateTime baseDate = solicitud.FechaTarea?.Date ?? nuevoInicio.Value.Date;
            solicitud.FechaTarea = baseDate;
            solicitud.FechaHoraInicioPlanificada = baseDate.Date + nuevoInicio.Value.TimeOfDay;
        }
        else
        {
            solicitud.FechaHoraInicioPlanificada = null;
        }

        ActualizarFinPlanificado();
        AplicarEstadoReprogramacion();
    }

    private void OnFinPlanificadoChanged(DateTime? nuevoFin)
    {
        if (solicitud == null) return;

        if (nuevoFin.HasValue)
        {
            DateTime baseDate = solicitud.FechaTarea?.Date ?? nuevoFin.Value.Date;
            solicitud.FechaTarea = baseDate;
            solicitud.FechaHoraFinPlanificada = baseDate.Date + nuevoFin.Value.TimeOfDay;
        }
        else
        {
            solicitud.FechaHoraFinPlanificada = null;
        }
        AplicarEstadoReprogramacion();
    }

    private async Task<bool> CalcularRutaAsync(bool mostrarMensaje)
    {
        if (solicitud == null) return false;

        SyncCoordinates();
        if (!TieneDatosRutaCompletos())
        {
            errorMessage = "Seleccione las tres plantas e indique las coordenadas de la obra.";
            return false;
        }

        try
        {
            calculandoRuta = true;
            errorMessage = null;
            if (mostrarMensaje)
            {
                solicitud.DuracionModificadaManualmente = false;
            }
            await SetupHeadersAsync();
            var url = mostrarMensaje ? "api/solicitudes/calcular-ruta?forzarActualizacion=true" : "api/solicitudes/calcular-ruta";
            var response = await Http.PostAsJsonAsync(url, solicitud);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ObtenerMensajeErrorAsync(response, "No se pudo calcular la ruta");
                return false;
            }

            var resultado = await response.Content.ReadFromJsonAsync<CalculoRutaSolicitudResultado>();
            if (resultado?.Calculado != true || resultado.Solicitud == null)
            {
                errorMessage = resultado?.Mensaje ?? "Mapbox no devolvió un cálculo válido.";
                return false;
            }

            solicitud = resultado.Solicitud;
            if (mostrarMensaje)
            {
                var origenDatos = resultado.TramosDesdeProveedor > 0
                    ? $"{resultado.TramosDesdeProveedor} tramo(s) consultados a Mapbox"
                    : "todos los tramos recuperados de caché";
                planificacionMessage = $"{resultado.Mensaje} ({origenDatos}).";
            }

            return true;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo calcular la ruta: {ex.Message}";
            return false;
        }
        finally
        {
            calculandoRuta = false;
        }
    }

    private bool TieneDatosRutaCompletos() =>
