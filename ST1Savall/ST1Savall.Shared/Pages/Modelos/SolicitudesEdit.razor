    private async Task<bool> GuardarInternamenteAsync()
    {
        if (solicitud == null) return false;
        if (firmaModificada && !PuedeFirmar)
        {
            errorMessage = $"No se puede guardar la firma: faltan los contenedores requeridos ({string.Join(", ", ContenedoresPendientesFirma)}).";
            return false;
        }
        if (EsEstadoFinalizado(estadoInicial ?? 0) && !finalizadaDesbloqueada)
        {
            passwordFinalizadaVisible = true;
            return false;
        }

        if (!ValidarEstadoAlGuardar(out var motivoError))
        {
            motivoEstadoMessage = motivoError;
            return false;
        }

        try
        {
            AplicarEstadoReprogramacion();
            if (solicitud.FechaTarea.HasValue)
            {
                var targetDate = solicitud.FechaTarea.Value.Date;
                if (solicitud.FechaHoraInicioPlanificada.HasValue)
                {
                    solicitud.FechaHoraInicioPlanificada = targetDate + solicitud.FechaHoraInicioPlanificada.Value.TimeOfDay;
                }
                if (solicitud.FechaHoraFinPlanificada.HasValue)
                {
                    solicitud.FechaHoraFinPlanificada = targetDate + solicitud.FechaHoraFinPlanificada.Value.TimeOfDay;
                }
            }
            else if (solicitud.FechaHoraInicioPlanificada.HasValue)
            {
                var targetDate = solicitud.FechaHoraInicioPlanificada.Value.Date;
                solicitud.FechaTarea = targetDate;
                solicitud.FechaHoraInicioPlanificada = targetDate + solicitud.FechaHoraInicioPlanificada.Value.TimeOfDay;
                if (solicitud.FechaHoraFinPlanificada.HasValue)
                {
                    solicitud.FechaHoraFinPlanificada = targetDate + solicitud.FechaHoraFinPlanificada.Value.TimeOfDay;
                }
            }

            SyncCoordinates();
            if (solicitud.Latitud.HasValue && solicitud.Longitud.HasValue)
            {
                solicitud.LatitudObra = solicitud.Latitud;
                solicitud.LongitudObra = solicitud.Longitud;
            }

            if (TieneDatosRutaCompletos() && !await CalcularRutaAsync(false))
                return false;

            solicitud.FechaActualizacion = DateTime.Now;
            await SetupHeadersAsync();
            HttpResponseMessage response;
            if (Id.HasValue && Duplicate != true && solicitud.IdSolicitud > 0)
            {
                using var request = new HttpRequestMessage(HttpMethod.Put, $"api/solicitudes/{solicitud.IdSolicitud}")
                {
                    Content = JsonContent.Create(solicitud)
                };
                if (Http.DefaultRequestHeaders.Authorization != null)
                {
                    request.Headers.Authorization = Http.DefaultRequestHeaders.Authorization;
                }
                else
                {
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    var token = authState.User.FindFirst("token")?.Value;
                    if (!string.IsNullOrEmpty(token))
                    {
                        var authHeader = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                        Http.DefaultRequestHeaders.Authorization = authHeader;
                        request.Headers.Authorization = authHeader;
                    }
                }
                if (EsEstadoFinalizado(estadoInicial ?? 0))
                    request.Headers.Add("X-Finalized-Service-Password", passwordFinalizada);
                response = await Http.SendAsync(request);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/solicitudes", solicitud);
            }

            if (response.IsSuccessStatusCode)
            {
                if (!Id.HasValue || Duplicate == true || solicitud.IdSolicitud == 0)
                {
                    var created = await response.Content.ReadFromJsonAsync<Solicitud>();
                    if (created != null)
                    {
                        solicitud = created;
                        Id = created.IdSolicitud;
                        Duplicate = false;
                    }
                }

                if (firmaEliminada && !await EliminarFirmaAsync())
                    return false;

                if (firmaModificada && !await GuardarFirmaAsync())
                    return false;

                solicitudInicial = SerializarSolicitud();
                unsavedChangesGuard?.AllowNextNavigation();
                return true;
            }
            else
            {
                errorMessage = await ObtenerMensajeErrorAsync(response, "Error al guardar la solicitud");
                return false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al guardar: {ex.Message}";
            return false;
        }
    }

    private async Task<bool> GuardarFirmaAsync()
    {
        if (solicitud is null || solicitud.IdSolicitud <= 0 || string.IsNullOrWhiteSpace(firmaImagenBase64))
            return true;

        var response = await Http.PostAsJsonAsync($"api/solicitudes/{solicitud.IdSolicitud}/firma", new
        {
            Nombre = solicitud.FirmaNombre,
            Dni = solicitud.FirmaDni,
            ImagenBase64 = firmaImagenBase64
        });
        if (response.IsSuccessStatusCode)
        {
            firmaModificada = false;
            return true;
        }

        errorMessage = await ObtenerMensajeErrorAsync(response, "Error al guardar la firma");
        return false;
    }

    private async Task<bool> EliminarFirmaAsync()
    {
        if (solicitud is null || solicitud.IdSolicitud <= 0) return true;

        var response = await Http.DeleteAsync($"api/solicitudes/{solicitud.IdSolicitud}/firma");
        if (response.IsSuccessStatusCode)
        {
            solicitud.FirmaPath = null;
            firmaEliminada = false;
            return true;
        }

        errorMessage = await ObtenerMensajeErrorAsync(response, "Error al borrar la firma");
        return false;
    }

