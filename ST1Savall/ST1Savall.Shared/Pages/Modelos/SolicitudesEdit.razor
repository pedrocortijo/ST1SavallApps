    private async Task ValidarPasswordFinalizadaAsync()
    {
        errorPasswordFinalizada = null;
        if (string.IsNullOrWhiteSpace(passwordFinalizada))
        {
            errorPasswordFinalizada = "Introduzca la contraseña.";
            return;
        }

        try
        {
            var parametros = await Http.GetFromJsonAsync<List<Parametro>>("api/parametros");
            var adminPassword = parametros?.FirstOrDefault()?.AdminPassword;
            if (!string.IsNullOrEmpty(adminPassword) && passwordFinalizada == adminPassword)
            {
                finalizadaDesbloqueada = true;
                passwordFinalizadaVisible = false;
                return;
            }
        }
        catch
        {
        }

        errorPasswordFinalizada = "La contraseña de administración no es correcta.";
    }

