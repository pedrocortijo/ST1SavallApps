        var pngBytes = await response.Content.ReadAsByteArrayAsync();
        return $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
    }

    private async Task EmitirDeCaOficinaAsync()
    {
        if (solicitud == null || solicitud.IdSolicitud <= 0) return;
        emitiendoDeCaOficina = true;
        try
        {
            var tareaSel = TareasDisponibles?.FirstOrDefault(t => t.IdTarea == solicitud.IdTipoTarea);
            var tipo = (tareaSel != null && (tareaSel.Entrega1 || tareaSel.Entrega2)) ? "ENTREGA" : "RETIRADA";
            var resp = await Http.PostAsync($"api/deca/solicitud/{solicitud.IdSolicitud}/emitir?tipo={tipo}", null);
            if (resp.IsSuccessStatusCode)
            {
                var resultado = await resp.Content.ReadFromJsonAsync<GenerarDeCaResultadoDto>();
                if (resultado != null && resultado.Exito)
                {
                    solicitud.GuidDeCa = resultado.GuidDeCa;
                    solicitud.TipoDeCaEmitido = resultado.Tipo;
                    solicitud.FechaHoraEmisionDeCa = resultado.FechaHoraEmision;
                    urlDescargaDeCaOficina = resultado.UrlDescarga;
                    qrDeCaOficinaImagenSrc = await CargarQrDeCaOficinaAsync(solicitud.IdSolicitud);
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al emitir DeCA en oficina: {ex.Message}");
        }
        finally
        {
            emitiendoDeCaOficina = false;
        }
    }
}
