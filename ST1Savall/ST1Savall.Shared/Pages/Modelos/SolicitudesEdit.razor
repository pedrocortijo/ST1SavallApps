                                    title="Borrar motivo"
                                    aria-label="Borrar firma" @onclick="() => OnMotivoReprogramacionChanged(null)">
                                <i class="oi oi-trash"></i>
                            </button>
@* 
                            <button type="button" class="btn btn-outline-danger" style="height: 32px; width: 38px;" title="Borrar motivo" aria-label="Borrar motivo"
                                    @onclick="() => OnMotivoReprogramacionChanged(null)">
                                <span aria-hidden="true" style="font-size: 1.35rem; line-height: 1;">&times;</span>
                            </button>
*@
                        </div>
                    </DxFormLayoutItem>

                    <!-- Grupo 5: Ocupación de Vía Pública y firma -->
                    <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="row g-4 mt-2">
                                <div class="col-md-7 border-end pe-md-4">
                                    <h6 class="fw-bold text-primary mb-3 pb-2 border-bottom">Ocupación de Vía Pública (OVP)</h6>
                                    <div class="row g-2">
                                        <div class="col-md-5 d-flex align-items-end mb-2"><DxCheckBox @bind-Checked:get="@solicitud.RequiereOVP" @bind-Checked:set="@OnRequiereOVPChanged" LabelPosition="LabelPosition.Right">Requiere Licencia OVP</DxCheckBox></div>
                                        <div class="col-md-7 mb-2"><label class="form-label fw-bold text-muted small mb-1">Nº Licencia</label><DxTextBox @bind-Text="@solicitud.NumLicenciaOVP" Enabled="@solicitud.RequiereOVP" /></div>
                                        <div class="col-12 mb-2"><div class="row justify-content-end g-2"><div class="col-md-4"><label class="form-label fw-bold text-muted small mb-1">Fecha Inicio OVP</label><DxDateEdit @bind-Date="@solicitud.FechaInicioOVP" Enabled="@solicitud.RequiereOVP" /></div><div class="col-md-4"><label class="form-label fw-bold text-muted small mb-1">Fecha Finalización OVP</label><DxDateEdit @bind-Date="@solicitud.FechaFinOVP" Enabled="@solicitud.RequiereOVP" /></div></div></div>
                                    </div>
                                </div>
                                <div class="col-md-5 ps-md-4">
                                    <h6 class="fw-bold text-primary mb-3 pb-2 border-bottom">Firma de solicitud</h6>
                                    <div class="row g-2">
                                        <div class="col-7"><label class="form-label fw-bold text-muted small mb-1">Nombre firmante</label><DxTextBox @bind-Text="@solicitud.FirmaNombre" NullText="Nombre y apellidos" /></div>
                                        <div class="col-5"><label class="form-label fw-bold text-muted small mb-1">DNI</label><DxTextBox @bind-Text="@solicitud.FirmaDni" NullText="DNI" /></div>
                                        @if (!PuedeFirmar)
                                        {
                                            <div class="col-12"><div class="alert alert-warning py-1 px-2 small mb-0">Antes de firmar, indique: @string.Join(", ", ContenedoresPendientesFirma).</div></div>
                                        }
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label fw-bold text-muted small mb-0">Firma</label>
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1" 
                                                title="Borrar firma" 
                                                aria-label="Borrar firma" @onclick="LimpiarFirmaAsync"><i 
                                                class="oi oi-trash"></i></button>
                                            </div><canvas id="solicitudFirmaCanvas" @ref="firmaCanvas" class="w-100 border rounded bg-white" style="@EstiloLienzoFirma"></canvas></div>
                                    </div>
                                </div>
                            </div>
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanMd="12" BeginRow="true" CssClass="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button class="btn btn-outline-secondary btn-sm px-4" @onclick="GoBack">Cancelar</button>
                        <button class="btn btn-primary btn-sm px-4" @onclick="SaveAsync">Guardar</button>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromQuery]
    public bool? Duplicate { get; set; }

    [SupplyParameterFromQuery]
    public int? ObraId { get; set; }

    [SupplyParameterFromQuery]
    public int? TareaId { get; set; }

    [SupplyParameterFromQuery]
    public string? ContenedorCodigo { get; set; }

    [SupplyParameterFromQuery(Name = "mapLat")]
    public decimal? MapLat { get; set; }

    [SupplyParameterFromQuery(Name = "mapLon")]
    public decimal? MapLon { get; set; }

    private Solicitud? solicitud;
    private List<Operario>? operarios;
    private List<ApplicationUserDto>? usuariosList;
    private List<EstadoSolicitud>? estadosList;
    private List<Obra>? obras;
    private List<Motivo>? motivosList;
    private List<Parametro>? parametrosList;
    private List<Contenedor>? contenedoresList;
    private List<Solicitud>? solicitudesConContenedores;
    private List<Planta>? plantas;
    private List<ContenedorTipo>? tiposContenedor;
    private bool nuevoContenedorVisible;
    private string? destinoNuevoContenedor;
    private string destinoNuevoContenedorDescripcion = string.Empty;
    private Contenedor nuevoContenedor = new();
    private string? errorNuevoContenedor;
    private bool loading = true;
    private string? errorMessage;
    private string? motivoEstadoMessage;
    private int? estadoInicial;
    private int? estadoPendienteCambio;
    private bool confirmacionEliminarPlanificacionVisible;
    private bool advertenciaPlanificacionIncompletaVisible;
    private bool advertenciaEstadoIniciadoVisible;
    private bool passwordFinalizadaVisible;
    private bool finalizadaDesbloqueada;
    private string passwordFinalizada = string.Empty;
    private string? errorPasswordFinalizada;
    private string? planificacionMessage;
    private bool calculandoRuta;
    private string? solicitudInicial;
    private bool confirmacionCambioTareaVisible;
    private bool popupObraBloqueadaVisible;
    private int tareaComboKey = 0;
    private int? tipoTareaPendiente;
    private int? tareaAnterior;
    private string? codigoEntregaPrevio;
    private string? codigoAmbosEntregaPrevio;
    private string? codigoRecogidaPrevio;
    private string? codigoAmbosRecogidaPrevio;
    private bool entrega1Afectada;
    private bool entrega2Afectada;
    private bool recogida1Afectada;
    private bool recogida2Afectada;
    private ElementReference firmaCanvas;
    private DotNetObjectReference<SolicitudesEdit>? firmaReference;
    private string? firmaImagenBase64;
    private bool firmaModificada;
    private bool firmaInicializada;
    private bool firmaPendienteDeMostrar;
    private bool firmaEliminada;

    private class KeyName
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private List<Tarea>? tareasList;

    private List<KeyName> prioridadesList = new()
    {
        new() { Id = 1, Name = "Alta" },
        new() { Id = 2, Name = "Media" },
        new() { Id = 3, Name = "Baja" }
    };

    protected override async Task OnInitializedAsync()
    {
        await SetupHeadersAsync();
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firmaInicializada && solicitud is not null)
        {
            firmaReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initSignaturePad", firmaCanvas, firmaReference);
            firmaInicializada = true;
        }

        if (firmaInicializada && firmaPendienteDeMostrar && !string.IsNullOrWhiteSpace(firmaImagenBase64))
        {
            await JSRuntime.InvokeVoidAsync("setSignatureImage", firmaCanvas, firmaImagenBase64);
            firmaPendienteDeMostrar = false;
        }
    }

    [JSInvokable]
    public Task OnSignatureChanged(string imagenBase64)
    {
        if (!PuedeFirmar) return Task.CompletedTask;
        firmaImagenBase64 = imagenBase64;
        firmaModificada = true;
        firmaEliminada = false;
        return Task.CompletedTask;
    }

    private async Task LimpiarFirmaAsync()
    {
        await JSRuntime.InvokeVoidAsync("clearSignaturePad", firmaCanvas);
        firmaImagenBase64 = null;
        firmaModificada = false;
        firmaPendienteDeMostrar = false;
        firmaEliminada = !string.IsNullOrWhiteSpace(solicitud?.FirmaPath);
        if (solicitud is not null)
        {
            solicitud.FirmaNombre = null;
            solicitud.FirmaDni = null;
        }
    }

    private IEnumerable<string> ContenedoresPendientesFirma
    {
        get
        {
            var tarea = TareaSeleccionada;
            if (solicitud is null || tarea is null) return ["el tipo de tarea"];

            var pendientes = new List<string>();
            if (tarea.Entrega1 && string.IsNullOrWhiteSpace(solicitud.CodigoEntrega)) pendientes.Add("Entrega [1]");
            if (tarea.Entrega2 && string.IsNullOrWhiteSpace(solicitud.CodigoAmbosEntrega)) pendientes.Add("Entrega [2]");
            if (tarea.Recoger1 && string.IsNullOrWhiteSpace(solicitud.CodigoRecogida)) pendientes.Add("Retirada [1]");
            if (tarea.Recoger2 && string.IsNullOrWhiteSpace(solicitud.CodigoAmbosRecogida)) pendientes.Add("Retirada [2]");
            return pendientes;
        }
    }

    private bool PuedeFirmar => !ContenedoresPendientesFirma.Any();

    private string EstiloLienzoFirma => PuedeFirmar
        ? "height: 115px; touch-action: none;"
        : "height: 115px; touch-action: none; pointer-events: none; opacity: .55;";

    private void OnRequiereOVPChanged(bool requiereOVP)
    {
        if (solicitud is null) return;

        solicitud.RequiereOVP = requiereOVP;
        if (!requiereOVP)
        {
            solicitud.NumLicenciaOVP = null;
            solicitud.FechaInicioOVP = null;
            solicitud.FechaFinOVP = null;
        }
    }

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            loading = true;
            operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios");
            usuariosList = await Http.GetFromJsonAsync<List<ApplicationUserDto>>("api/users");
            estadosList = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud");
            obras = await Http.GetFromJsonAsync<List<Obra>>("api/obras");
            tareasList = await Http.GetFromJsonAsync<List<Tarea>>("api/tareas");
            plantas = await Http.GetFromJsonAsync<List<Planta>>("api/plantas");
            tiposContenedor = await Http.GetFromJsonAsync<List<ContenedorTipo>>("api/contenedorestipos");
            motivosList = await Http.GetFromJsonAsync<List<Motivo>>("api/motivos");
            parametrosList = await Http.GetFromJsonAsync<List<Parametro>>("api/parametros");

            if (Id.HasValue)
            {
                solicitud = await Http.GetFromJsonAsync<Solicitud>($"api/solicitudes/{Id.Value}");
                if (solicitud != null)
                {
                    estadoInicial = solicitud.Estado;
                    if (Duplicate != true)
                        await CargarFirmaAsync();
                }
                if (Duplicate == true && solicitud != null)
                {
                    solicitud.IdSolicitud = 0;
                    solicitud.FechaSolicitud = DateTime.Today;
                    solicitud.Bloqueado = false;
                    solicitud.NotificacionInicioVisualizada = false;
                    AplicarEstadoReprogramacion();
                }
                else
                {
                    passwordFinalizadaVisible = solicitud != null && EsEstadoFinalizado(solicitud.Estado);
                }
            }
            else
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var currentUserName = authState.User.Identity?.Name;

                solicitud = new Solicitud
                {
                    FechaSolicitud = DateTime.Today,
                    //FechaInicial = DateTime.Today,
                    //FechaTarea = DateTime.Today,
                    Estado = 1, // Introducido por defecto
                    Prioridad = 3, // Prioridad baja por defecto
                    IdConductor = null, // Sin asignar por defecto
                    IdOperario = currentUserName, // Prefilled with login UserName
                    DuracionPlanificadaMinutos = null,
                    DuracionOperacionMinutos = 30,
                    FechaHoraInicioPlanificada = null,
                    FechaHoraFinPlanificada = null
                };

                if (ObraId.HasValue)
                {
                    solicitud.IdCliente = ObraId.Value;
                    var obra = obras?.FirstOrDefault(o => o.IdObra == ObraId.Value);
                    if (obra != null)
                    {
                        solicitud.NombreObra = obra.Descripcion;
                        solicitud.NombreCliente = obra.NombreCliente;
                        solicitud.DireccionCliente = obra.Ubicacion;
                        solicitud.PoblacionCliente = obra.Poblacion;
                        solicitud.TelefonoCliente = obra.Telefono;
                        solicitud.Encargado = obra.Encargado;
                        solicitud.Movil = obra.Movil;

                        await GeocodificarUbicacionObraAsync(obra);
                    }
                }

                if (TareaId.HasValue)
                {
                    solicitud.IdTipoTarea = TareaId.Value;
                }

                if (!string.IsNullOrEmpty(ContenedorCodigo))
                {
                    solicitud.CodigoRecogida = ContenedorCodigo;
                }
            }

            if (solicitud != null && MapLat.HasValue && MapLon.HasValue)
            {
                solicitud.Latitud = MapLat.Value;
                solicitud.Longitud = MapLon.Value;
                SyncCoordinates();
            }

            solicitudInicial = SerializarSolicitud();

            var allContenedores = await Http.GetFromJsonAsync<List<Contenedor>>("api/contenedores");
            if (allContenedores != null)
            {
                contenedoresList = allContenedores;
            }

            solicitudesConContenedores = await Http.GetFromJsonAsync<List<Solicitud>>(
                "api/solicitudes/con-contenedores");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void AbrirNuevoContenedor(string destino, string descripcion)
    {
        destinoNuevoContenedor = destino;
        destinoNuevoContenedorDescripcion = descripcion;
        errorNuevoContenedor = null;
        nuevoContenedor = new Contenedor
        {
            EstadoFisico = destino.Contains("Recogida", StringComparison.Ordinal) ? "Entregado" : "Disponible",
            IdPlanta = IdPlantaConductor ?? plantas?.FirstOrDefault()?.IdPlanta ?? 0
        };
        nuevoContenedorVisible = true;
    }

    private void CancelarNuevoContenedor()
    {
        nuevoContenedorVisible = false;
        errorNuevoContenedor = null;
    }

    private async Task CrearNuevoContenedorAsync()
    {
        nuevoContenedor.NumSerie = nuevoContenedor.NumSerie?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(nuevoContenedor.NumSerie) || nuevoContenedor.IdTipo <= 0 || nuevoContenedor.IdPlanta <= 0)
        {
            errorNuevoContenedor = "Indique el número de serie, el tipo y la planta del contenedor.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/contenedores", nuevoContenedor);
            if (!response.IsSuccessStatusCode)
            {
                errorNuevoContenedor = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorNuevoContenedor))
                    errorNuevoContenedor = "No se ha podido crear el contenedor.";
                return;
            }

            contenedoresList = await Http.GetFromJsonAsync<List<Contenedor>>("api/contenedores") ?? new List<Contenedor>();
            if (solicitud is not null)
            {
                switch (destinoNuevoContenedor)
                {
                    case "CodigoEntrega": solicitud.CodigoEntrega = nuevoContenedor.NumSerie; break;
                    case "CodigoAmbosEntrega": solicitud.CodigoAmbosEntrega = nuevoContenedor.NumSerie; break;
                    case "CodigoRecogida": solicitud.CodigoRecogida = nuevoContenedor.NumSerie; break;
                    case "CodigoAmbosRecogida": solicitud.CodigoAmbosRecogida = nuevoContenedor.NumSerie; break;
                }
            }

            nuevoContenedorVisible = false;
            errorNuevoContenedor = null;
        }
        catch (Exception ex)
        {
            errorNuevoContenedor = $"No se ha podido crear el contenedor: {ex.Message}";
        }
    }

    private async Task CargarFirmaAsync()
    {
        if (solicitud?.IdSolicitud <= 0 || string.IsNullOrWhiteSpace(solicitud.FirmaPath)) return;

        var response = await Http.GetAsync($"api/solicitudes/{solicitud.IdSolicitud}/firma");
        if (!response.IsSuccessStatusCode) return;

        var imagen = await response.Content.ReadAsByteArrayAsync();
        firmaImagenBase64 = $"data:image/png;base64,{Convert.ToBase64String(imagen)}";
        firmaPendienteDeMostrar = true;
    }

    private async Task OnObraChangedAsync(int val)
    {
        if (solicitud == null) return;
        solicitud.IdCliente = val;
        var obra = obras?.FirstOrDefault(o => o.IdObra == val);
        if (obra != null)
        {
            solicitud.NombreObra = obra.Descripcion;
            solicitud.NombreCliente = obra.NombreCliente;
            solicitud.DireccionCliente = obra.Ubicacion;
            solicitud.PoblacionCliente = obra.Poblacion;
            solicitud.TelefonoCliente = obra.Telefono;
            solicitud.Encargado = obra.Encargado;
            solicitud.Movil = obra.Movil;

            if (obra.Visible == false)
            {
                solicitud.Bloqueado = true;
            }

            await GeocodificarUbicacionObraAsync(obra);
        }
    }

    private async Task GeocodificarUbicacionObraAsync(Obra obra)
    {
        if (solicitud == null) return;

        var address = ST1Savall.MapHelper.BuildNormalizedQuery(
            obra.Ubicacion,
            obra.Poblacion,
            obra.CodigoPostal,
            obra.Provincia);

        if (string.IsNullOrWhiteSpace(address))
        {
            address = obra.Descripcion;
        }

        if (string.IsNullOrWhiteSpace(address)) return;

        try
        {
            var queryJson = System.Text.Json.JsonSerializer.Serialize($"{address}, Spain");
            var geocodeResult = await JSRuntime.InvokeAsync<GpsPosition>("eval", $@"
                (async () => {{
                    try {{
                        const response = await fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent({queryJson}) + '&limit=1');
                        if (!response.ok) return null;
                        const results = await response.json();
                        if (!results || results.length === 0) return null;
                        return {{ latitud: parseFloat(results[0].lat), longitud: parseFloat(results[0].lon) }};
                    }} catch (e) {{
                        return null;
                    }}
                }})()");

            if (geocodeResult != null && solicitud != null)
            {
                solicitud.Latitud = (decimal)geocodeResult.Latitud;
                solicitud.Longitud = (decimal)geocodeResult.Longitud;
                SyncCoordinates();
                StateHasChanged();
            }
        }
        catch
        {
        }
    }

    private async Task OnBloqueadoChanged(bool value)
    {
        if (solicitud == null) return;

        if (!value)
        {
            try
            {
                await SetupHeadersAsync();
                var latestObra = await Http.GetFromJsonAsync<Obra>($"api/obras/{solicitud.IdCliente}");
                if (latestObra != null)
                {
                    var idx = obras?.FindIndex(o => o.IdObra == solicitud.IdCliente) ?? -1;
                    if (idx >= 0 && obras != null)
                    {
                        obras[idx] = latestObra;
                    }

                    if (latestObra.Visible == false)
                    {
                        solicitud.Bloqueado = true;
                        popupObraBloqueadaVisible = true;
                        StateHasChanged();
                        return;
                    }
                }
            }
            catch
            {
                var obra = obras?.FirstOrDefault(o => o.IdObra == solicitud.IdCliente);
                if (obra != null && obra.Visible == false)
                {
                    solicitud.Bloqueado = true;
                    popupObraBloqueadaVisible = true;
                    StateHasChanged();
                    return;
                }
            }
        }

        solicitud.Bloqueado = value;
    }

