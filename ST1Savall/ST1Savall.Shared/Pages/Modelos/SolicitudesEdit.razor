                                    <div class="col-md-6 mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1"><label class="form-label fw-bold text-muted small mb-0">Retirada [2] - Nº Serie</label><button type="button" class="btn btn-link btn-sm p-0" @onclick='() => AbrirNuevoContenedor("CodigoAmbosRecogida", "Retirada [2]")'>Nuevo</button></div>
                                        <DxComboBox Data="@contenedoresRecogida" Enabled="@IsRecogida2Enabled"
