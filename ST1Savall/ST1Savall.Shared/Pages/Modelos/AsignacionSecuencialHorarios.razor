    private void AplicarDuracionRecalculada()
    {
        mostrarPreguntaModificarDuracion = false;
        if (solicitudRutaPendiente == null || !duracionRutaRecalculada.HasValue) return;

        var solicitud = solicitudRutaPendiente;
        solicitud.DuracionPlanificadaMinutos = duracionRutaRecalculada.Value;
        if (solicitud.FechaHoraInicioPlanificada.HasValue)
        {
            var inicio = AjustarInicioAlHorarioLaboral(solicitud.FechaHoraInicioPlanificada.Value, duracionRutaRecalculada.Value);
            solicitud.FechaHoraInicioPlanificada = inicio;
            solicitud.FechaHoraFinPlanificada = RedondearAIntervaloConfigurado(CalcularFinConsiderandoDescanso(inicio, duracionRutaRecalculada.Value));
            RecalcularServiciosPosteriores(solicitud);
        }

        ReevaluarItem(solicitud);
        solicitudRutaPendiente = null;
        duracionRutaRecalculada = null;
    }

