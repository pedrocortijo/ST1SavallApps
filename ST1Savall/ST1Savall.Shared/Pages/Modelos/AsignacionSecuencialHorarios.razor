    private void OnHoraInicioItemChanged(Solicitud item, DateTime? val)
    {
        if (val.HasValue && item.DuracionPlanificadaMinutos.GetValueOrDefault() > 0)
        {
            var inicioOriginal = val.Value;
            var inicio = AjustarInicioAlHorarioLaboral(RedondearAIntervaloConfigurado(val.Value), item.DuracionPlanificadaMinutos.Value);
            item.FechaHoraInicioPlanificada = inicio;
            item.FechaHoraFinPlanificada = RedondearAIntervaloConfigurado(CalcularFinConsiderandoDescanso(inicio, item.DuracionPlanificadaMinutos.Value));
            RecalcularServiciosPosteriores(item);

            if (inicio != inicioOriginal)
            {
                if (EsHoraDeDescanso(inicioOriginal))
                {
                    avisoDescanso = $"La hora de inicio indicada ({inicioOriginal:HH:mm}) está dentro del descanso de {horaInicioDescanso:hh\\:mm} a {horaFinDescanso:hh\\:mm}. Se ha ajustado a las {inicio:HH:mm}.";
                }
                else if (TieneDescansoValido() && inicioOriginal.TimeOfDay < horaInicioDescanso!.Value && inicioOriginal.AddMinutes(item.DuracionPlanificadaMinutos.Value).TimeOfDay > horaInicioDescanso.Value)
                {
                    avisoDescanso = $"El servicio no cabe antes del descanso de {horaInicioDescanso:hh\\:mm} a {horaFinDescanso:hh\\:mm}. Se ha programado para comenzar después del descanso a las {inicio:HH:mm}.";
                }
            }
        }
        else
        {
            item.FechaHoraInicioPlanificada = val;
        }
        ReevaluarItem(item);
    }

    private void RecalcularServiciosPosteriores(Solicitud itemModificado)
    {
        var indiceModificado = solicitudesOrdenadas.IndexOf(itemModificado);
        if (indiceModificado < 0 || !itemModificado.FechaHoraFinPlanificada.HasValue) return;

        var finAnterior = itemModificado.FechaHoraFinPlanificada.Value;
        var parametro = parametrosList?.FirstOrDefault();

        for (var indice = indiceModificado + 1; indice < solicitudesOrdenadas.Count; indice++)
        {
            var siguienteServicio = solicitudesOrdenadas[indice];
            var duracion = siguienteServicio.DuracionPlanificadaMinutos.GetValueOrDefault(60);
            if (duracion <= 0) duracion = 60;

            // Solo se mueve el siguiente servicio cuando se solapa con el anterior.
            // Si conserva un hueco válido, también se mantiene su horario y se corta la cascada.
            var inicioProgramado = siguienteServicio.FechaHoraInicioPlanificada;
            var inicioBase = !inicioProgramado.HasValue || inicioProgramado.Value < finAnterior
                ? finAnterior
                : inicioProgramado.Value;
            var inicioAjustado = AjustarInicioAlHorarioLaboral(inicioBase, duracion);
            if (!inicioProgramado.HasValue ||
                inicioProgramado.Value < finAnterior ||
                inicioAjustado != inicioProgramado.Value)
            {
                siguienteServicio.DuracionPlanificadaMinutos = duracion;
                siguienteServicio.FechaTarea = inicioAjustado.Date;
                siguienteServicio.FechaPrevista = inicioAjustado.Date;
                siguienteServicio.FechaHoraInicioPlanificada = inicioAjustado;
                siguienteServicio.FechaHoraFinPlanificada = RedondearAIntervaloConfigurado(CalcularFinConsiderandoDescanso(inicioAjustado, duracion));

                SolicitudEstadoEvaluator.EvaluarYAplicarEstado(siguienteServicio, parametro, null, estadosList);
            }

            finAnterior = siguienteServicio.FechaHoraFinPlanificada
                ?? CalcularFinConsiderandoDescanso(siguienteServicio.FechaHoraInicioPlanificada!.Value, duracion);
        }
    }

    private bool TieneDescansoValido() =>
        horaInicioDescanso.HasValue && horaFinDescanso.HasValue && horaFinDescanso > horaInicioDescanso;

    private bool EsHoraDeDescanso(DateTime fechaHora) =>
        TieneDescansoValido() &&
        fechaHora.TimeOfDay >= horaInicioDescanso!.Value &&
        fechaHora.TimeOfDay < horaFinDescanso!.Value;

    private bool CruzaDescanso(DateTime inicio, DateTime fin) =>
        TieneDescansoValido() && inicio.Date == fin.Date &&
        inicio.TimeOfDay < horaFinDescanso!.Value && fin.TimeOfDay > horaInicioDescanso!.Value;

    private DateTime RedondearAIntervaloConfigurado(DateTime fechaHora)
    {
        var minutosRedondeo = parametrosList?.FirstOrDefault()?.RedondeoHora ?? 5;
        var intervalo = TimeSpan.FromMinutes(minutosRedondeo > 0 ? minutosRedondeo : 5).Ticks;
        return new DateTime((fechaHora.Ticks + intervalo - 1) / intervalo * intervalo, fechaHora.Kind);
    }

    private DateTime CalcularFinConsiderandoDescanso(DateTime inicio, int duracion)
    {
        return inicio.AddMinutes(duracion);
    }

    private int CalcularMinutosOperacion(DateTime inicio, DateTime fin)
    {
        var minutos = (int)(fin - inicio).TotalMinutes;
        if (minutos <= 0 || !TieneDescansoValido() || inicio.Date != fin.Date)
        {
            return minutos;
        }

        var inicioDescanso = inicio.Date + horaInicioDescanso!.Value;
        var finDescanso = inicio.Date + horaFinDescanso!.Value;
        var solapeInicio = inicio > inicioDescanso ? inicio : inicioDescanso;
        var solapeFin = fin < finDescanso ? fin : finDescanso;
        if (solapeFin > solapeInicio)
        {
            minutos -= (int)(solapeFin - solapeInicio).TotalMinutes;
        }

        return minutos;
    }

    private DateTime AjustarInicioAlHorarioLaboral(DateTime inicio, int duracion)
    {
        var minutosDisponibles = (int)(horaFinJornada - horaInicioJornada).TotalMinutes;
        if (TieneDescansoValido())
        {
            minutosDisponibles -= (int)(horaFinDescanso!.Value - horaInicioDescanso!.Value).TotalMinutes;
        }

        if (duracion > minutosDisponibles)
        {
            avisoJornadaExcedida = "Hay servicios cuya duración supera el tiempo disponible de la jornada. Revise la relación y quite o reprograme los necesarios.";
            return inicio.Date + horaInicioJornada;
        }

        var candidato = inicio;

        while (true)
        {
            if (candidato.TimeOfDay < horaInicioJornada || candidato.TimeOfDay >= horaFinJornada)
            {
                candidato = candidato.Date.AddDays(candidato.TimeOfDay >= horaFinJornada ? 1 : 0) + horaInicioJornada;
            }

            if (TieneDescansoValido())
            {
                if (candidato.TimeOfDay >= horaInicioDescanso!.Value && candidato.TimeOfDay < horaFinDescanso!.Value)
                {
                    candidato = candidato.Date + horaFinDescanso.Value;
                }
                else if (candidato.TimeOfDay < horaInicioDescanso.Value)
                {
                    var finEstimado = candidato.AddMinutes(duracion);
                    if (finEstimado.Date > candidato.Date || finEstimado.TimeOfDay > horaInicioDescanso.Value)
                    {
                        candidato = candidato.Date + horaFinDescanso.Value;
                    }
                }
            }

            var fin = RedondearAIntervaloConfigurado(candidato.AddMinutes(duracion));
            if (fin.Date > candidato.Date || fin.TimeOfDay > horaFinJornada)
            {
                candidato = candidato.Date.AddDays(1) + horaInicioJornada;
                continue;
            }

            return candidato;
        }
    }

    private void OnHoraFinItemChanged(Solicitud item, DateTime? val)
    {
        DateTime? fin = val.HasValue ? RedondearAIntervaloConfigurado(val.Value) : null;
        item.FechaHoraFinPlanificada = fin;
        if (item.FechaHoraInicioPlanificada.HasValue && fin.HasValue && fin.Value > item.FechaHoraInicioPlanificada.Value)
        {
            var cruzaDescanso = CruzaDescanso(item.FechaHoraInicioPlanificada.Value, fin.Value);
            item.DuracionPlanificadaMinutos = CalcularMinutosOperacion(item.FechaHoraInicioPlanificada.Value, fin.Value);
            RecalcularServiciosPosteriores(item);
            if (cruzaDescanso)
            {
                avisoDescanso = $"El intervalo indicado incluye el descanso de {horaInicioDescanso:hh\\:mm} a {horaFinDescanso:hh\\:mm}. Esos minutos no se incluyen en la duración del servicio.";
            }
        }
        ReevaluarItem(item);
    }

    private void ReevaluarItem(Solicitud item)
    {
        var parametro = parametrosList?.FirstOrDefault();
        SolicitudEstadoEvaluator.EvaluarYAplicarEstado(item, parametro, null, estadosList);
    }

    private void ReevaluarEstados()
    {
        var parametro = parametrosList?.FirstOrDefault();
        foreach (var item in solicitudesOrdenadas)
        {
            SolicitudEstadoEvaluator.EvaluarYAplicarEstado(item, parametro, null, estadosList);
        }
    }

    private async Task AsignarHuecoIndividuoAsync(Solicitud item)
    {
        if (!item.IdConductor.HasValue) return;

        try
        {
            await SetupHeadersAsync();
            var duracion = item.DuracionPlanificadaMinutos.GetValueOrDefault(60);
            DateTime baseDate = item.FechaTarea?.Date ?? fechaTrabajo.Date;
            DateTime desde = baseDate + horaInicioJornada;
            var url = $"api/solicitudes/siguiente-hueco?idConductor={item.IdConductor.Value}&fecha={Uri.EscapeDataString(desde.ToString("O"))}&duracionMinutos={duracion}&excluirSolicitudId={item.IdSolicitud}";
            var hueco = await Http.GetFromJsonAsync<PlanificacionHueco>(url);
            if (hueco?.Disponible == true && hueco.Inicio.HasValue && hueco.Fin.HasValue)
            {
                item.FechaHoraInicioPlanificada = hueco.Inicio.Value;
                item.FechaHoraFinPlanificada = hueco.Fin.Value;
                item.FechaTarea = hueco.Inicio.Value.Date;
                ReevaluarItem(item);
                successMessage = $"Hueco asignado a la Solicitud #{item.IdSolicitud}: {hueco.Inicio:HH:mm} - {hueco.Fin:HH:mm}.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al buscar hueco libre: {ex.Message}";
        }
    }

    private async Task CalcularRutaIndividuoAsync(Solicitud item)
    {
        try
        {
            await SetupHeadersAsync();
            var response = await Http.PostAsJsonAsync("api/solicitudes/calcular-ruta?forzarActualizacion=true", item);
            if (response.IsSuccessStatusCode)
            {
                var resJson = await response.Content.ReadFromJsonAsync<CalculoRutaResultado>();
                if (resJson?.Solicitud != null)
                {
                    var duracionAnterior = item.DuracionPlanificadaMinutos;
                    var duracionNueva = resJson.Solicitud.DuracionPlanificadaMinutos;
                    item.DistanciaTotalMetros = resJson.Solicitud.DistanciaTotalMetros;
                    item.DuracionViajeMinutos = resJson.Solicitud.DuracionViajeMinutos;
                    successMessage = $"Ruta calculada para la Solicitud #{item.IdSolicitud}: {resJson.Mensaje}";

                    if (duracionNueva.HasValue && duracionNueva != duracionAnterior)
                    {
                        solicitudRutaPendiente = item;
                        duracionRutaRecalculada = duracionNueva;
                        preguntarModificarDuracionTrasExito = true;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al calcular ruta: {ex.Message}";
        }
    }

    private async Task LiberarServicioAsync(Solicitud item)
    {
        try
        {
            await SetupHeadersAsync();
            var response = await Http.PutAsync($"api/solicitudes/{item.IdSolicitud}/liberar-programacion", null);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"No se pudo liberar el servicio. {ExtraerMensajeApi(await response.Content.ReadAsStringAsync(), response.ReasonPhrase)}";
                return;
            }

            solicitudesOrdenadas.Remove(item);
            successMessage = $"El servicio #{item.IdSolicitud} se ha devuelto a pendiente.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al liberar el servicio: {ex.Message}";
        }
    }
    private async Task GuardarTodosCambiosAsync()
    {
        if (solicitudesOrdenadas.Count == 0) return;

        try
        {
            var invalidas = solicitudesOrdenadas.Where(s => EsTareaInvalida(s.IdTipoTarea)).ToList();
            if (invalidas.Count > 0)
            {
                var ids = string.Join(", ", invalidas.Select(s => $"#{s.IdSolicitud}"));
                avisoTareasInvalidas = $"No se puede guardar la planificación porque hay servicios sin Tipo de Tarea válido asignado ({ids}). Por favor, asigne una tarea a cada servicio antes de guardar la planificación.";
                return;
            }

            guardando = true;
            await SetupHeadersAsync();
            foreach (var item in solicitudesOrdenadas)
            {
                ReevaluarItem(item);
            }

            var cambios = solicitudesOrdenadas.Select(item => new ActualizacionPlanificacionSolicitud
            {
                IdSolicitud = item.IdSolicitud,
                IdConductor = item.IdConductor,
                FechaTarea = item.FechaTarea,
                FechaPrevista = item.FechaPrevista,
                FechaHoraInicioPlanificada = item.FechaHoraInicioPlanificada,
                FechaHoraFinPlanificada = item.FechaHoraFinPlanificada,
                DuracionPlanificadaMinutos = item.DuracionPlanificadaMinutos,
                Estado = item.Estado
            }).ToList();

            var response = await Http.PutAsJsonAsync("api/solicitudes/planificacion-lote", cambios);
            if (!response.IsSuccessStatusCode)
            {
                var contenido = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se guardó la planificación. {ExtraerMensajeApi(contenido, response.ReasonPhrase)}";
                return;
            }

            successMessage = $"Se han guardado y adjudicado correctamente {cambios.Count} solicitudes.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar solicitudes: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void VerificarTareasSinDefinir()
    {
        var invalidas = solicitudesOrdenadas.Where(s => EsTareaInvalida(s.IdTipoTarea)).ToList();
        if (invalidas.Count > 0)
        {
            var ids = string.Join(", ", invalidas.Select(s => $"#{s.IdSolicitud}"));
            avisoTareasInvalidas = $"Los siguientes servicios ({ids}) tienen el Tipo de Tarea sin definir (o Tarea 0) y aparecen marcados en rojo. Asigne un tipo de tarea válido editando cada servicio para garantizar una correcta programación y adjudicación.";
        }
    }

    private bool EsTareaInvalida(int idTarea)
    {
        if (idTarea <= 0) return true;
        return tareasList != null && !tareasList.Any(t => t.IdTarea == idTarea);
    }

    private static string ExtraerMensajeApi(string contenido, string? mensajeAlternativo)
    {
        if (string.IsNullOrWhiteSpace(contenido))
            return mensajeAlternativo ?? "Error desconocido.";

        const string prefijo = "{\"message\":\"";
        if (contenido.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase) && contenido.EndsWith("\"}"))
            return contenido[prefijo.Length..^2];

        return contenido;
    }

    private string GetNombreTarea(int idTarea)
    {
        var tarea = tareasList?.FirstOrDefault(t => t.IdTarea == idTarea);
        if (tarea != null && !string.IsNullOrWhiteSpace(tarea.NombreTarea))
            return tarea.NombreTarea;

        return idTarea <= 0 ? "Tarea 0" : $"Tarea {idTarea}";
    }

    private EstadoSolicitud? GetEstado(int idEstado)
    {
        return estadosList?.FirstOrDefault(e => e.IdEstado == idEstado);
    }

    private bool EsEstadoFinalizado(int idEstado)
    {
        var param = parametrosList?.FirstOrDefault();
        if (param?.EstadoFinalizado.HasValue == true && param.EstadoFinalizado.Value == idEstado) return true;

        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        if (descripcion?.Contains("finalizado", StringComparison.OrdinalIgnoreCase) == true) return true;
        if (descripcion?.Contains("anulad", StringComparison.OrdinalIgnoreCase) == true) return false;

        return idEstado == 4 || idEstado == 5;
    }

    private bool EsEstadoAnulado(int idEstado)
    {
        var param = parametrosList?.FirstOrDefault();
        if (param?.EstadoReprogramacion.HasValue == true && param.EstadoReprogramacion.Value == idEstado) return true;

        var descripcion = estadosList?.FirstOrDefault(e => e.IdEstado == idEstado)?.Descripcion;
        if (descripcion?.Contains("anulad", StringComparison.OrdinalIgnoreCase) == true) return true;

        return idEstado == 6;
    }

    private static bool EsConductor(Operario? o)
    {
        if (o == null) return false;
        if (o.IdCargo.HasValue && o.IdCargo == 1) return true;
        if (o.Cargo != null && !string.IsNullOrWhiteSpace(o.Cargo.Descripcion))
        {
            return string.Equals(o.Cargo.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase)
                || o.Cargo.Descripcion.Contains("conductor", StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

