@page "/servicios/asignacion-secuencial"
@using ST1Savall.Shared.Data
@using DevExpress.Blazor
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Programación de servicios</PageTitle>

<style>
    .enlace-solicitud {
        color: var(--bs-primary) !important;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .enlace-solicitud:hover {
        color: var(--bs-info) !important;
    }
</style>

<DxPopup @bind-Visible="mostrarErrorPopup"
         HeaderText="Error"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-circle-x text-danger fs-3"></i>
            <div>
                <p class="mb-0">@errorMessage</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="CerrarErrorAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(avisoDescanso))"
         VisibleChanged="@((bool visible) => { if (!visible) avisoDescanso = null; })"
         HeaderText="Horario de descanso"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0">@avisoDescanso</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => avisoDescanso = null" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(avisoFechaServicio))"
         VisibleChanged="@((bool visible) => { if (!visible) avisoFechaServicio = null; })"
         HeaderText="Servicio para hoy"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0">@avisoFechaServicio</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => avisoFechaServicio = null" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@(!string.IsNullOrWhiteSpace(avisoTareasInvalidas))"
         VisibleChanged="@((bool visible) => { if (!visible) avisoTareasInvalidas = null; })"
         HeaderText="Atención: Tarea sin definir"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-danger fs-3"></i>
            <div>
                <p class="mb-0">@avisoTareasInvalidas</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => avisoTareasInvalidas = null" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <DxPopup Visible="true"
             VisibleChanged="OnSuccessPopupVisibleChanged"
             HeaderText="Ruta calculada"
             ShowFooter="true"
             Width="480px"
             HorizontalAlignment="HorizontalAlignment.Center"
             VerticalAlignment="VerticalAlignment.Center">
        <BodyContentTemplate>
            <div class="py-2 d-flex align-items-center gap-3">
                <i class="oi oi-check text-success fs-3"></i>
                <div>
                    <p class="mb-0 fw-semibold">@successMessage</p>
                </div>
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <div class="d-flex justify-content-end w-100">
                <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="CerrarMensajeExito" />
            </div>
        </FooterContentTemplate>
    </DxPopup>
}

<DxPopup @bind-Visible="mostrarConfirmacionCalculoCadena"
         HeaderText="Confirmar cálculo en cadena"
         ShowFooter="true"
         Width="650px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-start gap-3">
            <i class="oi oi-info text-primary fs-3 mt-1"></i>
            <div>
                <p class="mb-2">El cálculo en cadena organizará los servicios por prioridad (Alta, Media y Baja) y optimizará su distribución en la jornada para minimizar los tiempos muertos antes del descanso y fin de jornada.</p>
                <p class="mb-0 fw-semibold">¿Desea continuar?</p>
            </div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="Cancelar" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelarCalculoEnCadenaAsync" />
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="ConfirmarCalculoEnCadenaAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="mostrarPreguntaModificarDuracion"
         HeaderText="Modificar duración"
         ShowFooter="true"
         Width="440px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <p class="mb-0">La duración total recalculada es de <strong>@duracionRutaRecalculada minutos</strong>, en lugar de los <strong>@solicitudRutaPendiente?.DuracionPlanificadaMinutos minutos</strong> actuales. ¿Desea aplicarla al servicio?</p>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 w-100">
            <DxButton Text="No" RenderStyle="ButtonRenderStyle.Secondary" Click="RechazarDuracionRecalculada" />
            <DxButton Text="Sí, aplicar" RenderStyle="ButtonRenderStyle.Primary" Click="AplicarDuracionRecalculada" />
        </div>
    </FooterContentTemplate>
</DxPopup>


@if (!string.IsNullOrWhiteSpace(avisoJornadaExcedida))
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between gap-3 mb-3" role="alert">
        <span><i class="oi oi-warning me-2"></i>@avisoJornadaExcedida</span>
        <DxButton Text="Entendido" RenderStyle="ButtonRenderStyle.Secondary" Click="() => avisoJornadaExcedida = null" />
    </div>
}
<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary mb-1">Programación de servicios</h2>
            <p class="text-muted mb-0">Establezca el orden de ejecución y programe los servicios en cadena</p>
        </div>
        <div class="d-flex gap-2">
            <NavLink href="/servicios/planificacion" class="btn btn-outline-primary btn-sm">
                <i class="oi oi-calendar me-1"></i> Planificación
            </NavLink>
            <NavLink href="/modelos/solicitudes" class="btn btn-outline-secondary btn-sm">
                <i class="oi oi-arrow-left me-1"></i> Volver a Solicitudes
            </NavLink>
        </div>
    </div>

    <!-- Panel de Selección de Conductor y Fecha -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius: 12px;">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-2">
                    <label class="form-label fw-bold text-primary mb-1">Fecha de servicio</label>
                    <DxDateEdit Date="@fechaTrabajo"
                                DateChanged="@((DateTime val) => OnFechaTrabajoChanged(val))"
                                MinDate="@DateTime.Today"
                                Format="dd/MM/yyyy"
                                DisplayFormat="dd/MM/yyyy" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-primary mb-1">Conductor</label>
                    <DxComboBox Data="@conductores"
                                TextFieldName="Nombre"
                                ValueFieldName="IdOperario"
                                Value="@selectedConductorId"
                                ValueChanged="@((int? val) => OnConductorSelectedChanged(val))"
                                NullText="Seleccione conductor..." />
                </div>
                <div class="col-md">
                    <label class="form-label fw-bold text-primary mb-1">Inicio jornada</label>
                    <DxTimeEdit Time="@horaInicioJornada"
                                TimeChanged="@((TimeSpan val) => OnHoraInicioJornadaChanged(val))"
                                Format="HH:mm" />
                </div>
                <div class="col-md">
                    <label class="form-label fw-bold text-primary mb-1">Fin jornada</label>
                    <DxTimeEdit Time="@horaFinJornada"
                                TimeChanged="@((TimeSpan val) => OnHoraFinJornadaChanged(val))"
                                Format="HH:mm"
                                DisplayFormat="HH:mm" />
                </div>
                <div class="col-md">
                    <label class="form-label fw-bold text-primary mb-1">Inicio descanso</label>
                    <DxTimeEdit Time="@horaInicioDescanso"
                                TimeChanged="@((TimeSpan? val) => OnHoraInicioDescansoChanged(val))"
                                Format="HH:mm"
                                DisplayFormat="HH:mm" />
                </div>
                <div class="col-md">
                    <label class="form-label fw-bold text-primary mb-1">Fin descanso</label>
                    <DxTimeEdit Time="@horaFinDescanso"
                                TimeChanged="@((TimeSpan? val) => OnHoraFinDescansoChanged(val))"
                                Format="HH:mm"
                                DisplayFormat="HH:mm" />
                </div>
                <div class="col-12 d-flex align-items-center justify-content-between gap-2">
                    <DxRadioGroup Items="@opcionesVistaServicios"
                                  TValue="int"
                                  TData="OpcionVistaServicios"
                                  Layout="RadioGroupLayout.Horizontal"
                                  TextFieldName="Texto"
                                  ValueFieldName="Valor"
                                  Value="@modoVistaServicios"
                                  ValueChanged="OnModoVistaServiciosChanged" />
                    <div class="d-flex gap-1">
                        @if (modoVistaServicios == 1)
                        {
                            <button class="btn btn-sm py-1 px-2 btn-warning text-dark fw-bold shadow-sm"
                                    @onclick="SolicitarCalculoEnCadena"
                                    disabled="@(solicitudesOrdenadas.Count == 0 || calculando)"
                                    title="Calcular horas inicio y fin secuencialmente según el orden actual">
                                @if (calculando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="oi oi-bolt me-1"></i>
                                }
                                Calcular en Cadena
                            </button>
                            <button class="btn btn-sm py-1 px-2 btn-primary fw-bold shadow-sm"
                                    @onclick="GuardarTodosCambiosAsync"
                                    disabled="@(solicitudesOrdenadas.Count == 0 || guardando)"
                                    title="Guardar todos los cambios de horarios y adjudicar solicitudes">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="oi oi-check me-1"></i>
                                }
                                Guardar Todo
                            </button>
                        }
                        else
                        {
                            <DxButton Text="Asignar al conductor"
                                      IconCssClass="oi oi-person"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      Enabled="@(selectedConductorId.HasValue && solicitudesSinAsignarSeleccionadas.Count > 0 && !asignando)"
                                      Click="AsignarSolicitudesSeleccionadasAsync" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted mb-0">Cargando datos...</p>
        </div>
    }
    else if (modoVistaServicios == 2)
    {
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fs-6 fw-bold text-dark mb-0">
                    <i class="oi oi-list me-2 text-primary"></i>Servicios sin asignar (@solicitudesSinAsignar.Count)
                </h5>
                <span class="text-muted small">Seleccione uno o varios servicios para asignarlos al conductor.</span>
            </div>
            <div class="card-body p-0">
                <DxGrid Data="@solicitudesSinAsignar"
                        KeyFieldName="IdSolicitud"
                        SelectedDataItems="@solicitudesSinAsignarSeleccionadas"
                        SelectedDataItemsChanged="OnSolicitudesSinAsignarSeleccionadasChanged"
                        CssClass="w-100">
                    <Columns>
                        <DxGridSelectionColumn Width="55px" />
                        <DxGridDataColumn FieldName="NombreObra" Caption="Obra" MinWidth="220" />
                        <DxGridDataColumn FieldName="DireccionCliente" Caption="Dirección de la obra" MinWidth="280" />
                        <DxGridDataColumn Caption="Cód. Postal / Población" MinWidth="210">
                            <CellDisplayTemplate Context="context">
                                @TextoCodigoPostalYPoblacion((Solicitud)context.DataItem)
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="FechaSolicitud" Caption="Fecha solicitud" DisplayFormat="dd/MM/yyyy" Width="160px" />
                    </Columns>
                </DxGrid>
            </div>
        </div>
    }
    else if (!selectedConductorId.HasValue)
    {
        <div class="alert alert-info text-center p-4 shadow-sm" style="border-radius: 12px;">
            <i class="oi oi-info fs-3 d-block mb-2 text-primary"></i>
            <strong>Seleccione un conductor</strong> para cargar sus servicios pendientes y establecer el orden de jornada.
        </div>
    }
    else if (solicitudesOrdenadas.Count == 0)
    {
        <div class="alert alert-warning text-center p-4 shadow-sm" style="border-radius: 12px;">
            <i class="oi oi-warning fs-3 d-block mb-2 text-warning"></i>
            No se encontraron solicitudes asignadas o pendientes para la fecha <strong>@fechaTrabajo.ToString("dd/MM/yyyy")</strong> con este conductor.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fs-6 fw-bold text-dark mb-0">
                    <i class="oi oi-list me-2 text-primary"></i>Secuencia de la Jornada (@solicitudesOrdenadas.Count servicios)
                </h5>
                <span class="text-muted small">Use las flechas ▲ ▼ para cambiar el orden secuencial de atención</span>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem; min-width: 940px;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;" class="text-center">Mover</th>
                            <th style="width: 78px;" class="text-center">Nº servicio</th>
                            <th style="min-width: 185px;">Obra / Cliente</th>
                            <th style="width: 82px;">Prioridad</th>
                            <th style="width: 80px;">Tipo tarea</th>
                            <th style="width: 82px;">Duración</th>
                            <th style="width: 116px;">Hora inicio</th>
                            <th style="width: 116px;">Hora fin</th>
                            <th style="width: 112px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < solicitudesOrdenadas.Count; i++)
                        {
                            var index = i;
                            var item = solicitudesOrdenadas[index];
                            var estadoObj = GetEstado(item.Estado);
                            var bgColor = estadoObj?.BgColor ?? "#6c757d";
                            var textColor = estadoObj?.TextColor ?? "#ffffff";

                            <tr>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary py-0 px-1"
                                                disabled="@(index == 0)"
                                                @onclick="() => MoverArriba(index)"
                                                title="Subir en el orden">
                                            ▲
                                        </button>
                                        <button class="btn btn-outline-secondary py-0 px-1"
                                                disabled="@(index == solicitudesOrdenadas.Count - 1)"
                                                @onclick="() => MoverAbajo(index)"
                                                title="Bajar en el orden">
                                            ▼
                                        </button>
                                    </div>
                                </td>
                                <td class="text-center fw-semibold text-nowrap"><a class="enlace-solicitud" href="@($"/modelos/solicitudes/edit/{item.IdSolicitud}?returnUrl={Uri.EscapeDataString("/servicios/asignacion-secuencial")}")" title="Abrir solicitud @item.IdSolicitud">@item.IdSolicitud</a></td>
                                <td class="align-middle">
                                    <div class="d-flex flex-column justify-content-center">
                                        <div class="fw-semibold obra-cliente-nombre">@(item.NombreObra ?? item.ObraDescripcion ?? "-")</div>
                                        <div class="small obra-cliente-detalle">@(item.NombreCliente ?? "-")</div>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center gap-2 prioridad-texto">
                                        <i class="oi oi-warning @GetClasePrioridad(item.Prioridad.GetValueOrDefault(3))" aria-hidden="true"></i>
                                        <span>@GetTextoPrioridad(item.Prioridad.GetValueOrDefault(3))</span>
                                    </div>
                                </td>
                                <td>
                                    @if (EsTareaInvalida(item.IdTipoTarea))
                                    {
                                        <span class="badge bg-danger text-white border border-danger fw-bold" title="Tipo de tarea sin definir">
                                            @(GetNombreTarea(item.IdTipoTarea))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @(GetNombreTarea(item.IdTipoTarea))
                                        </span>
                                    }
                                </td>
                                <td>
                                    <DxTextBox Text="@item.DuracionPlanificadaMinutos?.ToString()"
                                               TextChanged="@((string val) => OnDuracionTextoChanged(item, val))"
                                               InputMode="TextBoxInputMode.Numeric"
                                               MaxLength="3"
                                               BindValueMode="BindValueMode.OnInput" />
                                </td>
                                <td>
                                    <DxDateEdit Date="@item.FechaHoraInicioPlanificada"
                                                DateChanged="@((DateTime? val) => OnHoraInicioItemChanged(item, val))"
                                                TimeSectionVisible="true"
                                                Format="HH:mm"
                                                DisplayFormat="HH:mm" />
                                </td>
                                <td>
                                    <DxDateEdit Date="@item.FechaHoraFinPlanificada"
                                                DateChanged="@((DateTime? val) => OnHoraFinItemChanged(item, val))"
                                                TimeSectionVisible="true"
                                                Format="HH:mm"
                                                DisplayFormat="HH:mm" />
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center flex-nowrap">
                                        <button class="btn btn-sm btn-outline-primary py-1 px-2"
                                                @onclick="() => AsignarHuecoIndividuoAsync(item)"
                                                title="Asignar siguiente hueco libre">
                                            <i class="oi oi-clock"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-success py-1 px-2"
                                                @onclick="() => CalcularRutaIndividuoAsync(item)"
                                                title="Calcular ruta y tiempos del tramo">
                                            <i class="oi oi-map-marker"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger py-1 px-2"
                                                @onclick="() => LiberarServicioAsync(item)"
                                                title="Quitar conductor, fechas y horas; devolver a pendiente">
                                            <i class="oi oi-circle-x"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Operario>? operarios;
    private List<Operario> conductores = [];
    private List<EstadoSolicitud>? estadosList;
    private List<Tarea>? tareasList;
    private List<Parametro>? parametrosList;
    private List<Solicitud> solicitudesOrdenadas = [];
    private List<Solicitud> solicitudesSinAsignar = [];
    private IReadOnlyList<object> solicitudesSinAsignarSeleccionadas = [];
    private List<OpcionVistaServicios> opcionesVistaServicios =
    [
        new() { Valor = 1, Texto = "Servicios asignados al conductor" },
        new() { Valor = 2, Texto = "Servicios sin asignar" }
    ];
    private int modoVistaServicios = 1;
    private bool asignando;
    private string? avisoDescanso;
    private string? avisoFechaServicio;
    private string? avisoTareasInvalidas;

    private List<Obra> obras = [];
    private int? selectedConductorId;
    private DateTime fechaTrabajo = DateTime.Today;
    private TimeSpan horaInicioJornada = new TimeSpan(8, 0, 0);
    private TimeSpan horaFinJornada = new TimeSpan(17, 0, 0);
    private TimeSpan? horaInicioDescanso;
    private TimeSpan? horaFinDescanso;

    private bool loading = true;
    private bool calculando = false;
    private bool guardando = false;
    private bool mostrarConfirmacionCalculoCadena;
    private string? errorMessageInterno;
    private bool mostrarErrorPopup;
    private string? errorMessage
    {
        get => errorMessageInterno;
        set
        {
            errorMessageInterno = value;
            mostrarErrorPopup = !string.IsNullOrWhiteSpace(value);
        }
    }
    private string? successMessage;
    private string? avisoJornadaExcedida;
    private bool preguntarModificarDuracionTrasExito;
    private bool mostrarPreguntaModificarDuracion;
    private Solicitud? solicitudRutaPendiente;
    private int? duracionRutaRecalculada;

    protected override async Task OnInitializedAsync()
    {
        await SetupHeadersAsync();
        await LoadInitialDataAsync();
    }

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            loading = true;
            operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios");
            obras = await Http.GetFromJsonAsync<List<Obra>>("api/obras") ?? [];
            conductores = operarios?.Where(o => (o.Activo != false && !string.Equals(o.EstadoLaboral, "Inactivo", StringComparison.OrdinalIgnoreCase)) && EsConductor(o)).OrderBy(o => o.Nombre).ToList() ?? [];
            estadosList = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud");
            tareasList = await Http.GetFromJsonAsync<List<Tarea>>("api/tareas");
            parametrosList = await Http.GetFromJsonAsync<List<Parametro>>("api/parametros");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos iniciales: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private string TextoCodigoPostalYPoblacion(Solicitud solicitud)
    {
        var obra = obras.FirstOrDefault(o => o.IdObra == solicitud.IdCliente);
        var codigoPostal = obra?.CodigoPostal?.Trim();
        var poblacion = obra?.Poblacion?.Trim() ?? solicitud.PoblacionCliente?.Trim();
        return string.Join(" - ", new[] { codigoPostal, poblacion }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
    private async Task OnConductorSelectedChanged(int? idConductor)
    {
        selectedConductorId = idConductor;
        var conductorObj = idConductor.HasValue
            ? conductores.FirstOrDefault(c => c.IdOperario == idConductor.Value)
            : null;

        horaInicioJornada = conductorObj?.InicioJornada is { } inicio && inicio != TimeSpan.Zero
            ? inicio
            : new TimeSpan(8, 0, 0);
        horaFinJornada = conductorObj?.FinJornada is { } fin && fin != TimeSpan.Zero
            ? fin
            : new TimeSpan(17, 0, 0);
        horaInicioDescanso = conductorObj?.InicioDescanso;
        horaFinDescanso = conductorObj?.FinDescanso;

        solicitudesSinAsignarSeleccionadas = [];
        if (modoVistaServicios == 2)
            await CargarSolicitudesSinAsignarAsync();
        else
            await CargarSolicitudesConductorAsync();
    }

