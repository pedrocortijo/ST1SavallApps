    private void RecalcularConHorarioJornada()
    {
        if (horaFinJornada <= horaInicioJornada)
        {
            errorMessage = "La hora de fin de jornada debe ser posterior a la de inicio.";
            return;
        }

        if (TieneDescansoValido() &&
            (horaInicioDescanso!.Value < horaInicioJornada || horaFinDescanso!.Value > horaFinJornada))
        {
            errorMessage = "El intervalo de descanso debe estar dentro de la jornada laboral.";
            return;
        }

        EjecutarCalculoSecuencialCadena();
    }

