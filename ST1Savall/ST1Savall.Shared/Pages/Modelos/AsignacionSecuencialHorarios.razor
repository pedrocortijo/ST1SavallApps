    private async Task CargarSolicitudesSinAsignarAsync()
    {
        try
        {
            loading = true;
            await SetupHeadersAsync();
            var todas = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes") ?? [];
            solicitudesSinAsignar = todas
                .Where(s => !s.IdConductor.HasValue && !EsEstadoFinalizado(s.Estado) && !EsEstadoAnulado(s.Estado))
                .OrderBy(s => s.FechaSolicitud ?? DateTime.MaxValue)
                .ThenBy(s => s.IdSolicitud)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las solicitudes sin asignar: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AsignarSolicitudesSeleccionadasAsync()
    {
        if (!selectedConductorId.HasValue || solicitudesSinAsignarSeleccionadas.Count == 0)
            return;

        var idsDisponibles = solicitudesSinAsignar.Select(s => s.IdSolicitud).ToHashSet();
        var seleccionadas = solicitudesSinAsignarSeleccionadas
            .OfType<Solicitud>()
            .Where(s => idsDisponibles.Contains(s.IdSolicitud))
            .ToList();
        if (seleccionadas.Count == 0)
        {
            solicitudesSinAsignarSeleccionadas = [];
            return;
        }

        try
        {
            asignando = true;
            await SetupHeadersAsync();
            var asignacion = new
            {
                IdConductor = selectedConductorId,
                IdsSolicitudes = seleccionadas.Select(s => s.IdSolicitud).ToList()
            };

            var response = await Http.PutAsJsonAsync("api/solicitudes/asignar-conductor-lote", asignacion);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"No se pudieron asignar los servicios. {ExtraerMensajeApi(await response.Content.ReadAsStringAsync(), response.ReasonPhrase)}";
                return;
            }

            successMessage = $"Se han asignado {seleccionadas.Count} servicios al conductor seleccionado. Al volver a Servicios asignados al conductor se calcularán sus horas.";
            solicitudesSinAsignarSeleccionadas = [];
            await CargarSolicitudesSinAsignarAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al asignar los servicios: {ex.Message}";
        }
        finally
        {
            asignando = false;
        }
    }
