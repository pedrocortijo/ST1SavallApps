    private async Task CargarSolicitudesConductorAsync()
    {
        if (!selectedConductorId.HasValue)
        {
            solicitudesOrdenadas.Clear();
            return;
        }

        try
        {
            loading = true;
            await SetupHeadersAsync();
            var todas = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes");
            if (todas != null)
            {
                var targetDate = fechaTrabajo.Date;
                solicitudesOrdenadas = todas
                    .Where(s => s.IdConductor == selectedConductorId.Value &&
                        !EsEstadoFinalizado(s.Estado) &&
                        !EsEstadoAnulado(s.Estado) &&
                        ((s.FechaTarea.HasValue && s.FechaTarea.Value.Date == targetDate) ||
                         (s.FechaPrevista.HasValue && s.FechaPrevista.Value.Date == targetDate) ||
                         (s.FechaHoraInicioPlanificada.HasValue && s.FechaHoraInicioPlanificada.Value.Date == targetDate) ||
                         (!s.FechaTarea.HasValue && !s.FechaPrevista.HasValue && !s.FechaHoraInicioPlanificada.HasValue)))
                    .OrderBy(s => s.FechaHoraInicioPlanificada ?? DateTime.MaxValue)
                    .ThenBy(s => s.IdSolicitud)
                    .ToList();

                EjecutarCalculoSecuencialCadena();
                VerificarTareasSinDefinir();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las solicitudes del conductor: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void MoverArriba(int index)
    {
        if (index <= 0 || index >= solicitudesOrdenadas.Count) return;
        var item = solicitudesOrdenadas[index];
        solicitudesOrdenadas.RemoveAt(index);
        solicitudesOrdenadas.Insert(index - 1, item);
        EjecutarCalculoSecuencialCadena();
    }

    private void MoverAbajo(int index)
    {
        if (index < 0 || index >= solicitudesOrdenadas.Count - 1) return;
        var item = solicitudesOrdenadas[index];
        solicitudesOrdenadas.RemoveAt(index);
        solicitudesOrdenadas.Insert(index + 1, item);
        EjecutarCalculoSecuencialCadena();
    }

    private void EjecutarCalculoSecuencialCadena()
    {
        if (solicitudesOrdenadas.Count == 0) return;

        avisoJornadaExcedida = null;
        DateTime currentStart = RedondearAIntervaloConfigurado(fechaTrabajo.Date + horaInicioJornada);
        var parametro = parametrosList?.FirstOrDefault();

        for (int i = 0; i < solicitudesOrdenadas.Count; i++)
        {
            var item = solicitudesOrdenadas[i];
            int duracionOp = item.DuracionPlanificadaMinutos.GetValueOrDefault(60);
            if (duracionOp <= 0) duracionOp = 60;
            item.DuracionPlanificadaMinutos = duracionOp;

            currentStart = AjustarInicioAlHorarioLaboral(currentStart, duracionOp);
            item.FechaTarea = currentStart.Date;
            item.FechaPrevista = currentStart.Date;
            item.FechaHoraInicioPlanificada = currentStart;
            item.FechaHoraFinPlanificada = RedondearAIntervaloConfigurado(CalcularFinConsiderandoDescanso(currentStart, duracionOp));
            currentStart = item.FechaHoraFinPlanificada.Value;

            SolicitudEstadoEvaluator.EvaluarYAplicarEstado(item, parametro, null, estadosList);
        }
    }

    private async Task CalcularHorariosEnCadenaAsync()
    {
        if (solicitudesOrdenadas.Count == 0) return;

        try
        {
            calculando = true;
            solicitudesOrdenadas = OptimizarOrdenParaBloques(solicitudesOrdenadas);
            EjecutarCalculoSecuencialCadena();
            successMessage = $"Horarios calculados y optimizados en cadena para {solicitudesOrdenadas.Count} servicios.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al calcular horarios en cadena: {ex.Message}";
        }
        finally
        {
            calculando = false;
        }
    }

    private List<Solicitud> OptimizarOrdenParaBloques(List<Solicitud> items)
    {
        if (items.Count <= 1) return items;

        // Agrupamos por nivel de prioridad para respetar la prioridad estricta:
        // Prioridad 1 (Alta), Prioridad 2 (Media), Prioridad 3 / null (Baja)
        var gruposPrioridad = items
            .GroupBy(s => s.Prioridad.GetValueOrDefault(3))
            .OrderBy(g => g.Key)
            .ToList();

        var resultadoFinal = new List<Solicitud>();

        // Calculamos los bloques de tiempo de la jornada
        var capacidadManana = TieneDescansoValido()
            ? (int)(horaInicioDescanso!.Value - horaInicioJornada).TotalMinutes
            : (int)(horaFinJornada - horaInicioJornada).TotalMinutes;
        var capacidadTarde = TieneDescansoValido()
            ? (int)(horaFinJornada - horaFinDescanso!.Value).TotalMinutes
            : 0;

        if (capacidadManana <= 0) capacidadManana = 480;

        int minutosUsadosManana = 0;
        int minutosUsadosTarde = 0;

        foreach (var grupo in gruposPrioridad)
        {
            var pendientes = grupo.ToList();

            while (pendientes.Count > 0)
            {
                // ¿Hay espacio disponible en el bloque de la mañana?
                var espacioManana = capacidadManana - minutosUsadosManana;
                if (espacioManana > 0)
                {
                    // Encontrar la mejor combinación de 'pendientes' que maximice el tiempo antes del descanso
                    var seleccionManana = EncontrarMejorCombinacion(pendientes, espacioManana);
                    if (seleccionManana.Count > 0)
                    {
                        foreach (var s in seleccionManana)
                        {
                            resultadoFinal.Add(s);
                            pendientes.Remove(s);
                            minutosUsadosManana += s.DuracionPlanificadaMinutos.GetValueOrDefault(60);
                        }
                    }
                    else
                    {
                        // Ningún elemento restante cabe en el hueco de la mañana
                        minutosUsadosManana = capacidadManana;
                    }
                }
                else if (capacidadTarde > 0 && minutosUsadosTarde < capacidadTarde)
                {
                    // Estamos llenando el bloque de la tarde (después del descanso)
                    var espacioTarde = capacidadTarde - minutosUsadosTarde;
                    var seleccionTarde = EncontrarMejorCombinacion(pendientes, espacioTarde);
                    if (seleccionTarde.Count > 0)
                    {
                        foreach (var s in seleccionTarde)
                        {
                            resultadoFinal.Add(s);
                            pendientes.Remove(s);
                            minutosUsadosTarde += s.DuracionPlanificadaMinutos.GetValueOrDefault(60);
                        }
                    }
                    else
                    {
                        minutosUsadosTarde = capacidadTarde;
                    }
                }
                else
                {
                    // Si ya se llenaron los bloques de la jornada para este día, añadimos el resto
                    resultadoFinal.AddRange(pendientes);
                    pendientes.Clear();
                }
            }
        }

        return resultadoFinal;
    }

    private List<Solicitud> EncontrarMejorCombinacion(List<Solicitud> items, int capacidad)
    {
        if (items.Count == 0 || capacidad <= 0) return [];

        int n = items.Count;
        int[] duraciones = items.Select(x => Math.Max(5, x.DuracionPlanificadaMinutos.GetValueOrDefault(60))).ToArray();

        // Si solo hay 1 elemento, verificar si cabe directamente
        if (n == 1)
        {
            return duraciones[0] <= capacidad ? new List<Solicitud> { items[0] } : [];
        }

        // Programación dinámica (Knapsack 0/1) para maximizar la suma de duraciones <= capacidad
        int[,] dp = new int[n + 1, capacidad + 1];

        for (int i = 1; i <= n; i++)
        {
            int dur = duraciones[i - 1];
            for (int w = 0; w <= capacidad; w++)
            {
                if (dur <= w)
                {
                    dp[i, w] = Math.Max(dp[i - 1, w], dp[i - 1, w - dur] + dur);
                }
                else
                {
                    dp[i, w] = dp[i - 1, w];
                }
            }
        }

        // Reconstrucción de los elementos seleccionados
        var seleccionados = new List<Solicitud>();
        int pesoRestante = capacidad;
        for (int i = n; i > 0 && pesoRestante > 0; i--)
        {
            if (dp[i, pesoRestante] != dp[i - 1, pesoRestante])
            {
                seleccionados.Add(items[i - 1]);
                pesoRestante -= duraciones[i - 1];
            }
        }

        // Invertimos para conservar el orden relativo original
        seleccionados.Reverse();
        return seleccionados;
    }

