@page "/servicios/informes"
@using System.Net.Http.Json
@using DevExpress.Blazor.PivotTable
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Informes de Servicios</PageTitle>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">Informes de Servicios</h2>
            <p class="text-muted mb-0">Análisis interactivo de servicios, rutas y firmas.</p>
        </div>
        <DxButton Text="Actualizar" IconCssClass="oi oi-reload" RenderStyle="ButtonRenderStyle.Primary" Click="LoadDataAsync" Enabled="@(!loading)" />
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (loading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted mb-0">Cargando datos para los informes...</p>
        </div>
    }
    else
    {
        <DxTabs>
            <DxTabPage Text="Servicios">
                <div class="pt-3">
                    <p class="text-muted small">Analice servicios por conductor, obra, estado y mes. Puede mover los campos desde sus encabezados.</p>
                    <DxPivotTable Data="@datosServicios" CssClass="w-100" style="height: 560px;">
                        <Fields>
                            <DxPivotTableField Field="@nameof(InformeServicioPivot.Conductor)" Caption="Conductor" Area="@PivotTableArea.Row" AreaIndex="0" />
                            <DxPivotTableField Field="@nameof(InformeServicioPivot.Obra)" Caption="Obra" Area="@PivotTableArea.Row" AreaIndex="1" />
                            <DxPivotTableField Field="@nameof(InformeServicioPivot.Mes)" Caption="Mes" Area="@PivotTableArea.Column" AreaIndex="0" />
                            <DxPivotTableField Field="@nameof(InformeServicioPivot.NumeroServicios)" Caption="Nº servicios" Area="@PivotTableArea.Data" AreaIndex="0" SummaryType="@PivotTableSummaryType.Sum" />
                        </Fields>
                    </DxPivotTable>
                </div>
            </DxTabPage>
            <DxTabPage Text="Rutas y tiempos">
                <div class="pt-3">
                    <p class="text-muted small">Kilómetros y minutos previstos por conductor, obra y mes.</p>
                    <DxPivotTable Data="@datosRutas" CssClass="w-100" style="height: 560px;">
                        <Fields>
                            <DxPivotTableField Field="@nameof(InformeRutaPivot.Conductor)" Caption="Conductor" Area="@PivotTableArea.Row" AreaIndex="0" />
                            <DxPivotTableField Field="@nameof(InformeRutaPivot.Obra)" Caption="Obra" Area="@PivotTableArea.Row" AreaIndex="1" />
                            <DxPivotTableField Field="@nameof(InformeRutaPivot.Mes)" Caption="Mes" Area="@PivotTableArea.Column" AreaIndex="0" />
                            <DxPivotTableField Field="@nameof(InformeRutaPivot.Kilometros)" Caption="Km planificados" Area="@PivotTableArea.Data" AreaIndex="0" SummaryType="@PivotTableSummaryType.Sum" />
                            <DxPivotTableField Field="@nameof(InformeRutaPivot.MinutosRuta)" Caption="Minutos de ruta" Area="@PivotTableArea.Data" AreaIndex="1" SummaryType="@PivotTableSummaryType.Sum" />
                            <DxPivotTableField Field="@nameof(InformeRutaPivot.MinutosOperacion)" Caption="Minutos operación" Area="@PivotTableArea.Data" AreaIndex="2" SummaryType="@PivotTableSummaryType.Sum" />
                        </Fields>
                    </DxPivotTable>
                </div>
            </DxTabPage>
            <DxTabPage Text="Firmas e incidencias">
                <div class="pt-3">
                    <p class="text-muted small">Controle los servicios firmados, los pendientes de firma y las incidencias de planificación.</p>
                    <DxPivotTable Data="@datosFirmas" CssClass="w-100" style="height: 560px;">
                        <Fields>
                            <DxPivotTableField Field="@nameof(InformeFirmaPivot.EstadoFirma)" Caption="Firma" Area="@PivotTableArea.Row" AreaIndex="0" />
                            <DxPivotTableField Field="@nameof(InformeFirmaPivot.Incidencia)" Caption="Incidencia" Area="@PivotTableArea.Row" AreaIndex="1" />
                            <DxPivotTableField Field="@nameof(InformeFirmaPivot.Conductor)" Caption="Conductor" Area="@PivotTableArea.Column" AreaIndex="0" />
                            <DxPivotTableField Field="@nameof(InformeFirmaPivot.NumeroServicios)" Caption="Nº servicios" Area="@PivotTableArea.Data" AreaIndex="0" SummaryType="@PivotTableSummaryType.Sum" />
                        </Fields>
                    </DxPivotTable>
                </div>
            </DxTabPage>
        </DxTabs>
    }
</div>

@code {
    private List<InformeServicioPivot> datosServicios = [];
    private List<InformeRutaPivot> datosRutas = [];
    private List<InformeFirmaPivot> datosFirmas = [];
    private bool loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await SetupHeadersAsync();
        await LoadDataAsync();
    }

    private async Task SetupHeadersAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var token = authState.User.FindFirst("token")?.Value;
        if (!string.IsNullOrWhiteSpace(token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            var solicitudes = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes") ?? [];
            var estados = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud") ?? [];
            var operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? [];
            var estadoPorId = estados.ToDictionary(e => e.IdEstado, e => e.Descripcion ?? $"Estado {e.IdEstado}");
            var conductorPorId = operarios.ToDictionary(o => o.IdOperario, o => o.Nombre ?? $"Operario {o.IdOperario}");

            datosServicios = solicitudes.Select(s => CrearServicioPivot(s, estadoPorId, conductorPorId)).ToList();
            datosRutas = solicitudes.Select(s => CrearRutaPivot(s, estadoPorId, conductorPorId)).ToList();
            datosFirmas = solicitudes.Select(s => CrearFirmaPivot(s, estadoPorId, conductorPorId)).ToList();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudieron cargar los informes: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private static InformeServicioPivot CrearServicioPivot(Solicitud solicitud, IReadOnlyDictionary<int, string> estados, IReadOnlyDictionary<int, string> conductores) => new()
    {
        Mes = ObtenerMes(solicitud),
        Conductor = ObtenerConductor(solicitud, conductores),
        Cliente = solicitud.NombreCliente ?? "Sin cliente",
        Obra = solicitud.NombreObra ?? "Sin obra",
        Estado = ObtenerEstado(solicitud, estados),
        NumeroServicios = 1
    };

    private static InformeRutaPivot CrearRutaPivot(Solicitud solicitud, IReadOnlyDictionary<int, string> estados, IReadOnlyDictionary<int, string> conductores) => new()
    {
        Mes = ObtenerMes(solicitud),
        Conductor = ObtenerConductor(solicitud, conductores),
        Obra = solicitud.NombreObra ?? "Sin obra",
        Estado = ObtenerEstado(solicitud, estados),
        Kilometros = (solicitud.DistanciaTotalMetros ?? 0) / 1000m,
        MinutosRuta = solicitud.DuracionViajeMinutos ?? 0,
        MinutosOperacion = solicitud.DuracionOperacionMinutos ?? 0
    };

    private static InformeFirmaPivot CrearFirmaPivot(Solicitud solicitud, IReadOnlyDictionary<int, string> estados, IReadOnlyDictionary<int, string> conductores)
    {
        var firmada = !string.IsNullOrWhiteSpace(solicitud.FirmaNombre)
            && !string.IsNullOrWhiteSpace(solicitud.FirmaDni)
            && !string.IsNullOrWhiteSpace(solicitud.FirmaPath);
        var estado = ObtenerEstado(solicitud, estados);
        return new InformeFirmaPivot
        {
            Mes = ObtenerMes(solicitud),
            Conductor = ObtenerConductor(solicitud, conductores),
            Estado = estado,
            EstadoFirma = firmada ? "Firmada" : "Pendiente de firma",
            Incidencia = ObtenerIncidencia(solicitud, estado, firmada),
            NumeroServicios = 1
        };
    }

    private static string ObtenerMes(Solicitud solicitud) => (solicitud.FechaTarea ?? solicitud.FechaSolicitud)?.ToString("yyyy-MM") ?? "Sin fecha";
    private static string ObtenerConductor(Solicitud solicitud, IReadOnlyDictionary<int, string> conductores) => solicitud.IdConductor is int id && conductores.TryGetValue(id, out var nombre) ? nombre : "Sin asignar";
    private static string ObtenerEstado(Solicitud solicitud, IReadOnlyDictionary<int, string> estados) => estados.TryGetValue(solicitud.Estado, out var estado) ? estado : $"Estado {solicitud.Estado}";
    private static string ObtenerIncidencia(Solicitud solicitud, string estado, bool firmada)
    {
        if (estado.Contains("anulad", StringComparison.OrdinalIgnoreCase) || estado.Contains("reprogram", StringComparison.OrdinalIgnoreCase)) return "Anulado o reprogramado";
        if (solicitud.Bloqueado) return "Bloqueado";
        if (estado.Contains("finalizado", StringComparison.OrdinalIgnoreCase) && !firmada) return "Finalizado sin firma";
        return "Sin incidencia";
    }

    private sealed class InformeServicioPivot
    {
        public string Mes { get; init; } = string.Empty;
        public string Conductor { get; init; } = string.Empty;
        public string Cliente { get; init; } = string.Empty;
        public string Obra { get; init; } = string.Empty;
        public string Estado { get; init; } = string.Empty;
        public int NumeroServicios { get; init; }
    }

    private sealed class InformeRutaPivot
    {
        public string Mes { get; init; } = string.Empty;
        public string Conductor { get; init; } = string.Empty;
        public string Obra { get; init; } = string.Empty;
        public string Estado { get; init; } = string.Empty;
        public decimal Kilometros { get; init; }
        public int MinutosRuta { get; init; }
        public int MinutosOperacion { get; init; }
    }

    private sealed class InformeFirmaPivot
    {
        public string Mes { get; init; } = string.Empty;
        public string Conductor { get; init; } = string.Empty;
        public string Estado { get; init; } = string.Empty;
        public string EstadoFirma { get; init; } = string.Empty;
        public string Incidencia { get; init; } = string.Empty;
        public int NumeroServicios { get; init; }
    }
}