@page "/servicios/albaranes-venta"
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Albaranes de venta</PageTitle>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold text-primary mb-1">Albaranes de venta</h2><p class="text-muted mb-0">Control de albaranes creados en Sage 50.</p></div>
        <NavLink href="/" class="btn btn-outline-secondary btn-sm"><i class="oi oi-arrow-left me-1"></i> Volver a Inicio</NavLink>
    </div>
    @if (errorMessage is not null) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button></div> }
    <div class="card shadow-sm"><div class="card-body p-0">
        @if (albaranes is null) { <div class="p-5 text-center"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted mb-0">Cargando albaranes...</p></div> }
        else
        {
            <DxGrid @ref="grid" Data="@albaranes" KeyFieldName="Clave" EditMode="GridEditMode.PopupEditForm" EditModelSaving="OnEditModelSaving" DataItemDeleting="OnDataItemDeleting" PopupEditFormHeaderCssClass="bg-primary text-white" PopupEditFormHeaderText="Albarán de venta" PagerPosition="GridPagerPosition.Bottom" PageSize="20" AllowSort="true" ShowFilterRow="true" ShowSearchBox="true" SearchBoxNullText="Buscar albarán...">
                <Columns>
                    <DxGridCommandColumn Width="120px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                        <HeaderTemplate><button type="button" class="btn btn-sm btn-primary w-100" @onclick="() => grid?.StartEditNewRowAsync()"><i class="oi oi-plus me-1"></i> Nuevo</button></HeaderTemplate>
                        <CellDisplayTemplate>@{ var albaran = (AlbaranVentaEdicion)context.DataItem; }<div class="d-flex gap-1"><button type="button" class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => grid?.StartEditDataItemAsync(albaran)"><i class="oi oi-pencil"></i></button><button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => grid?.ShowDataItemDeleteConfirmation(albaran)"><i class="oi oi-trash"></i></button></div></CellDisplayTemplate>
                    </DxGridCommandColumn>
                    <DxGridDataColumn FieldName="Fecha" Caption="Fecha" DisplayFormat="d" Width="110px" /><DxGridDataColumn FieldName="Empresa" Caption="Empresa" Width="80px" /><DxGridDataColumn FieldName="Serie" Caption="Serie" Width="75px" /><DxGridDataColumn FieldName="Numero" Caption="Número" Width="120px" /><DxGridDataColumn FieldName="Cliente" Caption="Cliente Sage" Width="120px" /><DxGridDataColumn FieldName="Articulo" Caption="Artículo" Width="140px" /><DxGridDataColumn FieldName="Unidades" Caption="Unidades" DisplayFormat="n2" Width="110px" /><DxGridDataColumn FieldName="Precio" Caption="Precio" DisplayFormat="n2" Width="110px" /><DxGridDataColumn FieldName="Almacen" Caption="Almacén" Width="110px" /><DxGridDataColumn FieldName="Usuario" Caption="Usuario Sage" Width="180px" />
                </Columns>
                <EditFormTemplate Context="editContext">
                    @{ var albaran = (AlbaranVentaEdicion)editContext.EditModel; }
                    <DxFormLayout CssClass="w-100 p-3" CaptionPosition="CaptionPosition.Vertical">
                        <DxFormLayoutItem Caption="Empresa" ColSpanMd="3" BeginRow="true"><DxTextBox @bind-Text="albaran.Empresa" MaxLength="2" /></DxFormLayoutItem><DxFormLayoutItem Caption="Serie" ColSpanMd="3"><DxTextBox @bind-Text="albaran.Serie" MaxLength="2" /></DxFormLayoutItem><DxFormLayoutItem Caption="Número" ColSpanMd="6"><DxTextBox @bind-Text="albaran.Numero" MaxLength="10" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Fecha" ColSpanMd="4" BeginRow="true"><DxDateEdit @bind-Date="albaran.Fecha" /></DxFormLayoutItem><DxFormLayoutItem Caption="Cliente Sage" ColSpanMd="4"><DxTextBox @bind-Text="albaran.Cliente" MaxLength="8" /></DxFormLayoutItem><DxFormLayoutItem Caption="Almacén" ColSpanMd="4"><DxTextBox @bind-Text="albaran.Almacen" MaxLength="3" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Vendedor" ColSpanMd="3" BeginRow="true"><DxTextBox @bind-Text="albaran.Vendedor" MaxLength="5" /></DxFormLayoutItem><DxFormLayoutItem Caption="F. pago" ColSpanMd="3"><DxTextBox @bind-Text="albaran.FormaPago" MaxLength="2" /></DxFormLayoutItem><DxFormLayoutItem Caption="Operario" ColSpanMd="3"><DxTextBox @bind-Text="albaran.Operario" MaxLength="2" /></DxFormLayoutItem><DxFormLayoutItem Caption="Obra" ColSpanMd="3"><DxTextBox @bind-Text="albaran.Obra" MaxLength="5" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Tarifa" ColSpanMd="3" BeginRow="true"><input class="form-control" value="@albaran.Tarifa" readonly tabindex="-1" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Usuario Sage" ColSpanMd="6" BeginRow="true"><DxTextBox @bind-Text="albaran.Usuario" MaxLength="25" /></DxFormLayoutItem><DxFormLayoutItem Caption="Artículo Sage" ColSpanMd="6"><DxTextBox @bind-Text="albaran.Articulo" MaxLength="20" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Unidades" ColSpanMd="6" BeginRow="true"><DxSpinEdit @bind-Value="albaran.Unidades" MinValue="0.000001m" /></DxFormLayoutItem><DxFormLayoutItem Caption="Precio" ColSpanMd="6"><DxSpinEdit @bind-Value="albaran.Precio" MinValue="0m" /></DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanMd="12" BeginRow="true"><Template><h5 class="text-primary border-top pt-3 mt-2 mb-0">Datos del cliente</h5></Template></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="CIF" ColSpanMd="3" BeginRow="true"><input class="form-control" value="@albaran.ClienteCif" readonly tabindex="-1" /></DxFormLayoutItem><DxFormLayoutItem Caption="Nombre" ColSpanMd="9"><input class="form-control" value="@albaran.ClienteNombre" readonly tabindex="-1" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Dirección" ColSpanMd="12" BeginRow="true"><input class="form-control" value="@albaran.ClienteDireccion" readonly tabindex="-1" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="C. postal" ColSpanMd="3" BeginRow="true"><input class="form-control" value="@albaran.ClienteCodigoPostal" readonly tabindex="-1" /></DxFormLayoutItem><DxFormLayoutItem Caption="Población" ColSpanMd="4"><input class="form-control" value="@albaran.ClientePoblacion" readonly tabindex="-1" /></DxFormLayoutItem><DxFormLayoutItem Caption="Provincia" ColSpanMd="5"><input class="form-control" value="@albaran.ClienteProvincia" readonly tabindex="-1" /></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Teléfono" ColSpanMd="4" BeginRow="true"><input class="form-control" value="@albaran.ClienteTelefono" readonly tabindex="-1" /></DxFormLayoutItem><DxFormLayoutItem Caption="Email" ColSpanMd="8"><input class="form-control" value="@albaran.ClienteEmail" readonly tabindex="-1" /></DxFormLayoutItem>
                    </DxFormLayout>
                </EditFormTemplate>
            </DxGrid>
        }
    </div></div>
</div>

@code {
    private IGrid? grid;
    private List<AlbaranVentaEdicion>? albaranes;
    private string? errorMessage;
    protected override async Task OnInitializedAsync() { await SetupHeadersAsync(); await LoadDataAsync(); }
    private async Task SetupHeadersAsync() { var state = await AuthStateProvider.GetAuthenticationStateAsync(); var token = state.User.FindFirst("token")?.Value; if (!string.IsNullOrEmpty(token)) Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token); }
    private async Task LoadDataAsync() { try { albaranes = await Http.GetFromJsonAsync<List<AlbaranVentaEdicion>>("api/albaranes-venta") ?? []; errorMessage = null; } catch (Exception ex) { errorMessage = $"Error al cargar los albaranes: {ex.Message}"; albaranes ??= []; } }
    private async Task OnEditModelSaving(GridEditModelSavingEventArgs e) { var a = (AlbaranVentaEdicion)e.EditModel; try { await SetupHeadersAsync(); var response = e.IsNew ? await Http.PostAsJsonAsync("api/albaranes-venta", a) : await Http.PutAsJsonAsync("api/albaranes-venta", a); if (!response.IsSuccessStatusCode) { var error = await response.Content.ReadFromJsonAsync<ApiMessage>(); errorMessage = error?.Message ?? $"Error al guardar el albarán: {response.ReasonPhrase}"; e.Cancel = true; return; } await LoadDataAsync(); } catch (Exception ex) { errorMessage = $"Error al guardar el albarán: {ex.Message}"; e.Cancel = true; } }
    private async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e) { var a = (AlbaranVentaEdicion)e.DataItem; try { await SetupHeadersAsync(); var url = $"api/albaranes-venta?empresa={Uri.EscapeDataString(a.Empresa)}&numero={Uri.EscapeDataString(a.Numero)}&serie={Uri.EscapeDataString(a.Serie)}"; var response = await Http.DeleteAsync(url); if (!response.IsSuccessStatusCode) { errorMessage = $"Error al eliminar el albarán: {response.ReasonPhrase}"; e.Cancel = true; return; } await LoadDataAsync(); } catch (Exception ex) { errorMessage = $"Error al eliminar el albarán: {ex.Message}"; e.Cancel = true; } }
    private sealed class ApiMessage { public string? Message { get; set; } }
}
