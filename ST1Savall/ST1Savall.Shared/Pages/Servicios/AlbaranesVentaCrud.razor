@page "/servicios/albaranes-venta"
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Albaranes de venta</PageTitle>

<DxPopup Visible="@errorPopupVisible"
         VisibleChanged="@((bool visible) => errorPopupVisible = visible)"
         HeaderText="No se ha podido guardar el albarán"
         ShowFooter="true"
         Width="560px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-start gap-3">
            <i class="oi oi-circle-x text-danger fs-3"></i>
            <div><p class="mb-0 text-break">@errorMessage</p></div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="CerrarPopupError" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup Visible="@guardandoAlbaran"
         HeaderText="Guardando albarán"
         ShowCloseButton="false"
         CloseOnOutsideClick="false"
         Width="360px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-3 d-flex align-items-center gap-3">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Esperando respuesta de la API…</span>
        </div>
    </BodyContentTemplate>
</DxPopup>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold text-primary mb-1">Albaranes de venta</h2><p class="text-muted mb-0">Control de albaranes creados en Sage 50.</p></div>
        <NavLink href="/" class="btn btn-outline-secondary btn-sm"><i class="oi oi-arrow-left me-1"></i> Volver a Inicio</NavLink>
    </div>
    <div class="card shadow-sm"><div class="card-body p-0">
        @if (albaranes is null) { <div class="p-5 text-center"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted mb-0">Cargando albaranes...</p></div> }
        else
        {
            <DxGrid @ref="grid" Data="@albaranes" KeyFieldName="Clave" EditMode="GridEditMode.PopupEditForm" EditModelSaving="OnEditModelSaving" DataItemDeleting="OnDataItemDeleting" PopupEditFormHeaderCssClass="bg-primary text-white" PopupEditFormHeaderText="Albarán de venta" PagerPosition="GridPagerPosition.Bottom" PageSize="20" AllowSort="true" ShowFilterRow="true" ShowSearchBox="true" SearchBoxNullText="Buscar albarán..." ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" HorizontalScrollBarMode="ScrollBarMode.Auto" ValidationEnabled="false">
                <Columns>
                    <DxGridCommandColumn 
                        Width="90px" 
                        NewButtonVisible="false" 
                        EditButtonVisible="false" 
                        DeleteButtonVisible="false">
                        <HeaderTemplate><button type="button" class="btn btn-sm btn-primary w-100" @onclick="() => grid?.StartEditNewRowAsync()"><i class="oi oi-plus me-1"></i> Nuevo</button></HeaderTemplate>
                        <CellDisplayTemplate>@{ var albaran = (AlbaranVentaEdicion)context.DataItem; }
                            <div class="d-flex gap-1"><button type="button" class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => grid?.StartEditDataItemAsync(albaran)"><i class="oi oi-pencil"></i></button><button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => grid?.ShowDataItemDeleteConfirmation(albaran)"><i class="oi oi-trash"></i></button>
                            </div>
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                    <DxGridDataColumn
                        FieldName="Fecha" 
                        Caption="Fecha" 
                        DisplayFormat="d" 
                        Width="90px" />
                    <DxGridDataColumn Caption="Albarán" Width="100px">
                        <CellDisplayTemplate>
                            @{ var albaran = (AlbaranVentaEdicion)context.DataItem; }
                            @($"{albaran.Serie.Trim()}-{albaran.Numero.Trim()}")
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Obra" Width="220px">
                        <CellDisplayTemplate>
                            @{ var albaran = (AlbaranVentaEdicion)context.DataItem; }
                            @($"{albaran.Obra.Trim()}-{albaran.ObraNombre.Trim()}")
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn
                        FieldName="ClienteNombre" 
                        Caption="Nombre cliente" 
                        Width="210px" />
                    <DxGridDataColumn
                        FieldName="Articulo" 
                        Caption="Artículo" 
                        Width="120px" />
                    <DxGridDataColumn FieldName="TotalDocumento" Caption="Total" DisplayFormat="n2" Width="100px" TextAlignment="GridTextAlignment.Right" />

                </Columns>
                <EditFormTemplate Context="editContext">
                    @{ var albaran = (AlbaranVentaEdicion)editContext.EditModel; }

                    <div class="row g-0 p-3 albaran-cabecera">
                        <div class="col-lg-6 pe-lg-3"><section class="albaran-grupo h-100"><h6>Cabecera del albarán</h6><div class="row g-2">
                            <div class="col-1">
                                <label class="form-label">Serie</label>
                                <DxTextBox @bind-Text="albaran.Serie" MaxLength="2" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Número</label>
                                <DxTextBox @bind-Text="albaran.Numero" MaxLength="10" />
                            </div><div class="col-3"><label class="form-label">Fecha</label><DxDateEdit @bind-Date="albaran.Fecha" /></div>
                            <div class="col-6"><label class="form-label">F. pago</label><DxComboBox Data="@formasPago" TData="FpagSage50" TValue="string" TextFieldName="Nombre" ValueFieldName="Codigo" @bind-Value="albaran.FormaPago" SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains" NullText="Seleccione..."><ItemTemplate Context="formaPago"><strong>@formaPago.Codigo</strong> - @formaPago.Nombre</ItemTemplate></DxComboBox></div>
                            <div class="col-12"><label class="form-label">Obra</label><DxComboBox Data="@obrasSage" TData="CodigoNombre" TValue="string" TextFieldName="Descripcion" ValueFieldName="Codigo" @bind-Value="albaran.Obra" @bind-Value:after="@(() => ActualizarDatosObraAsync(albaran))" SearchMode="ListSearchMode.AutoSearch" ClearButtonVisible="true" NullText="Seleccione una obra..." /></div>
                            <div class="col-3"><label class="form-label">Vendedor</label><DxTextBox @bind-Text="albaran.Vendedor" MaxLength="5" /></div><div class="col-3"><label class="form-label">Factura</label><input class="form-control" value="@albaran.Factura" readonly tabindex="-1" /></div><div class="col-3"><label class="form-label">Fecha factura</label><input class="form-control" value="@FormatearFecha(albaran.FechaFactura)" readonly tabindex="-1" /></div><div class="col-3"><label class="form-label">Tarifa</label><input class="form-control" value="@albaran.Tarifa" readonly tabindex="-1" /></div>
                        </div></section></div>
                        <div class="col-lg-6 ps-lg-3 pt-3 pt-lg-0"><section class="albaran-grupo h-100"><h6>Datos del cliente</h6><div class="row g-2">
                            <div class="col-3"><label class="form-label">Código cliente</label><input class="form-control" value="@albaran.Cliente" readonly tabindex="-1" /></div><div class="col-3"><label class="form-label">CIF</label><input class="form-control" value="@albaran.ClienteCif" readonly tabindex="-1" /></div><div class="col-6"><label class="form-label">Nombre</label><input class="form-control" value="@albaran.ClienteNombre" readonly tabindex="-1" /></div>
                            <div class="col-12"><label class="form-label">Dirección</label><input class="form-control" value="@albaran.ClienteDireccion" readonly tabindex="-1" /></div>
                            <div class="col-3"><label class="form-label">Cód. postal</label><input class="form-control" value="@albaran.ClienteCodigoPostal" readonly tabindex="-1" /></div><div class="col-5"><label class="form-label">Población</label><input class="form-control" value="@albaran.ClientePoblacion" readonly tabindex="-1" /></div><div class="col-4"><label class="form-label">Provincia</label><input class="form-control" value="@albaran.ClienteProvincia" readonly tabindex="-1" /></div>
                        </div></section></div>
                        <div class="col-12 border-top mt-3 pt-3">
                            <h6 class="albaran-detalle-titulo">Detalle del albarán</h6>
                        <div class="row g-2">
                            <div class="col-md-2">
                                <label class="form-label">Artículo</label>
                                <DxComboBox Data="@articulosSage" TData="ArticuloSage50" TValue="string" TextFieldName="Codigo" ValueFieldName="Codigo" @bind-Value="albaran.Articulo" @bind-Value:after="@(() => ActualizarDefinicionArticulo(albaran))" SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains" ClearButtonVisible="true" NullText="Seleccione..."><ItemTemplate Context="articulo"><strong>@articulo.Codigo</strong> - @articulo.Nombre</ItemTemplate></DxComboBox></div><div class="col-md-5"><label class="form-label">Definición</label><DxTextBox @bind-Text="albaran.Definicion" MaxLength="100" /></div><div class="col-md-1"><label class="form-label">Unidades</label><DxSpinEdit @bind-Value="albaran.Unidades" MinValue="0.000001m" DecimalPlaces="2" DisplayFormat="n2" /></div><div class="col-md-1"><label class="form-label">Precio</label><DxSpinEdit @bind-Value="albaran.Precio" MinValue="0m" DecimalPlaces="2" DisplayFormat="n2" /></div><div class="col-md-1"><label class="form-label">Dto. 1</label><DxSpinEdit @bind-Value="albaran.Descuento1" MinValue="0m" MaxValue="100m" /></div><div class="col-md-1"><label class="form-label">Dto. 2</label><DxSpinEdit @bind-Value="albaran.Descuento2" MinValue="0m" MaxValue="100m" /></div><div class="col-md-1"><label class="form-label">Importe</label><input class="form-control text-center fw-bold" value="@FormatearImporte(albaran)" readonly tabindex="-1" /></div>
                        </div>                        <div class="row align-items-start mt-3">
                            <div class="col-md-4"><h6 class="albaran-detalle-titulo mb-2">Campos adicionales</h6></div>
                            <div class="col-md-8 d-flex flex-column align-items-md-end"><div class="albaran-totales-contenedor"><h6 class="albaran-detalle-titulo mb-2">Totales</h6></div></div>
                        </div>
                        <div class="row align-items-start mt-1">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <div class="border rounded px-3 py-2 albaran-campos-adicionales">
                                        <div class="row g-2">
                                            <div class="col-sm-6"><span class="fw-bold">Matrícula: </span><span class="text-info">@albaran.Matricula</span></div>
                                                <div class="col-sm-6"><span class="fw-bold">Albarán planta: </span><span class="text-info"> @albaran.AlbaranPlanta</span></div>
                                                <div class="col-sm-6"><span class="fw-bold">Fecha: </span><span class="text-info"> @albaran.FechaPlanta</span></div>
                                                <div class="col-sm-6"><span class="fw-bold">Neto Kg: </span><span class="text-info"> @albaran.NetoKg</span></div>
                                        </div>
                                </div>
                            </div>
                            <div class="col-md-8 d-flex flex-column align-items-md-end">
                                <div class="albaran-totales-contenedor">
                                    <div class="border rounded px-3 py-2 albaran-totales">
                                <div class="d-flex justify-content-between gap-4"><span>Base imponible</span><strong>@FormatearBase(albaran) €</strong></div>
                                <div class="d-flex justify-content-between gap-4 mt-1"><span>IVA (@albaran.PorcentajeIva.ToString("N2")%)</span><strong>@albaran.ImporteIva.ToString("N2") €</strong></div>
                                <div class="d-flex justify-content-between gap-4 mt-1 border-top pt-1"><span>Total albarán</span><strong class="text-primary">@FormatearTotal(albaran) €</strong></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>
                </EditFormTemplate>
            </DxGrid>
        }
    </div></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "serie")] public string? SerieSolicitada { get; set; }
    [SupplyParameterFromQuery(Name = "numero")] public string? NumeroSolicitado { get; set; }
    private IGrid? grid;
    private List<AlbaranVentaEdicion>? albaranes;
    private List<CodigoNombre> clientesSage = [];
    private List<CodigoNombre> obrasSage = [];
    private List<ClienteSage50> clientesSageDatos = [];
    private List<FpagSage50> formasPago = [];
    private List<ArticuloSage50> articulosSage = [];
    private string? errorMessage;
    private bool errorPopupVisible;
    private bool guardandoAlbaran;
    private bool abrirAlbaranSolicitado;
    protected override async Task OnInitializedAsync() { await SetupHeadersAsync(); await LoadDataAsync(); }
    protected override void OnParametersSet() => abrirAlbaranSolicitado = !string.IsNullOrWhiteSpace(SerieSolicitada) && !string.IsNullOrWhiteSpace(NumeroSolicitado);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!abrirAlbaranSolicitado || grid is null || albaranes is null) return;
        abrirAlbaranSolicitado = false;
        var albaran = albaranes.FirstOrDefault(a =>
            string.Equals(a.Serie.Trim(), SerieSolicitada?.Trim(), StringComparison.OrdinalIgnoreCase)
            && string.Equals(a.Numero.Trim(), NumeroSolicitado?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (albaran is null)
        {
            errorMessage = $"No se ha encontrado el albarán {SerieSolicitada}-{NumeroSolicitado}.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        await grid.StartEditDataItemAsync(albaran);
    }
    private async Task SetupHeadersAsync() { var state = await AuthStateProvider.GetAuthenticationStateAsync(); var token = state.User.FindFirst("token")?.Value; if (!string.IsNullOrEmpty(token)) Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token); }
    private static string FormatearFecha(DateTime? fecha) => fecha?.ToString("dd/MM/yyyy") ?? string.Empty;
    private static string FormatearImporte(AlbaranVentaEdicion albaran) => (albaran.Unidades * albaran.Precio * (1m - albaran.Descuento1 / 100m) * (1m - albaran.Descuento2 / 100m)).ToString("N2");
    private static string FormatearBase(AlbaranVentaEdicion albaran) => FormatearImporte(albaran);
    private static string FormatearTotal(AlbaranVentaEdicion albaran) => albaran.TotalDocumento.ToString("N2");
    private void ActualizarDefinicionArticulo(AlbaranVentaEdicion albaran)
    {
        albaran.Articulo = albaran.Articulo?.Trim() ?? string.Empty;
        albaran.Definicion = articulosSage.FirstOrDefault(a => string.Equals(a.Codigo.Trim(), albaran.Articulo, StringComparison.OrdinalIgnoreCase))?.Nombre.Trim() ?? string.Empty;
    }
    private async Task ActualizarDatosObraAsync(AlbaranVentaEdicion albaran)
    {
        var obra = obrasSage.FirstOrDefault(o => o.Codigo == albaran.Obra);
        if (obra is null) return;
        albaran.ObraNombre = obra.Nombre;
        albaran.Cliente = obra.Cliente;
        await ActualizarDatosClienteAsync(albaran);
    }
    private async Task ActualizarDatosClienteAsync(AlbaranVentaEdicion albaran)
    {
        var cliente = clientesSageDatos.FirstOrDefault(c => string.Equals(c.Codigo.Trim(), albaran.Cliente?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (cliente is null) return;
        albaran.ClienteCif = cliente.Cif.Trim(); albaran.ClienteNombre = cliente.Nombre.Trim();
        albaran.ClienteDireccion = cliente.Direccion.Trim(); albaran.ClienteCodigoPostal = cliente.Codpost.Trim();
        albaran.ClientePoblacion = cliente.Poblacion.Trim(); albaran.ClienteProvincia = cliente.Provincia.Trim();
        albaran.ClienteTelefono = cliente.Telefono.Trim(); albaran.ClienteEmail = cliente.Email.Trim();
        albaran.FormaPago = cliente.Fpag.Trim(); albaran.Tarifa = cliente.Tarifa.Trim();
        try
        {
            var direccion = await Http.GetFromJsonAsync<DireccionEnvioClienteSage50>($"api/albaranes-venta/direccion-envio/{Uri.EscapeDataString(albaran.Cliente)}");
            if (direccion is not null) { albaran.ClienteDireccion = direccion.DIRECCION.Trim(); albaran.ClienteCodigoPostal = direccion.CODPOS.Trim(); albaran.ClientePoblacion = direccion.POBLACION.Trim(); albaran.ClienteProvincia = direccion.PROVINCIA.Trim(); }
        }
        catch (HttpRequestException) { }
    }
    private async Task LoadDataAsync() { try { var albaranesTask = Http.GetFromJsonAsync<List<AlbaranVentaEdicion>>("api/albaranes-venta"); var clientesTask = Http.GetFromJsonAsync<List<ClienteSage50>>("api/clientessage50"); var obrasTask = Http.GetFromJsonAsync<List<ObraComunSage50>>("api/obrascomunsage50"); var formasPagoTask = Http.GetFromJsonAsync<List<FpagSage50>>("api/fpagsage50"); var articulosTask = Http.GetFromJsonAsync<List<ArticuloSage50>>("api/articulos-sage50"); await Task.WhenAll(albaranesTask, clientesTask, obrasTask, formasPagoTask, articulosTask); albaranes = albaranesTask.Result ?? []; clientesSageDatos = clientesTask.Result ?? []; clientesSage = clientesSageDatos.GroupBy(c => c.Codigo.Trim()).Select(g => new CodigoNombre(g.Key, g.First().Nombre.Trim())).OrderBy(x => x.Descripcion).ToList(); obrasSage = (obrasTask.Result ?? []).Select(o => new CodigoNombre(o.Codigo.Trim(), o.Nombre.Trim(), o.Cliente.Trim())).OrderBy(x => x.Descripcion).ToList(); formasPago = (formasPagoTask.Result ?? []).Select(f => { f.Codigo = f.Codigo.Trim(); f.Nombre = f.Nombre.Trim(); return f; }).OrderBy(f => f.Codigo).ToList(); articulosSage = (articulosTask.Result ?? []).Select(a => { a.Codigo = a.Codigo?.Trim() ?? string.Empty; a.Nombre = a.Nombre?.Trim() ?? string.Empty; return a; }).OrderBy(a => a.Codigo).ToList(); errorMessage = null; } catch (Exception ex) { errorMessage = $"Error al cargar los albaranes: {ex.Message}"; albaranes ??= []; } }
    private async Task OnEditModelSaving(GridEditModelSavingEventArgs e)
    {
        var a = (AlbaranVentaEdicion)e.EditModel;
        guardandoAlbaran = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await SetupHeadersAsync();
            using var cancelacion = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var response = e.IsNew
                ? await Http.PostAsJsonAsync("api/albaranes-venta", a, cancelacion.Token)
                : await Http.PutAsJsonAsync("api/albaranes-venta", a, cancelacion.Token);
            if (!response.IsSuccessStatusCode)
            {
                await MostrarErrorAsync(await ObtenerMensajeErrorAsync(response, "Error al guardar el albarán"));
                e.Cancel = true;
                return;
            }
            await LoadDataAsync();
        }
        catch (OperationCanceledException)
        {
            await MostrarErrorAsync("La API no ha respondido al guardar el albarán tras 15 segundos. Compruebe que el servicio local está iniciado.");
            e.Cancel = true;
        }
        catch (Exception ex)
        {
            await MostrarErrorAsync($"Error al guardar el albarán: {ex.Message}");
            e.Cancel = true;
        }
        finally
        {
            guardandoAlbaran = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task MostrarErrorAsync(string mensaje)
    {
        errorMessage = mensaje;
        errorPopupVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private void CerrarPopupError()
    {
        errorPopupVisible = false;
        errorMessage = null;
    }
    private async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e) { var a = (AlbaranVentaEdicion)e.DataItem; try { await SetupHeadersAsync(); var url = $"api/albaranes-venta?empresa={Uri.EscapeDataString(a.Empresa)}&numero={Uri.EscapeDataString(a.Numero)}&serie={Uri.EscapeDataString(a.Serie)}"; var response = await Http.DeleteAsync(url); if (!response.IsSuccessStatusCode) { errorMessage = $"Error al eliminar el albarán: {response.ReasonPhrase}"; e.Cancel = true; return; } await LoadDataAsync(); } catch (Exception ex) { errorMessage = $"Error al eliminar el albarán: {ex.Message}"; e.Cancel = true; } }
    private static async Task<string> ObtenerMensajeErrorAsync(HttpResponseMessage response, string titulo)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        try
        {
            using var documento = System.Text.Json.JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;
            foreach (var propiedad in new[] { "message", "detail", "title" })
                if (raiz.TryGetProperty(propiedad, out var valor) && !string.IsNullOrWhiteSpace(valor.GetString()))
                    return $"{titulo}: {valor.GetString()}";
        }
        catch (System.Text.Json.JsonException) { }
        return $"{titulo} ({(int)response.StatusCode} {response.ReasonPhrase}).";
    }
    private sealed class ApiMessage { public string? Message { get; set; } }
    private sealed record CodigoNombre(string Codigo, string Nombre, string Cliente = "") { public string Descripcion => $"{Codigo}-{Nombre}"; }
}
