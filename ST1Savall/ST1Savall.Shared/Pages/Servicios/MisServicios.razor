@page "/servicios/mis-servicios"
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Servicios asignados</PageTitle>

<style>
    .mis-servicios-header { gap: 16px; }
    .servicios-asignados-titulo { font-size: 1.1rem; }
    .servicios-asignados-conductor { color: #000000; }
    html.theme-blazing-dark .servicios-asignados-conductor,
    html.theme-fluent-dark .servicios-asignados-conductor { color: #ffc107; }
    .mis-servicios-refresh { min-height: 44px; min-width: 120px; }
    .servicios-tablet-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .servicio-tablet-card { border: 1px solid var(--bs-border-color, #d8dce1); border-left: 5px solid #0d6efd; border-radius: 12px; padding: 16px; min-height: 225px; display: flex; flex-direction: column; gap: 12px; }
    .servicio-tablet-card .servicio-hora { font-size: 1.7rem; font-weight: 700; line-height: 1; color: #0d6efd; }
    .servicio-tablet-card .servicio-tarea { font-size: 1rem; font-weight: 700; }
    .servicio-tablet-card .servicio-cliente { font-size: 1rem; font-weight: 600; }
    .servicio-tablet-card .servicio-direccion { font-size: .9rem; }
    .servicio-estado-iniciado { background-color: #198754 !important; color: #ffffff !important; font-size: 1.15rem; padding: .5rem .8rem; }
    .servicio-tablet-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: auto; }
    .servicio-tablet-actions .btn { min-height: 44px; font-weight: 600; }
    @@media (max-width: 700px) { .servicios-tablet-grid { grid-template-columns: 1fr; } .mis-servicios-header { align-items: stretch !important; } }
</style>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mis-servicios-header mb-3">
        <div>
            <h2 class="fw-bold text-primary mb-1 servicios-asignados-titulo">Servicios asignados a: <span class="servicios-asignados-conductor">@(conductorNombre ?? "...")</span></h2>
        </div>
        <button class="btn btn-outline-secondary mis-servicios-refresh" @onclick="LoadDataAsync"><i class="oi oi-reload me-1"></i>Actualizar</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (loading)
    {
        <div class="p-5 text-center"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Cargando servicios...</p></div>
    }
    else if (!string.IsNullOrWhiteSpace(userName) && servicios.Count == 0)
    {
        <div class="alert alert-info">No hay servicios asignados a <strong>@userName</strong>.</div>
    }
    else
    {
        <div class="servicios-tablet-grid">
            @foreach (var servicio in servicios)
            {
                <article class="servicio-tablet-card">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div><div class="small text-muted">Servicio #@servicio.IdSolicitud · @servicio.FechaTarea?.ToString("dd/MM/yyyy")</div><div class="servicio-hora">@(servicio.FechaHoraInicioPlanificada?.ToString("HH:mm") ?? "Sin hora")</div></div>
                        <span class="badge @(EsServicioIniciado(servicio) ? "servicio-estado-iniciado" : "text-bg-secondary")">@servicio.EstadoDescripcion</span>
                    </div>
                    <div class="servicio-tarea">@servicio.TipoTareaDescripcion</div>
                    <div><div class="servicio-cliente">@servicio.NombreCliente</div><div class="servicio-direccion text-muted">@servicio.NombreObra</div><div class="servicio-direccion text-muted">@servicio.DireccionCliente, @servicio.PoblacionCliente</div></div>
                    <div class="servicio-tablet-actions">
                        <button class="btn btn-primary" @onclick="() => OpenServicio(servicio.IdSolicitud)"><i class="oi oi-eye me-1"></i>Ver servicio</button>
                        <button class="btn @(EsServicioIniciado(servicio) ? "btn-outline-warning" : "btn-outline-success")"
                                disabled="@(iniciandoServicioId == servicio.IdSolicitud)"
                                @onclick="() => CambiarInicioServicioAsync(servicio)">
                            <i class="@(EsServicioIniciado(servicio) ? "oi oi-x me-1" : "oi oi-media-play me-1")"></i>
                            @(iniciandoServicioId == servicio.IdSolicitud ? "Actualizando..." : EsServicioIniciado(servicio) ? "Cancelar" : "Iniciar")
                        </button>
                        <button class="btn btn-outline-primary" disabled="@(!EsServicioIniciado(servicio))" @onclick="() => AbrirFirma(servicio.IdSolicitud)"><i class="oi oi-pencil me-1"></i>Firma</button>
                        <button class="btn btn-outline-danger" disabled="@(!EsServicioIniciado(servicio) || finalizandoServicioId == servicio.IdSolicitud)" @onclick="() => FinalizarServicioAsync(servicio.IdSolicitud)">
                            <i class="oi oi-media-stop me-1"></i>@(finalizandoServicioId == servicio.IdSolicitud ? "Finalizando..." : "Finalizar")
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</div>

<DxPopup @bind-Visible="mensajePopupVisible"
         HeaderText="No se puede finalizar el servicio"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0">@mensajePopup</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => mensajePopupVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@if (!string.IsNullOrWhiteSpace(pendingAction))
{
    <div class="alert alert-info position-fixed bottom-0 end-0 m-4 shadow">@pendingAction estará disponible al incorporar las reglas de negocio.<button class="btn-close ms-3" @onclick="() => pendingAction = null"></button></div>
}

@code {
    private readonly List<Solicitud> servicios = [];
    private bool loading = true;
    private string? errorMessage, pendingAction, userName, conductorNombre;
    private int? iniciandoServicioId;
    private int? finalizandoServicioId;
    private bool mensajePopupVisible;
    private string? mensajePopup;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        loading = true; errorMessage = null;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            userName = state.User.Identity?.Name;
            var token = state.User.FindFirst("token")?.Value;
            if (!string.IsNullOrWhiteSpace(token)) Http.DefaultRequestHeaders.Authorization = new("Bearer", token);
            var solicitudes = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes") ?? [];
            var operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? [];
            var users = await Http.GetFromJsonAsync<List<ApplicationUserDto>>("api/users") ?? [];
            var tareas = await Http.GetFromJsonAsync<List<Tarea>>("api/tareas") ?? [];
            var estados = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud") ?? [];
            var conductor = operarios.FirstOrDefault(o => string.Equals(o.Nombre,
                users.FirstOrDefault(u => string.Equals(u.Email, userName, StringComparison.OrdinalIgnoreCase))?.Tecnico,
                StringComparison.OrdinalIgnoreCase));
            var conductorId = conductor?.IdOperario;
            conductorNombre = conductor?.Nombre;
            servicios.Clear();
            servicios.AddRange(solicitudes.Where(s =>
                    s.IdConductor == conductorId
                    && s.FechaTarea?.Date == DateTime.Today)
                .OrderBy(s => s.FechaHoraInicioPlanificada ?? DateTime.MaxValue)
                .ThenBy(s => s.IdSolicitud));
            foreach (var s in servicios)
            {
                s.ConductorNombre = operarios.FirstOrDefault(o => o.IdOperario == s.IdConductor)?.Nombre ?? "-";
                s.TipoTareaDescripcion = tareas.FirstOrDefault(t => t.IdTarea == s.IdTipoTarea)?.NombreTarea ?? "-";
                s.EstadoDescripcion = estados.FirstOrDefault(e => e.IdEstado == s.Estado)?.Descripcion ?? "-";
            }
        }
        catch (Exception ex) { errorMessage = $"No se han podido cargar los servicios: {ex.Message}"; }
        finally { loading = false; }
    }
    private void OpenServicio(int id) => NavigationManager.NavigateTo($"/servicios/mis-servicios/{id}");
    private void AbrirFirma(int id) => NavigationManager.NavigateTo($"/servicios/mis-servicios/{id}/firma");

    private static bool EsServicioIniciado(Solicitud servicio) =>
        servicio.EstadoDescripcion?.Contains("iniciado", StringComparison.OrdinalIgnoreCase) == true;

    private Task CambiarInicioServicioAsync(Solicitud servicio) =>
        EsServicioIniciado(servicio)
            ? CancelarInicioServicioAsync(servicio.IdSolicitud)
            : IniciarServicioAsync(servicio.IdSolicitud);

    private async Task IniciarServicioAsync(int idSolicitud)
    {
        iniciandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/iniciar", null);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "No se ha podido iniciar el servicio.";
                return;
            }

            pendingAction = "Servicio iniciado.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido iniciar el servicio: {ex.Message}";
        }
        finally
        {
            iniciandoServicioId = null;
        }
    }

    private async Task CancelarInicioServicioAsync(int idSolicitud)
    {
        iniciandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/cancelar-inicio", null);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "No se ha podido cancelar el inicio del servicio.";
                return;
            }

            pendingAction = "Inicio del servicio cancelado.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido cancelar el inicio del servicio: {ex.Message}";
        }
        finally
        {
            iniciandoServicioId = null;
        }
    }

    private async Task FinalizarServicioAsync(int idSolicitud)
    {
        finalizandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/finalizar", null);
            if (!response.IsSuccessStatusCode)
            {
                mensajePopup = await ObtenerMensajeErrorAsync(response, "No se ha podido finalizar el servicio.");
                mensajePopupVisible = true;
                return;
            }

            pendingAction = "Servicio finalizado.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            mensajePopup = $"No se ha podido finalizar el servicio: {ex.Message}";
            mensajePopupVisible = true;
        }
        finally
        {
            finalizandoServicioId = null;
        }
    }

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }

    private static async Task<string> ObtenerMensajeErrorAsync(HttpResponseMessage response, string mensajePredeterminado)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        try
        {
            var error = System.Text.Json.JsonSerializer.Deserialize<ApiError>(contenido,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (!string.IsNullOrWhiteSpace(error?.Message))
                return error.Message;
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return mensajePredeterminado;
    }

    private void ShowPendingAction(string action) => pendingAction = action;
}
