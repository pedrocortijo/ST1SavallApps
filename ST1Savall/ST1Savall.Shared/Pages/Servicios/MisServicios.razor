@page "/servicios/mis-servicios"
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Servicios asignados</PageTitle>

<style>
    .mis-servicios-header { gap: 16px; }
    .mis-servicios-filtros { justify-content: flex-end; }
    .servicios-asignados-titulo { font-size: 1.1rem; }
    .servicios-asignados-conductor { min-width: 220px; }
    .mis-servicios-refresh { min-height: 44px; min-width: 120px; }
    .servicios-tablet-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .servicio-tablet-card { border: 1px solid var(--bs-border-color, #d8dce1); border-left: 5px solid #0d6efd; border-radius: 12px; padding: 16px; min-height: 225px; display: flex; flex-direction: column; gap: 12px; }
    .servicio-tablet-card .servicio-hora { font-size: 1.7rem; font-weight: 700; line-height: 1; color: #0d6efd; }
    .servicio-tablet-card .servicio-tarea { font-size: 1rem; font-weight: 700; }
    .servicio-tablet-card .servicio-cliente { font-size: 1rem; font-weight: 600; }
    .servicio-tablet-card .servicio-direccion { font-size: .9rem; }
    .servicio-estado-iniciado { background-color: #198754 !important; color: #ffffff !important; font-size: 1.15rem; padding: .5rem .8rem; }
    .servicio-estado-finalizado { background-color: #dc3545 !important; color: #ffffff !important; font-size: 1.15rem; padding: .5rem .8rem; }
    .servicio-estado-asignado { background-color: #fff200 !important; color: #1f1f1f !important; font-size: 1.15rem; padding: .5rem .8rem; }
    .servicio-ruta { font-size: 1.15rem; padding: .5rem .8rem; line-height: 1.2; }
    .servicio-tablet-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: auto; }
    .servicio-tablet-actions .btn { min-height: 44px; font-weight: 600; }
    @@media (max-width: 700px) { .servicios-tablet-grid { grid-template-columns: 1fr; } .mis-servicios-header { align-items: stretch !important; } .mis-servicios-filtros { justify-content: flex-start; } }
</style>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mis-servicios-header mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <label for="conductorSeleccionado" class="fw-bold text-primary mb-0">Conductor:</label>
                <DxComboBox Data="@conductoresConServiciosHoy"
                            TextFieldName="Nombre"
                            ValueFieldName="IdOperario"
                            Value="@conductorSeleccionadoId"
                            ValueChanged="@((int? idConductor) => CambiarConductorAsync(idConductor))"
                            Enabled="@(!conductorDelLogin)"
                            NullText="Seleccione un conductor..."
                            InputId="conductorSeleccionado"
                            CssClass="servicios-asignados-conductor" />
            </div>
        </div>
        <button class="btn btn-outline-secondary mis-servicios-refresh" @onclick="LoadDataAsync"><i class="oi oi-reload me-1"></i>Actualizar</button>
    </div>
    <div class="mis-servicios-filtros d-flex flex-wrap gap-3 mb-3">
        <div class="form-check form-switch mb-0"><input id="pendientesAnteriores" class="form-check-input" type="checkbox" role="switch" checked="@mostrarPendientesAnteriores" @onchange="CambiarPendientesAnterioresAsync" /><label class="form-check-label small" for="pendientesAnteriores">Sin finalizar anteriores</label></div>
        <div class="form-check form-switch mb-0"><input id="verFinalizados" class="form-check-input" type="checkbox" role="switch" checked="@mostrarFinalizados" @onchange="CambiarFinalizadosAsync" /><label class="form-check-label small" for="verFinalizados">Finalizados</label></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (loading)
    {
        <div class="p-5 text-center"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Cargando servicios...</p></div>
    }
    else if (conductorSeleccionadoId.HasValue && servicios.Count == 0)
    {
        <div class="alert alert-info">No hay servicios asignados al conductor seleccionado.</div>
    }
    else
    {
        <div class="servicios-tablet-grid">
            @foreach (var servicio in servicios)
            {
                <article class="servicio-tablet-card">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div><div class="small text-muted">Servicio #@servicio.IdSolicitud · @servicio.FechaTarea?.ToString("dd/MM/yyyy")</div><div class="servicio-hora">@(servicio.FechaHoraInicioPlanificada?.ToString("HH:mm") ?? "Sin hora")</div></div>
                        <div class="d-flex align-items-center gap-2">
                            @if (ObtenerUrlRuta(servicio) is { } urlRuta)
                            {
                                <a href="@urlRuta" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info servicio-ruta" title="Cómo llegar desde el origen" aria-label="Cómo llegar desde el origen" @onclick:stopPropagation><i class="oi oi-map-marker"></i></a>
                            }
                            <span class="badge @(EsServicioIniciado(servicio) ? "servicio-estado-iniciado" : EsServicioFinalizado(servicio) ? "servicio-estado-finalizado" : EsServicioAsignado(servicio) ? "servicio-estado-asignado" : "text-bg-secondary")">@servicio.EstadoDescripcion</span>
                        </div>
                    </div>
                    <div class="servicio-tarea">@servicio.TipoTareaDescripcion</div>
                    <div><div class="servicio-cliente">@servicio.NombreCliente</div><div class="servicio-direccion text-muted">@servicio.NombreObra</div><div class="servicio-direccion text-muted">@servicio.DireccionCliente, @servicio.PoblacionCliente</div></div>
                    <div class="servicio-tablet-actions">
                        <button class="btn btn-primary" @onclick="() => OpenServicio(servicio.IdSolicitud)"><i class="oi oi-eye me-1"></i>Mostrar</button>
                        <button class="btn @(EsServicioIniciado(servicio) ? "btn-outline-warning" : "btn-outline-success")"
                                disabled="@(EsServicioFinalizado(servicio) || iniciandoServicioId == servicio.IdSolicitud)"
                                @onclick="() => CambiarInicioServicioAsync(servicio)">
                            <i class="@(EsServicioIniciado(servicio) ? "oi oi-x me-1" : "oi oi-media-play me-1")"></i>
                            @(iniciandoServicioId == servicio.IdSolicitud ? "Actualizando..." : EsServicioIniciado(servicio) ? "Cancelar" : "Iniciar")
                        </button>
                        <button class="btn btn-outline-primary" disabled="@(!EsServicioIniciado(servicio))" @onclick="() => AbrirFirma(servicio.IdSolicitud)"><i class="oi oi-pencil me-1"></i>Firma</button>
                        <button class="btn @(EsServicioFinalizado(servicio) ? "btn-outline-warning" : "btn-outline-danger")"
                                disabled="@(!EsServicioIniciado(servicio) && !EsServicioFinalizado(servicio) || finalizandoServicioId == servicio.IdSolicitud)"
                                @onclick="() => CambiarFinalizacionServicioAsync(servicio)">
                            <i class="@(EsServicioFinalizado(servicio) ? "oi oi-x me-1" : "oi oi-media-stop me-1")"></i>@(finalizandoServicioId == servicio.IdSolicitud ? "Actualizando..." : EsServicioFinalizado(servicio) ? "Cancelar" : "Finalizar")
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</div>

<DxPopup @bind-Visible="mensajePopupVisible"
         HeaderText="No se puede finalizar el servicio"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0" style="white-space: pre-line;">@mensajePopup</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => mensajePopupVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [SupplyParameterFromQuery(Name = "conductor")]
    public int? ConductorDeRetornoId { get; set; }

    private readonly List<Solicitud> servicios = [];
    private bool loading = true;
    private string? errorMessage, userName;
    private List<Operario> conductoresConServiciosHoy = [];
    private List<Planta> plantas = [];
    private int? conductorSeleccionadoId;
    private bool conductorDelLogin;
    private int? iniciandoServicioId;
    private int? finalizandoServicioId;
    private bool mensajePopupVisible;
    private string? mensajePopup;
    private bool mostrarPendientesAnteriores = true;
    private bool mostrarFinalizados;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        loading = true; errorMessage = null;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            userName = state.User.Identity?.Name;
            var token = state.User.FindFirst("token")?.Value;
            if (!string.IsNullOrWhiteSpace(token)) Http.DefaultRequestHeaders.Authorization = new("Bearer", token);
            var solicitudes = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes") ?? [];
            var operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? [];
            var users = await Http.GetFromJsonAsync<List<ApplicationUserDto>>("api/users") ?? [];
            var tareas = await Http.GetFromJsonAsync<List<Tarea>>("api/tareas") ?? [];
            var estados = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud") ?? [];
            plantas = await Http.GetFromJsonAsync<List<Planta>>("api/plantas") ?? [];
            var tecnicoDelLogin = users.FirstOrDefault(u => string.Equals(u.Email, userName, StringComparison.OrdinalIgnoreCase))?.Tecnico;
            var operarioDelLogin = operarios.FirstOrDefault(o => string.Equals(o.Nombre, tecnicoDelLogin, StringComparison.OrdinalIgnoreCase));
            conductorDelLogin = string.Equals(operarioDelLogin?.Cargo?.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase);

            conductoresConServiciosHoy = operarios
                .Where(o => solicitudes.Any(s =>
                    s.IdConductor == o.IdOperario
                    && (s.FechaTarea?.Date == DateTime.Today
                        || (s.FechaTarea?.Date < DateTime.Today && !EsServicioFinalizado(s, estados)))))
                .OrderBy(o => o.Nombre)
                .ToList();

            if (conductorDelLogin)
            {
                conductorSeleccionadoId = operarioDelLogin!.IdOperario;
            }
            else if (ConductorDeRetornoId.HasValue && conductoresConServiciosHoy.Any(o => o.IdOperario == ConductorDeRetornoId.Value))
            {
                conductorSeleccionadoId = ConductorDeRetornoId.Value;
            }
            else if (conductorSeleccionadoId.HasValue && !conductoresConServiciosHoy.Any(o => o.IdOperario == conductorSeleccionadoId.Value))
            {
                conductorSeleccionadoId = null;
            }

            servicios.Clear();
            servicios.AddRange(solicitudes.Where(s =>
                    s.IdConductor == conductorSeleccionadoId
                    && (mostrarFinalizados
                        ? s.FechaTarea?.Date == DateTime.Today
                            && EsServicioFinalizado(s, estados)
                        : !EsServicioFinalizado(s, estados)
                            && (s.FechaTarea?.Date == DateTime.Today
                                || (mostrarPendientesAnteriores
                                    && s.FechaTarea?.Date < DateTime.Today))))
                .OrderBy(s => s.FechaHoraInicioPlanificada ?? DateTime.MaxValue)
                .ThenBy(s => s.IdSolicitud));
            foreach (var s in servicios)
            {
                s.ConductorNombre = operarios.FirstOrDefault(o => o.IdOperario == s.IdConductor)?.Nombre ?? "-";
                s.TipoTareaDescripcion = tareas.FirstOrDefault(t => t.IdTarea == s.IdTipoTarea)?.NombreTarea ?? "-";
                s.EstadoDescripcion = estados.FirstOrDefault(e => e.IdEstado == s.Estado)?.Descripcion ?? "-";
            }
        }
        catch (Exception ex) { errorMessage = $"No se han podido cargar los servicios: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task CambiarPendientesAnterioresAsync(ChangeEventArgs args)
    {
        mostrarPendientesAnteriores = args.Value is bool valor && valor;
        await LoadDataAsync();
    }

    private async Task CambiarFinalizadosAsync(ChangeEventArgs args)
    {
        mostrarFinalizados = args.Value is bool valor && valor;
        await LoadDataAsync();
    }

    private async Task CambiarConductorAsync(int? idConductor)
    {
        if (conductorDelLogin)
            return;

        conductorSeleccionadoId = idConductor;
        await LoadDataAsync();
    }

    private void OpenServicio(int id) => NavigationManager.NavigateTo(
        conductorSeleccionadoId.HasValue
            ? $"/servicios/mis-servicios/{id}?conductor={conductorSeleccionadoId.Value}"
            : $"/servicios/mis-servicios/{id}");
    private void AbrirFirma(int id) => NavigationManager.NavigateTo(
        conductorSeleccionadoId.HasValue
            ? $"/servicios/mis-servicios/{id}/firma?conductor={conductorSeleccionadoId.Value}"
            : $"/servicios/mis-servicios/{id}/firma");

    private static bool EsServicioIniciado(Solicitud servicio) =>
        servicio.EstadoDescripcion?.Contains("iniciado", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EsServicioFinalizado(Solicitud servicio) =>
        servicio.EstadoDescripcion?.Contains("finalizado", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EsServicioFinalizado(Solicitud servicio, IEnumerable<EstadoSolicitud> estados) =>
        estados.FirstOrDefault(estado => estado.IdEstado == servicio.Estado)?.Descripcion
            ?.Contains("finalizado", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EsServicioAsignado(Solicitud servicio) =>
        servicio.EstadoDescripcion?.Contains("asignado", StringComparison.OrdinalIgnoreCase) == true;

    private string? ObtenerUrlRuta(Solicitud servicio)
    {
        var plantaOrigen = plantas.FirstOrDefault(planta => planta.IdPlanta == servicio.IdPlantaOrigen);
        // Google interpreta esta calle como otra dirección en Benidorm. Las
        // coordenadas de la planta identifican inequívocamente su acceso real.
        var origen = ObtenerUbicacion(plantaOrigen?.Latitud, plantaOrigen?.Longitud)
            ?? ObtenerDireccion(
                plantaOrigen?.Direccion,
                plantaOrigen?.Poblacion,
                plantaOrigen?.CodigoPostal)
            ?? ObtenerUbicacion(servicio.LatitudOrigen, servicio.LongitudOrigen);
        var destino = servicio.LatitudObra.HasValue && servicio.LongitudObra.HasValue
            ? $"{servicio.LatitudObra.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{servicio.LongitudObra.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            : string.Join(", ", new[] { servicio.DireccionCliente, servicio.PoblacionCliente }.Where(valor => !string.IsNullOrWhiteSpace(valor)));

        return string.IsNullOrWhiteSpace(origen) || string.IsNullOrWhiteSpace(destino)
            ? null
            : $"https://www.google.com/maps/dir/?api=1&origin={Uri.EscapeDataString(origen)}&destination={Uri.EscapeDataString(destino)}&travelmode=driving";
    }

    private static string? ObtenerUbicacion(decimal? latitud, decimal? longitud, params string?[] direccion)
    {
        if (latitud.HasValue && longitud.HasValue)
        {
            return $"{latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }

        var texto = string.Join(", ", direccion.Where(valor => !string.IsNullOrWhiteSpace(valor)));
        return string.IsNullOrWhiteSpace(texto) ? null : texto;
    }

    private static string? ObtenerDireccion(params string?[] partes)
    {
        var direccion = string.Join(", ", partes.Where(valor => !string.IsNullOrWhiteSpace(valor)));
        return string.IsNullOrWhiteSpace(direccion) ? null : direccion;
    }

    private Task CambiarInicioServicioAsync(Solicitud servicio) =>
        EsServicioIniciado(servicio)
            ? CancelarInicioServicioAsync(servicio.IdSolicitud)
            : IniciarServicioAsync(servicio.IdSolicitud);

    private Task CambiarFinalizacionServicioAsync(Solicitud servicio)
    {
        if (EsServicioFinalizado(servicio))
            return CancelarFinalizacionServicioAsync(servicio.IdSolicitud);

        if (string.IsNullOrWhiteSpace(servicio.AlbaranPlanta))
        {
            mensajePopup = "Antes de finalizar, introduzca el número de albarán de la planta en la pantalla Firma.";
            mensajePopupVisible = true;
            return Task.CompletedTask;
        }

        return FinalizarServicioAsync(servicio.IdSolicitud);
    }

    private async Task IniciarServicioAsync(int idSolicitud)
    {
        iniciandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/iniciar", null);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "No se ha podido iniciar el servicio.";
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido iniciar el servicio: {ex.Message}";
        }
        finally
        {
            iniciandoServicioId = null;
        }
    }

    private async Task CancelarInicioServicioAsync(int idSolicitud)
    {
        iniciandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/cancelar-inicio", null);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "No se ha podido cancelar el inicio del servicio.";
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido cancelar el inicio del servicio: {ex.Message}";
        }
        finally
        {
            iniciandoServicioId = null;
        }
    }

    private async Task FinalizarServicioAsync(int idSolicitud)
    {
        finalizandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/finalizar", null);
            if (!response.IsSuccessStatusCode)
            {
                mensajePopup = await ObtenerMensajeErrorAsync(response, "No se ha podido finalizar el servicio.");
                mensajePopupVisible = true;
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            mensajePopup = $"No se ha podido finalizar el servicio: {ex.Message}";
            mensajePopupVisible = true;
        }
        finally
        {
            finalizandoServicioId = null;
        }
    }

    private async Task CancelarFinalizacionServicioAsync(int idSolicitud)
    {
        finalizandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/cancelar-finalizacion", null);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "No se ha podido cancelar la finalización del servicio.";
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se ha podido cancelar la finalización del servicio: {ex.Message}";
        }
        finally
        {
            finalizandoServicioId = null;
        }
    }

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }

    private static async Task<string> ObtenerMensajeErrorAsync(HttpResponseMessage response, string mensajePredeterminado)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        try
        {
            var error = System.Text.Json.JsonSerializer.Deserialize<ApiError>(contenido,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (!string.IsNullOrWhiteSpace(error?.Message))
                return error.Message;
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return mensajePredeterminado;
    }

}
