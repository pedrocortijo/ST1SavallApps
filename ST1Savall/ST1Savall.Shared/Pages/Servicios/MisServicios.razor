@page "/servicios/mis-servicios"
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Servicios asignados</PageTitle>

<style>
    .mis-servicios-header { gap: 16px; }
    .mis-servicios-filtros { justify-content: flex-end; }
    .servicios-asignados-titulo { font-size: 1.1rem; }
    .servicios-asignados-conductor { min-width: 220px; }
    .mis-servicios-refresh { align-self: stretch; min-height: 0; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.875rem; }
    .servicios-tablet-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .servicio-tablet-card { border: 1px solid var(--bs-border-color, #d8dce1); border-left: 5px solid #0d6efd; border-radius: 12px; padding: 16px; min-height: 225px; display: flex; flex-direction: column; gap: 12px; }
    .servicio-tablet-card .servicio-hora { font-size: 1.7rem; font-weight: 700; line-height: 1; color: #0d6efd; }
    .servicio-tablet-card .servicio-hora-fin { color: #0d6efd; }
    .servicio-tablet-card .servicio-tarea { font-size: 1rem; font-weight: 700; }
    .servicio-tablet-card .servicio-cliente { font-size: 1rem; font-weight: 600; }
    .servicio-tablet-card .servicio-direccion { font-size: .9rem; }
    .servicio-estado-badge { font-size: 1.15rem; padding: .4rem .8rem; display: inline-flex; align-items: center; justify-content: center; }
    .servicio-estado-ruta-obra { background-color: #198754 !important; color: #ffffff !important; }
    .servicio-estado-ruta-planta { background-color: #f58220 !important; color: #ffffff !important; }
    .servicio-estado-ruta-finalizada { background-color: #dc3545 !important; color: #ffffff !important; }
    .servicio-estado-ruta-sin-iniciar { background-color: #fff200 !important; color: #1f1f1f !important; }
    .servicio-ruta { font-size: 1.15rem; padding: .4rem .8rem; display: inline-flex; align-items: center; justify-content: center; align-self: stretch; min-height: 0; }
    .servicio-tablet-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: auto; }
    .servicio-tablet-actions .btn { min-height: 44px; font-weight: 600; }
    @@media (max-width: 700px) { .servicios-tablet-grid { grid-template-columns: 1fr; } .mis-servicios-header { align-items: stretch !important; } .mis-servicios-filtros { justify-content: flex-start; } }
</style>

<div class="container-fluid py-0">
    <div class="d-flex justify-content-between align-items-center mis-servicios-header mb-3">
        <div>
            <div class="d-flex align-items-stretch gap-2">
                <label for="conductorSeleccionado" class="fw-bold text-primary mb-0 d-flex align-items-center">Conductor:</label>
                <DxComboBox Data="@conductoresConServiciosHoy"
                            TextFieldName="Nombre"
                            ValueFieldName="IdOperario"
                            Value="@conductorSeleccionadoId"
                            ValueChanged="@((int? idConductor) => CambiarConductorAsync(idConductor))"
                            Enabled="@(!conductorDelLogin)"
                            NullText="Seleccione un conductor..."
                            InputId="conductorSeleccionado"
                            CssClass="servicios-asignados-conductor" />
                <button class="btn btn-sm btn-outline-secondary mis-servicios-refresh" @onclick="LoadDataAsync"><i class="oi oi-reload me-1"></i>Actualizar</button>
            </div>
        </div>
    </div>
    <div class="mis-servicios-filtros d-flex flex-wrap gap-3 mb-3">
        <div class="form-check form-switch mb-0"><input id="pendientesAnteriores" class="form-check-input" type="checkbox" role="switch" checked="@mostrarPendientesAnteriores" @onchange="CambiarPendientesAnterioresAsync" /><label class="form-check-label small" for="pendientesAnteriores">Sin finalizar anteriores</label></div>
        <div class="form-check form-switch mb-0"><input id="verFinalizados" class="form-check-input" type="checkbox" role="switch" checked="@mostrarFinalizados" @onchange="CambiarFinalizadosAsync" /><label class="form-check-label small" for="verFinalizados">Finalizados</label></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (loading)
    {
        <div class="p-5 text-center"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Cargando servicios...</p></div>
    }
    else if (!conductorSeleccionadoId.HasValue)
    {
        <div class="alert alert-secondary">Seleccione un conductor para ver sus servicios asignados.</div>
    }
    else if (servicios.Count == 0)
    {
        <div class="alert alert-info">No hay servicios asignados al conductor seleccionado.</div>
    }
    else
    {
        <div class="servicios-tablet-grid">
            @foreach (var servicio in servicios)
            {
                <article class="servicio-tablet-card">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div><div class="small text-muted">Servicio #@servicio.IdSolicitud · @servicio.FechaTarea?.ToString("dd/MM/yyyy")</div><div class="servicio-hora">@(servicio.FechaHoraInicioPlanificada?.ToString("HH:mm") ?? "Sin hora") <span class="servicio-hora-fin"> - @(servicio.FechaHoraFinPlanificada?.ToString("HH:mm") ?? "--:--")</span></div></div>
                        <div class="d-flex align-items-stretch gap-2">
                            @if (ObtenerUrlRuta(servicio) is { } urlRuta)
                            {
                                <a href="@urlRuta" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info servicio-ruta" title="Cómo llegar desde el origen" aria-label="Cómo llegar desde el origen" @onclick:stopPropagation><i class="oi oi-map-marker"></i></a>
                            }
                            <span class="badge servicio-estado-badge @(EsRutaSinIniciar(servicio) ? "servicio-estado-ruta-sin-iniciar" : EsRutaObra(servicio) ? "servicio-estado-ruta-obra" : EsRutaPlanta(servicio) ? "servicio-estado-ruta-planta" : EsRutaFinalizada(servicio) ? "servicio-estado-ruta-finalizada" : "text-bg-secondary")">@(EsRutaSinIniciar(servicio) ? "Sin Iniciar" : EsRutaObra(servicio) ? "Ruta a Obra" : EsRutaPlanta(servicio) ? "Ruta a Planta" : EsRutaFinalizada(servicio) ? "Finalizado" : servicio.EstadoDescripcion)</span>
                        </div>
                    </div>
                    <div class="servicio-tarea">@servicio.TipoTareaDescripcion</div>
                    <div><div class="servicio-cliente">@servicio.NombreCliente</div><div class="servicio-direccion text-muted">@servicio.NombreObra</div><div class="servicio-direccion text-muted">@servicio.DireccionCliente, @servicio.PoblacionCliente</div></div>
                    <div class="servicio-tablet-actions">
                        <button class="btn btn-primary" @onclick="() => OpenServicio(servicio.IdSolicitud)"><i class="oi oi-eye me-1"></i>Mostrar</button>
                        @{
                            bool sinIniciar = EsRutaSinIniciar(servicio);
                            bool rutaObra = EsRutaObra(servicio);
                            bool rutaPlanta = EsRutaPlanta(servicio);
                            bool hayOtraRutaObra = servicioIniciadoActualId.HasValue && servicioIniciadoActualId.Value != servicio.IdSolicitud;
                        }
                        <button class="btn @(sinIniciar ? "btn-outline-success" : "btn-outline-danger")"
                                disabled="@(!sinIniciar && !rutaObra && !rutaPlanta || iniciandoServicioId == servicio.IdSolicitud || (sinIniciar && hayOtraRutaObra))"
                                @onclick="() => CambiarRutaObraAsync(servicio)">
                            <i class="@(sinIniciar ? "oi oi-media-play me-1" : "oi oi-x me-1")"></i>@(iniciandoServicioId == servicio.IdSolicitud ? "Actualizando..." : sinIniciar ? "Ruta a Obra" : "Cancelar")
                        </button>
                        <button class="btn btn-outline-primary" disabled="@(!rutaObra && !rutaPlanta)" @onclick="() => AbrirFirma(servicio.IdSolicitud)"><i class="oi oi-pencil me-1"></i>@(rutaPlanta ? "Tique Báscula" : "Firma")</button>
                        <button class="btn @(rutaPlanta ? "btn-outline-danger" : "btn-outline-warning")"
                                disabled="@(!rutaObra && !rutaPlanta || finalizandoServicioId == servicio.IdSolicitud)"
                                @onclick="() => CambiarRutaPlantaAsync(servicio)">
                            <i class="@(rutaPlanta ? "oi oi-media-stop me-1" : rutaObra ? "oi oi-map-marker me-1" : "oi oi-map-marker me-1")"></i>@(finalizandoServicioId == servicio.IdSolicitud ? "Actualizando..." : rutaPlanta ? "Finalizar" : "Ruta a Planta")
                        </button>
                    </div>
                    @if (rutaObra || rutaPlanta || EsRutaFinalizada(servicio) || !string.IsNullOrWhiteSpace(servicio.GuidDeCa))
                    {
                        <button class="btn btn-sm btn-outline-dark w-100 mt-2 fw-semibold" @onclick="() => AbrirModalDeCaAsync(servicio.IdSolicitud)">
                            <i class="oi oi-shield me-1 text-primary"></i>DeCA / Código QR
                        </button>
                    }
                </article>
            }
        </div>
    }
</div>

<DxPopup @bind-Visible="mensajePopupVisible"
         HeaderText="@mensajePopupTitulo"
         ShowFooter="true"
         Width="480px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        <div class="py-2 d-flex align-items-center gap-3">
            <i class="oi oi-warning text-warning fs-3"></i>
            <p class="mb-0" style="white-space: pre-line;">@mensajePopup</p>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-end w-100">
            <DxButton Text="Aceptar" RenderStyle="ButtonRenderStyle.Primary" Click="() => mensajePopupVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="deCaPopupVisible"
         HeaderText="Documento de Control Administrativo (DeCA)"
         ShowFooter="true"
         Width="520px"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate>
        @if (cargandoDeCa)
        {
            <div class="p-4 text-center">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 small text-muted">Cargando documento DeCA...</div>
            </div>
        }
        else if (detalleDeCa is not null && !string.IsNullOrWhiteSpace(detalleDeCa.GuidDeCa))
        {
            <div class="py-1 text-center">
                <div class="alert alert-light border py-2 mb-2">
                    <div class="fw-bold text-primary" style="font-size: 1rem;">
                        @(detalleDeCa.Tipo == "ENTREGA" ? "DeCA: Entrega / Colocación de Contenedor" : "DeCA: Retirada de Residuos de Construcción (RCDs)")
                    </div>
                    <div class="small text-muted">
                        Emitido el @(detalleDeCa.FechaHoraEmision?.ToString("dd/MM/yyyy HH:mm:ss") ?? "--")
                    </div>
                </div>

                <div class="p-2 border rounded bg-white d-inline-block shadow-sm mb-2">
                    <img src="@($"api/deca/solicitud/{detalleDeCa.IdSolicitud}/qr-imagen?t={DateTime.UtcNow.Ticks}")"
                         alt="Código QR DeCA"
                         style="width: 200px; height: 200px; display: block;" />
                </div>

                <div class="alert alert-info py-2 small text-start mb-2">
                    <strong>Para la Inspección / Guardia Civil:</strong><br />
                    Muestre este código QR. El escaneo descarga el PDF nativo oficial sin contraseña.
                </div>

                <div class="text-start small p-2 bg-light border rounded">
                    <div><strong>Matrícula:</strong> @detalleDeCa.Matricula</div>
                    <div><strong>Cargador:</strong> @detalleDeCa.CargadorNombre</div>
                    <div><strong>Origen:</strong> @detalleDeCa.OrigenDireccion</div>
                    <div><strong>Destino:</strong> @detalleDeCa.DestinoDireccion</div>
                    <div><strong>Carga:</strong> @detalleDeCa.DescripcionCarga @(detalleDeCa.CubicajeM3.HasValue ? $"({detalleDeCa.CubicajeM3.Value:0.##} m³)" : "")</div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning py-3">
                No hay un documento DeCA emitido para este servicio.
                <button type="button" class="btn btn-sm btn-primary mt-2 d-block" @onclick="GenerarDeCaManualAsync">
                    <i class="oi oi-reload me-1"></i>Emitir DeCA ahora
                </button>
            </div>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="d-flex justify-content-between align-items-center w-100">
            @if (detalleDeCa is not null && !string.IsNullOrWhiteSpace(detalleDeCa.GuidDeCa))
            {
                <a href="@($"api/deca/solicitud/{detalleDeCa.IdSolicitud}/pdf")" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="oi oi-document me-1"></i>Descargar PDF
                </a>
            }
            else { <span></span> }
            <DxButton Text="Cerrar" RenderStyle="ButtonRenderStyle.Secondary" Click="() => deCaPopupVisible = false" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [SupplyParameterFromQuery(Name = "conductor")]
    public int? ConductorDeRetornoId { get; set; }
    private readonly List<Solicitud> servicios = [];
    private bool loading = true;
    private string? errorMessage, userName;
    private List<Operario> conductoresConServiciosHoy = [];
    private List<Planta> plantas = [];
    private List<EstadoSolicitud> estadosRuta = [];
    private int? conductorSeleccionadoId;
    private bool conductorDelLogin;
    private int? servicioIniciadoActualId;
    private int? iniciandoServicioId;
    private int? finalizandoServicioId;
    private bool mensajePopupVisible;
    private string mensajePopupTitulo = "Aviso";
    private string? mensajePopup;
    private bool mostrarPendientesAnteriores = true;
    private bool mostrarFinalizados;
    private HashSet<int> tareasQueCreanAlbaran = [];
    private bool deCaPopupVisible;
    private bool cargandoDeCa;
    private DeCaDetalleDto? detalleDeCa;
    private int idSolicitudDeCaActual;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        loading = true; errorMessage = null;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            userName = state.User.Identity?.Name;
            var token = state.User.FindFirst("token")?.Value;
            if (!string.IsNullOrWhiteSpace(token)) Http.DefaultRequestHeaders.Authorization = new("Bearer", token);
            var solicitudes = await Http.GetFromJsonAsync<List<Solicitud>>("api/solicitudes") ?? [];
            var operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? [];
            var users = await Http.GetFromJsonAsync<List<ApplicationUserDto>>("api/users") ?? [];
            var tareas = await Http.GetFromJsonAsync<List<Tarea>>("api/tareas") ?? [];
            tareasQueCreanAlbaran = tareas.Where(t => t.CreaAlbaran).Select(t => t.IdTarea).ToHashSet();
            var estados = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud") ?? [];
            plantas = await Http.GetFromJsonAsync<List<Planta>>("api/plantas") ?? [];
            estadosRuta = estados;
            var tecnicoDelLogin = users.FirstOrDefault(u => string.Equals(u.Email, userName, StringComparison.OrdinalIgnoreCase))?.Tecnico;
            var operarioDelLogin = operarios.FirstOrDefault(o => string.Equals(o.Nombre, tecnicoDelLogin, StringComparison.OrdinalIgnoreCase));
            conductorDelLogin = string.Equals(operarioDelLogin?.Cargo?.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase);

            conductoresConServiciosHoy = operarios
                .Where(o => solicitudes.Any(s =>
                    s.IdConductor == o.IdOperario
                    && (s.FechaTarea?.Date == DateTime.Today
                        || (s.FechaTarea?.Date < DateTime.Today && !EsRutaFinalizada(s)))))
                .OrderBy(o => o.Nombre)
                .ToList();

            if (conductorDelLogin)
            {
                conductorSeleccionadoId = operarioDelLogin!.IdOperario;
            }
            else if (ConductorDeRetornoId.HasValue && conductoresConServiciosHoy.Any(o => o.IdOperario == ConductorDeRetornoId.Value))
            {
                conductorSeleccionadoId = ConductorDeRetornoId.Value;
            }
            else if (conductorSeleccionadoId.HasValue && !conductoresConServiciosHoy.Any(o => o.IdOperario == conductorSeleccionadoId.Value))
            {
                conductorSeleccionadoId = null;
            }

            servicioIniciadoActualId = conductorSeleccionadoId.HasValue
                ? solicitudes
                    .FirstOrDefault(s => s.IdConductor == conductorSeleccionadoId.Value && EsRutaObra(s))
                    ?.IdSolicitud
                : null;

            servicios.Clear();
            if (conductorSeleccionadoId.HasValue)
            {
                servicios.AddRange(solicitudes.Where(s =>
                        s.IdConductor == conductorSeleccionadoId.Value
                        && (mostrarFinalizados
                            ? s.FechaTarea?.Date == DateTime.Today
                                && EsRutaFinalizada(s)
                            : !EsRutaFinalizada(s)
                                && (s.FechaTarea?.Date == DateTime.Today
                                    || (mostrarPendientesAnteriores
                                        && s.FechaTarea?.Date < DateTime.Today))))
                    .OrderBy(s => s.FechaHoraInicioPlanificada ?? DateTime.MaxValue)
                    .ThenBy(s => s.IdSolicitud));
            }
            foreach (var s in servicios)
            {
                s.ConductorNombre = operarios.FirstOrDefault(o => o.IdOperario == s.IdConductor)?.Nombre ?? "-";
                s.TipoTareaDescripcion = tareas.FirstOrDefault(t => t.IdTarea == s.IdTipoTarea)?.NombreTarea ?? "-";
                s.EstadoDescripcion = estados.FirstOrDefault(e => e.IdEstado == s.Estado)?.Descripcion ?? "-";
            }
        }
        catch (Exception ex) { errorMessage = $"No se han podido cargar los servicios: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task CambiarPendientesAnterioresAsync(ChangeEventArgs args)
    {
        mostrarPendientesAnteriores = args.Value is bool valor && valor;
        await LoadDataAsync();
    }

    private async Task CambiarFinalizadosAsync(ChangeEventArgs args)
    {
        mostrarFinalizados = args.Value is bool valor && valor;
        await LoadDataAsync();
    }

    private async Task CambiarConductorAsync(int? idConductor)
    {
        if (conductorDelLogin)
            return;

        conductorSeleccionadoId = idConductor;
        await LoadDataAsync();
    }

    private void OpenServicio(int id) => NavigationManager.NavigateTo(
        conductorSeleccionadoId.HasValue
            ? $"/servicios/mis-servicios/{id}?conductor={conductorSeleccionadoId.Value}"
            : $"/servicios/mis-servicios/{id}");
    private void AbrirFirma(int id) => NavigationManager.NavigateTo(
        conductorSeleccionadoId.HasValue
            ? $"/servicios/mis-servicios/{id}/firma?conductor={conductorSeleccionadoId.Value}"
            : $"/servicios/mis-servicios/{id}/firma");

    // Compatibilidad temporal con solicitudes existentes hasta que el arranque de la API normalice EstadoServicio.
    private EstadoServicio? ObtenerEstadoServicio(Solicitud servicio)
    {
        var estado = estadosRuta.FirstOrDefault(e => e.IdEstado == servicio.Estado);
        if (estado?.EstadoServicio is { } estadoServicio)
            return estadoServicio;

        // La descripción se obtiene de EstadosSolicitud antes de que se complete la tarjeta.
        var descripcion = estado?.Descripcion ?? servicio.EstadoDescripcion;
        return descripcion?.Contains("finalizado", StringComparison.OrdinalIgnoreCase) == true
            ? EstadoServicio.RutaFinalizada
            : descripcion?.Contains("iniciado", StringComparison.OrdinalIgnoreCase) == true
                ? EstadoServicio.RutaObra
                : descripcion?.Contains("asignad", StringComparison.OrdinalIgnoreCase) == true
                    || descripcion?.Contains("adjudicad", StringComparison.OrdinalIgnoreCase) == true
                    ? EstadoServicio.RutaSinIniciar
                    : null;
    }

    private bool EsRutaSinIniciar(Solicitud servicio) => ObtenerEstadoServicio(servicio) == EstadoServicio.RutaSinIniciar;
    private bool EsRutaObra(Solicitud servicio) => ObtenerEstadoServicio(servicio) == EstadoServicio.RutaObra;
    private bool EsRutaPlanta(Solicitud servicio) => ObtenerEstadoServicio(servicio) == EstadoServicio.RutaPlanta;
    private bool EsRutaFinalizada(Solicitud servicio) => ObtenerEstadoServicio(servicio) == EstadoServicio.RutaFinalizada;
    private static bool EsServicioIniciado(Solicitud servicio) =>
        servicio.EstadoDescripcion?.Contains("iniciado", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EsServicioIniciado(Solicitud servicio, IEnumerable<EstadoSolicitud> estados) =>
        estados.FirstOrDefault(estado => estado.IdEstado == servicio.Estado)?.Descripcion
            ?.Contains("iniciado", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EsServicioFinalizado(Solicitud servicio) =>
        servicio.EstadoDescripcion?.Contains("finalizado", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EsServicioFinalizado(Solicitud servicio, IEnumerable<EstadoSolicitud> estados) =>
        estados.FirstOrDefault(estado => estado.IdEstado == servicio.Estado)?.Descripcion
            ?.Contains("finalizado", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EsServicioAsignado(Solicitud servicio) =>
        servicio.EstadoDescripcion?.Contains("asignado", StringComparison.OrdinalIgnoreCase) == true;

    private string? ObtenerUrlRuta(Solicitud servicio)
    {
        var plantaOrigen = plantas.FirstOrDefault(planta => planta.IdPlanta == servicio.IdPlantaOrigen);
        // Google interpreta esta calle como otra dirección en Benidorm. Las
        // coordenadas de la planta identifican inequívocamente su acceso real.
        var origen = ObtenerUbicacion(plantaOrigen?.Latitud, plantaOrigen?.Longitud)
            ?? ObtenerDireccion(
                plantaOrigen?.Direccion,
                plantaOrigen?.Poblacion,
                plantaOrigen?.CodigoPostal)
            ?? ObtenerUbicacion(servicio.LatitudOrigen, servicio.LongitudOrigen);
        var destino = servicio.LatitudObra.HasValue && servicio.LongitudObra.HasValue
            ? $"{servicio.LatitudObra.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{servicio.LongitudObra.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            : string.Join(", ", new[] { servicio.DireccionCliente, servicio.PoblacionCliente }.Where(valor => !string.IsNullOrWhiteSpace(valor)));

        return string.IsNullOrWhiteSpace(origen) || string.IsNullOrWhiteSpace(destino)
            ? null
            : $"https://www.google.com/maps/dir/?api=1&origin={Uri.EscapeDataString(origen)}&destination={Uri.EscapeDataString(destino)}&travelmode=driving";
    }

    private static string? ObtenerUbicacion(decimal? latitud, decimal? longitud, params string?[] direccion)
    {
        if (latitud.HasValue && longitud.HasValue)
        {
            return $"{latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }

        var texto = string.Join(", ", direccion.Where(valor => !string.IsNullOrWhiteSpace(valor)));
        return string.IsNullOrWhiteSpace(texto) ? null : texto;
    }

    private static string? ObtenerDireccion(params string?[] partes)
    {
        var direccion = string.Join(", ", partes.Where(valor => !string.IsNullOrWhiteSpace(valor)));
        return string.IsNullOrWhiteSpace(direccion) ? null : direccion;
    }

    private Task CambiarRutaObraAsync(Solicitud servicio) =>
        EsRutaSinIniciar(servicio) ? CambiarRutaAsync(servicio.IdSolicitud, "iniciar") : EsRutaObra(servicio) ? CambiarRutaAsync(servicio.IdSolicitud, "cancelar-inicio") : CambiarRutaAsync(servicio.IdSolicitud, "cancelar-planta");

    private Task CambiarRutaPlantaAsync(Solicitud servicio) =>
        EsRutaPlanta(servicio) ? CambiarFinalizacionServicioAsync(servicio) : CambiarRutaAsync(servicio.IdSolicitud, "regresar-planta");

    private async Task CambiarRutaAsync(int idSolicitud, string accion)
    {
        finalizandoServicioId = idSolicitud;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/{accion}", null);
            if (!response.IsSuccessStatusCode)
            {
                mensajePopupTitulo = "No se puede actualizar la ruta";
                mensajePopup = await ObtenerMensajeErrorAsync(response, $"No se ha podido actualizar el estado de ruta (HTTP {(int)response.StatusCode} {response.ReasonPhrase}).");
                mensajePopupVisible = true;
                return;
            }
            await LoadDataAsync();
        }
        finally { finalizandoServicioId = null; }
    }
    private Task CambiarInicioServicioAsync(Solicitud servicio) =>
        EsServicioIniciado(servicio)
            ? CancelarInicioServicioAsync(servicio.IdSolicitud)
            : IniciarServicioAsync(servicio.IdSolicitud);

    private Task CambiarFinalizacionServicioAsync(Solicitud servicio)
    {
        if (EsServicioFinalizado(servicio))
            return CancelarFinalizacionServicioAsync(servicio.IdSolicitud);

        var camposPendientes = ObtenerCamposBasculaPendientes(servicio);
        
        if (camposPendientes.Count > 0)
        {
            mensajePopupTitulo = "No se puede finalizar el servicio";
            mensajePopup = $"Antes de finalizar, complete en el grupo Báscula los campos: {Environment.NewLine}{Environment.NewLine}{string.Join("  ", camposPendientes)}";
            mensajePopupVisible = true;
            return Task.CompletedTask;
        }

        return FinalizarServicioAsync(servicio.IdSolicitud);
    }

    private static List<string> ObtenerCamposBasculaPendientes(Solicitud servicio)
    {
        var campos = new List<string>();
        if (string.IsNullOrWhiteSpace(servicio.TipoResiduo)) campos.Add(" • Tipo de residuo." + Environment.NewLine);
        if (string.IsNullOrWhiteSpace(servicio.AlbaranPlanta)) campos.Add(" • Albarán planta" + Environment.NewLine);
        if (!servicio.FechaPesaje.HasValue) campos.Add(" • Fecha pesaje." + Environment.NewLine);
        if (!servicio.KgAlbaran.HasValue || servicio.KgAlbaran.Value <= 0) campos.Add(" • Kg Neto." + Environment.NewLine);
        if (!servicio.HoraPesaje.HasValue) campos.Add(" • Hora pesaje." + Environment.NewLine);
        return campos;
    }

    private async Task IniciarServicioAsync(int idSolicitud)
    {
        if (servicioIniciadoActualId.HasValue && servicioIniciadoActualId.Value != idSolicitud)
        {
            mensajePopupTitulo = "No se puede iniciar el servicio";
            mensajePopup = $"El conductor ya tiene el servicio #{servicioIniciadoActualId.Value} iniciado y sin finalizar.{Environment.NewLine}Debe finalizarlo o cancelar su inicio antes de iniciar otro.";
            mensajePopupVisible = true;
            return;
        }

        iniciandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/iniciar", null);
            if (!response.IsSuccessStatusCode)
            {
                mensajePopupTitulo = "No se puede iniciar el servicio";
                mensajePopup = await ObtenerMensajeErrorAsync(response, "No se ha podido iniciar el servicio.");
                mensajePopupVisible = true;
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            mensajePopupTitulo = "Error";
            mensajePopup = $"No se ha podido iniciar el servicio: {ex.Message}";
            mensajePopupVisible = true;
        }
        finally
        {
            iniciandoServicioId = null;
        }
    }

    private async Task CancelarInicioServicioAsync(int idSolicitud)
    {
        iniciandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/cancelar-inicio", null);
            if (!response.IsSuccessStatusCode)
