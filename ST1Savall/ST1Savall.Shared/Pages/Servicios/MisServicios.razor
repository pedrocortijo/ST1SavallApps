        }
    }

    private async Task FinalizarServicioAsync(int idSolicitud)
    {
        finalizandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/finalizar", null);
            if (!response.IsSuccessStatusCode)
            {
                mensajePopupTitulo = "No se puede finalizar el servicio";
                mensajePopup = await ObtenerMensajeErrorAsync(response, "No se ha podido finalizar el servicio.");
                mensajePopupVisible = true;
                return;
            }

            var resultado = await response.Content.ReadFromJsonAsync<ResultadoFinalizacionServicio>();
            if (resultado?.AlbaranGenerado == false && !string.IsNullOrWhiteSpace(resultado.Aviso))
            {
                mensajePopupTitulo = "Aviso de albarán";
                mensajePopup = $"El servicio se ha finalizado, pero no se pudo crear el albarán de Sage:{Environment.NewLine}{resultado.Aviso}";
                mensajePopupVisible = true;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            mensajePopupTitulo = "Error";
            mensajePopup = $"No se ha podido finalizar el servicio: {ex.Message}";
            mensajePopupVisible = true;
        }
        finally
        {
            finalizandoServicioId = null;
        }
    }

    private async Task CancelarFinalizacionServicioAsync(int idSolicitud)
    {
        if (servicioIniciadoActualId.HasValue && servicioIniciadoActualId.Value != idSolicitud)
        {
            mensajePopupTitulo = "No se puede reanudar el servicio";
            mensajePopup = $"El conductor ya tiene el servicio #{servicioIniciadoActualId.Value} iniciado y sin finalizar.{Environment.NewLine}Debe finalizarlo o cancelar su inicio antes de reanudar otro servicio.";
            mensajePopupVisible = true;
            return;
        }

        finalizandoServicioId = idSolicitud;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsync($"api/solicitudes/{idSolicitud}/cancelar-finalizacion", null);
            if (!response.IsSuccessStatusCode)
            {
                mensajePopupTitulo = "No se puede reanudar el servicio";
                mensajePopup = await ObtenerMensajeErrorAsync(response, "No se ha podido cancelar la finalización del servicio.");
                mensajePopupVisible = true;
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            mensajePopupTitulo = "Error";
            mensajePopup = $"No se ha podido cancelar la finalización del servicio: {ex.Message}";
            mensajePopupVisible = true;
        }
        finally
        {
            finalizandoServicioId = null;
        }
    }

    private sealed class ApiError
    {
        public string? Message { get; set; }
    }

    private static async Task<string> ObtenerMensajeErrorAsync(HttpResponseMessage response, string mensajePredeterminado)
    {
        var contenido = await response.Content.ReadAsStringAsync();
        try
        {
            var error = System.Text.Json.JsonSerializer.Deserialize<ApiError>(contenido,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (!string.IsNullOrWhiteSpace(error?.Message))
                return error.Message;
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return mensajePredeterminado;
    }

    private async Task AbrirModalDeCaAsync(int idSolicitud)
    {
        idSolicitudDeCaActual = idSolicitud;
        deCaPopupVisible = true;
        cargandoDeCa = true;
        detalleDeCa = null;
        try
        {
            detalleDeCa = await Http.GetFromJsonAsync<DeCaDetalleDto>($"api/deca/solicitud/{idSolicitud}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar DeCA: {ex.Message}");
        }
        finally
        {
            cargandoDeCa = false;
        }
    }

    private async Task GenerarDeCaManualAsync()
    {
        if (idSolicitudDeCaActual <= 0) return;
        cargandoDeCa = true;
        try
        {
            var s = servicios.FirstOrDefault(x => x.IdSolicitud == idSolicitudDeCaActual);
            var tipo = (s != null && EsRutaObra(s)) ? "ENTREGA" : "RETIRADA";
            var resp = await Http.PostAsync($"api/deca/solicitud/{idSolicitudDeCaActual}/emitir?tipo={tipo}", null);
            if (resp.IsSuccessStatusCode)
            {
                detalleDeCa = await Http.GetFromJsonAsync<DeCaDetalleDto>($"api/deca/solicitud/{idSolicitudDeCaActual}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al emitir DeCA: {ex.Message}");
        }
        finally
        {
            cargandoDeCa = false;
        }
    }
}
