@page "/servicios/facturas-correo"
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ST1Savall.Shared.Services.IFormFactor FormFactor

<PageTitle>Facturas por correo</PageTitle>
<NavigationLock ConfirmExternalNavigation="@ocupado" />
<h2 class="fw-bold text-primary">Facturas por correo</h2>
<p>Seleccione las facturas. Si tienen albaranes asociados se adjuntarán, tras la factura, en un único PDF.</p>
<DxPopup @bind-Visible="mensajeVisible" HeaderText="Facturas por correo" ShowFooter="true" Width="460px" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
    <BodyContentTemplate><div class="text-wrap">@mensaje</div></BodyContentTemplate>
    <FooterContentTemplate><div class="d-flex justify-content-end w-100"><DxButton Text="Aceptar" Click="@(() => mensajeVisible = false)" RenderStyle="ButtonRenderStyle.Primary" /></div></FooterContentTemplate>
</DxPopup>
<div class="d-flex gap-3 align-items-center mb-3">
    <DxButton Text="Actualizar pendientes" Enabled="@(!ocupado)" Click="Cargar" />
    <DxButton Text="@($"Enviar seleccionadas ({seleccion.Count})")" Enabled="@(!ocupado && seleccion.Count > 0)" Click="Enviar" RenderStyle="ButtonRenderStyle.Primary" />
    <DxCheckBox CheckType="CheckType.Switch" Checked="@mostrarEnviados" CheckedChanged="@((bool valor) => CambiarVistaEnviados(valor))" LabelPosition="LabelPosition.Right" Enabled="@(!ocupado)">Visualizar enviados</DxCheckBox>
    <DxCheckBox CheckType="CheckType.Switch" Checked="@mostrarTodos" CheckedChanged="@((bool valor) => CambiarVistaTodos(valor))" LabelPosition="LabelPosition.Right" Enabled="@(!ocupado)">Visualizar todas las facturas sin enviar</DxCheckBox>
    @if (ocupado) { <span role="status" class="fw-semibold">@progreso</span> }
</div>
<div style="@(ocupado ? "pointer-events:none;opacity:.65" : "")" aria-busy="@ocupado">
<DxGrid Data="@facturas" KeyFieldName="Numero" ShowFilterRow="true" ShowSearchBox="true" PageSize="20" SelectionMode="GridSelectionMode.Multiple" SelectedDataItems="@seleccion" SelectedDataItemsChanged="@((IReadOnlyList<object> x) => seleccion=x)">
 <Columns>
  <DxGridSelectionColumn Width="55px" /><DxGridDataColumn FieldName="Empresa" Width="80px" /><DxGridDataColumn FieldName="Numero" Caption="Factura" Width="120px" /><DxGridDataColumn FieldName="Fecha" DisplayFormat="dd/MM/yyyy" Width="120px" /><DxGridDataColumn FieldName="Cliente" /><DxGridDataColumn FieldName="Email" Caption="Destinatario(s)" /><DxGridDataColumn FieldName="Total" DisplayFormat="n2" Width="110px" />
 </Columns>
 <DetailRowTemplate Context="fila">
  @{ var relacionados = ((FacturaCorreo)fila.DataItem).Albaranes; }
  <DxGrid Data="@relacionados" PageSize="10"><Columns><DxGridDataColumn FieldName="Serie" Caption="Serie" /><DxGridDataColumn FieldName="Numero" Caption="Albarán" /><DxGridDataColumn FieldName="Fecha" DisplayFormat="dd/MM/yyyy" /><DxGridDataColumn FieldName="Obra" /><DxGridDataColumn FieldName="Total" DisplayFormat="n2" /></Columns></DxGrid>
 </DetailRowTemplate>
</DxGrid>
</div>
@if (resultados.Count > 0) { <h3 class="mt-4">Resumen del envío</h3><DxGrid Data="@resultados"><Columns><DxGridDataColumn FieldName="Factura" /><DxGridDataColumn FieldName="Destinatario" /><DxGridDataColumn FieldName="Enviado" /><DxGridDataColumn FieldName="Detalle" /></Columns></DxGrid> }

@code {
 List<FacturaCorreo> facturas=[]; IReadOnlyList<object> seleccion=[]; List<ResultadoFacturaCorreo> resultados=[]; bool ocupado; bool mostrarEnviados; bool mostrarTodos; string progreso=""; string mensaje=""; bool mensajeVisible;
 protected override async Task OnInitializedAsync()=>await Cargar();
 async Task Autenticar(){var u=(await AuthStateProvider.GetAuthenticationStateAsync()).User; var t=u.FindFirst("token")?.Value; if(!string.IsNullOrEmpty(t)) Http.DefaultRequestHeaders.Authorization=new("Bearer",t);}
 void Mostrar(string texto){mensaje=texto; mensajeVisible=true;}
 async Task Cargar(){ocupado=true; progreso="Cargando facturas..."; try{await Autenticar(); var r=await Http.GetAsync("api/facturas-correo?enviados=" + mostrarEnviados.ToString().ToLowerInvariant() + "&todos=" + mostrarTodos.ToString().ToLowerInvariant()); if(!r.IsSuccessStatusCode){var problema=await r.Content.ReadFromJsonAsync<ProblemaApi>(); Mostrar($"No se pudieron cargar las facturas: {problema?.Detail ?? $"Error HTTP {(int)r.StatusCode}."}"); return;} facturas=await r.Content.ReadFromJsonAsync<List<FacturaCorreo>>()??[]; seleccion=[];}catch(Exception ex){Mostrar($"No se pudieron cargar las facturas: {ex.GetBaseException().Message}");}finally{ocupado=false;}}
 async Task CambiarVistaEnviados(bool valor){mostrarEnviados=valor; seleccion=[]; await Cargar();} async Task CambiarVistaTodos(bool valor){mostrarTodos=valor; seleccion=[]; await Cargar();} async Task Enviar(){var lote=seleccion.Cast<FacturaCorreo>().ToList(); ocupado=true; resultados=[]; try{await Autenticar(); var origen=await Http.GetStringAsync("api/facturas-correo/ruta-origen"); foreach(var f in lote){progreso=$"Copiando y enviando {resultados.Count+1} de {lote.Count}..."; await InvokeAsync(StateHasChanged); var nombre="FA"+string.Concat(f.Numero.Where(char.IsLetterOrDigit))+".pdf"; await FormFactor.CopyFileToDirectoryAsync(Path.Combine(origen,nombre),"\\\\192.168.1.230\\Documentos"); var r=await Http.PostAsJsonAsync("api/facturas-correo/enviar",f.ObtenerClave()); if(!r.IsSuccessStatusCode){var texto=await r.Content.ReadAsStringAsync(); resultados.Add(new($"{f.Serie}-{f.Numero}",f.Email,false,string.IsNullOrWhiteSpace(texto)?$"Error HTTP {(int)r.StatusCode}.":texto)); continue;} resultados.Add(await r.Content.ReadFromJsonAsync<ResultadoFacturaCorreo>() ?? new($"{f.Serie}-{f.Numero}",f.Email,false,"El servidor no devolvió resultado."));} if(resultados.Any(x=>!x.Enviado)) Mostrar("Hay facturas no enviadas. Revise el resumen del envío.");}catch(Exception ex){Mostrar($"No se pudo completar el envío: {ex.GetBaseException().Message}");}finally{ocupado=false;}}
 sealed class ProblemaApi { public string? Detail { get; set; } }
}
