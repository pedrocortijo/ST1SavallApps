@page "/servicios/adjudicar-kg-plantas"
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
@inject HttpClient Http

<PageTitle>Adjudicar Kg Plantas</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary mb-1">Adjudicar Kg Plantas</h2>
            <p class="text-muted mb-0">Completa el pesaje de los servicios que todavía no tienen Kg asignados.</p>
        </div>
        <a class="btn btn-secondary" href="/">← Volver al inicio</a>
    </div>

    <div class="card p-3 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label">Fecha de servicio desde</label>
                <DxDateEdit @bind-Date="fechaDesde" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Fecha de servicio hasta</label>
                <DxDateEdit @bind-Date="fechaHasta" />
            </div>
            <div class="col-12 col-md-3">
                <DxButton Text="Adjudicar Kg" RenderStyle="ButtonRenderStyle.Primary" Click="ProcesarAsync" Enabled="@(!procesando)" />
            </div>
        </div>
        <div class="form-text mt-3">Se busca el número de albarán de planta en la columna A del Excel de la planta de reciclaje y se toma el Neto Kg de la columna G.</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (resultado is not null)
    {
        <div class="alert alert-info">Revisados: @resultado.Revisados · Actualizados: @resultado.Actualizados · Sin datos: @resultado.SinDatos</div>
        <DxGrid Data="@resultado.Detalles" KeyFieldName="IdSolicitud" PageSize="20" ShowSearchBox="true" AllowSort="true" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="solicitudes-grid">
            <Columns>
                <DxGridDataColumn FieldName="IdSolicitud" Caption="Servicio" Width="100px" />
                <DxGridDataColumn FieldName="FechaServicio" Caption="Fecha servicio" DisplayFormat="dd/MM/yyyy" Width="140px" />
                <DxGridDataColumn FieldName="AlbaranPlanta" Caption="Albarán planta" Width="160px" />
                <DxGridDataColumn FieldName="AlbaranSage" Caption="Albarán Sage" Width="150px" />
                <DxGridDataColumn FieldName="Kg" Caption="Neto Kg" Width="120px" />
                <DxGridDataColumn Caption="Resultado">
                    <CellDisplayTemplate Context="celda">Actualizado</CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGrid>
    }
</div>

@code {
    private DateTime fechaDesde = DateTime.Today.AddMonths(-1);
    private DateTime fechaHasta = DateTime.Today;
    private bool procesando;
    private string? error;
    private ResultadoProcesoAdjudicarKgPlantas? resultado;

    private async Task ProcesarAsync()
    {
        procesando = true;
        error = null;
        resultado = null;
        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/albaranes-venta/kg-plantas/procesar", new ProcesoAdjudicarKgPlantasRequest
            {
                FechaDesde = fechaDesde,
                FechaHasta = fechaHasta
            });
            if (!respuesta.IsSuccessStatusCode)
            {
                error = await respuesta.Content.ReadAsStringAsync();
                return;
            }
            resultado = await respuesta.Content.ReadFromJsonAsync<ResultadoProcesoAdjudicarKgPlantas>();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }
}
