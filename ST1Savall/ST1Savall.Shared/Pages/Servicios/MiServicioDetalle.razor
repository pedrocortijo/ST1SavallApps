@page "/servicios/mis-servicios/{Id:int}"
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Detalle de servicio</PageTitle>

<style>
    .detalle-servicio .bg-light {
        background-color: var(--bs-body-bg) !important;
        color: var(--bs-body-color);
        border-color: var(--bs-border-color) !important;
    }

    html.theme-blazing-dark .detalle-servicio .bg-light,
    html.theme-fluent-dark .detalle-servicio .bg-light {
        background-color: #1e1d32 !important;
        color: #f8f9fa;
        border-color: #8b8a9a !important;
    }
</style>

<div class="container-fluid py-0 detalle-servicio">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold text-primary mb-1">Detalle del servicio</h2>
            <p class="text-muted mb-0">Consulta de los datos asignados.</p>
            </div><button class="btn btn-outline-secondary btn-sm" @onclick="Volver"><i class="oi oi-arrow-left me-1"></i>Volver</button>
            </div>
    @if (loading) { <div class="p-5 text-center"><div class="spinner-border text-primary"></div></div> }
    else if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger">@errorMessage</div> }
    else if (solicitud is not null) {
        <div class="card shadow-sm border-0"><div class="card-body p-4"><DxFormLayout CaptionPosition="CaptionPosition.Vertical">
            <DxFormLayoutItem Caption="Nº Solicitud" ColSpanMd="2"><DxSpinEdit Value="@solicitud.IdSolicitud" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Fecha Solicitud" ColSpanMd="2"><DxDateEdit Date="@solicitud.FechaSolicitud" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Obra" ColSpanMd="4"><DxTextBox Text="@solicitud.NombreObra" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Albarán planta" ColSpanMd="4"><DxTextBox Text="@solicitud.AlbaranPlanta" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="12"><Template><div class="small p-3 rounded border bg-light"><div class="row g-2"><div class="col-md-6"><b>Obra:</b> @solicitud.NombreObra</div><div class="col-md-6"><b>Cliente:</b> @solicitud.NombreCliente</div><div class="col-md-8"><b>Dirección:</b> @solicitud.DireccionCliente, @solicitud.PoblacionCliente</div><div class="col-md-4"><b>Teléfono:</b> @solicitud.TelefonoCliente</div></div></div></Template></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Tarea" ColSpanMd="3"><DxTextBox Text="@tarea" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Conductor" ColSpanMd="3"><DxTextBox Text="@conductor" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Estado" ColSpanMd="3"><DxTextBox Text="@estado" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Central-Origen" ColSpanMd="3"><DxTextBox Text="@Planta(solicitud.IdPlantaOrigen)" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Planta reciclaje" ColSpanMd="3"><DxTextBox Text="@Planta(solicitud.IdPlantaDescarga)" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Central - Regreso" ColSpanMd="3"><DxTextBox Text="@Planta(solicitud.IdPlantaRegreso)" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Tiempo (minutos)" ColSpanMd="3"><DxSpinEdit Value="@solicitud.DuracionPlanificadaMinutos" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Fecha prevista" ColSpanMd="4"><DxDateEdit Date="@solicitud.FechaTarea" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Hora Inicio" ColSpanMd="4"><DxDateEdit Date="@solicitud.FechaHoraInicioPlanificada" TimeSectionVisible="true" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Hora final" ColSpanMd="4"><DxDateEdit Date="@solicitud.FechaHoraFinPlanificada" TimeSectionVisible="true" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Observaciones para el conductor" ColSpanMd="12"><DxTextBox Text="@solicitud.Observaciones" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Comentarios para oficina" ColSpanMd="12"><DxTextBox Text="@solicitud.ComentariosOficina" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Entrega [1] - Nº Serie" ColSpanMd="3"><DxTextBox Text="@solicitud.CodigoEntrega" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Entrega [2] - Nº Serie" ColSpanMd="3"><DxTextBox Text="@solicitud.CodigoAmbosEntrega" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Retirada [1] - Nº Serie" ColSpanMd="3"><DxTextBox Text="@solicitud.CodigoRecogida" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Retirada [2] - Nº Serie" ColSpanMd="3"><DxTextBox Text="@solicitud.CodigoAmbosRecogida" Enabled="false" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="Fecha Próxima Prevista" ColSpanMd="4"><DxDateEdit Date="@solicitud.FechaPrevista" Enabled="false" /></DxFormLayoutItem><DxFormLayoutItem Caption="Motivo del aplazamiento" ColSpanMd="8"><DxTextBox Text="@motivo" Enabled="false" /></DxFormLayoutItem>
        </DxFormLayout></div></div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "conductor")]
    public int? ConductorSeleccionadoId { get; set; }
    private Solicitud? solicitud; private bool loading = true; private string? errorMessage, tarea, conductor, estado, motivo;
    private List<Planta> plantas = [];
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User.Identity?.Name;
            solicitud = await Http.GetFromJsonAsync<Solicitud>($"api/solicitudes/{Id}");
            var operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? [];
            var users = await Http.GetFromJsonAsync<List<ApplicationUserDto>>("api/users") ?? [];
            var tecnicoDelLogin = users.FirstOrDefault(u => string.Equals(u.Email, user, StringComparison.OrdinalIgnoreCase))?.Tecnico;
            var operarioDelLogin = operarios.FirstOrDefault(o => string.Equals(o.Nombre, tecnicoDelLogin, StringComparison.OrdinalIgnoreCase));
            var esConductor = string.Equals(operarioDelLogin?.Cargo?.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase);
            var conductorAutorizado = esConductor ? operarioDelLogin?.IdOperario : ConductorSeleccionadoId;

            if (solicitud is null || !conductorAutorizado.HasValue || solicitud.IdConductor != conductorAutorizado.Value)
            {
                solicitud = null;
                errorMessage = "No tiene acceso a este servicio.";
                return;
            }

            var tareas = await Http.GetFromJsonAsync<List<Tarea>>("api/tareas") ?? [];
            var estados = await Http.GetFromJsonAsync<List<EstadoSolicitud>>("api/estadosSolicitud") ?? [];
            var motivos = await Http.GetFromJsonAsync<List<Motivo>>("api/motivos") ?? [];
            plantas = await Http.GetFromJsonAsync<List<Planta>>("api/plantas") ?? [];
            conductor = operarios.FirstOrDefault(x => x.IdOperario == solicitud.IdConductor)?.Nombre;
            tarea = tareas.FirstOrDefault(x => x.IdTarea == solicitud.IdTipoTarea)?.NombreTarea;
            estado = estados.FirstOrDefault(x => x.IdEstado == solicitud.Estado)?.Descripcion;
            motivo = motivos.FirstOrDefault(x => x.IdMotivo == solicitud.MotivoReprogramacion)?.DescripcionMotivo;
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { loading = false; }
    }

    private void Volver() => NavigationManager.NavigateTo(
        ConductorSeleccionadoId.HasValue
            ? $"/servicios/mis-servicios?conductor={ConductorSeleccionadoId.Value}"
            : "/servicios/mis-servicios");
    private string Planta(int? id) => plantas.FirstOrDefault(x => x.IdPlanta == id)?.Nombre ?? "-";
}
