<div id="sidebar">
    @* The responsive Drawer renders this single DxMenu on every device. *@
    <DxMenu Orientation="@Orientation.Vertical" CssClass="menu">
        <Items>
            @if (isConductor)
            {
                <DxMenuItem Text="Servicios" CssClass="menu-item" IconCssClass="icon doc-icon">
                    <Items>
                        <DxMenuItem NavigateUrl="/servicios/mis-servicios" Text="Mis servicios" CssClass="menu-item" IconCssClass="icon tareas-icon"></DxMenuItem>
                    </Items>
                </DxMenuItem>
            }
            else
            {
            <DxMenuItem NavigateUrl="/" Text="Inicio" CssClass="menu-item" IconCssClass="icon home-icon"></DxMenuItem>
            
            <DxMenuItem Text="Maestros" CssClass="menu-item" IconCssClass="icon database-icon">
                <Items>
                    <DxMenuItem NavigateUrl="/modelos/contenedores" Text="Contenedores" CssClass="menu-item" IconCssClass="icon contenedores-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/contenedores-tipos" Text="Tipos de contenedores" CssClass="menu-item" IconCssClass="icon tipos-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/obrasmnto" Text="Obras / Precios" CssClass="menu-item" IconCssClass="icon obras-icon"></DxMenuItem>
                 @* <DxMenuItem NavigateUrl="/servicios/precios-especiales-obra" Text="Precios especiales por obra" CssClass="menu-item" IconCssClass="icon doc-icon"></DxMenuItem> *@
                    <DxMenuItem NavigateUrl="/modelos/clientes" Text="Clientes" CssClass="menu-item" IconCssClass="icon operarios-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/estados" Text="Estados" CssClass="menu-item" IconCssClass="icon status-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/prioridades" Text="Prioridades" CssClass="menu-item" IconCssClass="icon status-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/poblaciones" Text="Poblaciones" CssClass="menu-item" IconCssClass="icon status-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/plantas" Text="Plantas" CssClass="menu-item" IconCssClass="icon status-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/motivos" Text="Motivos de aplazamiento" CssClass="menu-item" IconCssClass="icon status-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/camiones" Text="Camiones" CssClass="menu-item" IconCssClass="icon operarios-icon"></DxMenuItem>
                </Items>
            </DxMenuItem>

            <DxMenuItem Text="Laboral" CssClass="menu-item" IconCssClass="icon operarios-icon">
                <Items>
                    <DxMenuItem NavigateUrl="/modelos/operarios" Text="Operarios" CssClass="menu-item" IconCssClass="icon operarios-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/cargos" Text="Cargos" CssClass="menu-item" IconCssClass="icon cargos-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/laboral/usuarios" Text="Usuarios" CssClass="menu-item" IconCssClass="icon person-icon"></DxMenuItem>
                </Items>
            </DxMenuItem>

            <DxMenuItem Text="Servicios" CssClass="menu-item" IconCssClass="icon doc-icon">
                <Items>
                    <DxMenuItem NavigateUrl="/modelos/solicitudes" Text="Solicitudes" CssClass="menu-item" IconCssClass="icon solicitudes-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/planificacion" Text="Planificación" CssClass="menu-item" IconCssClass="icon tareas-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/asignacion-secuencial" Text="Programación" CssClass="menu-item" IconCssClass="icon tareas-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/tareas" Text="Tareas" CssClass="menu-item" IconCssClass="icon tareas-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/modelos/tareas-relaciones" Text=" Transiciones de tareas" CssClass="menu-item" IconCssClass="icon status-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/asignacion-tareas" Text="Asignación de tareas" CssClass="menu-item" IconCssClass="icon tareas-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/mis-servicios" Text="Mis servicios" CssClass="menu-item" IconCssClass="icon tareas-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/albaranes-venta" Text="Albaranes de venta" CssClass="menu-item" IconCssClass="icon doc-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/campos-adicionales-albaranes" Text="Campos adicionales (Anteriores)" CssClass="menu-item" IconCssClass="icon doc-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/adjudicar-kg-plantas" Text="Adjudicar Kg Plantas" CssClass="menu-item" IconCssClass="icon doc-icon"></DxMenuItem>
                    <DxMenuItem NavigateUrl="/servicios/series-sage50" Text="Series de Sage" CssClass="menu-item" IconCssClass="icon doc-icon"></DxMenuItem>
                </Items>
            </DxMenuItem>

            <DxMenuItem Text="Informes" CssClass="menu-item" IconCssClass="icon settings-icon">
                <Items>
                    <DxMenuItem NavigateUrl="/servicios/informes" Text="Informes" CssClass="menu-item" IconCssClass="icon chart-icon"></DxMenuItem>
                </Items>
            </DxMenuItem>

            <DxMenuItem Text="Configuración" CssClass="menu-item" IconCssClass="icon settings-icon">
                <Items>
                    <DxMenuItem NavigateUrl="/modelos/parametros" Text="Parámetros" CssClass="menu-item" IconCssClass="icon settings-icon"></DxMenuItem>
                </Items>
            </DxMenuItem>

            }
        </Items>
    </DxMenu>

    <AuthorizeView>
        <Authorized>
            <div class="mobile-account-actions">
                <NavLink href="@ManageUrl" class="mobile-account-link">
                    <DxButton RenderStyle="@ButtonRenderStyle.Dark" Text="@context.User.Identity?.Name" RenderStyleMode="@ButtonRenderStyleMode.Text" IconCssClass="oi oi-person" />
                </NavLink>
                <DxButton RenderStyle="@ButtonRenderStyle.Dark" Text="Cerrar sesión" RenderStyleMode="@ButtonRenderStyleMode.Text" IconCssClass="oi oi-account-logout" Click="CerrarSesionAsync" />
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="mobile-account-actions">
                <NavLink href="login" class="mobile-account-link">
                    <DxButton RenderStyle="@ButtonRenderStyle.Dark" Text="Iniciar sesión" RenderStyleMode="@ButtonRenderStyleMode.Text" IconCssClass="oi oi-account-login" />
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <div class="theme-selector-container px-3 py-2 mt-4" style="border-top: 1px solid rgba(255,255,255,0.1);">
        <label class="text-white-50 small mb-1 d-block" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Tema Visual</label>
        <DxComboBox Data="@availableThemes"
                    TextFieldName="Name"
                    ValueFieldName="Id"
                    Value="@selectedTheme"
                    ValueChanged="@((string t) => OnThemeChanged(t))"
                    CssClass="w-100" />
    </div>
</div>
 
@inject ST1Savall.Shared.Services.IFormFactor FormFactor
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ST1Savall.Shared.Services.IAuthService AuthService
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using ST1Savall.Shared.Data
 
@code {
    private string ManageUrl => FormFactor.GetPlatform() == "Web" ? "Account/Manage" : "settings";

    private List<ThemeInfo> availableThemes = new()
    {
        new() { Id = "blazing-berry", Name = "Blazing Berry" },
        new() { Id = "blazing-dark", Name = "Blazing Dark" },
        new() { Id = "office-white", Name = "Office White" },
        new() { Id = "purple", Name = "Purple" },
        new() { Id = "fluent-light", Name = "Fluent Light" },
        new() { Id = "fluent-dark", Name = "Fluent Dark" }
    };
    private string selectedTheme = "blazing-berry";
    private bool isConductor;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var email = state.User.Identity?.Name;
        var token = state.User.FindFirst("token")?.Value;
        if (!string.IsNullOrWhiteSpace(token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        if (string.IsNullOrWhiteSpace(email)) return;

        try
        {
            var users = await Http.GetFromJsonAsync<List<ApplicationUserDto>>("api/users") ?? [];
            var user = users.FirstOrDefault(u => string.Equals(u.Email, email, StringComparison.OrdinalIgnoreCase));
            var operarios = await Http.GetFromJsonAsync<List<Operario>>("api/operarios") ?? [];
            isConductor = !string.IsNullOrWhiteSpace(user?.Tecnico)
                && operarios.Any(o => string.Equals(o.Nombre, user.Tecnico, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(o.Cargo?.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase));
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var cookieTheme = await JSRuntime.InvokeAsync<string>("getTheme");
                if (!string.IsNullOrEmpty(cookieTheme) && availableThemes.Any(t => t.Id == cookieTheme))
                {
                    selectedTheme = cookieTheme;
                }

                // Reaplicar el tema al iniciar para sincronizar la hoja de estilos
                // y la clase del elemento HTML, especialmente en la versión web.
                await JSRuntime.InvokeVoidAsync("setTheme", selectedTheme);
                StateHasChanged();
            }
            catch
            {
                
            }
        }
    }

    private async Task OnThemeChanged(string theme)
    {
        selectedTheme = theme;
        await JSRuntime.InvokeVoidAsync("setTheme", theme);
    }

    private async Task CerrarSesionAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    public class ThemeInfo
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }
}


