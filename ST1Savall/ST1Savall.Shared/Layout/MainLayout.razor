@implements IDisposable
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ST1Savall.Shared.Services.IUserDisplayService UserDisplayService
@inject ST1Savall.Shared.Services.IFormFactor FormFactor
@inject ST1Savall.Shared.Services.IAuthService AuthService
@inject ST1Savall.Shared.Services.ObrasMntoGridState ObrasMntoGridState
@inject ST1Savall.Shared.Services.SolicitudesGridState SolicitudesGridState
@inject ST1Savall.Shared.Services.HomeGridState HomeGridState
@inject HttpClient Http

<div class="page">
    <Drawer @ref="drawer" DrawerHeader="drawerHeader">
        <DrawerBody>
            <div class="w-100">
                <NavMenu></NavMenu>
            </div>
        </DrawerBody>
        <DrawerTarget>
            <div class="nav-buttons-container align-items-center">
                <DxButton RenderStyle="@ButtonRenderStyle.Secondary"
                          RenderStyleMode="@ButtonRenderStyleMode.Text"
                          CssClass="menu-button"
                          IconCssClass="oi oi-menu menu-toggle-icon"
                          Click="ToggleNavigationAsync"
                          style="font-size: 1.25rem;" />
                <span class="ms-3 fw-bold text-uppercase display-desktop company-name-label" 
                style="font-size: 1.1rem; letter-spacing: 0.5px;">@companyName</span>
                <span class="flex-grow-1 text-center text-muted display-desktop api-server-label" title="Servidor de la API">API: @ServidorApi</span>
                
                @if (new Uri(NavigationManager.Uri).LocalPath != "/") 
                {
                    <NavLink 
                        href="/"
                        class="button-link hidden">
                                <DxButton RenderStyle="@ButtonRenderStyle.Dark" 
                                Text="Volver al inicio" 
                                RenderStyleMode="@ButtonRenderStyleMode.Text" 
                                CssClass="menu-button-nav" 
                                IconCssClass="oi oi-arrow-left"></DxButton>
                    </NavLink>
                }
                <AuthorizeView>
                    <Authorized>
                        <NavLink href="@ManageUrl" class="button-link menubutton-float-end display-desktop">
                                    <DxButton RenderStyle="@ButtonRenderStyle.Dark" Text="@context.User.Identity?.Name" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button-nav" IconCssClass="oi oi-person"></DxButton>
                        </NavLink>
                        <DxButton RenderStyle="@ButtonRenderStyle.Dark" Click="HandleLogout" Text="Cerrar sesión" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button-nav display-desktop" IconCssClass="oi oi-account-logout"></DxButton>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="@LoginUrl" class="button-link menubutton-float-end display-desktop">
                                    <DxButton RenderStyle="@ButtonRenderStyle.Dark" Text="Iniciar sesión" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button-nav" IconCssClass="oi oi-account-login"></DxButton>
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <div class="px-4 pt-0 pb-4">
                @if (!accessChecked)
                {
                    <div class="p-5 text-center"><div class="spinner-border text-primary"></div></div>
                }
                else if (!isConductor || IsConductorRoute())
                {
                    @Body
                }
                else
                {
                    <div class="p-5 text-center"><div class="spinner-border text-primary"></div></div>
                }
            </div>
        </DrawerTarget>
    </Drawer>
</div>

@code {
    private string ServidorApi => Http.BaseAddress?.GetLeftPart(UriPartial.Authority) ?? "No configurado";
    private string LoginUrl => "login";
    private string ManageUrl => FormFactor.GetPlatform() == "Web" ? "Account/Manage" : "settings";

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }
    private Task ToggleNavigationAsync() => drawer?.ToggleAsync() ?? Task.CompletedTask;

    private Drawer? drawer;

    private RenderFragment drawerHeader => @<div class="navigation-drawer-header d-flex align-items-center justify-content-center px-3 py-2 w-100 bg-white" style="border-radius: 8px; border-bottom: 2px solid #fc9e32;">
        <img class="logo" src="images/logo-savall.jpg" alt="JOSE SAVALL RONDA" style="max-height: 48px; object-fit: contain;" />
    </div>;

    private string? currentUrl;
    private bool accessChecked;
    private bool isConductor;
    private string companyName = "JOSE SAVALL RONDA, S.A.";
    private string displayName = "José Savall Ronda S.A.";

    protected override async Task OnInitializedAsync() {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        try {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            displayName = await UserDisplayService.GetUserDisplayNameAsync(authState.User);

            var token = authState.User.FindFirst("token")?.Value;
            if (!string.IsNullOrEmpty(token)) {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var parametros = await Http.GetFromJsonAsync<List<ST1Savall.Shared.Data.Parametro>>("api/parametros");
            var empresa = parametros?.FirstOrDefault()?.Empresa;
            if (!string.IsNullOrWhiteSpace(empresa)) {
                companyName = empresa;
            }

            var users = await Http.GetFromJsonAsync<List<ST1Savall.Shared.Data.ApplicationUserDto>>("api/users") ?? [];
            var operarios = await Http.GetFromJsonAsync<List<ST1Savall.Shared.Data.Operario>>("api/operarios") ?? [];
            var user = users.FirstOrDefault(u => string.Equals(u.Email, authState.User.Identity?.Name, StringComparison.OrdinalIgnoreCase));
            isConductor = !string.IsNullOrWhiteSpace(user?.Tecnico)
                && operarios.Any(o => string.Equals(o.Nombre, user.Tecnico, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(o.Cargo?.Descripcion, "Conductor", StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex) {
            Console.WriteLine($"Error loading user display name in layout: {ex.Message}");
        }
        finally {
            accessChecked = true;
        }

        RedirectConductorToServices();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) {
        var previousPath = new Uri($"{NavigationManager.BaseUri.TrimEnd('/')}/{(currentUrl ?? string.Empty).TrimStart('/')}").LocalPath;
        var nextPath = new Uri(e.Location).LocalPath;

        const string obrasPath = "/modelos/obrasmnto";
        const string solicitudesPath = "/modelos/solicitudes";
        const string mapPath = "/modelos/contenedores/mapa";
        var comesFromObras = previousPath.StartsWith(obrasPath, StringComparison.OrdinalIgnoreCase);

        if (nextPath.Equals(mapPath, StringComparison.OrdinalIgnoreCase)) {
            if (comesFromObras) {
                ObrasMntoGridState.IsMapNavigationFromObras = true;
            }
            else {
                ObrasMntoGridState.Clear();
            }
        }
        else if (nextPath.StartsWith(obrasPath, StringComparison.OrdinalIgnoreCase)) {
            var returnsFromObrasMap = previousPath.Equals(mapPath, StringComparison.OrdinalIgnoreCase)
                && ObrasMntoGridState.IsMapNavigationFromObras;

            ObrasMntoGridState.IsMapNavigationFromObras = false;
            if (nextPath.Equals(obrasPath, StringComparison.OrdinalIgnoreCase)
                && !previousPath.StartsWith($"{obrasPath}/edit", StringComparison.OrdinalIgnoreCase)
                && !returnsFromObrasMap) {
                ObrasMntoGridState.Clear();
            }
        }
        else {
            ObrasMntoGridState.Clear();
        }

        if (nextPath.StartsWith(solicitudesPath, StringComparison.OrdinalIgnoreCase)) {
            if (nextPath.Equals(solicitudesPath, StringComparison.OrdinalIgnoreCase)
                && !previousPath.StartsWith($"{solicitudesPath}/edit", StringComparison.OrdinalIgnoreCase)
                && !previousPath.StartsWith(obrasPath, StringComparison.OrdinalIgnoreCase)
                && !previousPath.Equals(mapPath, StringComparison.OrdinalIgnoreCase)) {
                SolicitudesGridState.Clear();
            }
        }
        else if (!nextPath.StartsWith($"{solicitudesPath}/edit", StringComparison.OrdinalIgnoreCase)
            && !nextPath.StartsWith(obrasPath, StringComparison.OrdinalIgnoreCase)
            && !nextPath.Equals(mapPath, StringComparison.OrdinalIgnoreCase)) {
            SolicitudesGridState.Clear();
        }

        if (nextPath.Equals("/", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(nextPath.Trim('/'))) {
            if (!previousPath.StartsWith($"{solicitudesPath}/edit", StringComparison.OrdinalIgnoreCase)
                && !previousPath.StartsWith(obrasPath, StringComparison.OrdinalIgnoreCase)
                && !previousPath.Equals(mapPath, StringComparison.OrdinalIgnoreCase)) {
                HomeGridState.Clear();
            }
        }
        else if (!nextPath.StartsWith($"{solicitudesPath}/edit", StringComparison.OrdinalIgnoreCase)
            && !nextPath.StartsWith(obrasPath, StringComparison.OrdinalIgnoreCase)
            && !nextPath.Equals(mapPath, StringComparison.OrdinalIgnoreCase)) {
            HomeGridState.Clear();
        }

        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        RedirectConductorToServices();
        StateHasChanged();
    }

    private bool IsConductorRoute() => new Uri(NavigationManager.Uri).LocalPath
        .StartsWith("/servicios/mis-servicios", StringComparison.OrdinalIgnoreCase);

    private void RedirectConductorToServices()
    {
        if (accessChecked && isConductor && !IsConductorRoute())
        {
            NavigationManager.NavigateTo("/servicios/mis-servicios", replace: true);
        }
    }

    public void Dispose() {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
 
}
